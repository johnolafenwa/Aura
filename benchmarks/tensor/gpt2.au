import sys
import tensor
from tensor import Device, Tensor, float16


# GPT-2 with its real weights, as `float32` and as `float16` tensors.
# Pass the path of `model.safetensors` of the 124M model, then `gpu` for
# the GPU device and `small` for sizes that finish in seconds. Each row
# prints `<name> <size> <milliseconds> <result> <first pass milliseconds>`.


class Affine[T]:
    weight: Tensor[T]
    bias: Tensor[T]


class Block[T]:
    ln_1: Affine[T]
    c_attn: Affine[T]
    attn_proj: Affine[T]
    ln_2: Affine[T]
    c_fc: Affine[T]
    mlp_proj: Affine[T]


class Gpt2[T]:
    wte: Tensor[T]
    wpe: Tensor[T]
    blocks: list[Block[T]]
    ln_f: Affine[T]
    heads: int64


def gelu_new[T](x: Tensor[T]) -> Tensor[T]:
    # The approximation of gelu that GPT-2 was trained with.
    inner = (x + x * x * x * 0.044715) * 0.7978845608028654
    return x * 0.5 * (inner.tanh() + 1.0)


def split_heads[T](x: Tensor[T], heads: int64) -> Tensor[T]:
    shape = x.shape()
    return x.reshape([shape[0], shape[1], heads, shape[2] // heads]).permute([0, 2, 1, 3])


def attend[T](x: Tensor[T], block: Block[T], heads: int64) -> Tensor[T]:
    shape = x.shape()
    width = shape[2]
    joined = tensor.linear(x, block.c_attn.weight, block.c_attn.bias)
    query = split_heads(joined.slice(2, 0, width), heads)
    key = split_heads(joined.slice(2, width, 2 * width), heads)
    value = split_heads(joined.slice(2, 2 * width, 3 * width), heads)
    mixed = tensor.scaled_dot_product_attention(query, key, value, true)
    return tensor.linear(mixed.permute([0, 2, 1, 3]).reshape(shape), block.attn_proj.weight, block.attn_proj.bias)


def hidden_of[T](model: Gpt2[T], ids: Tensor[int64]) -> Tensor[T]:
    # The model's last hidden rows for `[batch, length]` tokens.
    length = ids.shape()[1]
    places = tensor.arange(length, ids.device())
    mut hidden = model.wte.index_select(0, ids) + model.wpe.index_select(0, places)
    for at in range(model.blocks.len()):
        view block = model.blocks[at]
        normed = tensor.layer_norm(hidden, block.ln_1.weight, block.ln_1.bias)
        attended = hidden + attend(normed, block, model.heads)
        inner = tensor.layer_norm(attended, block.ln_2.weight, block.ln_2.bias)
        wide = gelu_new(tensor.linear(inner, block.c_fc.weight, block.c_fc.bias))
        hidden = attended + tensor.linear(wide, block.mlp_proj.weight, block.mlp_proj.bias)
    return hidden


def next_tokens[T](model: Gpt2[T], ids: Tensor[int64]) -> Tensor[int64]:
    # The likeliest next token of each row.
    shape = ids.shape()
    hidden = hidden_of(model, ids)
    last = hidden.slice(1, shape[1] - 1, shape[1])
    final = tensor.layer_norm(last, model.ln_f.weight, model.ln_f.bias).reshape([shape[0], -1])
    return final.matmul(model.wte.transpose()).argmax()


def affine(path: str, name: str, device: Device) -> Result[Affine[float32], str]:
    weight = try tensor.load_float32(path, f"{name}.weight", device)
    bias = try tensor.load_float32(path, f"{name}.bias", device)
    return Ok(Affine[float32](weight=weight, bias=bias))


def load(path: str, layers: int64, device: Device) -> Result[Gpt2[float32], str]:
    mut blocks: list[Block[float32]] = []
    for layer in range(layers):
        blocks.append(
            Block[float32](
                ln_1=try affine(path, f"h.{layer}.ln_1", device),
                c_attn=try affine(path, f"h.{layer}.attn.c_attn", device),
                attn_proj=try affine(path, f"h.{layer}.attn.c_proj", device),
                ln_2=try affine(path, f"h.{layer}.ln_2", device),
                c_fc=try affine(path, f"h.{layer}.mlp.c_fc", device),
                mlp_proj=try affine(path, f"h.{layer}.mlp.c_proj", device),
            )
        )
    return Ok(
        Gpt2[float32](
            wte=try tensor.load_float32(path, "wte.weight", device),
            wpe=try tensor.load_float32(path, "wpe.weight", device),
            blocks=blocks,
            ln_f=try affine(path, "ln_f", device),
            heads=12,
        )
    )


def narrow(pair: Affine[float32]) -> Affine[float16]:
    return Affine[float16](weight=pair.weight.to_float16(), bias=pair.bias.to_float16())


def halved(model: Gpt2[float32]) -> Gpt2[float16]:
    # The same model with every weight rounded to half precision.
    mut blocks: list[Block[float16]] = []
    for at in range(model.blocks.len()):
        view block = model.blocks[at]
        blocks.append(
            Block[float16](
                ln_1=narrow(block.ln_1),
                c_attn=narrow(block.c_attn),
                attn_proj=narrow(block.attn_proj),
                ln_2=narrow(block.ln_2),
                c_fc=narrow(block.c_fc),
                mlp_proj=narrow(block.mlp_proj),
            )
        )
    return Gpt2[float16](
        wte=model.wte.to_float16(),
        wpe=model.wpe.to_float16(),
        blocks=blocks,
        ln_f=narrow(model.ln_f),
        heads=model.heads,
    )


def generate[T](name: str, model: Gpt2[T], count: int64, device: Device) -> None:
    # Greedy text after "Hello, I'm a language model,", one token at a
    # time over the whole text so far.
    mut tokens = [15496, 11, 314, 1101, 257, 3303, 2746, 11]
    mut first = 0
    mut start = sys.monotonic_time_ms()
    for step in range(count + 1):
        ids = Tensor[int64].from_array(Array[int64].from_list(tokens, [1, tokens.len()]), device)
        tokens.append(next_tokens(model, ids).item())
        if step == 0:
            first = sys.monotonic_time_ms() - start
            start = sys.monotonic_time_ms()
    mut sum = 0
    for token in tokens:
        sum += token
    print(f"{name} {count} {sys.monotonic_time_ms() - start} {sum} {first}")
    print(f"# {name} tokens {tokens}")


def infer[T](name: str, model: Gpt2[T], batch: int64, context: int64, reps: int64, device: Device) -> None:
    # The next token of each row of a batch of fixed tokens.
    places = tensor.arange(batch * context, device)
    spread = places * 7919 + 104729
    # Integer tensors do not divide yet, so the quotient goes through floats.
    ids = (spread - (spread.to_float64() / 50257.0).to_int64() * 50257).reshape([batch, context])
    ids.eval()
    mut total = 0
    mut first = 0
    mut start = sys.monotonic_time_ms()
    for rep in range(reps + 1):
        total = next_tokens(model, ids).sum().item()
        if rep == 0:
            first = sys.monotonic_time_ms() - start
            start = sys.monotonic_time_ms()
    print(f"{name} {batch}x{context} {sys.monotonic_time_ms() - start} {total} {first}")


def main() -> int32:
    args = sys.args()
    mut device = Device.cpu()
    mut small = false
    mut path = ""
    for arg in args:
        if arg == "gpu":
            device = Device.default()
            if not device.is_gpu():
                print("this machine has no GPU device")
                return 1
        elif arg == "small":
            small = true
        elif arg.ends_with(".safetensors"):
            path = arg.clone()
    if path == "":
        print("usage: gpt2 <model.safetensors> [gpu] [small]")
        return 1
    print(f"device {device.name()}")
    tensor.set_grad_enabled(false)
    mut layers = 12
    mut count = 20
    mut batch = 8
    mut context = 256
    mut reps = 10
    if small:
        layers = 2
        count = 3
        batch = 2
        context = 16
        reps = 2
    match own load(path, layers, device):
        case Err(message):
            print(f"could not load the weights: {message}")
            return 1
        case Ok(model):
            generate("gpt2_generate", model, count, device)
            infer("gpt2_infer", model, batch, context, reps, device)
            half = halved(model)
            generate("gpt2_generate_float16", half, count, device)
            infer("gpt2_infer_float16", half, batch, context, reps, device)
    return 0
