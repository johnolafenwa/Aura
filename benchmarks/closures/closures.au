import sys

type Step = Callable[def(value: int64) -> int64]
type Tally = Callable[mut def(amount: int64) -> int64]


class Total:
    sum: int64

    def add(mut self, amount: int64) -> int64:
        self.sum = self.sum + amount
        return self.sum


class Rule:
    weight: int64
    step: Step


def make_adder(amount: int64) -> Step:
    return lambda value: value + amount


def apply(step: Step, value: int64) -> int64:
    return step(value)


def running_total() -> Tally:
    total = Total(sum=0)
    return lambda [own total] amount: total.add(amount)


def list_call(count: int64, reps: int64) -> None:
    mut steps: list[Step] = []
    for index in range(count):
        if index % 2 == 0:
            steps.append(make_adder(index))
        else:
            steps.append(lambda value: value ^ index)
    mut acc = 0
    start = sys.monotonic_time_ms()
    for rep in range(reps):
        for step in steps:
            acc = step(acc) & 1048575
    print(f"list_call {count * reps} {sys.monotonic_time_ms() - start} {acc}")


def field_call(calls: int64) -> None:
    rule = Rule(weight=3, step=make_adder(7))
    mut acc = 0
    start = sys.monotonic_time_ms()
    for index in range(calls):
        acc = rule.step(acc + rule.weight) & 1048575
    print(f"field_call {calls} {sys.monotonic_time_ms() - start} {acc}")


def mutable_call(calls: int64) -> None:
    mut tally = running_total()
    mut acc = 0
    start = sys.monotonic_time_ms()
    for index in range(calls):
        acc = tally(index & 7)
    print(f"mutable_call {calls} {sys.monotonic_time_ms() - start} {acc}")


def create_call(calls: int64) -> None:
    mut acc = 0
    start = sys.monotonic_time_ms()
    for index in range(calls):
        step = make_adder(index & 15)
        acc = step(acc) & 1048575
    print(f"create_call {calls} {sys.monotonic_time_ms() - start} {acc}")


def argument_call(calls: int64) -> None:
    mut acc = 0
    start = sys.monotonic_time_ms()
    for index in range(calls):
        acc = apply(lambda value: value + index, acc) & 1048575
    print(f"argument_call {calls} {sys.monotonic_time_ms() - start} {acc}")


def main():
    list_call(64, 500000)
    field_call(30000000)
    mutable_call(30000000)
    create_call(10000000)
    argument_call(10000000)
