import sys

type Step = Callable[def(value: int64) -> int64]


def measure_lambda(seed: int64, count: int64) -> None:
    step: Step = lambda value: (value * 3 + seed) & 1048575
    mut result = 1
    start = sys.monotonic_time_ms()
    for index in range(count):
        result = step(result)
    print(f"lambda {count} {sys.monotonic_time_ms() - start} {result}")


def measure_local(seed: int64, count: int64) -> None:
    def step(value: int64) -> int64:
        return (value * 3 + seed) & 1048575
    mut result = 1
    start = sys.monotonic_time_ms()
    for index in range(count):
        result = step(result)
    print(f"local {count} {sys.monotonic_time_ms() - start} {result}")


def main() -> int32:
    args = sys.args()
    mut seed: int64 = 7
    mut count: int64 = 48000000
    if len(args) > 0:
        match parse_int64(args[0]):
            case Result.Ok(value):
                seed = value
            case Result.Err(_):
                print("expected an integer seed")
                return 2
    if len(args) > 1:
        match parse_int64(args[1]):
            case Result.Ok(value):
                count = value
            case Result.Err(_):
                print("expected an integer count")
                return 2
    measure_local(seed, count)
    measure_lambda(seed, count)
    return 0
