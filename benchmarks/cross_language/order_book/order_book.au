# Trading: a limit order book with price-time priority matching.
#
# Feeds N events into a book with 1,000 price ticks: limit orders (60%), cancels
# of earlier orders (25%), and market orders (15%) around a drifting mid price.
# Each price level keeps a FIFO of order ids with a head index; cancelled orders
# are skipped lazily when they reach the head. Reports trades, volume, notional
# value, cancels, resting orders, the final best bid and ask, and a checksum.
import sys

TICKS = 1000
BUY = 0
SELL = 1
MOD = 1000000007


class Rng:
    state: int64

    def next(mut self) -> int64:
        self.state = self.state * 48271 % 2147483647
        return self.state


class OrderBook:
    order_qty: list[int64]
    order_price: list[int64]
    order_side: list[int64]
    bids: list[list[int64]]
    asks: list[list[int64]]
    bid_heads: list[int64]
    ask_heads: list[int64]
    bid_qty: list[int64]
    ask_qty: list[int64]
    best_bid: int64
    best_ask: int64
    trades: int64
    volume: int64
    notional: int64
    cancels: int64
    checksum: int64

    def fix_best_bid(mut self):
        while self.best_bid >= 0 and self.bid_qty[self.best_bid] == 0:
            self.best_bid -= 1

    def fix_best_ask(mut self):
        while self.best_ask < TICKS and self.ask_qty[self.best_ask] == 0:
            self.best_ask += 1

    def fill(mut self, resting: int64, remaining: int64, level: int64) -> int64:
        amount = min(remaining, self.order_qty[resting])
        self.order_qty[resting] -= amount
        self.trades += 1
        self.volume += amount
        self.notional += amount * level
        self.checksum = (self.checksum * 31 + resting * 7 + amount) % MOD
        return amount

    def submit(mut self, side: int64, price: int64, qty: int64, rest: bool):
        order_id = self.order_qty.len()
        self.order_qty.append(0)
        self.order_price.append(price)
        self.order_side.append(side)
        mut remaining = qty
        if side == BUY:
            while remaining > 0:
                self.fix_best_ask()
                if self.best_ask >= TICKS or self.best_ask > price:
                    break
                level = self.best_ask
                mut head = self.ask_heads[level]
                while self.order_qty[self.asks[level][head]] == 0:
                    head += 1
                resting = self.asks[level][head]
                amount = self.fill(resting, remaining, level)
                remaining -= amount
                self.ask_qty[level] -= amount
                if self.order_qty[resting] == 0:
                    head += 1
                self.ask_heads[level] = head
            if remaining > 0 and rest:
                self.order_qty[order_id] = remaining
                self.bids[price].append(order_id)
                self.bid_qty[price] += remaining
                if price > self.best_bid:
                    self.best_bid = price
        else:
            while remaining > 0:
                self.fix_best_bid()
                if self.best_bid < 0 or self.best_bid < price:
                    break
                level = self.best_bid
                mut head = self.bid_heads[level]
                while self.order_qty[self.bids[level][head]] == 0:
                    head += 1
                resting = self.bids[level][head]
                amount = self.fill(resting, remaining, level)
                remaining -= amount
                self.bid_qty[level] -= amount
                if self.order_qty[resting] == 0:
                    head += 1
                self.bid_heads[level] = head
            if remaining > 0 and rest:
                self.order_qty[order_id] = remaining
                self.asks[price].append(order_id)
                self.ask_qty[price] += remaining
                if price < self.best_ask:
                    self.best_ask = price

    def cancel(mut self, order_id: int64):
        qty = self.order_qty[order_id]
        if qty == 0:
            return
        price = self.order_price[order_id]
        if self.order_side[order_id] == BUY:
            self.bid_qty[price] -= qty
        else:
            self.ask_qty[price] -= qty
        self.order_qty[order_id] = 0
        self.cancels += 1


def zeros(n: int64) -> list[int64]:
    mut values: list[int64] = []
    for _ in range(n):
        values.append(0)
    return values


def empty_levels(n: int64) -> list[list[int64]]:
    mut levels: list[list[int64]] = []
    for _ in range(n):
        levels.append(list[int64]())
    return levels


def main():
    match parse_int64(sys.args()[0]):
        case Result.Ok(n):
            run(n)
        case Result.Err(_):
            print("usage: order_book <events>")


def run(n: int64):
    mut rng = Rng(state=47)
    mut book = OrderBook(
        order_qty=[],
        order_price=[],
        order_side=[],
        bids=empty_levels(TICKS),
        asks=empty_levels(TICKS),
        bid_heads=zeros(TICKS),
        ask_heads=zeros(TICKS),
        bid_qty=zeros(TICKS),
        ask_qty=zeros(TICKS),
        best_bid=-1,
        best_ask=TICKS,
        trades=0,
        volume=0,
        notional=0,
        cancels=0,
        checksum=0,
    )
    mut mid = 500
    for step in range(n):
        r = rng.next()
        if step % 100 == 0:
            mid = min(900, max(100, mid + (r // 100) % 11 - 5))
        kind = r % 100
        if kind < 60:
            side = (r // 100) % 2
            offset = (r // 200) % 20
            qty = 1 + (r // 4000) % 50
            if side == BUY:
                book.submit(BUY, mid - offset + 5, qty, true)
            else:
                book.submit(SELL, mid + offset - 5, qty, true)
        elif kind < 85:
            orders = book.order_qty.len()
            if orders > 0:
                book.cancel((r // 100) % orders)
        else:
            side = (r // 100) % 2
            qty = 1 + (r // 200) % 100
            if side == BUY:
                book.submit(BUY, TICKS - 1, qty, false)
            else:
                book.submit(SELL, 0, qty, false)
    book.fix_best_bid()
    book.fix_best_ask()
    mut resting = 0
    for qty in book.order_qty:
        if qty > 0:
            resting += 1
    print(
        f"order_book events={n} orders={book.order_qty.len()} trades={book.trades} volume={book.volume} notional={book.notional} cancels={book.cancels} resting={resting} best_bid={book.best_bid} best_ask={book.best_ask} checksum={book.checksum}"
    )
