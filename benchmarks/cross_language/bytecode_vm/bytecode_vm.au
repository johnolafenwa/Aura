# Bytecode virtual machine: assemble three stack-machine programs and run them.
#
# A two-pass assembler turns text assembly into integer bytecode. A dispatch
# loop then runs an arithmetic loop, a sieve of Eratosthenes in VM memory, and
# an iterative Fibonacci sequence modulo a prime.
import sys


def arithmetic_program() -> str:
    return """
    push 0
    store 0
    push 0
    store 1
loop:
    load 0
    push N
    lt
    jz done
    load 1
    load 0
    load 0
    mul
    push 7
    mod
    add
    load 0
    push 3
    mod
    sub
    store 1
    load 0
    push 1
    add
    store 0
    jmp loop
done:
    load 1
    out
    halt
"""


def sieve_program() -> str:
    return """
    push 2
    store 0
outer:
    load 0
    load 0
    mul
    push N1
    lt
    jz count
    load 0
    loadm
    jnz next
    load 0
    load 0
    mul
    store 1
inner:
    load 1
    push N1
    lt
    jz next
    push 1
    load 1
    storem
    load 1
    load 0
    add
    store 1
    jmp inner
next:
    load 0
    push 1
    add
    store 0
    jmp outer
count:
    push 2
    store 0
    push 0
    store 2
scan:
    load 0
    push N1
    lt
    jz finish
    load 0
    loadm
    jnz skip
    load 2
    push 1
    add
    store 2
skip:
    load 0
    push 1
    add
    store 0
    jmp scan
finish:
    load 2
    out
    halt
"""


def fibonacci_program() -> str:
    return """
    push 0
    store 0
    push 1
    store 1
    push 0
    store 2
step:
    load 2
    push N
    lt
    jz end
    load 0
    load 1
    dup
    store 0
    add
    push 1000007
    mod
    store 1
    load 2
    push 1
    add
    store 2
    jmp step
end:
    load 0
    out
    halt
"""


def opcodes() -> list[str]:
    return [
        "halt",
        "push",
        "load",
        "store",
        "add",
        "sub",
        "mul",
        "div",
        "mod",
        "lt",
        "eq",
        "jmp",
        "jz",
        "jnz",
        "loadm",
        "storem",
        "out",
        "dup",
    ]


def assemble(text: str, n: int64) -> list[int64]:
    names = opcodes()
    mut lines: list[str] = []
    for raw in text.lines():
        line = raw.trim()
        if line.len() > 0:
            lines.append(line)
    mut labels: dict[str, int64] = {}
    mut address = 0
    for line in lines:
        if line.ends_with(":"):
            labels[line[:-1]] = address
        else:
            address += line.split_whitespace().len()
    mut code: list[int64] = []
    for line in lines:
        if line.ends_with(":"):
            continue
        parts = line.split_whitespace()
        code.append(names.index(parts[0]))
        if parts.len() == 2:
            view operand = parts[1]
            if operand == "N":
                code.append(n)
            elif operand == "N1":
                code.append(n + 1)
            else:
                match labels.get(operand):
                    case Lookup.Found(target):
                        code.append(target)
                    case Lookup.Missing:
                        match parse_int64(operand):
                            case Result.Ok(value):
                                code.append(value)
                            case Result.Err(_):
                                code.append(0)
    return code


def execute(code: list[int64], memory_size: int64, out: mut list[int64]) -> int64:
    mut stack: list[int64] = []
    mut registers: list[int64] = [0, 0, 0, 0, 0, 0, 0, 0]
    mut memory = list[int64].with_capacity(memory_size)
    for _ in range(memory_size):
        memory.append(0)
    mut pc = 0
    mut steps = 0
    while true:
        op = code[pc]
        steps += 1
        match op:
            case 1:
                stack.append(code[pc + 1])
                pc += 2
            case 2:
                stack.append(registers[code[pc + 1]])
                pc += 2
            case 3:
                registers[code[pc + 1]] = stack.pop()
                pc += 2
            case 4:
                b = stack.pop()
                a = stack.pop()
                stack.append(a + b)
                pc += 1
            case 5:
                b = stack.pop()
                a = stack.pop()
                stack.append(a - b)
                pc += 1
            case 6:
                b = stack.pop()
                a = stack.pop()
                stack.append(a * b)
                pc += 1
            case 7:
                b = stack.pop()
                a = stack.pop()
                stack.append(a // b)
                pc += 1
            case 8:
                b = stack.pop()
                a = stack.pop()
                stack.append(a % b)
                pc += 1
            case 9:
                b = stack.pop()
                a = stack.pop()
                stack.append(1 if a < b else 0)
                pc += 1
            case 10:
                b = stack.pop()
                a = stack.pop()
                stack.append(1 if a == b else 0)
                pc += 1
            case 11:
                pc = code[pc + 1]
            case 12:
                pc = code[pc + 1] if stack.pop() == 0 else pc + 2
            case 13:
                pc = code[pc + 1] if stack.pop() != 0 else pc + 2
            case 14:
                address = stack.pop()
                stack.append(memory[address])
                pc += 1
            case 15:
                address = stack.pop()
                memory[address] = stack.pop()
                pc += 1
            case 16:
                out.append(stack.pop())
                pc += 1
            case 17:
                top = stack[-1]
                stack.append(top)
                pc += 1
            case _:
                return steps
    return steps


def main():
    match parse_int64(sys.args()[0]):
        case Result.Ok(n):
            mut out: list[int64] = []
            mut steps = 0
            mut code_size = 0
            for text in [arithmetic_program(), sieve_program(), fibonacci_program()]:
                code = assemble(text, n)
                code_size += code.len()
                steps += execute(code, n + 1, out)
            printed = ",".join([f"{value}" for value in out])
            print(f"bytecode_vm n={n} code={code_size} steps={steps} output={printed}")
        case Result.Err(_):
            print("usage: bytecode_vm <n>")
