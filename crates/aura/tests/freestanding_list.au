class Bag:
    items: list[int64]
    name: str

def total(values: list[int64]) -> int64:
    mut sum = 0
    for value in values:
        sum = sum + value
    return sum

def fill(values: mut list[float64], n: int64) -> None:
    for i in range(0, n):
        values.append(i as float64 * 0.5)

def squares(n: int64) -> list[int64]:
    mut out: list[int64] = []
    for i in range(0, n):
        out.append(i * i)
    return out

def work(n: int64) -> int64:
    mut items = [3, 4, 5]
    items.append(6)
    items[1] = 40
    mut halves: list[float64] = []
    fill(halves, 5)
    bag = Bag(items=[1, 2], name="b")
    flags = [true, false, true]
    mut count = 0
    for flag in flags:
        if flag:
            count = count + 1
    small: list[uint8] = [250, 5]
    mut sum = total(items) + items.len() + items[0] + (halves[4] as int64) + total(bag.items) + count + (small[0] as int64)
    if not items.is_empty():
        sum = sum + items[-1] * 1000
    many = squares(n)
    sum = sum + total(many) + many[n - 1] + many.len()
    items.clear()
    if items.is_empty():
        sum = sum + 1000000
    return sum + bag.name.len()

export "C" def entry(n: int64) -> int64:
    return work(n)

def main() -> None:
    print(entry(40))
