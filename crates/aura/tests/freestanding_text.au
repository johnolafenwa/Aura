class Named:
    name: str
    age: int64

enum Token:
    Word(str)
    Number(int64)
    Stop

def greet(name: str, n: int64) -> str:
    mut out = "hi " + name
    if name == "bob":
        out = out + "!"
    if n > 2:
        out = out + " again"
    return out

def keep(name: own str) -> Named:
    return Named(name=name, age=3)

def pick(flag: bool) -> str:
    if flag:
        return "yes"
    return "no"

def weigh(token: Token) -> int64:
    match token:
        case Token.Word(text):
            return text.len()
        case Token.Number(n):
            return n
        case Token.Stop:
            return 0 - 1

def check(text: str) -> Result[str, str]:
    if text.starts_with("hi"):
        return Ok(text + "?")
    return Err("bad " + text)

def both(text: str) -> Result[int64, str]:
    first = try check(text)
    second = try check(first + " é")
    return Ok(first.len() * 100 + second.byte_len())

def total(n: int64) -> int64:
    a = greet("bob", 2)
    b = greet(a, n)
    k = keep("zed")
    mut sum = b.len() + k.name.len() + pick(true).len() + k.age
    if a < b:
        sum = sum + 1000
    if a.starts_with("hi") and b.ends_with("again") and b.contains("bob!") and not a.contains("zed"):
        sum = sum + 10000
    if k.name == "zed" and k.name != "zeds":
        sum = sum + 100000
    sum = sum + weigh(Token.Word("héllo")) + weigh(Token.Number(7)) + weigh(Token.Stop)
    match both(a):
        case Ok(v):
            sum = sum + v * 1000000
        case Err(e):
            sum = sum - e.len()
    match both("x"):
        case Ok(v):
            sum = sum + v
        case Err(e):
            sum = sum - e.len() * 3
    return sum

def describe(name: str, count: int64, small: uint8, flag: bool, wide: uint64) -> str:
    return f"{name}: {count} of {small} ({flag}) max {wide}{-5}"

def lowest() -> str:
    low: int64 = -9223372036854775807 - 1
    tiny: int8 = -128
    return f"{low}{tiny}" + f"" + f"plain" + f"{0}"

def formatted(text: str) -> int64:
    mut sum = text.len() * 1000
    if text == "board: -42 of 200 (true) max 18446744073709551615-5":
        sum = sum + 1
    if lowest() == "-9223372036854775808-128plain0":
        sum = sum + 20
    if f"{false}" == "false":
        sum = sum + 300
    return sum

export "C" def entry(n: int64) -> int64:
    return total(n) + formatted(describe("board", 0 - 42, 200, true, 18446744073709551615))

def main() -> None:
    print(entry(40))
