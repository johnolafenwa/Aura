class Shelf:
    counts: dict[str, int64]
    size: int64

def count_words(words: list[str]) -> dict[str, int64]:
    mut counts: dict[str, int64] = {}
    for word in words:
        if word in counts:
            seen = counts[word]
            counts[word.clone()] = seen + 1
        else:
            counts[word.clone()] = 1
    return counts

def squares(n: int64) -> dict[int64, int64]:
    mut out: dict[int64, int64] = {}
    for i in range(0 - n, n):
        out[i] = i * i
    return out

def work(n: int64) -> int64:
    mut ages: dict[str, int64] = {"a": 1, "b": 2}
    ages["c"] = n
    ages["a"] = 10
    mut sum = ages["a"] + ages.len()
    if "b" in ages:
        sum = sum + 100
    if "zz" in ages:
        sum = sum + 5000
    for (key, value) in ages.items():
        sum = sum + key.len() + value
    for key in ages.keys():
        sum = sum + key.len()
    for value in ages.values():
        sum = sum + value
    mut ids: dict[int64, str] = {}
    ids[n] = "x"
    ids[0 - 3] = "minus"
    ids[n] = "longer"
    sum = sum + ids[n].len() + ids[0 - 3].len() * 1000 + ids.len()
    table = squares(n)
    sum = sum + table[0 - 7] + table[n - 1] + table.len()
    words = ["to", "be", "or", "not", "to", "be"]
    shelf = Shelf(counts=count_words(words), size=1)
    sum = sum + shelf.counts["to"] * 100000 + shelf.counts["not"] * 1000000 + shelf.counts.len()
    mut nested: dict[str, list[int64]] = {}
    nested["evens"] = [2, 4]
    nested["odds"] = [1, 3, 5]
    nested["evens"] = [2, 4, 6, 8]
    view evens = nested["evens"]
    sum = sum + evens.len() * 10000000
    mut big: dict[uint64, int64] = {}
    mut i: uint64 = 0
    while i < 300:
        big[i * 7] = (i as int64)
        i = i + 1
    sum = sum + big[7 * 299] + big.len()
    ages.clear()
    if ages.is_empty():
        sum = sum + 1
    return sum

export "C" def entry(n: int64) -> int64:
    return work(n)

def main() -> None:
    print(entry(40))
