# Tuples, enums with and without payloads, a generic enum, a result, an
# enum that holds a class, and a class that holds both. A freestanding
# build keeps each in machine words. The tests build `total` on every
# target and compare it with what `main` prints.

enum Color:
    Red
    Green
    Blue

enum Option2[T]:
    Some2(T)
    None2

class Point:
    x: int64
    y: int64

enum Item:
    At(Point)
    Pair((int64, float64))
    Flag(bool, uint8)
    Tinted(Color, int32)
    Nothing

class Holder:
    item: Item
    where: (int64, int64)

def color_code(c: Color) -> int64:
    match c:
        case Color.Red:
            return 1
        case Color.Green:
            return 2
        case _:
            return 3

def item_value(item: Item) -> int64:
    match item:
        case Item.At(p):
            return p.x * 10 + p.y
        case Item.Pair(t):
            return t[0] + (t[1] as int64)
        case Item.Flag(b, n):
            if b:
                return (n as int64)
            return 0 - (n as int64)
        case Item.Tinted(c, n):
            return color_code(c) * 100 + (n as int64)
        case Item.Nothing:
            return 7

def first(o: Option2[int64], fallback: int64) -> int64:
    match o:
        case Option2.Some2(v):
            return v
        case Option2.None2:
            return fallback

def find(n: int64) -> Option2[int64]:
    if n > 3:
        return Option2.Some2(n * 2)
    return Option2.None2

def swap(t: (int64, int64)) -> (int64, int64):
    return (t[1], t[0])

def divide(a: int64, b: int64) -> Result[(int64, int64), Color]:
    if b == 0:
        return Err(Color.Blue)
    return Ok((a // b, a % b))

def compute(n: int64) -> int64:
    mut total = 0
    for i in range(0, n):
        mut item = Item.Nothing
        if i % 5 == 0:
            item = Item.At(Point(x=i, y=n))
        elif i % 5 == 1:
            item = Item.Pair((i, 2.5))
        elif i % 5 == 2:
            item = Item.Flag(i % 2 == 0, (i as uint8))
        elif i % 5 == 3:
            item = Item.Tinted(Color.Green, (i as int32))
        holder = Holder(item=item, where=(i, i + 1))
        total = total + item_value(holder.item) + holder.where[1]
        total = total + first(find(i), 0 - 1)
        s = swap((i, total))
        total = s[0] - s[1]
        match divide(total, i):
            case Ok(qr):
                total = total + qr[0] + qr[1]
            case Err(c):
                total = total + color_code(c)
    return total

export "C" def total(n: int64) -> int64:
    return compute(n)

def main() -> None:
    print(total(40))
