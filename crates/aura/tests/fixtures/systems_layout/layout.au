import mem

extern "C" packed align(8) class Header:
    kind: uint8
    serial: uint32
    count: uint16 bits(5)
    mode: uint16 bits(3)

extern "C" union Word:
    whole: uint32
    low: uint8

extern "C" def header_size() -> uint64
extern "C" def header_alignment() -> uint64
extern "C" def serial_offset() -> uint64
extern "C" def update_header(h: mut Header) -> uint8

extern "C" packed class Small:
    tag: uint8
    serial: uint32

extern "C" align(32) class Line:
    value: uint32

extern "C" def make_small(s: Small, delta: uint32) -> Small
extern "C" def aligned_line(line: mut Line) -> uint8

extern "C" class Packet:
    rows: fixed[Small, 2]
    lines: fixed[Line, 2]

extern "C" def check_packet(p: mut Packet) -> uint8

def main() -> int32:
    print(mem.size_of(Header) == header_size())
    print(mem.align_of(Header) == header_alignment())
    print(mem.offset_of(Header, serial) == serial_offset())
    mut h = Header(kind=7, serial=123456, count=3, mode=6)
    print(update_header(h) == 1)
    print(h.count)
    print(h.mode)
    mut w = Word.from_whole(305419896)
    w.low = 10
    print(w.whole == 305419786)
    small = make_small(Small(tag=2, serial=127), 4096)
    print(small.tag == 3 and small.serial == 4223)
    mut line = Line(value=17)
    print(aligned_line(line) == 1)
    mut p = Packet(rows=[Small(tag=1, serial=9), Small(tag=2, serial=7)], lines=[Line(value=17), Line(value=19)])
    print(check_packet(p) == 1)
    print(p.rows[1].serial)
    print(p.lines[1].value)
    return 0
