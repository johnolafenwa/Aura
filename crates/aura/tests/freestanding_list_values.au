class Point:
    x: int64
    y: int64

enum Chain:
    End
    Link(int64, indirect Chain)

class Entry:
    name: str
    count: int64

class Shelf:
    labels: list[str]
    size: int64

def depth(chain: Chain) -> int64:
    match chain:
        case Chain.End:
            return 0
        case Chain.Link(_, rest):
            return 1 + depth(rest)

def build(n: int64) -> Chain:
    mut chain = Chain.End
    for i in range(0, n):
        chain = Chain.Link(i, chain)
    return chain

def longest(names: list[str]) -> int64:
    mut best = 0
    for name in names:
        if name.len() > best:
            best = name.len()
    return best

def labels(n: int64) -> list[str]:
    mut out: list[str] = []
    for i in range(0, n):
        out.append(f"item {i}")
    return out

def add(names: mut list[str], text: str) -> None:
    names.append(text + "!")

def rows(n: int64) -> list[list[int64]]:
    mut out: list[list[int64]] = []
    for i in range(0, n):
        mut row: list[int64] = []
        for j in range(0, i):
            row.append(j)
        out.append(row)
    return out

def work(n: int64) -> int64:
    mut names: list[str] = ["ab", "c"]
    names.append("defg" + "h")
    names[1] = "longer text"
    add(names, "tail")
    view first = names[0]
    mut sum = longest(names) + first.len() + names.len()
    if names[1] == "longer text":
        sum = sum + 100
    mut points: list[Point] = []
    for i in range(0, n):
        points.append(Point(x=i, y=i * 2))
    points[0] = Point(x=7, y=9)
    for p in points:
        sum = sum + p.x + p.y
    sum = sum + points[1].y
    mut chains: list[Chain] = [build(2), Chain.End]
    chains.append(build(n))
    chains[1] = build(3)
    for chain in chains:
        sum = sum + depth(chain) * 1000
    view kept = chains[2]
    sum = sum + depth(kept)
    entries = [Entry(name="one", count=1), Entry(name="three", count=3)]
    for entry in entries:
        sum = sum + entry.name.len() * entry.count
    made = labels(n)
    sum = sum + made[n - 1].len() + made.len()
    shelf = Shelf(labels=labels(3), size=3)
    sum = sum + longest(shelf.labels) + shelf.size
    table = rows(n)
    for row in table:
        sum = sum + row.len()
    sum = sum + table[n - 1][n - 2]
    return sum

export "C" def entry(n: int64) -> int64:
    return work(n)

def main() -> None:
    print(entry(40))
