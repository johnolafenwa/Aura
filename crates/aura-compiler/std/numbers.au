# The builtin `numbers` module: integers of any size, exact decimal
# numbers, and complex numbers (ADR-0113). The compiler checks this file as
# module `numbers` and merges its public items with the host functions that
# `builtin_modules.rs` declares.
#
# A `BigInt` or the coefficient of a `Decimal` that fits `int64` lives in
# the `small` field with an empty `digits` list, and this file computes on
# it directly. Any other value keeps its magnitude in `digits`, in the wire
# form `numbers_host.rs` describes, and the runtime does the arithmetic.
import math
import numbers


public trait Sub[Rhs, Out]:
    """Subtraction of `Rhs`, producing `Out`. `-` calls `sub` when no builtin
    subtraction applies."""
    def sub(self, rhs: Rhs) -> Out


public trait Mul[Rhs, Out]:
    """Multiplication by `Rhs`, producing `Out`. `*` calls `mul` when no
    builtin multiplication applies."""
    def mul(self, rhs: Rhs) -> Out


public trait Div[Rhs, Out]:
    """Division by `Rhs`, producing `Out`. `/` calls `div` when no builtin
    division applies."""
    def div(self, rhs: Rhs) -> Out


public trait FloorDiv[Rhs, Out]:
    """Floor division by `Rhs`, producing `Out`. `//` calls `floor_div` when
    no builtin division applies."""
    def floor_div(self, rhs: Rhs) -> Out


public trait Mod[Rhs, Out]:
    """The remainder of floor division by `Rhs`, producing `Out`. `%` calls
    `mod` when no builtin remainder applies."""
    def mod(self, rhs: Rhs) -> Out


public trait Neg[Out]:
    """Negation, producing `Out`. Unary `-` calls `neg` when no builtin
    negation applies."""
    def neg(self) -> Out


# The least `int64`, which has no positive counterpart.
def least_int() -> int64:
    return -9223372036854775807 - 1


# The `int64` a wire list holds when its first word is 0.
def wire_small(wire: list[uint64]) -> int64:
    magnitude = wire[4]
    if wire[1] == 0:
        return magnitude as int64
    if magnitude == 9223372036854775808:
        return least_int()
    return -(magnitude as int64)


# The decimal exponent a wire list holds.
def wire_exponent(wire: list[uint64]) -> int64:
    if wire[2] == 0:
        return wire[3] as int64
    return -(wire[3] as int64)


def big_of(wire: own list[uint64]) -> BigInt:
    if wire[0] == 0:
        return BigInt(small=wire_small(wire), digits=list[uint64]())
    return BigInt(small=0, digits=wire)


public class BigInt:
    """An integer of any size. Arithmetic never overflows: a result grows
    to the size it needs."""
    small: int64
    digits: list[uint64]

    public def from_int(value: int64) -> BigInt:
        """The `BigInt` equal to `value`."""
        return BigInt(small=value, digits=list[uint64]())

    public def from_float(value: float64) -> BigInt | None:
        """`value` with its fraction dropped, or `None` for NaN or an
        infinity."""
        wire = numbers.__aura_big_from_float(value)
        if wire.len() == 0:
            return None
        return big_of(wire)

    public def parse(text: str) -> BigInt | None:
        """The integer `text` writes in decimal, with an optional sign, or
        `None` when `text` is anything else."""
        return BigInt.parse_radix(text, 10)

    public def parse_radix(text: str, radix: int64) -> BigInt | None:
        """The integer `text` writes in base `radix`, from 2 to 36, with an
        optional sign and no prefix. Letters stand for the digits from ten,
        in either case."""
        wire = numbers.__aura_big_parse(text, radix)
        if wire.len() == 0:
            return None
        return big_of(wire)

    def binary(self, op: int64, rhs: BigInt) -> BigInt:
        return big_of(numbers.__aura_big_binary(op, self.small, self.digits, rhs.small, rhs.digits))

    def binary_int(self, op: int64, rhs: int64) -> BigInt:
        return big_of(numbers.__aura_big_binary(op, self.small, self.digits, rhs, list[uint64]()))

    def is_small(self) -> bool:
        return self.digits.len() == 0

    public def is_zero(self) -> bool:
        """Whether this is 0."""
        return self.small == 0 and self.digits.len() == 0

    public def sign(self) -> int64:
        """-1, 0, or 1 as this is negative, zero, or positive."""
        if self.digits.len() == 0:
            if self.small > 0:
                return 1
            if self.small < 0:
                return -1
            return 0
        if self.digits[1] == 1:
            return -1
        return 1

    public def copy(self) -> BigInt:
        """Another `BigInt` with the same value."""
        return BigInt(small=self.small, digits=self.digits.copy())

    public def abs(self) -> BigInt:
        """The absolute value."""
        if self.sign() < 0:
            return self.neg()
        return self.copy()

    public def compare(self, rhs: BigInt) -> int64:
        """-1, 0, or 1 as this is less than, equal to, or greater than
        `rhs`."""
        if self.digits.len() == 0 and rhs.digits.len() == 0:
            if self.small < rhs.small:
                return -1
            if self.small > rhs.small:
                return 1
            return 0
        return numbers.__aura_big_compare(self.small, self.digits, rhs.small, rhs.digits)

    public def pow(self, exponent: int64) -> BigInt:
        """This raised to `exponent`, which must not be negative."""
        return self.binary_int(6, exponent)

    public def pow_mod(self, exponent: BigInt, modulus: BigInt) -> BigInt:
        """This raised to `exponent`, modulo `modulus`, without building the
        full power. The result has the sign of `modulus`."""
        return big_of(numbers.__aura_big_pow_mod(self.small, self.digits, exponent.small, exponent.digits, modulus.small, modulus.digits))

    public def gcd(self, rhs: BigInt) -> BigInt:
        """The greatest common divisor, never negative."""
        return self.binary(5, rhs)

    public def lcm(self, rhs: BigInt) -> BigInt:
        """The least common multiple, never negative."""
        return self.binary(12, rhs)

    public def divmod(self, rhs: BigInt) -> (BigInt, BigInt):
        """The floor quotient and its remainder, as `//` and `%` give
        them."""
        return (self.binary(3, rhs), self.binary(4, rhs))

    public def sqrt(self) -> BigInt:
        """The greatest integer whose square is at most this. This must not
        be negative."""
        return big_of(numbers.__aura_big_unary(0, self.small, self.digits))

    public def bit_length(self) -> int64:
        """The bits the magnitude needs. Zero needs none."""
        return numbers.__aura_big_bits(self.small, self.digits)

    public def shift_left(self, count: int64) -> BigInt:
        """This times two to the power `count`."""
        return self.binary_int(7, count)

    public def shift_right(self, count: int64) -> BigInt:
        """This divided by two to the power `count`, rounded toward negative
        infinity."""
        return self.binary_int(8, count)

    public def bit_and(self, rhs: BigInt) -> BigInt:
        """The bitwise AND, with a negative value read in two's
        complement."""
        return self.binary(9, rhs)

    public def bit_or(self, rhs: BigInt) -> BigInt:
        """The bitwise OR, with a negative value read in two's complement."""
        return self.binary(10, rhs)

    public def bit_xor(self, rhs: BigInt) -> BigInt:
        """The bitwise XOR, with a negative value read in two's
        complement."""
        return self.binary(11, rhs)

    public def is_even(self) -> bool:
        """Whether two divides this."""
        if self.digits.len() == 0:
            return self.small % 2 == 0
        return self.digits[4] % 2 == 0

    public def to_int(self) -> int64 | None:
        """This as an `int64`, or `None` when it does not fit."""
        if self.digits.len() == 0:
            return self.small
        return None

    public def to_float(self) -> float64:
        """The nearest `float64`. A value beyond the range of `float64` gives
        an infinity."""
        if self.digits.len() == 0:
            return self.small.to_float()
        return numbers.__aura_big_to_float(self.small, self.digits)

    public def to_radix(self, radix: int64) -> str:
        """The text of this in base `radix`, from 2 to 36, with lowercase
        letters and a leading `-` when negative."""
        return numbers.__aura_big_format(self.small, self.digits, radix)


impl Display for BigInt:
    def display(self) -> str:
        if self.digits.len() == 0:
            return str(self.small)
        return numbers.__aura_big_format(self.small, self.digits, 10)


public trait IntegerOperand:
    """What can stand on the right of a `BigInt` operator or comparison: a
    `BigInt` or an `int64`. Each method computes with `left` on the left and
    this value on the right."""
    def big_added_to(self, left: BigInt) -> BigInt
    def big_subtracted_from(self, left: BigInt) -> BigInt
    def big_multiplied_by(self, left: BigInt) -> BigInt
    def big_dividing(self, left: BigInt) -> BigInt
    def big_remainder_of(self, left: BigInt) -> BigInt
    def big_ordering_of(self, left: BigInt) -> int64


impl IntegerOperand for BigInt:
    def big_added_to(self, left: BigInt) -> BigInt:
        if left.digits.len() == 0 and self.digits.len() == 0:
            sum = left.small.wrapping_add(self.small)
            if sum == left.small.saturating_add(self.small):
                return BigInt(small=sum, digits=list[uint64]())
        return left.binary(0, self)

    def big_subtracted_from(self, left: BigInt) -> BigInt:
        if left.digits.len() == 0 and self.digits.len() == 0:
            difference = left.small.wrapping_sub(self.small)
            if difference == left.small.saturating_sub(self.small):
                return BigInt(small=difference, digits=list[uint64]())
        return left.binary(1, self)

    def big_multiplied_by(self, left: BigInt) -> BigInt:
        if left.digits.len() == 0 and self.digits.len() == 0:
            product = left.small.wrapping_mul(self.small)
            if product == left.small.saturating_mul(self.small):
                return BigInt(small=product, digits=list[uint64]())
        return left.binary(2, self)

    def big_dividing(self, left: BigInt) -> BigInt:
        if left.digits.len() == 0 and self.digits.len() == 0 and self.small > 0:
            return BigInt(small=left.small // self.small, digits=list[uint64]())
        return left.binary(3, self)

    def big_remainder_of(self, left: BigInt) -> BigInt:
        if left.digits.len() == 0 and self.digits.len() == 0 and self.small > 0:
            return BigInt(small=left.small % self.small, digits=list[uint64]())
        return left.binary(4, self)

    def big_ordering_of(self, left: BigInt) -> int64:
        return left.compare(self)


impl IntegerOperand for int64:
    def big_added_to(self, left: BigInt) -> BigInt:
        if left.digits.len() == 0:
            sum = left.small.wrapping_add(self)
            if sum == left.small.saturating_add(self):
                return BigInt(small=sum, digits=list[uint64]())
        return left.binary_int(0, self)

    def big_subtracted_from(self, left: BigInt) -> BigInt:
        if left.digits.len() == 0:
            difference = left.small.wrapping_sub(self)
            if difference == left.small.saturating_sub(self):
                return BigInt(small=difference, digits=list[uint64]())
        return left.binary_int(1, self)

    def big_multiplied_by(self, left: BigInt) -> BigInt:
        if left.digits.len() == 0:
            product = left.small.wrapping_mul(self)
            if product == left.small.saturating_mul(self):
                return BigInt(small=product, digits=list[uint64]())
        return left.binary_int(2, self)

    def big_dividing(self, left: BigInt) -> BigInt:
        if left.digits.len() == 0 and self > 0:
            return BigInt(small=left.small // self, digits=list[uint64]())
        return left.binary_int(3, self)

    def big_remainder_of(self, left: BigInt) -> BigInt:
        if left.digits.len() == 0 and self > 0:
            return BigInt(small=left.small % self, digits=list[uint64]())
        return left.binary_int(4, self)

    def big_ordering_of(self, left: BigInt) -> int64:
        if left.digits.len() == 0:
            if left.small < self:
                return -1
            if left.small > self:
                return 1
            return 0
        return left.sign()


impl[R: IntegerOperand] Add[R, BigInt] for BigInt:
    def add(self, rhs: R) -> BigInt:
        return rhs.big_added_to(self)


impl[R: IntegerOperand] Sub[R, BigInt] for BigInt:
    def sub(self, rhs: R) -> BigInt:
        return rhs.big_subtracted_from(self)


impl[R: IntegerOperand] Mul[R, BigInt] for BigInt:
    def mul(self, rhs: R) -> BigInt:
        return rhs.big_multiplied_by(self)


impl[R: IntegerOperand] FloorDiv[R, BigInt] for BigInt:
    def floor_div(self, rhs: R) -> BigInt:
        return rhs.big_dividing(self)


impl[R: IntegerOperand] Mod[R, BigInt] for BigInt:
    def mod(self, rhs: R) -> BigInt:
        return rhs.big_remainder_of(self)


impl Neg[BigInt] for BigInt:
    def neg(self) -> BigInt:
        if self.digits.len() == 0 and self.small != least_int():
            return BigInt(small=-self.small, digits=list[uint64]())
        return BigInt.from_int(0).binary(1, self)


impl[R: IntegerOperand] Ord[R] for BigInt:
    def lt(self, rhs: R) -> bool:
        return rhs.big_ordering_of(self) < 0

    def le(self, rhs: R) -> bool:
        return rhs.big_ordering_of(self) <= 0

    def gt(self, rhs: R) -> bool:
        return rhs.big_ordering_of(self) > 0

    def ge(self, rhs: R) -> bool:
        return rhs.big_ordering_of(self) >= 0


impl Add[BigInt, BigInt] for int64:
    def add(self, rhs: BigInt) -> BigInt:
        return self.big_added_to(rhs)


impl Sub[BigInt, BigInt] for int64:
    def sub(self, rhs: BigInt) -> BigInt:
        return BigInt.from_int(self).binary(1, rhs)


impl Mul[BigInt, BigInt] for int64:
    def mul(self, rhs: BigInt) -> BigInt:
        return self.big_multiplied_by(rhs)


public def factorial(value: int64) -> BigInt:
    """`value!` as a `BigInt`. `value` must not be negative."""
    return big_of(numbers.__aura_big_unary(1, value, list[uint64]()))


public enum Rounding:
    """How a `Decimal` operation picks between the two nearest results."""
    HalfEven
    HalfUp
    HalfDown
    Down
    Up
    Floor
    Ceiling


def rounding_code(rounding: Rounding) -> int64:
    match rounding:
        case Rounding.HalfEven:
            return 0
        case Rounding.HalfUp:
            return 1
        case Rounding.HalfDown:
            return 2
        case Rounding.Down:
            return 3
        case Rounding.Up:
            return 4
        case Rounding.Floor:
            return 5
        case Rounding.Ceiling:
            return 6


def decimal_of(wire: own list[uint64]) -> Decimal:
    exponent = wire_exponent(wire)
    if wire[0] == 0:
        return Decimal(small=wire_small(wire), digits=list[uint64](), power=exponent)
    return Decimal(small=0, digits=wire, power=exponent)


# The decimal `coefficient * 10^exponent` in normal form: no trailing zeros
# in the coefficient, and exponent 0 for zero.
def small_decimal(coefficient: int64, exponent: int64) -> Decimal:
    if coefficient == 0:
        return Decimal(small=0, digits=list[uint64](), power=0)
    mut value = coefficient
    mut power = exponent
    while value % 10 == 0:
        value = value // 10
        power += 1
    if power > 4611686018427387904 or power < -4611686018427387904:
        # The runtime reports the overflow.
        return decimal_of(numbers.__aura_dec_normalize(value, list[uint64](), power))
    return Decimal(small=value, digits=list[uint64](), power=power)


# `value * 10^count`, or the least `int64`, which no such product equals,
# when the product does not fit.
def scaled(value: int64, count: int64) -> int64:
    mut result = value
    mut left = count
    while left > 0:
        next = result.wrapping_mul(10)
        if next != result.saturating_mul(10):
            return least_int()
        result = next
        left -= 1
    return result


# `left` plus the decimal `small * 10^exponent`.
def decimal_sum(left: Decimal, small: int64, exponent: int64) -> Decimal:
    if left.digits.len() == 0:
        gap = left.power.saturating_sub(exponent)
        mut first = left.small
        mut second = small
        mut power = exponent
        if gap > 0 and gap <= 18:
            first = scaled(first, gap)
        elif gap < 0 and gap >= -18:
            second = scaled(second, -gap)
            power = left.power
        elif gap != 0:
            first = least_int()
        if first != least_int() and second != least_int():
            sum = first.wrapping_add(second)
            if sum == first.saturating_add(second):
                return small_decimal(sum, power)
    return decimal_of(numbers.__aura_dec_binary(0, left.small, left.digits, left.power, small, list[uint64](), exponent, 0, 0))


# `left` times the decimal `small * 10^exponent`.
def decimal_product(left: Decimal, small: int64, exponent: int64) -> Decimal:
    if left.digits.len() == 0:
        product = left.small.wrapping_mul(small)
        if product == left.small.saturating_mul(small):
            return small_decimal(product, left.power + exponent)
    return decimal_of(numbers.__aura_dec_binary(2, left.small, left.digits, left.power, small, list[uint64](), exponent, 0, 0))


# `left` divided by the decimal `small * 10^exponent`, to 28 digits.
def decimal_quotient(left: Decimal, small: int64, exponent: int64) -> Decimal:
    if left.digits.len() == 0 and small > 0 and left.small % small == 0:
        return small_decimal(left.small // small, left.power.saturating_sub(exponent))
    return decimal_of(numbers.__aura_dec_binary(3, left.small, left.digits, left.power, small, list[uint64](), exponent, 28, 0))


public class Decimal:
    """An exact decimal number: an integer coefficient of any size times a
    power of ten. Addition, subtraction, and multiplication are exact.
    Division rounds to 28 significant digits. Equal numbers are equal
    values: `1.50` and `1.5` are the same `Decimal`."""
    small: int64
    digits: list[uint64]
    power: int64

    public def from_int(value: int64) -> Decimal:
        """The `Decimal` equal to `value`."""
        return small_decimal(value, 0)

    public def from_big(value: BigInt) -> Decimal:
        """The `Decimal` equal to `value`."""
        return Decimal.from_parts(value, 0)

    public def from_parts(coefficient: BigInt, exponent: int64) -> Decimal:
        """`coefficient` times ten to the power `exponent`."""
        if coefficient.digits.len() == 0:
            return small_decimal(coefficient.small, exponent)
        return decimal_of(numbers.__aura_dec_normalize(coefficient.small, coefficient.digits, exponent))

    public def from_float(value: float64) -> Decimal | None:
        """The exact value of `value`, every binary digit kept, or `None`
        for NaN or an infinity. `from_float(0.1)` is not `0.1`."""
        wire = numbers.__aura_dec_from_float(value)
        if wire.len() == 0:
            return None
        return decimal_of(wire)

    public def parse(text: str) -> Decimal | None:
        """The number `text` writes: an optional sign, digits with an
        optional point, and an optional exponent such as `e-3`. `None` when
        `text` is anything else."""
        wire = numbers.__aura_dec_parse(text)
        if wire.len() == 0:
            return None
        return decimal_of(wire)

    public def is_zero(self) -> bool:
        """Whether this is 0."""
        return self.small == 0 and self.digits.len() == 0

    public def sign(self) -> int64:
        """-1, 0, or 1 as this is negative, zero, or positive."""
        if self.digits.len() == 0:
            if self.small > 0:
                return 1
            if self.small < 0:
                return -1
            return 0
        if self.digits[1] == 1:
            return -1
        return 1

    public def copy(self) -> Decimal:
        """Another `Decimal` with the same value."""
        return Decimal(small=self.small, digits=self.digits.copy(), power=self.power)

    public def abs(self) -> Decimal:
        """The absolute value."""
        if self.sign() < 0:
            return self.neg()
        return self.copy()

    public def coefficient(self) -> BigInt:
        """The integer coefficient. It has no trailing zeros."""
        if self.digits.len() == 0:
            return BigInt.from_int(self.small)
        return big_of(numbers.__aura_big_binary(0, self.small, self.digits, 0, list[uint64]()))

    public def exponent(self) -> int64:
        """The power of ten that scales the coefficient."""
        return self.power

    public def compare(self, rhs: Decimal) -> int64:
        """-1, 0, or 1 as this is less than, equal to, or greater than
        `rhs`."""
        if self.digits.len() == 0 and rhs.digits.len() == 0 and self.power == rhs.power:
            if self.small < rhs.small:
                return -1
            if self.small > rhs.small:
                return 1
            return 0
        return numbers.__aura_dec_compare(self.small, self.digits, self.power, rhs.small, rhs.digits, rhs.power)

    public def divide(self, rhs: Decimal, digits: int64, rounding: Rounding) -> Decimal:
        """This divided by `rhs`, rounded to `digits` significant digits."""
        return decimal_of(numbers.__aura_dec_binary(3, self.small, self.digits, self.power, rhs.small, rhs.digits, rhs.power, digits, rounding_code(rounding)))

    public def round(self, places: int64, rounding: Rounding) -> Decimal:
        """This rounded to `places` digits after the point. A negative
        `places` rounds to tens, hundreds, and so on."""
        if self.power >= -places and places > -4611686018427387904:
            return self.copy()
        return decimal_of(numbers.__aura_dec_round(self.small, self.digits, self.power, places, rounding_code(rounding)))

    public def to_big(self, rounding: Rounding) -> BigInt:
        """This rounded to an integer."""
        return big_of(numbers.__aura_dec_integer(self.small, self.digits, self.power, rounding_code(rounding)))

    public def trunc(self) -> BigInt:
        """The integer left after dropping the fraction."""
        return self.to_big(Rounding.Down)

    public def floor(self) -> BigInt:
        """The greatest integer that is not greater than this."""
        return self.to_big(Rounding.Floor)

    public def ceil(self) -> BigInt:
        """The least integer that is not less than this."""
        return self.to_big(Rounding.Ceiling)

    public def pow(self, exponent: int64) -> Decimal:
        """This raised to `exponent`, exactly. `exponent` must not be
        negative."""
        return decimal_of(numbers.__aura_dec_binary(4, self.small, self.digits, self.power, exponent, list[uint64](), 0, 0, 0))

    public def sqrt(self, digits: int64) -> Decimal:
        """The square root to `digits` significant digits, rounded half to
        even. This must not be negative."""
        return decimal_of(numbers.__aura_dec_sqrt(self.small, self.digits, self.power, digits))

    public def to_float(self) -> float64:
        """The nearest `float64`. A value beyond the range of `float64`
        gives an infinity."""
        return numbers.__aura_dec_to_float(self.small, self.digits, self.power)

    public def to_fixed(self, places: int64) -> str:
        """The text of this with exactly `places` digits after the point,
        rounded half to even. `places` must not be negative."""
        if places < 0:
            # The runtime reports the bad argument.
            return numbers.__aura_dec_format(self.small, self.digits, self.power, -3)
        return numbers.__aura_dec_format(self.small, self.digits, self.power, places)

    public def to_plain(self) -> str:
        """The text of this with every digit written out and no exponent."""
        return numbers.__aura_dec_format(self.small, self.digits, self.power, -2)


impl Display for Decimal:
    def display(self) -> str:
        if self.digits.len() == 0 and self.power == 0:
            return str(self.small)
        return numbers.__aura_dec_format(self.small, self.digits, self.power, -1)


public trait DecimalOperand:
    """What can stand on the right of a `Decimal` operator or comparison: a
    `Decimal` or an `int64`. Each method computes with `left` on the left
    and this value on the right."""
    def decimal_added_to(self, left: Decimal) -> Decimal
    def decimal_subtracted_from(self, left: Decimal) -> Decimal
    def decimal_multiplied_by(self, left: Decimal) -> Decimal
    def decimal_dividing(self, left: Decimal) -> Decimal
    def decimal_ordering_of(self, left: Decimal) -> int64


impl DecimalOperand for Decimal:
    def decimal_added_to(self, left: Decimal) -> Decimal:
        if self.digits.len() == 0:
            return decimal_sum(left, self.small, self.power)
        return decimal_of(numbers.__aura_dec_binary(0, left.small, left.digits, left.power, self.small, self.digits, self.power, 0, 0))

    def decimal_subtracted_from(self, left: Decimal) -> Decimal:
        if self.digits.len() == 0 and self.small != least_int():
            return decimal_sum(left, -self.small, self.power)
        return decimal_of(numbers.__aura_dec_binary(1, left.small, left.digits, left.power, self.small, self.digits, self.power, 0, 0))

    def decimal_multiplied_by(self, left: Decimal) -> Decimal:
        if self.digits.len() == 0:
            return decimal_product(left, self.small, self.power)
        return decimal_of(numbers.__aura_dec_binary(2, left.small, left.digits, left.power, self.small, self.digits, self.power, 0, 0))

    def decimal_dividing(self, left: Decimal) -> Decimal:
        if self.digits.len() == 0:
            return decimal_quotient(left, self.small, self.power)
        return decimal_of(numbers.__aura_dec_binary(3, left.small, left.digits, left.power, self.small, self.digits, self.power, 28, 0))

    def decimal_ordering_of(self, left: Decimal) -> int64:
        return left.compare(self)


impl DecimalOperand for int64:
    def decimal_added_to(self, left: Decimal) -> Decimal:
        return decimal_sum(left, self, 0)

    def decimal_subtracted_from(self, left: Decimal) -> Decimal:
        if self != least_int():
            return decimal_sum(left, -self, 0)
        return decimal_of(numbers.__aura_dec_binary(1, left.small, left.digits, left.power, self, list[uint64](), 0, 0, 0))

    def decimal_multiplied_by(self, left: Decimal) -> Decimal:
        return decimal_product(left, self, 0)

    def decimal_dividing(self, left: Decimal) -> Decimal:
        return decimal_quotient(left, self, 0)

    def decimal_ordering_of(self, left: Decimal) -> int64:
        if left.digits.len() == 0 and left.power == 0:
            if left.small < self:
                return -1
            if left.small > self:
                return 1
            return 0
        return numbers.__aura_dec_compare(left.small, left.digits, left.power, self, list[uint64](), 0)


impl[R: DecimalOperand] Add[R, Decimal] for Decimal:
    def add(self, rhs: R) -> Decimal:
        return rhs.decimal_added_to(self)


impl[R: DecimalOperand] Sub[R, Decimal] for Decimal:
    def sub(self, rhs: R) -> Decimal:
        return rhs.decimal_subtracted_from(self)


impl[R: DecimalOperand] Mul[R, Decimal] for Decimal:
    def mul(self, rhs: R) -> Decimal:
        return rhs.decimal_multiplied_by(self)


impl[R: DecimalOperand] Div[R, Decimal] for Decimal:
    def div(self, rhs: R) -> Decimal:
        return rhs.decimal_dividing(self)


impl Neg[Decimal] for Decimal:
    def neg(self) -> Decimal:
        if self.digits.len() == 0 and self.small != least_int():
            return Decimal(small=-self.small, digits=list[uint64](), power=self.power)
        return decimal_of(numbers.__aura_dec_binary(1, 0, list[uint64](), 0, self.small, self.digits, self.power, 0, 0))


impl[R: DecimalOperand] Ord[R] for Decimal:
    def lt(self, rhs: R) -> bool:
        return rhs.decimal_ordering_of(self) < 0

    def le(self, rhs: R) -> bool:
        return rhs.decimal_ordering_of(self) <= 0

    def gt(self, rhs: R) -> bool:
        return rhs.decimal_ordering_of(self) > 0

    def ge(self, rhs: R) -> bool:
        return rhs.decimal_ordering_of(self) >= 0


public copy class Complex:
    """A complex number of two `float64` parts."""
    public re: float64
    public im: float64

    public def from_polar(radius: float64, angle: float64) -> Complex:
        """The number `radius` from the origin at `angle` radians."""
        return Complex(re=radius * math.cos(angle), im=radius * math.sin(angle))

    public def abs(self) -> float64:
        """The distance from the origin."""
        return math.hypot(self.re, self.im)

    public def arg(self) -> float64:
        """The angle from the positive real axis, in `[-pi, pi]`."""
        return math.atan2(self.im, self.re)

    public def conj(self) -> Complex:
        """The conjugate: the imaginary part negated."""
        return Complex(re=self.re, im=-self.im)

    public def exp(self) -> Complex:
        """e raised to this."""
        size = math.exp(self.re)
        return Complex(re=size * math.cos(self.im), im=size * math.sin(self.im))

    public def log(self) -> Complex:
        """The principal natural logarithm. Its imaginary part lies in
        `[-pi, pi]`. Zero has none."""
        return Complex(re=math.log(self.abs()), im=self.arg())

    public def sqrt(self) -> Complex:
        """The principal square root, the one whose real part is not
        negative."""
        if self.re == 0.0 and self.im == 0.0:
            return Complex(re=0.0, im=self.im)
        half = math.sqrt((self.abs() + abs(self.re)) / 2.0)
        if self.re >= 0.0:
            return Complex(re=half, im=self.im / (2.0 * half))
        return Complex(re=abs(self.im) / (2.0 * half), im=math.copysign(half, self.im))

    public def pow(self, exponent: Complex) -> Complex:
        """This raised to `exponent`, by the principal logarithm. Zero to
        the power zero is one, and zero to any other power is zero."""
        if self.re == 0.0 and self.im == 0.0:
            if exponent.re == 0.0 and exponent.im == 0.0:
                return Complex(re=1.0, im=0.0)
            return Complex(re=0.0, im=0.0)
        return exponent.complex_multiplied_by(self.log()).exp()

    public def is_finite(self) -> bool:
        """Whether neither part is NaN or an infinity."""
        return math.is_finite(self.re) and math.is_finite(self.im)


impl Display for Complex:
    def display(self) -> str:
        if self.im < 0.0 or (self.im == 0.0 and math.copysign(1.0, self.im) < 0.0):
            return str(self.re) + "-" + str(-self.im) + "i"
        return str(self.re) + "+" + str(self.im) + "i"


public trait ComplexOperand:
    """What can stand on the right of a `Complex` operator: a `Complex` or
    a `float64`. Each method computes with `left` on the left and this
    value on the right."""
    def complex_added_to(self, left: Complex) -> Complex
    def complex_subtracted_from(self, left: Complex) -> Complex
    def complex_multiplied_by(self, left: Complex) -> Complex
    def complex_dividing(self, left: Complex) -> Complex


impl ComplexOperand for Complex:
    def complex_added_to(self, left: Complex) -> Complex:
        return Complex(re=left.re + self.re, im=left.im + self.im)

    def complex_subtracted_from(self, left: Complex) -> Complex:
        return Complex(re=left.re - self.re, im=left.im - self.im)

    def complex_multiplied_by(self, left: Complex) -> Complex:
        return Complex(re=left.re * self.re - left.im * self.im, im=left.re * self.im + left.im * self.re)

    def complex_dividing(self, left: Complex) -> Complex:
        # Smith's method keeps the intermediate values in range.
        if abs(self.re) >= abs(self.im):
            ratio = self.im / self.re
            scale = self.re + self.im * ratio
            return Complex(re=(left.re + left.im * ratio) / scale, im=(left.im - left.re * ratio) / scale)
        ratio = self.re / self.im
        scale = self.re * ratio + self.im
        return Complex(re=(left.re * ratio + left.im) / scale, im=(left.im * ratio - left.re) / scale)


impl ComplexOperand for float64:
    def complex_added_to(self, left: Complex) -> Complex:
        return Complex(re=left.re + self, im=left.im)

    def complex_subtracted_from(self, left: Complex) -> Complex:
        return Complex(re=left.re - self, im=left.im)

    def complex_multiplied_by(self, left: Complex) -> Complex:
        return Complex(re=left.re * self, im=left.im * self)

    def complex_dividing(self, left: Complex) -> Complex:
        return Complex(re=left.re / self, im=left.im / self)


impl[R: ComplexOperand] Add[R, Complex] for Complex:
    def add(self, rhs: R) -> Complex:
        return rhs.complex_added_to(self)


impl[R: ComplexOperand] Sub[R, Complex] for Complex:
    def sub(self, rhs: R) -> Complex:
        return rhs.complex_subtracted_from(self)


impl[R: ComplexOperand] Mul[R, Complex] for Complex:
    def mul(self, rhs: R) -> Complex:
        return rhs.complex_multiplied_by(self)


impl[R: ComplexOperand] Div[R, Complex] for Complex:
    def div(self, rhs: R) -> Complex:
        return rhs.complex_dividing(self)


impl Neg[Complex] for Complex:
    def neg(self) -> Complex:
        return Complex(re=-self.re, im=-self.im)
