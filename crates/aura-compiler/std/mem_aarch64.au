public def read_midr_el1() -> uint64:
    mut value: uint64 = 0
    asm("mrs $0, midr_el1", output("reg", value), options("preserves_flags"))
    return value

public def read_mpidr_el1() -> uint64:
    mut value: uint64 = 0
    asm("mrs $0, mpidr_el1", output("reg", value), options("preserves_flags"))
    return value

