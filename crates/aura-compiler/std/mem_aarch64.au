public def enable_interrupts() -> None:
    asm("msr DAIFClr, #2", options("preserves_flags"))

public def disable_interrupts() -> None:
    asm("msr DAIFSet, #2", options("preserves_flags"))

public def halt() -> None:
    asm("wfi", options("preserves_flags"))
