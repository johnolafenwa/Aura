# The text of a freestanding program.
#
# A `str` value is the address of a block from the allocation hooks: a
# reference count in its first 8 bytes, the length in bytes in the next 8,
# then the bytes, and a zero byte after them for C. The functions here
# take text as the address of its first byte and its length in bytes, so a
# literal in the program's data needs no block. `aura build
# --freestanding` adds them to a program that uses `str`.

import mem


# A new block that holds a copy of the `length` bytes at `source`, with
# one reference.
def value_text_new(source: uint64, length: uint64) -> uint64:
    return value_text_concat(source, length, 0, 0)


# The address of the first byte of the text in the block at `address`.
def value_text_bytes(address: uint64) -> uint64:
    return address + 16


# The length in bytes of the text in the block at `address`.
def value_text_byte_length(address: uint64) -> uint64:
    return mem.read_uint64(address + 8)


# One reference fewer to the block at `address`, which is freed with its
# last one. Address 0 is no block.
def value_text_release(address: uint64) -> None:
    if address == 0:
        return
    count = mem.read_uint64(address)
    if count > 1:
        mem.write_uint64(address, count - 1)
        return
    mem.free(address, 17 + mem.read_uint64(address + 8), 8)


# A new block that holds the left text and then the right.
def value_text_concat(left: uint64, left_length: uint64, right: uint64, right_length: uint64) -> uint64:
    length = left_length + right_length
    address = mem.alloc(17 + length, 8)
    assert address != 0, "out of memory"
    mem.write_uint64(address, 1)
    mem.write_uint64(address + 8, length)
    mut at: uint64 = 0
    while at < left_length:
        mem.write_uint8(address + 16 + at, mem.read_uint8(left + at))
        at = at + 1
    at = 0
    while at < right_length:
        mem.write_uint8(address + 16 + left_length + at, mem.read_uint8(right + at))
        at = at + 1
    mem.write_uint8(address + 16 + length, 0)
    return address


# Whether the two texts hold the same bytes.
def value_text_equal(left: uint64, left_length: uint64, right: uint64, right_length: uint64) -> bool:
    if left_length != right_length:
        return false
    mut at: uint64 = 0
    while at < left_length:
        if mem.read_uint8(left + at) != mem.read_uint8(right + at):
            return false
        at = at + 1
    return true


# The order of the two texts by their bytes: -1 when the left comes
# first, 0 when they are equal, and 1 when the right comes first.
def value_text_compare(left: uint64, left_length: uint64, right: uint64, right_length: uint64) -> int64:
    mut at: uint64 = 0
    while at < left_length and at < right_length:
        a = mem.read_uint8(left + at)
        b = mem.read_uint8(right + at)
        if a < b:
            return -1
        if a > b:
            return 1
        at = at + 1
    if left_length < right_length:
        return -1
    if left_length > right_length:
        return 1
    return 0


# The number of characters: every byte that does not continue one.
def value_text_length(source: uint64, length: uint64) -> int64:
    mut count = 0
    mut at: uint64 = 0
    while at < length:
        if mem.read_uint8(source + at) & 192 != 128:
            count = count + 1
        at = at + 1
    return count


# The length in bytes as an `int64`.
def value_text_byte_count(source: uint64, length: uint64) -> int64:
    return length as int64


# Whether the text starts with the part.
def value_text_starts_with(text: uint64, length: uint64, part: uint64, part_length: uint64) -> bool:
    if part_length > length:
        return false
    return value_text_equal(text, part_length, part, part_length)


# Whether the text ends with the part.
def value_text_ends_with(text: uint64, length: uint64, part: uint64, part_length: uint64) -> bool:
    if part_length > length:
        return false
    return value_text_equal(text + (length - part_length), part_length, part, part_length)


# Whether the part lies somewhere in the text.
def value_text_contains(text: uint64, length: uint64, part: uint64, part_length: uint64) -> bool:
    if part_length > length:
        return false
    mut at: uint64 = 0
    while at <= length - part_length:
        if value_text_equal(text + at, part_length, part, part_length):
            return true
        at = at + 1
    return false
