public def read_mstatus() -> uint64:
    mut value: uint64 = 0
    asm("csrr $0, mstatus", output("reg", value), options("preserves_flags"))
    return value

public def write_mstatus(value: uint64) -> None:
    asm("csrw mstatus, $0", input("reg", value), options("preserves_flags"))

