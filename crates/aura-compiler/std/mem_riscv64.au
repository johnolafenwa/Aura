public def read_mhartid() -> uint64:
    mut value: uint64 = 0
    asm("csrr $0, mhartid", output("reg", value), options("preserves_flags"))
    return value

public def read_misa() -> uint64:
    mut value: uint64 = 0
    asm("csrr $0, misa", output("reg", value), options("preserves_flags"))
    return value

