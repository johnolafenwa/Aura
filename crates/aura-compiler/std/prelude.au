# The builtin prelude: names every module sees without an import (ADR-0069).
# The compiler checks this file as module `prelude` and imports a name from it
# into a module that uses the name without declaring or importing its own.


public trait Ord[Rhs]:
    """Ordering against `Rhs`. `<`, `<=`, `>`, and `>=` call these methods
    when no builtin comparison applies, as on a type parameter."""
    def lt(self, rhs: Rhs) -> bool
    def le(self, rhs: Rhs) -> bool
    def gt(self, rhs: Rhs) -> bool
    def ge(self, rhs: Rhs) -> bool


public trait Add[Rhs, Out]:
    """Addition with `Rhs`, producing `Out`. `+` and `+=` call `add` when no
    builtin addition applies."""
    def add(self, rhs: Rhs) -> Out


public trait From[Source]:
    """A conversion from `Source`. `try` uses it to convert an error type."""
    def from(value: own Source) -> Self


public trait Transfer:
    """A value that may cross a task boundary. No `impl` is written for it:
    a type is Transfer when its structure is. As a supertrait,
    `trait Job: Transfer:`, it admits only Transfer types, so `dyn Job`
    may cross a task boundary too."""
    pass


public trait ResultMethods[T, E]:
    """Methods on `Result[T, E]`."""
    def is_ok(self) -> bool
    def is_err(self) -> bool
    def unwrap_or(own self, default: own T) -> T
    def map[U](own self, f: def(T) -> U) -> Result[U, E]
    def map_err[F](own self, f: def(E) -> F) -> Result[T, F]


impl[T, E] ResultMethods[T, E] for Result[T, E]:
    def is_ok(self) -> bool:
        match self:
            case Ok(_):
                return true
            case Err(_):
                return false

    def is_err(self) -> bool:
        match self:
            case Ok(_):
                return false
            case Err(_):
                return true

    def unwrap_or(own self, default: own T) -> T:
        match own self:
            case Ok(value):
                return value
            case Err(_):
                return default

    def map[U](own self, f: def(T) -> U) -> Result[U, E]:
        match own self:
            case Ok(value):
                return Ok(f(value))
            case Err(error):
                return Err(error)

    def map_err[F](own self, f: def(E) -> F) -> Result[T, F]:
        match own self:
            case Ok(value):
                return Ok(value)
            case Err(error):
                return Err(f(error))


impl Ord[int8] for int8:
    def lt(self, rhs: int8) -> bool:
        return self < rhs

    def le(self, rhs: int8) -> bool:
        return self <= rhs

    def gt(self, rhs: int8) -> bool:
        return self > rhs

    def ge(self, rhs: int8) -> bool:
        return self >= rhs


