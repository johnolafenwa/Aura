    def neg(self) -> F32x4:
        return F32x4(l0=-self.l0, l1=-self.l1, l2=-self.l2, l3=-self.l3)


public copy class F32x8:
    """Eight `float32` lanes, `l0` first."""
    public l0: float32
    public l1: float32
    public l2: float32
    public l3: float32
    public l4: float32
    public l5: float32
    public l6: float32
    public l7: float32

    public def splat(value: float32) -> F32x8:
        """Every lane holds `value`."""
        return F32x8(l0=value, l1=value, l2=value, l3=value, l4=value, l5=value, l6=value, l7=value)

    public def load(values: list[float32], at: int64) -> F32x8:
        """The 8 elements of `values` from index `at`. Each index
        follows the list index rules and must be inside the list."""
        return F32x8(l0=values[at], l1=values[at + 1], l2=values[at + 2], l3=values[at + 3], l4=values[at + 4], l5=values[at + 5], l6=values[at + 6], l7=values[at + 7])

    public def store(self, values: mut list[float32], at: int64):
        """Writes the lanes over the 8 elements of `values` from index
        `at`. Each index must be inside the list."""
        values[at] = self.l0
        values[at + 1] = self.l1
        values[at + 2] = self.l2
        values[at + 3] = self.l3
        values[at + 4] = self.l4
        values[at + 5] = self.l5
        values[at + 6] = self.l6
        values[at + 7] = self.l7

    public def min(self, other: F32x8) -> F32x8:
        """In each lane, `self` where it is less than `other`, else
        `other`."""
        return F32x8(l0=(self.l0 if self.l0 < other.l0 else other.l0), l1=(self.l1 if self.l1 < other.l1 else other.l1), l2=(self.l2 if self.l2 < other.l2 else other.l2), l3=(self.l3 if self.l3 < other.l3 else other.l3), l4=(self.l4 if self.l4 < other.l4 else other.l4), l5=(self.l5 if self.l5 < other.l5 else other.l5), l6=(self.l6 if self.l6 < other.l6 else other.l6), l7=(self.l7 if self.l7 < other.l7 else other.l7))

    public def max(self, other: F32x8) -> F32x8:
        """In each lane, `self` where it is greater than `other`, else
        `other`."""
        return F32x8(l0=(self.l0 if self.l0 > other.l0 else other.l0), l1=(self.l1 if self.l1 > other.l1 else other.l1), l2=(self.l2 if self.l2 > other.l2 else other.l2), l3=(self.l3 if self.l3 > other.l3 else other.l3), l4=(self.l4 if self.l4 > other.l4 else other.l4), l5=(self.l5 if self.l5 > other.l5 else other.l5), l6=(self.l6 if self.l6 > other.l6 else other.l6), l7=(self.l7 if self.l7 > other.l7 else other.l7))

    public def abs(self) -> F32x8:
        """The absolute value of each lane."""
        return F32x8(l0=abs(self.l0), l1=abs(self.l1), l2=abs(self.l2), l3=abs(self.l3), l4=abs(self.l4), l5=abs(self.l5), l6=abs(self.l6), l7=abs(self.l7))

    public def sqrt(self) -> F32x8:
        """The square root of each lane."""
        return F32x8(l0=sqrt(self.l0), l1=sqrt(self.l1), l2=sqrt(self.l2), l3=sqrt(self.l3), l4=sqrt(self.l4), l5=sqrt(self.l5), l6=sqrt(self.l6), l7=sqrt(self.l7))

    public def mul_add(self, factor: F32x8, addend: F32x8) -> F32x8:
        """`self * factor + addend` in each lane, rounded after the product
        and again after the sum."""
        return F32x8(l0=self.l0 * factor.l0 + addend.l0, l1=self.l1 * factor.l1 + addend.l1, l2=self.l2 * factor.l2 + addend.l2, l3=self.l3 * factor.l3 + addend.l3, l4=self.l4 * factor.l4 + addend.l4, l5=self.l5 * factor.l5 + addend.l5, l6=self.l6 * factor.l6 + addend.l6, l7=self.l7 * factor.l7 + addend.l7)

    public def sum(self) -> float32:
        """The sum of the lanes, added in pairs: `(l0 + l1) + (l2 + l3)`
        for four lanes."""
        return ((self.l0 + self.l1) + (self.l2 + self.l3)) + ((self.l4 + self.l5) + (self.l6 + self.l7))

    public def to_list(self) -> list[float32]:
        """The lanes as a list, `l0` first."""
        return [self.l0, self.l1, self.l2, self.l3, self.l4, self.l5, self.l6, self.l7]


impl Add[F32x8, F32x8] for F32x8:
    def add(self, rhs: F32x8) -> F32x8:
        return F32x8(l0=self.l0 + rhs.l0, l1=self.l1 + rhs.l1, l2=self.l2 + rhs.l2, l3=self.l3 + rhs.l3, l4=self.l4 + rhs.l4, l5=self.l5 + rhs.l5, l6=self.l6 + rhs.l6, l7=self.l7 + rhs.l7)


impl Sub[F32x8, F32x8] for F32x8:
    def sub(self, rhs: F32x8) -> F32x8:
        return F32x8(l0=self.l0 - rhs.l0, l1=self.l1 - rhs.l1, l2=self.l2 - rhs.l2, l3=self.l3 - rhs.l3, l4=self.l4 - rhs.l4, l5=self.l5 - rhs.l5, l6=self.l6 - rhs.l6, l7=self.l7 - rhs.l7)


impl Mul[F32x8, F32x8] for F32x8:
    def mul(self, rhs: F32x8) -> F32x8:
        return F32x8(l0=self.l0 * rhs.l0, l1=self.l1 * rhs.l1, l2=self.l2 * rhs.l2, l3=self.l3 * rhs.l3, l4=self.l4 * rhs.l4, l5=self.l5 * rhs.l5, l6=self.l6 * rhs.l6, l7=self.l7 * rhs.l7)


impl Div[F32x8, F32x8] for F32x8:
    def div(self, rhs: F32x8) -> F32x8:
        return F32x8(l0=self.l0 / rhs.l0, l1=self.l1 / rhs.l1, l2=self.l2 / rhs.l2, l3=self.l3 / rhs.l3, l4=self.l4 / rhs.l4, l5=self.l5 / rhs.l5, l6=self.l6 / rhs.l6, l7=self.l7 / rhs.l7)


impl Neg[F32x8] for F32x8:
    def neg(self) -> F32x8:
        return F32x8(l0=-self.l0, l1=-self.l1, l2=-self.l2, l3=-self.l3, l4=-self.l4, l5=-self.l5, l6=-self.l6, l7=-self.l7)
