# The builtin `simd` module: values of two, four, or eight numbers that
# native code keeps in one vector register (ADR-0087). The compiler checks
# this file as module `simd`. Each class is a plain Copy class of lanes, and
# each method is ordinary Aura over the lanes, so `aura run` and a native
# build compute the same bits. Native code holds the lanes unboxed, and LLVM
# joins the per-lane arithmetic into vector instructions. The compiler lowers
# a call to `load` or `store` as the element reads or writes it stands for,
# so a counted loop checks their range once (see `mir/simd.rs`).
import simd


public trait Sub[Rhs, Out]:
    """Subtraction of `Rhs`, producing `Out`. `-` calls `sub` when no builtin
    subtraction applies."""
    def sub(self, rhs: Rhs) -> Out


public trait Mul[Rhs, Out]:
    """Multiplication by `Rhs`, producing `Out`. `*` calls `mul` when no
    builtin multiplication applies."""
    def mul(self, rhs: Rhs) -> Out


public trait Div[Rhs, Out]:
    """Division by `Rhs`, producing `Out`. `/` calls `div` when no builtin
    division applies."""
    def div(self, rhs: Rhs) -> Out


public trait Neg[Out]:
    """Negation, producing `Out`. Unary `-` calls `neg` when no builtin
    negation applies."""
    def neg(self) -> Out


public copy class F64x2:
    """Two `float64` lanes, `l0` first."""
    public l0: float64
    public l1: float64

    public def splat(value: float64) -> F64x2:
        """Every lane holds `value`."""
        return F64x2(l0=value, l1=value)

    public def load(values: list[float64], at: int64) -> F64x2:
        """The 2 elements of `values` from index `at`. Each index
        follows the list index rules and must be inside the list."""
        return F64x2(l0=values[at], l1=values[at + 1])

    public def store(self, values: mut list[float64], at: int64):
        """Writes the lanes over the 2 elements of `values` from index
        `at`. Each index must be inside the list."""
        values[at] = self.l0
        values[at + 1] = self.l1

    public def min(self, other: F64x2) -> F64x2:
        """In each lane, `self` where it is less than `other`, else
        `other`."""
        return F64x2(l0=(self.l0 if self.l0 < other.l0 else other.l0), l1=(self.l1 if self.l1 < other.l1 else other.l1))

    public def max(self, other: F64x2) -> F64x2:
        """In each lane, `self` where it is greater than `other`, else
        `other`."""
        return F64x2(l0=(self.l0 if self.l0 > other.l0 else other.l0), l1=(self.l1 if self.l1 > other.l1 else other.l1))

    public def abs(self) -> F64x2:
        """The absolute value of each lane."""
        return F64x2(l0=abs(self.l0), l1=abs(self.l1))

    public def sqrt(self) -> F64x2:
        """The square root of each lane."""
        return F64x2(l0=sqrt(self.l0), l1=sqrt(self.l1))

    public def mul_add(self, factor: F64x2, addend: F64x2) -> F64x2:
        """`self * factor + addend` in each lane, rounded after the product
        and again after the sum."""
        return F64x2(l0=self.l0 * factor.l0 + addend.l0, l1=self.l1 * factor.l1 + addend.l1)

    public def sum(self) -> float64:
        """The sum of the lanes, added in pairs: `(l0 + l1) + (l2 + l3)`
        for four lanes."""
        return self.l0 + self.l1

    public def to_list(self) -> list[float64]:
        """The lanes as a list, `l0` first."""
        return [self.l0, self.l1]


impl Add[F64x2, F64x2] for F64x2:
    def add(self, rhs: F64x2) -> F64x2:
        return F64x2(l0=self.l0 + rhs.l0, l1=self.l1 + rhs.l1)


impl Sub[F64x2, F64x2] for F64x2:
    def sub(self, rhs: F64x2) -> F64x2:
        return F64x2(l0=self.l0 - rhs.l0, l1=self.l1 - rhs.l1)


impl Mul[F64x2, F64x2] for F64x2:
    def mul(self, rhs: F64x2) -> F64x2:
        return F64x2(l0=self.l0 * rhs.l0, l1=self.l1 * rhs.l1)


impl Div[F64x2, F64x2] for F64x2:
    def div(self, rhs: F64x2) -> F64x2:
        return F64x2(l0=self.l0 / rhs.l0, l1=self.l1 / rhs.l1)


impl Neg[F64x2] for F64x2:
    def neg(self) -> F64x2:
        return F64x2(l0=-self.l0, l1=-self.l1)


public copy class F64x4:
    """Four `float64` lanes, `l0` first."""
    public l0: float64
    public l1: float64
    public l2: float64
    public l3: float64

    public def splat(value: float64) -> F64x4:
        """Every lane holds `value`."""
        return F64x4(l0=value, l1=value, l2=value, l3=value)

    public def load(values: list[float64], at: int64) -> F64x4:
        """The 4 elements of `values` from index `at`. Each index
        follows the list index rules and must be inside the list."""
        return F64x4(l0=values[at], l1=values[at + 1], l2=values[at + 2], l3=values[at + 3])

    public def store(self, values: mut list[float64], at: int64):
        """Writes the lanes over the 4 elements of `values` from index
        `at`. Each index must be inside the list."""
        values[at] = self.l0
        values[at + 1] = self.l1
        values[at + 2] = self.l2
        values[at + 3] = self.l3

    public def min(self, other: F64x4) -> F64x4:
        """In each lane, `self` where it is less than `other`, else
        `other`."""
        return F64x4(l0=(self.l0 if self.l0 < other.l0 else other.l0), l1=(self.l1 if self.l1 < other.l1 else other.l1), l2=(self.l2 if self.l2 < other.l2 else other.l2), l3=(self.l3 if self.l3 < other.l3 else other.l3))

    public def max(self, other: F64x4) -> F64x4:
        """In each lane, `self` where it is greater than `other`, else
        `other`."""
        return F64x4(l0=(self.l0 if self.l0 > other.l0 else other.l0), l1=(self.l1 if self.l1 > other.l1 else other.l1), l2=(self.l2 if self.l2 > other.l2 else other.l2), l3=(self.l3 if self.l3 > other.l3 else other.l3))

    public def abs(self) -> F64x4:
        """The absolute value of each lane."""
        return F64x4(l0=abs(self.l0), l1=abs(self.l1), l2=abs(self.l2), l3=abs(self.l3))

    public def sqrt(self) -> F64x4:
        """The square root of each lane."""
        return F64x4(l0=sqrt(self.l0), l1=sqrt(self.l1), l2=sqrt(self.l2), l3=sqrt(self.l3))

    public def mul_add(self, factor: F64x4, addend: F64x4) -> F64x4:
        """`self * factor + addend` in each lane, rounded after the product
        and again after the sum."""
        return F64x4(l0=self.l0 * factor.l0 + addend.l0, l1=self.l1 * factor.l1 + addend.l1, l2=self.l2 * factor.l2 + addend.l2, l3=self.l3 * factor.l3 + addend.l3)

    public def sum(self) -> float64:
        """The sum of the lanes, added in pairs: `(l0 + l1) + (l2 + l3)`
        for four lanes."""
        return (self.l0 + self.l1) + (self.l2 + self.l3)

    public def to_list(self) -> list[float64]:
        """The lanes as a list, `l0` first."""
        return [self.l0, self.l1, self.l2, self.l3]


impl Add[F64x4, F64x4] for F64x4:
    def add(self, rhs: F64x4) -> F64x4:
        return F64x4(l0=self.l0 + rhs.l0, l1=self.l1 + rhs.l1, l2=self.l2 + rhs.l2, l3=self.l3 + rhs.l3)


impl Sub[F64x4, F64x4] for F64x4:
    def sub(self, rhs: F64x4) -> F64x4:
        return F64x4(l0=self.l0 - rhs.l0, l1=self.l1 - rhs.l1, l2=self.l2 - rhs.l2, l3=self.l3 - rhs.l3)


impl Mul[F64x4, F64x4] for F64x4:
    def mul(self, rhs: F64x4) -> F64x4:
        return F64x4(l0=self.l0 * rhs.l0, l1=self.l1 * rhs.l1, l2=self.l2 * rhs.l2, l3=self.l3 * rhs.l3)


impl Div[F64x4, F64x4] for F64x4:
    def div(self, rhs: F64x4) -> F64x4:
        return F64x4(l0=self.l0 / rhs.l0, l1=self.l1 / rhs.l1, l2=self.l2 / rhs.l2, l3=self.l3 / rhs.l3)


impl Neg[F64x4] for F64x4:
    def neg(self) -> F64x4:
        return F64x4(l0=-self.l0, l1=-self.l1, l2=-self.l2, l3=-self.l3)


public copy class F32x4:
    """Four `float32` lanes, `l0` first."""
    public l0: float32
    public l1: float32
    public l2: float32
    public l3: float32

    public def splat(value: float32) -> F32x4:
        """Every lane holds `value`."""
        return F32x4(l0=value, l1=value, l2=value, l3=value)

    public def load(values: list[float32], at: int64) -> F32x4:
        """The 4 elements of `values` from index `at`. Each index
        follows the list index rules and must be inside the list."""
        return F32x4(l0=values[at], l1=values[at + 1], l2=values[at + 2], l3=values[at + 3])

    public def store(self, values: mut list[float32], at: int64):
        """Writes the lanes over the 4 elements of `values` from index
        `at`. Each index must be inside the list."""
        values[at] = self.l0
        values[at + 1] = self.l1
        values[at + 2] = self.l2
        values[at + 3] = self.l3

    public def min(self, other: F32x4) -> F32x4:
        """In each lane, `self` where it is less than `other`, else
        `other`."""
        return F32x4(l0=(self.l0 if self.l0 < other.l0 else other.l0), l1=(self.l1 if self.l1 < other.l1 else other.l1), l2=(self.l2 if self.l2 < other.l2 else other.l2), l3=(self.l3 if self.l3 < other.l3 else other.l3))

    public def max(self, other: F32x4) -> F32x4:
        """In each lane, `self` where it is greater than `other`, else
        `other`."""
        return F32x4(l0=(self.l0 if self.l0 > other.l0 else other.l0), l1=(self.l1 if self.l1 > other.l1 else other.l1), l2=(self.l2 if self.l2 > other.l2 else other.l2), l3=(self.l3 if self.l3 > other.l3 else other.l3))

    public def abs(self) -> F32x4:
        """The absolute value of each lane."""
        return F32x4(l0=abs(self.l0), l1=abs(self.l1), l2=abs(self.l2), l3=abs(self.l3))

    public def sqrt(self) -> F32x4:
        """The square root of each lane."""
        return F32x4(l0=sqrt(self.l0), l1=sqrt(self.l1), l2=sqrt(self.l2), l3=sqrt(self.l3))

    public def mul_add(self, factor: F32x4, addend: F32x4) -> F32x4:
        """`self * factor + addend` in each lane, rounded after the product
        and again after the sum."""
        return F32x4(l0=self.l0 * factor.l0 + addend.l0, l1=self.l1 * factor.l1 + addend.l1, l2=self.l2 * factor.l2 + addend.l2, l3=self.l3 * factor.l3 + addend.l3)

    public def sum(self) -> float32:
        """The sum of the lanes, added in pairs: `(l0 + l1) + (l2 + l3)`
        for four lanes."""
        return (self.l0 + self.l1) + (self.l2 + self.l3)

    public def to_list(self) -> list[float32]:
        """The lanes as a list, `l0` first."""
        return [self.l0, self.l1, self.l2, self.l3]


impl Add[F32x4, F32x4] for F32x4:
    def add(self, rhs: F32x4) -> F32x4:
        return F32x4(l0=self.l0 + rhs.l0, l1=self.l1 + rhs.l1, l2=self.l2 + rhs.l2, l3=self.l3 + rhs.l3)


impl Sub[F32x4, F32x4] for F32x4:
