        return F32x4(l0=self.l0 * rhs.l0, l1=self.l1 * rhs.l1, l2=self.l2 * rhs.l2, l3=self.l3 * rhs.l3)


impl Div[F32x4, F32x4] for F32x4:
    def div(self, rhs: F32x4) -> F32x4:
        return F32x4(l0=self.l0 / rhs.l0, l1=self.l1 / rhs.l1, l2=self.l2 / rhs.l2, l3=self.l3 / rhs.l3)


