    """Each element of a batch as one row: `[batch, ...]` to
    `[batch, features]`."""


impl Module for Flatten:
    def collect(self, into: mut Collector) -> None:
        return


impl Layer for Flatten:
    def forward(self, x: Tensor[float32]) -> Tensor[float32]:
        return x.reshape([x.shape()[0], -1])


public class BatchNorm2d:
    """Each channel of a `[batch, channels, height, width]` tensor moved
    to mean zero and deviation one, then scaled by `weight` and moved by
    `bias`. In training mode the statistics are those of the batch, and
    `running_mean` and `running_var` move toward them by `momentum`. In
    evaluation mode the statistics are the running ones."""
    public weight: Parameter[float32]
    public bias: Parameter[float32]
    public running_mean: Parameter[float32]
    public running_var: Parameter[float32]
    public eps: float64
    public momentum: float64
    training: Parameter[float32]

    public def __init__(self, num_features: int64, device: Device):
        self.weight = Parameter[float32](Tensor[float32].full([num_features], 1.0, device))
        self.bias = Parameter[float32](Tensor[float32].zeros([num_features], device))
        self.running_mean = Parameter[float32](Tensor[float32].zeros([num_features], device))
        self.running_var = Parameter[float32](Tensor[float32].full([num_features], 1.0, device))
        self.eps = 0.00001
        self.momentum = 0.1
        self.training = Parameter[float32](Tensor[float32].full([1], 1.0, Device.cpu()))


impl Module for BatchNorm2d:
    def collect(self, into: mut Collector) -> None:
        into.parameter("weight", self.weight)
        into.parameter("bias", self.bias)
        into.buffer("running_mean", self.running_mean)
        into.buffer("running_var", self.running_var)
        into.mode(self.training)


impl Layer for BatchNorm2d:
    def forward(self, x: Tensor[float32]) -> Tensor[float32]:
        shape = x.shape()
        channels = shape[1]
        wide = [1, channels, 1, 1]
        weight = self.weight.value().reshape(wide)
        bias = self.bias.value().reshape(wide)
        if self.training.value().item() < 0.5:
            mean = self.running_mean.value().detach().reshape(wide)
            spread = self.running_var.value().detach().reshape(wide)
            return (x - mean) / (spread + self.eps).sqrt() * weight + bias
        lanes = [shape[0], channels, shape[2] * shape[3]]
        mean = x.reshape(lanes).mean(2).mean(0)
        centered = x - mean.reshape(wide)
        spread = (centered * centered).reshape(lanes).mean(2).mean(0)
        count = shape[0] * shape[2] * shape[3]
        mut unbiased = 1.0
        if count > 1:
            unbiased = (count as float64) / ((count - 1) as float64)
        self.running_mean.assign((self.running_mean.value() * (1.0 - self.momentum) + mean * self.momentum).detach())
        self.running_var.assign((self.running_var.value() * (1.0 - self.momentum) + spread * (self.momentum * unbiased)).detach())
        return centered / (spread.reshape(wide) + self.eps).sqrt() * weight + bias


public class SGD:
    """Gradient descent: each parameter less `lr` times its gradient."""
    params: list[Parameter[float32]]
    public lr: float64

    public def __init__(self, params: own list[Parameter[float32]], lr: float64):
        self.params = params
        self.lr = lr

    public def zero_grad(mut self) -> None:
        """Clears the gradient of every parameter. `step()` does this
        too, so a loop needs it only to drop gradients it will not use."""
        mut at = 0
        while at < self.params.len():
            view param = self.params[at]
            param.zero_grad()
            at += 1

    public def step(mut self) -> None:
        """Moves every parameter against its gradient and clears the
        gradients. The loss, the gradients and every update run as one
        piece of work."""
        mut updates = list[Tensor[float32]]()
        mut at = 0
        while at < self.params.len():
            view param = self.params[at]
            updates.append(param.value().detach() - param.grad * self.lr)
            at += 1
        evaluate(updates)
        at = 0
        while at < self.params.len():
            view param = self.params[at]
            view update = updates[at]
            param.assign(update)
            at += 1

    public def minimize(mut self, loss: Tensor[float32]) -> None:
        """`loss.backward()` and `step()`."""
        loss.backward()
        self.step()


public class AdamW:
    """Adam with weight decay applied to the parameters themselves."""
    params: list[Parameter[float32]]
    public lr: float64
    public weight_decay: float64
    beta1: float64
    beta2: float64
    eps: float64
    first: list[Tensor[float32]]
    second: list[Tensor[float32]]
    power1: float64
    power2: float64

    public def __init__(self, params: own list[Parameter[float32]], lr: float64 = 0.001, weight_decay: float64 = 0.01):
        mut first = list[Tensor[float32]]()
        mut second = list[Tensor[float32]]()
        mut at = 0
        while at < params.len():
            view param = params[at]
            current = param.value()
            first.append(Tensor[float32].zeros(current.shape(), current.device()))
            second.append(Tensor[float32].zeros(current.shape(), current.device()))
            at += 1
        self.params = params
        self.lr = lr
        self.weight_decay = weight_decay
        self.beta1 = 0.9
        self.beta2 = 0.999
        self.eps = 0.00000001
        self.first = first
        self.second = second
        self.power1 = 1.0
        self.power2 = 1.0

    public def zero_grad(mut self) -> None:
        """Clears the gradient of every parameter. `step()` does this
        too, so a loop needs it only to drop gradients it will not use."""
        mut at = 0
        while at < self.params.len():
            view param = self.params[at]
            param.zero_grad()
            at += 1

    public def step(mut self) -> None:
        """Moves every parameter by one Adam step against its gradient
        and clears the gradients. The loss, the gradients and every
        update run as one piece of work."""
        self.power1 = self.power1 * self.beta1
        self.power2 = self.power2 * self.beta2
        count = self.params.len()
        mut work = list[Tensor[float32]]()
        mut first = list[Tensor[float32]]()
        mut second = list[Tensor[float32]]()
        mut at = 0
        while at < count:
            view param = self.params[at]
            view mean = self.first[at]
            view square = self.second[at]
            slope = param.grad
            moved = mean * self.beta1 + slope * (1.0 - self.beta1)
            spread = square * self.beta2 + slope * slope * (1.0 - self.beta2)
            size = (spread / (1.0 - self.power2)).sqrt() + self.eps
            work.append(param.value().detach() * (1.0 - self.lr * self.weight_decay) - moved / size * (self.lr / (1.0 - self.power1)))
            first.append(moved)
            second.append(spread)
            at += 1
        at = 0
        while at < count:
            view moved = first[at]
            view spread = second[at]
            work.append(moved.clone())
            work.append(spread.clone())
            at += 1
        evaluate(work)
        at = 0
        while at < count:
            view param = self.params[at]
            view update = work[at]
            param.assign(update)
            at += 1
        self.first = first
        self.second = second

    public def minimize(mut self, loss: Tensor[float32]) -> None:
        """`loss.backward()` and `step()`."""
        loss.backward()
        self.step()


def reduce(node: tensor.Node, reduction: int64, axis: int64 | None, keep: bool) -> tensor.Node:
    mut shape = tensor.__aura_shape(node)
    match axis:
        case None:
            made = tensor.__aura_reduce(node, reduction, 0, false)
            if not keep:
                return made
            mut at = 0
            while at < shape.len():
                shape[at] = 1
                at += 1
            return tensor.__aura_reshape(made, shape)
        case int64 as lane:
            made = tensor.__aura_reduce(node, reduction, lane, true)
            if not keep:
                return made
            if lane < 0:
                shape[lane + shape.len()] = 1
            else:
                shape[lane] = 1
            return tensor.__aura_reshape(made, shape)


def shifted(node: tensor.Node, axis: int64) -> tensor.Node:
    # Each lane less its largest element, which keeps `exp` from
    # overflowing. The shift is a constant: it cancels in the gradient.
    largest = tensor.__aura_node_op(reduce(node, 2, axis, true), 5, list[int64]())
    return tensor.__aura_binary(node, largest, 1)


public def cat[T](tensors: list[Tensor[T]], dim: int64 = 0) -> Tensor[T]:
    """The tensors, one after another along `dim`."""
    mut joined = tensor.__aura_share(tensors[0].node)
    mut at = 1
    while at < tensors.len():
        joined = tensor.__aura_pair_op(joined, tensors[at].node, 0, [dim])
        at += 1
    return Tensor[T](node=joined)


public def rand(shape: list[int64], seed: int64, device: Device) -> Tensor[float32]:
    """Random floats spread evenly from zero up to, and not including,
    one. A seed always gives the same tensor."""
    return Tensor[float32](node=tensor.__aura_filled(shape, 0, seed, 2, device.kind))


public def randn(shape: list[int64], seed: int64, device: Device) -> Tensor[float32]:
    """Random floats of the normal distribution with mean zero and
    deviation one. A seed always gives the same tensor."""
    return Tensor[float32](node=tensor.__aura_filled(shape, 1, seed, 2, device.kind))


public def arange(count: int64, device: Device) -> Tensor[int64]:
    """The integers from zero up to, and not including, `count`."""
    return Tensor[int64](node=tensor.__aura_filled([count], 2, 0, 1, device.kind))


public def cross_entropy[T](logits: Tensor[T], targets: Tensor[int64]) -> Tensor[T]:
    """The mean, over the rows of `logits`, of the negative logarithm of
    the softmax entry that the row's target names. `logits` has one row
    for each target and one column for each class."""
    shape = tensor.__aura_shape(logits.node)
    scores = logits.log_softmax(1)
    classes = tensor.__aura_filled([shape[1]], 2, 0, 1, tensor.__aura_device(logits.node))
    named = tensor.__aura_compare(classes, tensor.__aura_reshape(targets.node, [shape[0], 1]), 4)
    zero = tensor.__aura_scalar_like_f64(scores.node, 0.0)
    total = tensor.__aura_reduce(tensor.__aura_where(named, scores.node, zero), 0, 0, false)
    scale = tensor.__aura_scalar_like_f64(scores.node, -1.0 / (shape[0] as float64))
    return Tensor[T](node=tensor.__aura_binary(total, scale, 2))


public def where[T](mask: Tensor[bool], input: Tensor[T], other: Tensor[T]) -> Tensor[T]:
    """Each element of `input` where `mask` holds, else of `other`. The three shapes broadcast."""
    return Tensor[T](node=tensor.__aura_where(mask.node, input.node, other.node))


public trait Operand[T]:
    """What can stand on the other side of a `Tensor[T]` in an operator or
    an elementwise member: a `Tensor[T]`, or a number, which is used as a
    tensor of one element of the tensor's dtype."""
    def operand(self, like: tensor.Node) -> tensor.Node


impl[T] Operand[T] for Tensor[T]:
    def operand(self, like: tensor.Node) -> tensor.Node:
        return tensor.__aura_share(self.node)


