impl Elements[Array[bool], bool] for Tensor[bool]:
    def from_array(values: Array[bool], device: Device) -> Tensor[bool]:
        return Tensor[bool](node=tensor.__aura_from_array_bool(values, device.kind))

    def full(shape: list[int64], value: bool, device: Device) -> Tensor[bool]:
        return Tensor[bool](node=tensor.__aura_full_bool(shape, value, 4, device.kind))

    def zeros(shape: list[int64], device: Device) -> Tensor[bool]:
        return Tensor[bool](node=tensor.__aura_full_bool(shape, false, 4, device.kind))

    def to_array(self) -> Array[bool]:
        return tensor.__aura_to_array_bool(self.node)

    def item(self) -> bool:
        return tensor.__aura_item_bool(self.node)

    def scalar(self, value: bool) -> Tensor[bool]:
        return Tensor[bool](node=tensor.__aura_full_bool([1], value, 4, tensor.__aura_device(self.node)))
