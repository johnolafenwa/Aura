# The Aura-source part of the builtin `tensor` module. The compiler checks
# this file as module `tensor` and merges its public items with the host
# functions that `builtin_modules.rs` declares. A `Tensor[T]` holds a
# `tensor.Node`: memory that a device owns. Every operation is a host call
# on nodes, so the same source runs on the CPU device and on a GPU.
import tensor


public trait Sub[Rhs, Out]:
    """Subtraction of `Rhs`, producing `Out`. `-` calls `sub` when no builtin
    subtraction applies."""
    def sub(self, rhs: Rhs) -> Out


public trait Mul[Rhs, Out]:
    """Multiplication by `Rhs`, producing `Out`. `*` calls `mul` when no
    builtin multiplication applies."""
    def mul(self, rhs: Rhs) -> Out


public trait Div[Rhs, Out]:
    """Division by `Rhs`, producing `Out`. `/` calls `div` when no builtin
    division applies."""
    def div(self, rhs: Rhs) -> Out


public trait Neg[Out]:
    """Negation, producing `Out`. Unary `-` calls `neg` when no builtin
    negation applies."""
    def neg(self) -> Out


public copy class Device:
    """Where a tensor's memory lives and its operations run."""
    kind: int64

    public def cpu() -> Device:
        """The CPU device. Every machine has it."""
        return Device(kind=0)

    public def metal() -> Device | None:
        """The Metal GPU of this Mac, or `None` when there is none."""
        if tensor.__aura_device_available(1):
            return Device(kind=1)
        return None

    public def cuda() -> Device | None:
        """The NVIDIA GPU of this machine, or `None` when there is none
        with a driver and the CUDA libraries."""
        if tensor.__aura_device_available(2):
            return Device(kind=2)
        return None

    public def default() -> Device:
        """The GPU when this machine has one Aura can use, else the CPU."""
        if tensor.__aura_device_available(1):
            return Device(kind=1)
        if tensor.__aura_device_available(2):
            return Device(kind=2)
        return Device(kind=0)

    public def name(self) -> str:
        """`"cpu"`, `"metal"`, or `"cuda"`."""
        if self.kind == 1:
            return "metal"
        if self.kind == 2:
            return "cuda"
        return "cpu"

    public def is_gpu(self) -> bool:
        return self.kind != 0


public class Tensor[T]:
    """Numbers of one dtype on a device. A tensor is never changed: each
    operation gives a new one. Shapes follow the `Array` rules."""
    node: tensor.Node

    public def shape(self) -> list[int64]:
        return tensor.__aura_shape(self.node)

    public def len(self) -> int64:
        """The number of elements."""
        return tensor.__aura_len(self.node)

    public def device(self) -> Device:
        return Device(kind=tensor.__aura_device(self.node))

    public def to(self, device: Device) -> Tensor[T]:
        """This tensor on `device`. The elements are copied unless it is
        already there."""
        return Tensor[T](node=tensor.__aura_to_device(self.node, device.kind))

    public def clone(self) -> Tensor[T]:
        """Another handle to the same memory. Nothing is copied."""
        return Tensor[T](node=tensor.__aura_share(self.node))

    public def eval(self) -> None:
        """Runs any work this tensor is still waiting on. A device failure
        is reported here."""
        tensor.__aura_eval(self.node)

    public def reshape(self, shape: list[int64]) -> Tensor[T]:
        return Tensor[T](node=tensor.__aura_reshape(self.node, shape))

    public def flatten(self) -> Tensor[T]:
        return Tensor[T](node=tensor.__aura_reshape(self.node, [self.len()]))

    public def transpose(self) -> Tensor[T]:
        """The axes in reverse order."""
        return Tensor[T](node=tensor.__aura_permute(self.node, list[int64]()))

    public def permute(self, axes: list[int64]) -> Tensor[T]:
        return Tensor[T](node=tensor.__aura_permute(self.node, axes))

    public def matmul(self, other: Tensor[T]) -> Tensor[T]:
        return Tensor[T](node=tensor.__aura_matmul(self.node, other.node))

    public def minimum(self, other: Tensor[T]) -> Tensor[T]:
        return Tensor[T](node=tensor.__aura_binary(self.node, other.node, 16))

    public def maximum(self, other: Tensor[T]) -> Tensor[T]:
        return Tensor[T](node=tensor.__aura_binary(self.node, other.node, 17))

    public def pow(self, exponent: Tensor[T]) -> Tensor[T]:
        return Tensor[T](node=tensor.__aura_binary(self.node, exponent.node, 18))

    public def powf(self, exponent: float64) -> Tensor[T]:
        """Each element raised to one exponent."""
        return Tensor[T](node=tensor.__aura_binary(self.node, tensor.__aura_scalar_like_f64(self.node, exponent), 18))

    public def clamp(self, low: float64, high: float64) -> Tensor[T]:
        """Each element, or `low` where it is below `low`, or `high` where
        it is above `high`."""
        raised = tensor.__aura_binary(self.node, tensor.__aura_scalar_like_f64(self.node, low), 17)
        return Tensor[T](node=tensor.__aura_binary(raised, tensor.__aura_scalar_like_f64(self.node, high), 16))

    public def relu(self) -> Tensor[T]:
        """Each element, or zero where it is negative."""
        return Tensor[T](node=tensor.__aura_binary(self.node, tensor.__aura_scalar_like_i64(self.node, 0), 17))

    public def abs(self) -> Tensor[T]:
        return Tensor[T](node=tensor.__aura_unary(self.node, 0))

    public def sqrt(self) -> Tensor[T]:
        return Tensor[T](node=tensor.__aura_unary(self.node, 1))

    public def exp(self) -> Tensor[T]:
        return Tensor[T](node=tensor.__aura_unary(self.node, 2))

    public def log(self) -> Tensor[T]:
        return Tensor[T](node=tensor.__aura_unary(self.node, 3))

    public def sin(self) -> Tensor[T]:
        return Tensor[T](node=tensor.__aura_unary(self.node, 6))

    public def cos(self) -> Tensor[T]:
        return Tensor[T](node=tensor.__aura_unary(self.node, 7))

    public def tanh(self) -> Tensor[T]:
        return Tensor[T](node=tensor.__aura_unary(self.node, 65))

    public def sigmoid(self) -> Tensor[T]:
        """`1 / (1 + exp(-x))` of each element."""
        return Tensor[T](node=tensor.__aura_unary(self.node, 66))

    public def erf(self) -> Tensor[T]:
        """The error function of each element."""
        return Tensor[T](node=tensor.__aura_unary(self.node, 67))

    public def gelu(self) -> Tensor[T]:
        """`x * (1 + erf(x / sqrt(2))) / 2` of each element."""
        scaled = tensor.__aura_binary(self.node, tensor.__aura_scalar_like_f64(self.node, 0.7071067811865476), 2)
        raised = tensor.__aura_binary(tensor.__aura_unary(scaled, 67), tensor.__aura_scalar_like_f64(self.node, 1.0), 0)
        halved = tensor.__aura_binary(self.node, tensor.__aura_scalar_like_f64(self.node, 0.5), 2)
        return Tensor[T](node=tensor.__aura_binary(halved, raised, 2))

    public def slice(self, axis: int64, start: int64, stop: int64, step: int64 = 1) -> Tensor[T]:
        """The entries `start` to `stop`, without `stop`, along `axis`,
        `step` apart. A negative bound counts from the end."""
        return Tensor[T](node=tensor.__aura_node_op(self.node, 0, [axis, start, stop, step]))

    public def broadcast_to(self, shape: list[int64]) -> Tensor[T]:
        """This tensor repeated to `shape`, which its shape broadcasts
        to."""
        return Tensor[T](node=tensor.__aura_node_op(self.node, 1, shape))

    public def concat(self, other: Tensor[T], axis: int64 = 0) -> Tensor[T]:
        """This tensor followed by `other` along `axis`."""
        return Tensor[T](node=tensor.__aura_pair_op(self.node, other.node, 0, [axis]))

    public def take(self, indices: Tensor[int64], axis: int64 = 0) -> Tensor[T]:
        """For each index, the entry at that place along `axis`. The
        shape of `indices` takes the place of the axis."""
        return Tensor[T](node=tensor.__aura_pair_op(self.node, indices.node, 1, [axis]))

    public def index_add(self, indices: Tensor[int64], size: int64, axis: int64 = 0) -> Tensor[T]:
        """A tensor with `size` entries along `axis`, where entry `k` is
        the sum of this tensor's entries whose index is `k`. The shape of
        `indices` is this tensor's shape from `axis`."""
        return Tensor[T](node=tensor.__aura_pair_op(self.node, indices.node, 2, [axis, size]))

    public def argmax(self, axis: int64 = -1) -> Tensor[int64]:
        """The place of the largest element of each lane along `axis`."""
        return Tensor[int64](node=tensor.__aura_node_op(self.node, 2, [axis]))

    public def argmin(self, axis: int64 = -1) -> Tensor[int64]:
        """The place of the smallest element of each lane along `axis`."""
        return Tensor[int64](node=tensor.__aura_node_op(self.node, 3, [axis]))

    public def watch(self) -> Tensor[T]:
        """This tensor as one that gradients are taken with respect to.
        Float tensors only."""
        return Tensor[T](node=tensor.__aura_node_op(self.node, 4, list[int64]()))

    public def detach(self) -> Tensor[T]:
        """This tensor as a constant: no gradient passes through it."""
        return Tensor[T](node=tensor.__aura_node_op(self.node, 5, list[int64]()))

    public def gradient(self, of: Tensor[T]) -> Tensor[T]:
        """The gradient of the sum of this tensor with respect to the
        watched tensor `of`, in the shape of `of`."""
        return Tensor[T](node=tensor.__aura_pair_op(self.node, of.node, 3, list[int64]()))

    public def softmax(self, axis: int64 = -1) -> Tensor[T]:
        """Each lane along `axis` as positive numbers that sum to one."""
        powers = tensor.__aura_unary(shifted(self.node, axis), 2)
        return Tensor[T](node=tensor.__aura_binary(powers, reduce(powers, 0, axis, true), 3))

    public def log_softmax(self, axis: int64 = -1) -> Tensor[T]:
        """The logarithm of `softmax(axis)`, computed without overflow."""
        moved = shifted(self.node, axis)
        total = reduce(tensor.__aura_unary(moved, 2), 0, axis, true)
        return Tensor[T](node=tensor.__aura_binary(moved, tensor.__aura_unary(total, 3), 1))

    public def less(self, other: Tensor[T]) -> Tensor[bool]:
        return Tensor[bool](node=tensor.__aura_compare(self.node, other.node, 0))

    public def less_equal(self, other: Tensor[T]) -> Tensor[bool]:
        return Tensor[bool](node=tensor.__aura_compare(self.node, other.node, 1))

    public def greater(self, other: Tensor[T]) -> Tensor[bool]:
        return Tensor[bool](node=tensor.__aura_compare(self.node, other.node, 2))

    public def greater_equal(self, other: Tensor[T]) -> Tensor[bool]:
        return Tensor[bool](node=tensor.__aura_compare(self.node, other.node, 3))

    public def equal(self, other: Tensor[T]) -> Tensor[bool]:
        return Tensor[bool](node=tensor.__aura_compare(self.node, other.node, 4))

    public def not_equal(self, other: Tensor[T]) -> Tensor[bool]:
        return Tensor[bool](node=tensor.__aura_compare(self.node, other.node, 5))

    public def sum(self, axis: int64 | None = None, keep: bool = false) -> Tensor[T]:
        """The sum of every element as a tensor of shape `[1]`, or of each
        lane along `axis`. The order of the additions is not fixed. With
        `keep`, the result has the tensor's rank, with length one on each
        axis that was summed."""
        return Tensor[T](node=reduce(self.node, 0, axis, keep))

    public def min(self, axis: int64 | None = None, keep: bool = false) -> Tensor[T]:
        return Tensor[T](node=reduce(self.node, 1, axis, keep))

    public def max(self, axis: int64 | None = None, keep: bool = false) -> Tensor[T]:
        return Tensor[T](node=reduce(self.node, 2, axis, keep))

    public def mean(self, axis: int64 | None = None, keep: bool = false) -> Tensor[T]:
        """The mean, in the tensor's own dtype. Float tensors only."""
        return Tensor[T](node=reduce(self.node, 3, axis, keep))

    public def to_int32(self) -> Tensor[int32]:
        return Tensor[int32](node=tensor.__aura_cast(self.node, 0))

    public def to_int64(self) -> Tensor[int64]:
        return Tensor[int64](node=tensor.__aura_cast(self.node, 1))

    public def to_float32(self) -> Tensor[float32]:
        return Tensor[float32](node=tensor.__aura_cast(self.node, 2))

    public def to_float64(self) -> Tensor[float64]:
        return Tensor[float64](node=tensor.__aura_cast(self.node, 3))


public class Variable[T]:
    """A float tensor that can be replaced by another of the same shape:
    a weight that training changes. Every clone names the same variable,
    so an optimizer and a model see one value."""
    slot: tensor.Node

    public def holding(value: Tensor[T]) -> Variable[T]:
        """A variable that starts as `value`. Float tensors only."""
        return Variable[T](slot=tensor.__aura_node_op(value.node, 6, list[int64]()))

    public def value(self) -> Tensor[T]:
        """The tensor the variable holds now. It is watched, so a result
        computed from it has a gradient with respect to it."""
        return Tensor[T](node=tensor.__aura_node_op(self.slot, 7, list[int64]()))

    public def assign(self, value: Tensor[T]) -> None:
        """Replaces the tensor the variable holds. Any work `value` waits
        on runs now."""
        tensor.__aura_pair_op(self.slot, value.node, 4, list[int64]())

    public def clone(self) -> Variable[T]:
        """Another handle to the same variable."""
        return Variable[T](slot=tensor.__aura_share(self.slot))


public def evaluate[T](tensors: list[Tensor[T]]) -> None:
    """Runs the work the tensors wait on, as one piece of work, so an
    expression several of them share is computed once."""
    if tensors.len() == 0:
        return
    mut at = 0
    while at + 1 < tensors.len():
        tensor.__aura_node_op(tensors[at].node, 8, list[int64]())
        at += 1
    tensor.__aura_node_op(tensors[at].node, 9, list[int64]())


public def weight_names(path: str) -> Result[list[str], str]:
    """The names of the tensors in the safetensors file at `path`, in the
    file's order."""
    return tensor.__aura_weights_names(path)


public def load_float32(path: str, name: str, device: Device) -> Result[Tensor[float32], str]:
    """The float tensor `name` of the safetensors file at `path`. A
    tensor stored as `float16`, `bfloat16` or `float64` is converted."""
    match own tensor.__aura_weights_load(path, name, 2, device.kind):
        case Ok(node):
            return Ok(Tensor[float32](node=node))
        case Err(message):
            return Err(message)


public def load_int64(path: str, name: str, device: Device) -> Result[Tensor[int64], str]:
    """The integer tensor `name` of the safetensors file at `path`."""
    match own tensor.__aura_weights_load(path, name, 1, device.kind):
        case Ok(node):
            return Ok(Tensor[int64](node=node))
        case Err(message):
            return Err(message)


public def save[T](path: str, names: list[str], tensors: list[Tensor[T]]) -> Result[int64, str]:
    """Writes `tensors` under `names` as a safetensors file at `path`, and
    gives the file's length in bytes."""
    if names.len() != tensors.len():
        return Err("`tensor.save` expects one name for each tensor")
    mut at = 0
    while at < names.len():
        tensor.__aura_weights_put(path, names[at], tensors[at].node)
        at += 1
    return tensor.__aura_weights_write(path)


public class Linear:
    """`x.matmul(weight) + bias` over the last axis of `x`."""
    public weight: Variable[float32]
    public bias: Variable[float32]

    public def create(inputs: int64, outputs: int64, seed: int64, device: Device) -> Linear:
        """A layer from `inputs` features to `outputs`, with weights spread
        evenly between plus and minus `1 / sqrt(inputs)`."""
        bound = 1.0 / (inputs as float64).sqrt()
        weight = (uniform([inputs, outputs], seed, device) * 2.0 - 1.0) * bound
        bias = (uniform([outputs], seed + 1, device) * 2.0 - 1.0) * bound
        return Linear(weight=Variable[float32].holding(weight), bias=Variable[float32].holding(bias))

    public def apply(self, x: Tensor[float32]) -> Tensor[float32]:
        mut shape = x.shape()
        last = shape.len() - 1
        weight = self.weight.value()
        flat = x.reshape([-1, shape[last]]).matmul(weight) + self.bias.value()
        shape[last] = weight.shape()[1]
        return flat.reshape(shape)

    public def variables(self) -> list[Variable[float32]]:
        return [self.weight.clone(), self.bias.clone()]


public class Embedding:
    """A row of `weight` for each index."""
    public weight: Variable[float32]

    public def create(count: int64, width: int64, seed: int64, device: Device) -> Embedding:
        return Embedding(weight=Variable[float32].holding(normal([count, width], seed, device) * 0.02))

    public def apply(self, indices: Tensor[int64]) -> Tensor[float32]:
        return self.weight.value().take(indices)

    public def variables(self) -> list[Variable[float32]]:
        return [self.weight.clone()]


public class LayerNorm:
    """Each lane along the last axis moved to mean zero and deviation
    one, then scaled by `weight` and moved by `bias`."""
    public weight: Variable[float32]
    public bias: Variable[float32]
    public epsilon: float64

    public def create(width: int64, device: Device) -> LayerNorm:
        return LayerNorm(weight=Variable[float32].holding(Tensor[float32].full([width], 1.0, device)), bias=Variable[float32].holding(Tensor[float32].zeros([width], device)), epsilon=0.00001)

    public def apply(self, x: Tensor[float32]) -> Tensor[float32]:
        centered = x - x.mean(-1, true)
        spread = (centered * centered).mean(-1, true)
        return centered / (spread + self.epsilon).sqrt() * self.weight.value() + self.bias.value()

    public def variables(self) -> list[Variable[float32]]:
        return [self.weight.clone(), self.bias.clone()]


public def dropout(x: Tensor[float32], rate: float64, seed: int64) -> Tensor[float32]:
    """`x` with a share `rate` of its elements, chosen by `seed`, set to
    zero, and the others scaled up so the mean stays."""
    kept = uniform(x.shape(), seed, x.device()).greater_equal(x.scalar(rate as float32))
    return choose(kept, x / (1.0 - rate), x.scalar(0.0))


public def attention(query: Tensor[float32], key: Tensor[float32], value: Tensor[float32], causal: bool = false) -> Tensor[float32]:
    """Scaled dot-product attention over the last two axes: for each
    query row, the rows of `value` weighted by the softmax of the query's
    products with the rows of `key`. With `causal`, row `i` attends to
    rows `0` to `i` only."""
    shape = query.shape()
    rank = shape.len()
    mut axes = list[int64]()
    mut axis = 0
    while axis < rank:
        axes.append(axis)
        axis += 1
    axes[rank - 1] = rank - 2
    axes[rank - 2] = rank - 1
    mut scores = query.matmul(key.permute(axes)) * (1.0 / (shape[rank - 1] as float64).sqrt())
    if causal:
        rows = arange(shape[rank - 2], query.device())
        columns = arange(key.shape()[rank - 2], query.device())
        seen = rows.reshape([-1, 1]).greater_equal(columns.reshape([1, -1]))
        scores = choose(seen, scores, scores.scalar(-1.0e30))
    return scores.softmax(-1).matmul(value)


public class Attention:
    """Self-attention with several heads over a `[batch, length, width]`
    tensor."""
    public query: Linear
    public key: Linear
    public value: Linear
    public output: Linear
    public heads: int64

    public def create(width: int64, heads: int64, seed: int64, device: Device) -> Attention:
        return Attention(query=Linear.create(width, width, seed, device), key=Linear.create(width, width, seed + 2, device), value=Linear.create(width, width, seed + 4, device), output=Linear.create(width, width, seed + 6, device), heads=heads)

    def split(self, x: Tensor[float32]) -> Tensor[float32]:
        shape = x.shape()
        return x.reshape([shape[0], shape[1], self.heads, shape[2] // self.heads]).permute([0, 2, 1, 3])

    public def apply(self, x: Tensor[float32], causal: bool = false) -> Tensor[float32]:
        mixed = attention(self.split(self.query.apply(x)), self.split(self.key.apply(x)), self.split(self.value.apply(x)), causal)
        return self.output.apply(mixed.permute([0, 2, 1, 3]).reshape(x.shape()))

    public def variables(self) -> list[Variable[float32]]:
        mut all = self.query.variables()
        all.extend(self.key.variables())
        all.extend(self.value.variables())
        all.extend(self.output.variables())
        return all


public class SGD:
    """Gradient descent: each variable less `rate` times its gradient."""
    variables: list[Variable[float32]]
    public rate: float64

    public def create(variables: own list[Variable[float32]], rate: float64) -> SGD:
        return SGD(variables=variables, rate=rate)

    public def step(self, loss: Tensor[float32]) -> None:
        """Moves every variable against the gradient of `loss`. The work
        of the loss and of every update runs as one piece."""
        mut updates: list[Tensor[float32]] = [loss.clone()]
        mut at = 0
        while at < self.variables.len():
            view variable = self.variables[at]
            current = variable.value()
            updates.append(current.detach() - loss.gradient(current) * self.rate)
            at += 1
        evaluate(updates)
        at = 0
        while at < self.variables.len():
            view variable = self.variables[at]
            view update = updates[at + 1]
            variable.assign(update)
            at += 1


public class AdamW:
    """Adam with weight decay applied to the variables themselves."""
    variables: list[Variable[float32]]
    public rate: float64
    public decay: float64
    beta1: float64
    beta2: float64
    epsilon: float64
    first: list[Tensor[float32]]
    second: list[Tensor[float32]]
    power1: float64
    power2: float64

    public def create(variables: own list[Variable[float32]], rate: float64, decay: float64 = 0.01) -> AdamW:
        mut first = list[Tensor[float32]]()
        mut second = list[Tensor[float32]]()
        mut at = 0
        while at < variables.len():
            view variable = variables[at]
            current = variable.value()
            first.append(Tensor[float32].zeros(current.shape(), current.device()))
            second.append(Tensor[float32].zeros(current.shape(), current.device()))
            at += 1
        return AdamW(variables=variables, rate=rate, decay=decay, beta1=0.9, beta2=0.999, epsilon=0.00000001, first=first, second=second, power1=1.0, power2=1.0)

    public def step(mut self, loss: Tensor[float32]) -> None:
        """Moves every variable by one Adam step against the gradient of
        `loss`. The work of the loss and of every update runs as one
        piece."""
        self.power1 = self.power1 * self.beta1
        self.power2 = self.power2 * self.beta2
        count = self.variables.len()
        mut work: list[Tensor[float32]] = [loss.clone()]
        mut first = list[Tensor[float32]]()
        mut second = list[Tensor[float32]]()
        mut at = 0
        while at < count:
            view variable = self.variables[at]
            view mean = self.first[at]
            view square = self.second[at]
            current = variable.value()
            slope = loss.gradient(current)
            moved = mean * self.beta1 + slope * (1.0 - self.beta1)
            spread = square * self.beta2 + slope * slope * (1.0 - self.beta2)
            size = (spread / (1.0 - self.power2)).sqrt() + self.epsilon
            work.append(current.detach() * (1.0 - self.rate * self.decay) - moved / size * (self.rate / (1.0 - self.power1)))
            first.append(moved)
            second.append(spread)
            at += 1
        at = 0
        while at < count:
            view moved = first[at]
            view spread = second[at]
            work.append(moved.clone())
            work.append(spread.clone())
            at += 1
        evaluate(work)
        at = 0
        while at < count:
            view variable = self.variables[at]
            view update = work[at + 1]
            variable.assign(update)
            at += 1
        self.first = first
        self.second = second


def reduce(node: tensor.Node, reduction: int64, axis: int64 | None, keep: bool) -> tensor.Node:
    mut shape = tensor.__aura_shape(node)
    match axis:
        case None:
            made = tensor.__aura_reduce(node, reduction, 0, false)
            if not keep:
                return made
            mut at = 0
            while at < shape.len():
                shape[at] = 1
                at += 1
            return tensor.__aura_reshape(made, shape)
        case int64 as lane:
            made = tensor.__aura_reduce(node, reduction, lane, true)
            if not keep:
                return made
            if lane < 0:
                shape[lane + shape.len()] = 1
            else:
                shape[lane] = 1
            return tensor.__aura_reshape(made, shape)


def shifted(node: tensor.Node, axis: int64) -> tensor.Node:
    # Each lane less its largest element, which keeps `exp` from
    # overflowing. The shift is a constant: it cancels in the gradient.
    largest = tensor.__aura_node_op(reduce(node, 2, axis, true), 5, list[int64]())
    return tensor.__aura_binary(node, largest, 1)


public def concat[T](parts: list[Tensor[T]], axis: int64 = 0) -> Tensor[T]:
    """The tensors of `parts`, one after another along `axis`."""
    mut joined = tensor.__aura_share(parts[0].node)
    mut at = 1
    while at < parts.len():
        joined = tensor.__aura_pair_op(joined, parts[at].node, 0, [axis])
        at += 1
    return Tensor[T](node=joined)


public def uniform(shape: list[int64], seed: int64, device: Device) -> Tensor[float32]:
    """Random floats spread evenly from zero up to, and not including,
    one. A seed always gives the same tensor."""
    return Tensor[float32](node=tensor.__aura_filled(shape, 0, seed, 2, device.kind))


public def normal(shape: list[int64], seed: int64, device: Device) -> Tensor[float32]:
    """Random floats of the normal distribution with mean zero and
    deviation one. A seed always gives the same tensor."""
    return Tensor[float32](node=tensor.__aura_filled(shape, 1, seed, 2, device.kind))


public def arange(count: int64, device: Device) -> Tensor[int64]:
    """The integers from zero up to, and not including, `count`."""
    return Tensor[int64](node=tensor.__aura_filled([count], 2, 0, 1, device.kind))


public def cross_entropy[T](logits: Tensor[T], targets: Tensor[int64]) -> Tensor[T]:
    """The mean, over the rows of `logits`, of the negative logarithm of
    the softmax entry that the row's target names. `logits` has one row
    for each target and one column for each class."""
    shape = tensor.__aura_shape(logits.node)
    scores = logits.log_softmax(1)
    classes = tensor.__aura_filled([shape[1]], 2, 0, 1, tensor.__aura_device(logits.node))
    named = tensor.__aura_compare(classes, tensor.__aura_reshape(targets.node, [shape[0], 1]), 4)
    zero = tensor.__aura_scalar_like_f64(scores.node, 0.0)
    total = tensor.__aura_reduce(tensor.__aura_where(named, scores.node, zero), 0, 0, false)
    scale = tensor.__aura_scalar_like_f64(scores.node, -1.0 / (shape[0] as float64))
    return Tensor[T](node=tensor.__aura_binary(total, scale, 2))


public def choose[T](mask: Tensor[bool], when_true: Tensor[T], when_false: Tensor[T]) -> Tensor[T]:
    """Each element of `when_true` where `mask` holds, else of
    `when_false`. The three shapes broadcast."""
    return Tensor[T](node=tensor.__aura_where(mask.node, when_true.node, when_false.node))


public trait Operand[T]:
    """What can stand on the other side of a `Tensor[T]` in an operator or
    an elementwise member: a `Tensor[T]`, or a number, which is used as a
    tensor of one element of the tensor's dtype."""
    def operand(self, like: tensor.Node) -> tensor.Node


impl[T] Operand[T] for Tensor[T]:
    def operand(self, like: tensor.Node) -> tensor.Node:
        return tensor.__aura_share(self.node)


impl[T] Operand[T] for float64:
    def operand(self, like: tensor.Node) -> tensor.Node:
        return tensor.__aura_scalar_like_f64(like, self)


impl[T] Operand[T] for float32:
    def operand(self, like: tensor.Node) -> tensor.Node:
        return tensor.__aura_scalar_like_f64(like, self as float64)


impl[T] Operand[T] for int64:
    def operand(self, like: tensor.Node) -> tensor.Node:
        return tensor.__aura_scalar_like_i64(like, self)


impl[T] Operand[T] for int32:
    def operand(self, like: tensor.Node) -> tensor.Node:
        return tensor.__aura_scalar_like_i64(like, self as int64)


impl[T, R: Operand[T]] Add[R, Tensor[T]] for Tensor[T]:
    def add(self, rhs: R) -> Tensor[T]:
        return Tensor[T](node=tensor.__aura_binary(self.node, rhs.operand(self.node), 0))


impl[T] Add[Tensor[T], Tensor[T]] for float64:
    def add(self, rhs: Tensor[T]) -> Tensor[T]:
        return Tensor[T](node=tensor.__aura_binary(tensor.__aura_scalar_like_f64(rhs.node, self), rhs.node, 0))


impl[T] Add[Tensor[T], Tensor[T]] for int64:
    def add(self, rhs: Tensor[T]) -> Tensor[T]:
        return Tensor[T](node=tensor.__aura_binary(tensor.__aura_scalar_like_i64(rhs.node, self), rhs.node, 0))


impl[T, R: Operand[T]] Sub[R, Tensor[T]] for Tensor[T]:
    def sub(self, rhs: R) -> Tensor[T]:
        return Tensor[T](node=tensor.__aura_binary(self.node, rhs.operand(self.node), 1))


impl[T] Sub[Tensor[T], Tensor[T]] for float64:
    def sub(self, rhs: Tensor[T]) -> Tensor[T]:
        return Tensor[T](node=tensor.__aura_binary(tensor.__aura_scalar_like_f64(rhs.node, self), rhs.node, 1))


impl[T] Sub[Tensor[T], Tensor[T]] for int64:
    def sub(self, rhs: Tensor[T]) -> Tensor[T]:
        return Tensor[T](node=tensor.__aura_binary(tensor.__aura_scalar_like_i64(rhs.node, self), rhs.node, 1))


impl[T, R: Operand[T]] Mul[R, Tensor[T]] for Tensor[T]:
    def mul(self, rhs: R) -> Tensor[T]:
        return Tensor[T](node=tensor.__aura_binary(self.node, rhs.operand(self.node), 2))


impl[T] Mul[Tensor[T], Tensor[T]] for float64:
    def mul(self, rhs: Tensor[T]) -> Tensor[T]:
        return Tensor[T](node=tensor.__aura_binary(tensor.__aura_scalar_like_f64(rhs.node, self), rhs.node, 2))


impl[T] Mul[Tensor[T], Tensor[T]] for int64:
    def mul(self, rhs: Tensor[T]) -> Tensor[T]:
        return Tensor[T](node=tensor.__aura_binary(tensor.__aura_scalar_like_i64(rhs.node, self), rhs.node, 2))


impl[T, R: Operand[T]] Div[R, Tensor[T]] for Tensor[T]:
    def div(self, rhs: R) -> Tensor[T]:
        return Tensor[T](node=tensor.__aura_binary(self.node, rhs.operand(self.node), 3))


impl[T] Div[Tensor[T], Tensor[T]] for float64:
    def div(self, rhs: Tensor[T]) -> Tensor[T]:
        return Tensor[T](node=tensor.__aura_binary(tensor.__aura_scalar_like_f64(rhs.node, self), rhs.node, 3))


impl[T] Div[Tensor[T], Tensor[T]] for int64:
    def div(self, rhs: Tensor[T]) -> Tensor[T]:
        return Tensor[T](node=tensor.__aura_binary(tensor.__aura_scalar_like_i64(rhs.node, self), rhs.node, 3))


impl[T] Neg[Tensor[T]] for Tensor[T]:
    def neg(self) -> Tensor[T]:
        return Tensor[T](node=tensor.__aura_unary(self.node, 64))


public trait Elements[A, E]:
    """The members of a tensor that name its dtype: moving to and from an
    `Array`, and single elements."""
    def from_array(values: A, device: Device) -> Self
    def full(shape: list[int64], value: E, device: Device) -> Self
    def zeros(shape: list[int64], device: Device) -> Self
    def to_array(self) -> A
    def item(self) -> E
    def scalar(self, value: E) -> Self


impl Elements[Array[int32], int32] for Tensor[int32]:
    def from_array(values: Array[int32], device: Device) -> Tensor[int32]:
        return Tensor[int32](node=tensor.__aura_from_array_i32(values, device.kind))

    def full(shape: list[int64], value: int32, device: Device) -> Tensor[int32]:
        return Tensor[int32](node=tensor.__aura_full_i32(shape, value, 0, device.kind))

    def zeros(shape: list[int64], device: Device) -> Tensor[int32]:
        return Tensor[int32](node=tensor.__aura_full_i32(shape, 0, 0, device.kind))

    def to_array(self) -> Array[int32]:
        return tensor.__aura_to_array_i32(self.node)

    def item(self) -> int32:
        return tensor.__aura_item_i32(self.node)

    def scalar(self, value: int32) -> Tensor[int32]:
        return Tensor[int32](node=tensor.__aura_full_i32([1], value, 0, tensor.__aura_device(self.node)))


impl Elements[Array[int64], int64] for Tensor[int64]:
    def from_array(values: Array[int64], device: Device) -> Tensor[int64]:
        return Tensor[int64](node=tensor.__aura_from_array_i64(values, device.kind))

    def full(shape: list[int64], value: int64, device: Device) -> Tensor[int64]:
        return Tensor[int64](node=tensor.__aura_full_i64(shape, value, 1, device.kind))

    def zeros(shape: list[int64], device: Device) -> Tensor[int64]:
        return Tensor[int64](node=tensor.__aura_full_i64(shape, 0, 1, device.kind))

    def to_array(self) -> Array[int64]:
        return tensor.__aura_to_array_i64(self.node)

    def item(self) -> int64:
        return tensor.__aura_item_i64(self.node)

    def scalar(self, value: int64) -> Tensor[int64]:
        return Tensor[int64](node=tensor.__aura_full_i64([1], value, 1, tensor.__aura_device(self.node)))


impl Elements[Array[float32], float32] for Tensor[float32]:
    def from_array(values: Array[float32], device: Device) -> Tensor[float32]:
        return Tensor[float32](node=tensor.__aura_from_array_f32(values, device.kind))

    def full(shape: list[int64], value: float32, device: Device) -> Tensor[float32]:
        return Tensor[float32](node=tensor.__aura_full_f32(shape, value, 2, device.kind))

    def zeros(shape: list[int64], device: Device) -> Tensor[float32]:
        return Tensor[float32](node=tensor.__aura_full_f32(shape, 0.0, 2, device.kind))

    def to_array(self) -> Array[float32]:
        return tensor.__aura_to_array_f32(self.node)

    def item(self) -> float32:
        return tensor.__aura_item_f32(self.node)

    def scalar(self, value: float32) -> Tensor[float32]:
        return Tensor[float32](node=tensor.__aura_full_f32([1], value, 2, tensor.__aura_device(self.node)))


impl Elements[Array[float64], float64] for Tensor[float64]:
    def from_array(values: Array[float64], device: Device) -> Tensor[float64]:
        return Tensor[float64](node=tensor.__aura_from_array_f64(values, device.kind))

    def full(shape: list[int64], value: float64, device: Device) -> Tensor[float64]:
        return Tensor[float64](node=tensor.__aura_full_f64(shape, value, 3, device.kind))

    def zeros(shape: list[int64], device: Device) -> Tensor[float64]:
        return Tensor[float64](node=tensor.__aura_full_f64(shape, 0.0, 3, device.kind))

    def to_array(self) -> Array[float64]:
