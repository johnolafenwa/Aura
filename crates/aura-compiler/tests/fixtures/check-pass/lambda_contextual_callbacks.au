import control

def invoke(transform: def(int64) -> int64, value: int64) -> int64:
    return transform(value)

def main() -> int32:
    offset: int64 = 5
    identity: def(int64) -> int64 = lambda value: value
    add_offset: def(int64) -> int64 = lambda value: value + offset

    first: int64 = invoke(lambda value: value + 1, 1)
    second: int64 = identity(add_offset(first))

    mut values: Vec[int64] = [3, 1, 2]
    values.sort_by(lambda value: 0 - value)
    mapped: Vec[int64] = values.map(lambda value: value + offset)
    retained: Vec[int64] = values.filter(lambda value: value > 1)
    outcome: Result[int64, String] = control.retry(
        lambda: Result[int64, String].Ok(second),
        max_attempts=2,
        initial_backoff=0ms
    )
    return 0
