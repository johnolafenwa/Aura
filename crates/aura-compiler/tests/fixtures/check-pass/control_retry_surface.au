import control

enum RetryError:
    Temporary(str)

def int_worker() -> Result[int32, str]:
    return Result.Ok(1)

def owned_worker() -> Result[list[str], RetryError]:
    return Result.Err(RetryError.Temporary("retry"))

def accepts_worker(worker: def() -> Result[int32, str]) -> Result[int32, str]:
    return control.retry(worker)

def main() -> int32:
    inferred = control.retry(int_worker)
    explicit = control.retry[int32, str](
        worker=int_worker,
        max_attempts=4,
        initial_backoff=2ms
    )
    noncopy = control.retry[list[str], RetryError](owned_worker)
    print(inferred)
    print(explicit)
    print(noncopy)
    return 0
