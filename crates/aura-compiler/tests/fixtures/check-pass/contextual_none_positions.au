def accepts(value: int32 | None):
    pass

def no_value() -> int32 | None:
    return None

def is_empty[T](value: T | None) -> bool:
    return value == None

def main() -> int32:
    left: int32 | None = None
    accepts(None)
    left_first = left == None
    right_first = None == left
    grouped = (None) == left
    grouped_right = left == ((None))
    unequal_left = left != None
    unequal_right = None != left
    units_equal = None == None
    units_unequal = None != None
    returned: int32 | None = no_value()
    accepts(returned)
    generic = is_empty[int32](value=returned)
    return 0
