import io
import sys

def main() -> int32:
    args: list[str] = sys.args()
    home: Option[str] = sys.env("HOME")
    cwd: Result[str, io.Error] = sys.current_dir()
    wall: int64 = sys.unix_time_ms()
    monotonic: int64 = sys.monotonic_time_ms()
    print(args.len())
    print(home)
    print(cwd)
    print(wall)
    print(monotonic)
    return 0
