def main():
    numbers: list[int32] = [1, 2, 3]
    names = ["a", "b"]
    selected: list[int32] = [value * 2 for value in numbers if value > 0]
    unique: set[int32] = {value for value in numbers}
    source_set = {1, 2, 3}
    from_set: list[int64] = [value for value in source_set]
    lookup: dict[int64, str] = {index: name.clone() for index, name in enumerate(names)}
    pairs: list[int32] = [left + right for left, right in zip(numbers, numbers)]
    nested: list[int64] = [
        outer * 10 + inner
        for outer in range(0, 2)
        if outer >= 0
        for inner in range(0, outer)
    ]
    copies: list[str] = [name.clone() for name in names]
    jobs = Queue[str]()
    received: list[str] = [job for job in jobs]
