def bounded(value: int32, low: int32, high: int32) -> bool:
    return low <= value < high

def main():
    mut values = Vec[int32]()
    values.push(1)
    mut names = Set[String]()
    names.insert("aura")
    mut ages = Map[String, int32]()
    ages.set("ada", 36)
    text = "hello world"

    print(1 in values)
    print(2 not in values)
    print("aura" in names)
    print("ada" in ages)
    print("world" in text)
    print(bounded(2, 1, 5))
    print(1 == 1 == 1)
