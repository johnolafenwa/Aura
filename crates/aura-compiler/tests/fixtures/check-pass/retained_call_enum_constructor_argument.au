enum Wrapped[T]:
    Value(T)

def main():
    mut options: list[Option[int32]] = []
    options.append(Option.Some(1))
    options.append(Option.None)

    mut results: list[Result[int32, str]] = []
    results.append(Result.Ok(2))

    mut wrapped: list[Wrapped[int32]] = []
    wrapped.append(Wrapped[int32].Value(3))
