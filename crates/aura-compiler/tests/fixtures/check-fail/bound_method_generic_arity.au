trait Scale:
    def factor(self) -> int64

class Twice:
    pass

impl Scale for Twice:
    def factor(self) -> int64:
        return 2

class Counter:
    total: int64

    def scaled[S: Scale](self, scale: S) -> int64:
        return self.total * scale.factor()

def main():
    counter = Counter(total=3)
    scaled = counter.scaled[Twice, Twice]
    print(scaled(Twice()))
