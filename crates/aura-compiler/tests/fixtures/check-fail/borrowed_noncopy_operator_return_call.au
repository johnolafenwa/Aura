trait Add[Rhs, Out]:
    def add(self, rhs: Rhs) -> Out

class Label:
    value: str

impl Add[Label, str] for Label:
    def add(self, rhs: Label) -> str:
        return self.value

def main():
    left = Label(value="left")
    right = Label(value="right")
    alias = left + right
    print(alias)
