trait Add[Rhs, Out]:
    def add(self, rhs: own Rhs) -> Out

class Token:
    value: str

impl Add[Token, Token] for Token:
    def add(self, rhs: own Token) -> Token:
        return Token(value=self.value + rhs.value)

def main():
    left = Token(value="left")
    right = Token(value="right")
    combined = left + right
    print(combined.value)
    print(right.value)
