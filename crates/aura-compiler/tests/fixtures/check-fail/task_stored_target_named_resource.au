import random

type Job = TaskCallable[def(first: int64 = ..., *, resource: own random.Rng) -> int64]

def worker(first: int64 = 1, *, resource: own random.Rng) -> int64:
    return first

def main():
    target = Job(worker)
    with group = TaskGroup():
        task = group.start(target, resource=random.Rng(seed=42))
        print(task.result_or(-1, timeout=1s))
