trait Job: Transfer:
    def run(self) -> int64

class Sum:
    values: list[int64]

impl Job for Sum:
    def run(self) -> int64:
        return len(self.values)

trait Plain:
    def run(self) -> int64

impl Plain for Sum:
    def run(self) -> int64:
        return 0

def main() -> None:
    queue = Queue[dyn Plain]()
