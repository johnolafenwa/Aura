class Cell:
    count: int64

class Pair:
    first: Cell
    second: Cell

def second_of(pair: mut Pair) -> view mut Cell from pair:
    return view mut pair.second

def main():
    pair = Pair(first=Cell(count=1), second=Cell(count=2))
    picker: def(pair: mut Pair) -> view mut Cell from pair = second_of
    view mut chosen = picker(pair)
    chosen.count = 5
    print(pair.second.count)
