class Inner:
    name: str

    def __exit__(mut self) -> None:
        print("inner exit " + self.name)

class Tracer:
    name: str

    def __exit__(mut self) -> None:
        print("exit " + self.name)
        with inner = Inner(name=self.name.clone()):
            mut names: list[str] = []
            for index in range(3):
                names.append(f"{self.name}{index}")
            print(len(names))
            print(names[9])

def work(items: list[int64]) -> int64:
    with first = Tracer(name="first"), second = Tracer(name="second"):
        return items[4]

def main():
    print(work([1]))
