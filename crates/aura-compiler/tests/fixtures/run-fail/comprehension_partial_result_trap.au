class Resource:
    name: String

    def close(mut self):
        print("close " + self.name)

def build_value(index: int64) -> String:
    print(f"build {index}")
    if index == 2:
        empty: Vec[int64] = []
        impossible = empty[0]
        return f"value-{impossible}"
    return f"value-{index}"

def main():
    with resource = Resource(name="outer"):
        result: Vec[String] = [
            build_value(index)
            for index in [1, 2, 3]
        ]
        print(result)
