class Tracer:
    name: str

    def __exit__(mut self) -> None:
        print("exit " + self.name)
        assert false, "exit of " + self.name + " failed"

def grow(value: int64, step: int64) -> int64:
    with tracer = Tracer(name="tracer"):
        return value + step

def main():
    print(grow(9223372036854775807, 1))
