import mem

extern "C" class Counter:
    count: int64

def write_raw(address: uint64) -> None:
    mem.write_int64(address, 5)

def relay(address: uint64) -> None:
    write_raw(address)

def use_cell() -> None:
    mut cell = Counter(count=0)
    p = mem.address_of(cell.count)
    relay(p as uint64)
    assert cell.count == 0

def untouched(value: int64) -> int64:
    ensures result == value
    return value
