def produce_numbers(out: Queue[int32]) -> int32:
    out.put(2)
    out.put(4)
    out.close()
    return 6

def double(value: int32) -> int32:
    return value * 2

def main() -> int32:
    jobs = Queue[int32]()
    with TaskGroup() as group:
        task = group.start(produce_numbers, jobs)

        while true:
            match jobs.get():
                case QueueReceive.Item(value):
                    print(value)
                case QueueReceive.Closed:
                    break
                case QueueReceive.TimedOut:
                    pass
                case QueueReceive.Cancelled:
                    break

        match task.result():
            case TaskResult.Ready(total):
                print(total)
            case TaskResult.Error(_message):
                return 1
            case TaskResult.Cancelled:
                return 1
            case TaskResult.TimedOut:
                return 1

        other = group.start(double, 5)
        match other.result():
            case TaskResult.Ready(value):
                print(value)
            case TaskResult.Error(_message):
                return 1
            case TaskResult.Cancelled:
                return 1
            case TaskResult.TimedOut:
                return 1

    return 0
