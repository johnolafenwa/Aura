type ValuePrinter = def(int64 | str) -> None

def show(value: int64 | str):
    match value:
        case int64 as number:
            print(number)
        case str as text:
            print(text)
def main():
    handlers: list[def(int64 | str) -> None] = [ValuePrinter(show)]
    match handlers.get(0):
        case Lookup.Found(handler):
            handler(41)
            handler("text")
        case Lookup.Missing:
            print("none")
