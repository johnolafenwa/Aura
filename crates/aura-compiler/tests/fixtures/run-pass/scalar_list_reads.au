def main():
    ints: list[int64] = [3, -4, 5]
    floats: list[float64] = [1.5, -2.25]
    flags: list[bool] = [true, false, true]
    mut total = 0
    for value in ints:
        total += value
    mut sum = 0.0
    for value in floats:
        sum += value
    mut on = 0
    for flag in flags:
        if flag:
            on += 1
    print(f"{total} {sum} {on}")
    print(f"{ints[0]} {ints[-1]} {floats[1]} {flags[1]}")
    mut i = 0
    mut weighted = 0
    while i < ints.len():
        weighted += ints[i] * (i + 1)
        i += 1
    print(weighted)
