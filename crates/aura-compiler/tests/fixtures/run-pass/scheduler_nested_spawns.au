def child(events: Queue[str], label: own str, value: int32) -> int32:
    events.put(label)
    return value

def cleanup_after_release(events: Queue[str], release: Queue[int32]) -> None:
    match release.get():
        case QueueReceive.Item(_):
            events.put("cleanup")
        case QueueReceive.Closed:
            events.put("cleanup-closed")
        case QueueReceive.TimedOut:
            events.put("cleanup-timed-out")
        case QueueReceive.Cancelled:
            events.put("cleanup-cancelled")

def nested_parent(events: Queue[str]) -> int32:
    events.put("parent-start")
    release = Queue[int32]()
    mut total: int32 = 0

    with TaskGroup() as children:
        first = children.start_with_stack(262144, child, events, "child-first", 11)
        second = children.start(child, events, "child-second", 22)
        children.start_soon(cleanup_after_release, events, release)

        events.put("parent-wait")
        match first.result(timeout=2s):
            case TaskResult.Ready(value):
                total += value
                events.put("parent-after-first")
            case TaskResult.Error(_):
                return -1
            case TaskResult.TimedOut:
                return -2
            case TaskResult.Cancelled:
                return -3

        match second.result(timeout=2s):
            case TaskResult.Ready(value):
                total += value
                events.put("parent-after-second")
            case TaskResult.Error(_):
                return -4
            case TaskResult.TimedOut:
                return -5
            case TaskResult.Cancelled:
                return -6

        release.put(1)
        events.put("parent-leaving-scope")

    events.put("parent-joined")
    return total

def next_event(events: Queue[str]) -> str:
    match events.get(timeout=2s):
        case QueueReceive.Item(event):
            return event.clone()
        case QueueReceive.Closed:
            return "event-closed"
        case QueueReceive.TimedOut:
            return "event-timed-out"
        case QueueReceive.Cancelled:
            return "event-cancelled"

def event_code(event: str) -> int32:
    if event == "parent-start":
        return 2
    if event == "parent-wait":
        return 3
    if event == "child-first":
        return 5
    if event == "child-second":
        return 7
    if event == "parent-after-first":
        return 11
    if event == "parent-after-second":
        return 13
    if event == "parent-leaving-scope":
        return 17
    if event == "cleanup":
        return 19
    if event == "parent-joined":
        return 23
    return 0

def main() -> int32:
    events = Queue[str]()
    mut total: int32 = 0

    with TaskGroup() as parents:
        parent = parents.start(nested_parent, events)
        match parent.result(timeout=2s):
            case TaskResult.Ready(value):
                total = value
            case TaskResult.Error(_):
                return 1
            case TaskResult.TimedOut:
                return 2
            case TaskResult.Cancelled:
                return 3

    mut event_sum: int32 = 0
    mut event_product: int32 = 1
    mut saw_child_first = false
    mut saw_child_second = false
    mut saw_parent_leaving_scope = false
    mut saw_cleanup = false
    for _ in range(9):
        event = next_event(events)
        if event == "child-first":
            saw_child_first = true
        if event == "child-second":
            saw_child_second = true
        if event == "parent-after-first":
            assert saw_child_first
        if event == "parent-after-second":
            assert saw_child_second
        if event == "parent-leaving-scope":
            saw_parent_leaving_scope = true
        if event == "cleanup":
            saw_cleanup = true
        if event == "parent-joined":
            assert saw_parent_leaving_scope
            assert saw_cleanup

        code = event_code(event)
        event_sum += code
        event_product *= code
    assert event_sum == 100
    assert event_product == 223092870

    print("parent-start")
    print("parent-wait")
    print("child-first")
    print("child-second")
    print("parent-after-first")
    print("parent-after-second")
    print("parent-leaving-scope")
    print("cleanup")
    print("parent-joined")
    print(total)
    return 0
