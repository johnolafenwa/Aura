# A call in an `if`, `elif`, or `while` condition, or a `match` scrutinee,
# that borrows a list element ends its loan once it has its result, so the
# body may write that element.
enum Cell:
    Int(value: int64)
    Text(value: str)


def positive(row: list[Cell]) -> bool:
    match row[0]:
        case Cell.Int(v):
            return v > 0
        case Cell.Text(_):
            return false


def first_int(row: list[Cell]) -> int64:
    match row[0]:
        case Cell.Int(v):
            return v
        case Cell.Text(_):
            return 0


def label(row: list[Cell]) -> Result[str, str]:
    match row[1]:
        case Cell.Text(s):
            return Result.Ok(s.clone())
        case Cell.Int(_):
            return Result.Err("not text")


class Table:
    rows: list[list[Cell]]

    def update(mut self, slots: list[int64]) -> int64:
        mut updated = 0
        for slot in slots:
            if positive(self.rows[slot]):
                scaled = first_int(self.rows[slot]) * 10
                self.rows[slot][1] = Cell.Int(value=scaled)
                updated += 1
        return updated


def counts(row: list[int64]) -> int64:
    return row[0]


def main() -> int32:
    mut table = Table(rows=[[Cell.Int(value=4), Cell.Text(value="a")], [Cell.Int(value=0), Cell.Text(value="b")]])
    print(table.update([0, 1]))
    print(first_int(table.rows[0]) + (match table.rows[0][1]:
        case Cell.Int(v): v
        case Cell.Text(_): -1))

    mut grid = [[3, 0], [0, 2]]
    slot = 1
    if counts(grid[slot]) > 0:
        grid[slot][0] = -1
    elif counts(grid[slot]) == 0 or grid[slot][1] == 2:
        grid[slot][1] = 20
    print(grid[1][1])

    slot2 = 0
    while counts(grid[slot2]) > 0:
        grid[slot2][0] -= 1
        grid[slot2][1] += 1
    print(grid[0][1])

    match counts(grid[1]):
        case 0:
            grid[1][0] = 5
        case _:
            grid[1][0] = 9
    print(grid[1][0])

    match label(table.rows[1]):
        case Result.Ok(text):
            table.rows[1][1] = Cell.Text(value=text + "!")
        case Result.Err(_):
            table.rows[1][1] = Cell.Text(value="?")
    match table.rows[1][1]:
        case Cell.Text(text):
            print(text)
        case Cell.Int(_):
            print("int")

    mut cube = [[[1, 2], [0, 0]]]
    if counts(cube[0][0]) == 1:
        cube[0][0][1] = 7
    print(cube[0][0][1])
    return 0
