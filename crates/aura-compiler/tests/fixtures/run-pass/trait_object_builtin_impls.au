trait Shape:
    def area(self) -> int64
    def name(self) -> str
    def grow(mut self, by: int64) -> None
    def describe(self) -> str:
        return f"{self.name()} of area {self.area()}"


class Square:
    side: int64


class Rect:
    w: int64
    h: int64


class Label:
    text: str
    hits: list[int64]


impl Shape for Square:
    def area(self) -> int64:
        return self.side * self.side
    def name(self) -> str:
        return "square"
    def grow(mut self, by: int64) -> None:
        self.side += by


impl Shape for Rect:
    def area(self) -> int64:
        return self.w * self.h
    def name(self) -> str:
        return "rect"
    def grow(mut self, by: int64) -> None:
        self.w += by
        self.h += by


impl Shape for Label:
    def area(self) -> int64:
        return len(self.text) + len(self.hits)
    def name(self) -> str:
        return self.text.clone()
    def grow(mut self, by: int64) -> None:
        self.hits.append(by)
    def describe(self) -> str:
        return f"label {self.text}"


impl Shape for int64:
    def area(self) -> int64:
        return self
    def name(self) -> str:
        return "int"
    def grow(mut self, by: int64) -> None:
        self += by


impl Shape for str:
    def area(self) -> int64:
        return len(self)
    def name(self) -> str:
        return "str"
    def grow(mut self, by: int64) -> None:
        pass


def main() -> None:
    mut shapes: list[dyn Shape] = [5, "hello", Square(side=2)]
    for shape in mut shapes:
        shape.grow(1)
    for shape in shapes:
        print(shape.describe())
