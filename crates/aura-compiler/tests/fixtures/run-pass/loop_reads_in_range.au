def total(values: Span[int64]) -> int64:
    mut sum = 0
    for value in values:
        sum += value
    return sum


def main():
    numbers: list[int64] = [3, -4, 9223372036854775807, -9223372036854775808, 5]
    mut wrapped = 0
    for number in numbers:
        wrapped = wrapped.wrapping_add(number)
    print(wrapped)

    mut skipped = 0
    for number in numbers:
        if number < 0:
            continue
        if number > 100:
            break
        skipped += number
    print(skipped)

    mut pairs = 0
    for left in numbers[0:2]:
        for right in numbers[3:]:
            pairs += left.wrapping_mul(right) % 7
    print(pairs)
    print(total(numbers[0:2]))
    print(total(numbers[4:]))

    empty: list[int64] = []
    for number in empty:
        print(number)

    ratios: list[float64] = [0.5, 1.25, -2.0]
    mut ratio_sum = 0.0
    for ratio in ratios:
        ratio_sum += ratio
    print(ratio_sum)

    flags = [true, false, true, true]
    mut set_flags = 0
    for flag in flags:
        if flag:
            set_flags += 1
    print(set_flags)

    names = ["ada", "grace", "edsger"]
    mut letters = 0
    for name in names:
        letters += name.len()
    print(letters)

    points = [(1, 2), (3, 4)]
    mut coordinate_sum = 0
    for x, y in points:
        coordinate_sum += x * 10 + y
    print(coordinate_sum)

    narrow = Array[int32].from_list([7, -8, 9], [3])
    print(narrow[0] + narrow[-1])
    print(narrow[1])
    wide = Array[int64].full([4], 9223372036854775807)
    print(wide[3])
    halves = Array[float32].from_list([0.5, 1.5], [2])
    print(halves[1])
    doubles = Array[float64].from_list([0.25, 2.5, 4.0], [3])
    mut index = 0
    mut double_sum = 0.0
    while index < doubles.len():
        double_sum += doubles[index]
        index += 1
    print(double_sum)
    grid = Array[int64].from_list([1, 2, 3, 4, 5, 6], [2, 3])
    print(grid[1, 2])
    mut grown = Array[int64].zeros([2])
    grown[1] = 42
    print(grown[1])
