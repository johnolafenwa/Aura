import bytes

def consume_length(payload: own list[uint8]) -> int32:
    return payload.len() as int32

def pair(decoded: own Result[str, bytes.Error], measured: int32) -> int32:
    match own decoded:
        case Result.Ok(text):
            print(text)
        case Result.Err(error):
            print(error)
    return measured

def main():
    reusable: list[uint8] = [65, 66]
    decoded = str.from_bytes(reusable)
    print(reusable.len())
    match own decoded:
        case Result.Ok(text):
            print(text)
        case Result.Err(error):
            print(error)

    nested: list[uint8] = [65, 117, 114, 97]
    print(pair(str.from_bytes(nested), consume_length(nested)))
