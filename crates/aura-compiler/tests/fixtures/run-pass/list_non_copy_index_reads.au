def main() -> int32:
    names = ["Ada", "Grace"]
    match names.get(0):
        case Lookup.Found(value):
            print(value)
        case Lookup.Missing:
            pass
    match names.get(1):
        case Lookup.Found(value):
            print(value)
        case Lookup.Missing:
            pass

    grids = [[1, 2], [3, 4]]
    match grids.get(0):
        case Lookup.Found(row):
            print(row[1])
        case Lookup.Missing:
            pass
    match grids.get(1):
        case Lookup.Found(row):
            print(row[0])
        case Lookup.Missing:
            pass
    return 0
