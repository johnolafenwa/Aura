trait Counter:
    def bump(mut self) -> None

class Tally:
    count: int64

impl Counter for Tally:
    def bump(mut self) -> None:
        self.count += 1

def advance[T: Counter](item: mut T):
    item.bump()

def main():
    mut tally = Tally(count=0)
    advance(tally)
    advance(tally)
    print(tally.count)
