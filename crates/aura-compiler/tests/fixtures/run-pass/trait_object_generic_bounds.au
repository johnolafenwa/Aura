trait Shape:
    def area(self) -> int64
    def name(self) -> str
    def grow(mut self, by: int64) -> None
    def describe(self) -> str:
        return f"{self.name()} of area {self.area()}"


class Square:
    side: int64


class Rect:
    w: int64
    h: int64


class Label:
    text: str
    hits: list[int64]


impl Shape for Square:
    def area(self) -> int64:
        return self.side * self.side
    def name(self) -> str:
        return "square"
    def grow(mut self, by: int64) -> None:
        self.side += by


impl Shape for Rect:
    def area(self) -> int64:
        return self.w * self.h
    def name(self) -> str:
        return "rect"
    def grow(mut self, by: int64) -> None:
        self.w += by
        self.h += by


impl Shape for Label:
    def area(self) -> int64:
        return len(self.text) + len(self.hits)
    def name(self) -> str:
        return self.text.clone()
    def grow(mut self, by: int64) -> None:
        self.hits.append(by)
    def describe(self) -> str:
        return f"label {self.text}"


class Box[T]:
    value: T

    def take(own self) -> T:
        return self.value


def last[T](items: own list[T]) -> T:
    mut held = items
    return held.pop()


def area_sum[T: Shape](items: list[T]) -> int64:
    mut sum = 0
    for item in items:
        sum += item.area()
    return sum


def area_of[T: Shape](item: T) -> int64:
    return item.area()


def main() -> None:
    box = Box[dyn Shape](value=Square(side=3))
    print(box.value.area())
    print(box.take().describe())
    shapes: list[dyn Shape] = [Rect(w=3, h=3), Square(side=1)]
    print(area_sum(shapes))
    print(area_of(shapes[1]))
    print(last(shapes).describe())
    held: list[dyn Shape] = [Square(side=7)]
    add: def(int64) -> int64 = lambda extra: area_sum(held) + extra
    print(add(1))
