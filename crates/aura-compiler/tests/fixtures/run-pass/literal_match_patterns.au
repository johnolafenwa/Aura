def describe_number(value: int32) -> str:
    match own value:
        case 0:
            return "zero"
        case 1:
            return "one"
        case _:
            return "many"

def describe_flag(flag: bool) -> str:
    match own flag:
        case true:
            return "yes"
        case false:
            return "no"

def describe_name(name: str) -> str:
    match name:
        case "aura":
            return "repo"
        case _:
            return "other"

def describe_negative(value: int32) -> str:
    match own value:
        case -1:
            return "negative"
        case _:
            return "other"

def main() -> int32:
    print(describe_number(0))
    print(describe_number(4))
    print(describe_flag(true))
    print(describe_flag(false))
    print(describe_name("aura"))
    print(describe_name("codex"))
    print(describe_negative(-1))
    return 0
