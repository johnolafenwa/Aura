trait From[T]:
    def from(value: own T) -> Self

enum ReadError:
    Missing(str)

enum AppError:
    Read(ReadError)

impl From[ReadError] for AppError:
    def from(value: own ReadError) -> AppError:
        return AppError.Read(value)

def read(available: bool) -> Result[str, ReadError]:
    if available:
        return Result.Ok("payload")
    return Result.Err(ReadError.Missing("missing.au"))

def load(available: bool) -> Result[str, AppError]:
    value = try read(available)
    return Result.Ok(value)

def main() -> int32:
    print(load(true))
    print(load(false))
    return 0
