def total(values: list[int64]) -> int64:
    mut sum = 0
    for value in values:
        sum += value
    return sum


def mean(values: list[float64]) -> float64:
    mut sum = 0.0
    for value in values:
        sum += value
    return sum / (values.len() as float64)


def count_true(flags: list[bool]) -> int64:
    mut count = 0
    for flag in flags:
        if flag:
            count += 1
    return count


def main():
    mut values: list[int64] = [3, -4, 9223372036854775807, -9223372036854775808]
    print(values[0] + values[1])
    print(values[2])
