trait Shape:
    def area(self) -> int64
    def name(self) -> str
    def grow(mut self, by: int64) -> None
    def describe(self) -> str:
        return f"{self.name()} of area {self.area()}"


class Square:
    side: int64


class Rect:
    w: int64
    h: int64


class Label:
    text: str
    hits: list[int64]


impl Shape for Square:
    def area(self) -> int64:
        return self.side * self.side
    def name(self) -> str:
        return "square"
    def grow(mut self, by: int64) -> None:
        self.side += by


impl Shape for Rect:
    def area(self) -> int64:
        return self.w * self.h
    def name(self) -> str:
        return "rect"
    def grow(mut self, by: int64) -> None:
        self.w += by
        self.h += by


impl Shape for Label:
    def area(self) -> int64:
        return len(self.text) + len(self.hits)
    def name(self) -> str:
        return self.text.clone()
    def grow(mut self, by: int64) -> None:
        self.hits.append(by)
    def describe(self) -> str:
        return f"label {self.text}"


enum Slot:
    Empty
    Full(shape: dyn Shape)


def main() -> None:
    mut by_name: dict[str, dyn Shape] = {}
    by_name["s"] = Square(side=4)
    by_name["l"] = Label(text="lab", hits=[1, 2, 3])
    print(by_name["s"].area())
    print(by_name["l"].describe())
    pair: (dyn Shape, int64) = (Rect(w=2, h=2), 7)
    (held, extra) = pair
    print(held.area() + extra)
    slot = Slot.Full(shape=Square(side=5))
    match slot:
        case Slot.Full(shape):
            print(shape.area())
        case Slot.Empty:
            print("empty")
    maybe: dyn Shape | None = Square(side=6)
    if maybe is not None:
        print(maybe.area())
    nothing: dyn Shape | None = None
    print(nothing is None)
    nested: list[list[dyn Shape]] = [
        [Square(side=1)],
        [Rect(w=1, h=2), Label(text="x", hits=[])],
    ]
    mut count = 0
    for row in nested:
        for shape in row:
            count += shape.area()
    print(count)
