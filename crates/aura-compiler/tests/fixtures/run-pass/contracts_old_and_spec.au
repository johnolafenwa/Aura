spec def is_sorted(xs: list[int64]) -> bool:
    """Each element is at most the next."""
    return forall(i in range(len(xs) - 1), xs[i] <= xs[i + 1])


spec def count_of(xs: list[int64], x: int64) -> int64:
    return len([y for y in xs if y == x])


def insert_sorted(xs: mut list[int64], x: int64):
    requires is_sorted(xs)
    ensures is_sorted(xs)
    ensures len(xs) == len(old(xs)) + 1
    ensures count_of(xs, x) == count_of(old(xs), x) + 1
    ensures exists(y in xs, y == x)
    mut i = len(xs)
    xs.append(x)
    while i > 0 and xs[i - 1] > x:
        invariant 0 <= i and i < len(xs)
        decreases i
        previous = xs[i - 1]
        xs[i] = previous
        i -= 1
    xs[i] = x


class Counter:
    n: int64

    def bump(mut self) -> int64:
        ensures self.n == old(self.n) + 1 and result == self.n
        self.n += 1
        return self.n


def shout(s: str) -> str:
    ensures len(result) == len(old(s)) + 1
    return s + "!"


def main():
    mut xs = [1, 3, 5]
    insert_sorted(xs, 4)
    insert_sorted(xs, 0)
    print(xs)
    mut c = Counter(n=41)
    print(c.bump())
    print(shout("hi"))
