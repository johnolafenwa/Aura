trait Values:
    def initial() -> int64
    def add(self, n: int64, *, bonus: int64) -> int64
    def identity[T](self, value: own T) -> T
    def label(self) -> str:
        return "trait"

class Engine:
    pass

impl Values for Engine:
    def initial() -> int64:
        return 4

    def add(self, n: int64, *, bonus: int64) -> int64:
        return n + bonus

    def identity[T](self, value: own T) -> T:
        return value

    def label(self) -> str:
        return "engine"

class Car:
    engine: Engine

impl Values for Car by engine

def main():
    car = Car(engine=Engine())
    print(Car.initial())
    print(car.add(3, bonus=5))
    print(car.identity[str]("ok"))
    print(car.label())
