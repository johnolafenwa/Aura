trait Named:
    def name(self) -> str

class Ticket:
    label: str
    def __drop__(mut self):
        print("drop " + self.label)

impl Named for Ticket:
    def name(self) -> str:
        return self.label.clone()

def main():
    item: dyn Named = Ticket("object")
    print(item.name())
    print("end scope")
