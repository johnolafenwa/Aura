def one(value: int64 = 1) -> int64:
    return value + 1

def two(value: int64) -> int64:
    return value + 2

def main():
    slot: (def(value: int64 = ...) -> int64) | None = one
    match slot:
        case def(value: int64 = ...) -> int64 as chosen:
            print(chosen())
        case None:
            print("none")
    plain: (def(value: int64) -> int64) | None = two
    match plain:
        case def(value: int64) -> int64 as chosen:
            print(chosen(1))
        case None:
            print("none")
    empty: (def(value: int64) -> int64) | None = None
    print(empty is None)
