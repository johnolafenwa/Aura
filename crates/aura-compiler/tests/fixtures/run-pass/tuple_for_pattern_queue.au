def main():
    rows: list[(str, int64)] = [("left", 1), ("right", 2)]
    for label, value in own rows:
        print(f"{label}:{value}")

    match (2, ("go", true)):
        case (1, _):
            print("wrong")
        case (2, (command, true)):
            print(f"case {command}")
        case _:
            print("wrong")

    jobs = Queue[(int64, str)]()
    jobs.put((3, "queue"))
    jobs.close()
    for label, value in jobs:
        print(f"{label}:{value}")
