type Fn[A, R] = Callable[def(args: A) -> R]


class Counter:
    total: int64

    def bump(mut self) -> int64:
        self.total = self.total + 1
        return self.total


class Button:
    label: str
    on_click: Callable[def() -> str]


def double(value: int64) -> int64:
    return value * 2


def make_adder(n: int64) -> Callable[def(value: int64) -> int64]:
    return lambda value: value + n


def make_bumper() -> Callable[mut def() -> int64]:
    counter = Counter(total=0)
    return lambda [own counter]: counter.bump()


def apply(f: Callable[def(value: int64) -> int64], x: int64) -> int64:
    return f(x)


def pick(flag: bool, n: int64) -> Callable[def(value: int64) -> int64]:
    return (lambda value: value + n) if flag else (lambda value: value - n)


def first_part():
    add5 = make_adder(5)
    print(add5(1))
    mut bumper = make_bumper()
    print(bumper())
    print(bumper())
    name = "ok"
    button = Button(label="b", on_click=lambda: name.clone())
    print(button.on_click())
    k = 10
    fs: list[Callable[def(value: int64) -> int64]] = [
        lambda value: value + k,
        lambda value: value * k,
        double,
    ]
    for f in fs:
        print(f(3))
    print(apply(lambda value: value + k, 1))
    print(apply(double, 4))
    mut table: dict[str, Callable[def(value: int64) -> int64]] = {}
    table["add"] = lambda value: value + k
    table["dbl"] = double
    print(table["add"](1))
    print(table["dbl"](8))
    g: Callable[def(value: int64) -> int64] = lambda value: value - k
    print(g(1))
    h = lambda: k + 1
    stored: Callable[def() -> int64] = h
    print(stored())
    mut handlers: list[Callable[def() -> int64]] = []
    for i in range(3):
        handlers.append(lambda: i * i)
    for handler in handlers:
        print(handler())
    print(pick(true, 2)(10))
    print(pick(false, 2)(10))
    counter = Counter(total=40)
    mut bound: Callable[mut def() -> int64] = counter.bump
    print(bound())


class Holder:
    action: Callable[def() -> int64] | None
    step: Callable[mut def() -> int64]


def compose[A, B, C](first: own Fn[A, B], second: own Fn[B, C]) -> Fn[A, C]:
    return lambda [own first, own second] args: second(first(args))


def run_twice(f: mut Callable[mut def() -> int64]) -> int64:
    f()
    return f()


def run_once(f: own Callable[own def() -> str]) -> str:
    return f()


def maybe(flag: bool, n: int64) -> Callable[def() -> int64] | None:
    if flag:
        return lambda: n
    return None


def choose(kind: int64, n: int64) -> Callable[def(value: int64) -> int64]:
    return match kind:
        case 0: lambda value: value + n
        case 1: lambda value: value * n
        case _: lambda value: value


def second_part():
    both = compose[int64, int64, str](lambda args: args * 2, lambda args: f"<{args}>")
    print(both(21))
    mut count = 0
    mut step: Callable[mut def() -> int64] = lambda: count + 1
    print(run_twice(step))
    text = "done"
    print(run_once(lambda [own text]: text))
    mut holder = Holder(action=None, step=lambda: 7)
    holder.action = lambda: count + 5
    match holder.action:
        case None:
            print("none")
        case _:
            print("some")
    print(holder.step())
    squares: list[Callable[def() -> int64]] = [lambda: i * i for i in range(4)]
    for square in squares:
        print(square())
    pair: (Callable[def() -> int64], int64) = (lambda: count, 2)
    (first, _) = pair
    print(first())
    print(choose(0, 5)(1))
    print(choose(1, 5)(2))
    print(choose(2, 5)(3))
    match maybe(true, 9):
        case None:
            print("none")
        case _:
            print("got")


def main():
    first_part()
    second_part()
