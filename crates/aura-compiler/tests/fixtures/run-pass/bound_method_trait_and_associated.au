trait Named:
    def name(self) -> str

class Dog:
    tag: str

impl Named for Dog:
    def name(self) -> str:
        return self.tag.clone()

class Math:
    def double(value: int64) -> int64:
        return value * 2

def apply(step: def(value: int64) -> int64, value: int64) -> int64:
    return step(value)

def main():
    dog = Dog(tag="rex")
    name = dog.name
    print(name())
    doubler = Math.double
    print(doubler(21))
    print(apply(Math.double, 4))
