def identity[T](value: own T) -> T:
    return value

trait Show:
    def show(self) -> String

impl Show for int32:
    def show(self) -> String:
        return "int32"

impl Show for int64:
    def show(self) -> String:
        return "int64"

def contextual[T: Show](value: own T) -> T:
    print(value.show())
    return value

def print_int32(value: int32):
    print(value)

def print_first(values: Vec[int32]):
    print(values[0])

def print_optional(value: Option[int32]):
    match own value:
        case Option.Some(inner):
            print(inner)
        case Option.None:
            print(0)

def main() -> int32:
    positive: int32 = 2147483647
    negative: int32 = -2147483648
    collection: Vec[int32] = [3, 4]
    generic: int32 = identity(value=5)
    visible_generic: int32 = contextual(value=7)
    optional: Option[int32] = Option.Some(6)

    print_int32(positive)
    print_int32(negative)
    print_first(collection)
    print_int32(generic)
    print_int32(visible_generic)
    print_optional(optional)
    return 0
