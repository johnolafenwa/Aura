class Grid:
    rows: list[list[int64]]

def rows_of(g: Grid) -> view list[list[int64]] from g:
    return view g.rows

def total(part: Span[int64]) -> int64:
    mut sum = 0
    for x in part:
        sum += x
    return sum

def main():
    g = Grid(rows=[[1, 2, 3], [4, 5, 6]])
    print(total(rows_of(g)[0][1:]))
    print(total(rows_of(g)[1]))
    i = 1
    print(total(rows_of(g)[i][:2]))
    view rows = rows_of(g)
    view first = rows[0]
    print(first)
