def classify(value: int64 | None, other: int64 | None) -> int64:
    if value is None:
        return 0
    elif other is None:
        return value
    else:
        return value + other

def label(value: str | None) -> int64:
    return value.len() if value is not None else 0 - 1

def main():
    print(classify(None, None))
    print(classify(3, None))
    print(classify(3, 4))
    mut current: int64 | None = 5
    doubled = current * 2 if current is not None else 0
    print(doubled)
    print(current is None)
    current = None
    print(current is None)
    print(current is not None)
    print(label("aura"))
    print(label(None))
    print(classify(3, 4) if current is None else 0)
