def main():
    items = [3, 1, 4, 1, 5, 9, 2, 6]
    view window = items[2:6]
    print(4 in window)
    print(3 in window)
    print(window.index(1))
    print(window.count(1))
    print(window == [4, 1, 5, 9])
    view other = items[2:6]
    print(window == other)
    print(window.to_list())
    print(window[1:3])
    view inner = window[1:]
    print(inner.to_list())
    print(len(inner))
    names = ["ada", "lin", "bo"]
    view some = names[1:]
    for name in some:
        print(name)
    print(len(some[0]))
