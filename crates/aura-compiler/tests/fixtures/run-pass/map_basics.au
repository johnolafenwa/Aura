def print_bool(value: bool):
    match own value:
        case true:
            print("true")
        case false:
            print("false")

def print_int_option(value: Option[int32]):
    match own value:
        case Some(inner):
            print(inner)
        case None:
            print(-1)

def main() -> int32:
    mut counts: Map[String, int32] = {}
    print_bool(counts.is_empty())
    counts["aura"] = 1
    counts["agents"] = 2
    print(counts["aura"])
    print_int_option(counts.get("agents"))
    print_bool(counts.contains_key("missing"))
    print(counts.len())
    print_int_option(counts.set("aura", 3))
    print(counts["aura"])
    print_int_option(counts.remove("agents"))
    print_bool(counts == {"aura": 3})

    seeded = {"codex": 4, "agents": 5}
    print(seeded["codex"])
    print(seeded.keys().len())
    print(seeded.values().len())
    return 0
