def print_bool(value: bool):
    match own value:
        case true:
            print("true")
        case false:
            print("false")

def print_int_option(value: Option[int32]):
    match own value:
        case Some(inner):
            print(inner)
        case None:
            print(-1)

def main() -> int32:
    mut counts: dict[str, int32] = {}
    print_bool(counts.is_empty())
    counts["aura"] = 1
    counts["agents"] = 2
    print(counts["aura"])
    print_int_option(counts.get("agents"))
    print_bool(("missing" in counts))
    print(counts.len())
    previous_aura = counts.get("aura")
    counts["aura"] = 3
    print_int_option(previous_aura)
    print(counts["aura"])
    print_int_option(counts.remove("agents"))
    print_bool(counts == {"aura": 3})

    seeded = {"codex": 4, "agents": 5}
    print(seeded["codex"])
    print(seeded.keys().len())
    print(seeded.values().len())
    return 0
