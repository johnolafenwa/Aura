trait Show:
    def show(self) -> str

class Box[T]:
    value: T

class Marker[T]:
    label: str

class Pair[T, U]:
    first: T
    second: U

impl Show for int32:
    def show(self) -> str:
        return "int32"

impl Show for int64:
    def show(self) -> str:
        return "int64"

impl Show for Box[int32]:
    def show(self) -> str:
        return "box-int32"

impl Show for Box[int64]:
    def show(self) -> str:
        return "box-int64"

impl Show for Marker[int32]:
    def show(self) -> str:
        return "marker-int32"

impl Show for Marker[int64]:
    def show(self) -> str:
        return "marker-int64"

impl Show for Lookup[int32]:
    def show(self) -> str:
        return "lookup-int32"

impl[T] Show for Lookup[T]:
    def show(self) -> str:
        return "lookup-generic"

impl[T] Show for Lookup[list[T]]:
    def show(self) -> str:
        return "lookup-vec"

impl[T] Show for Pair[T, None]:
    def show(self) -> str:
        return "pair-none"

def render[T: Show](value: T) -> None:
    print(value.show())

def render_first[T: Show](values: list[T]) -> None:
    match values.get(0):
        case Lookup.Found(value):
            print(value.show())
        case Lookup.Missing:
            print("missing")

def identity_lookup[T](value: own Lookup[T]) -> Lookup[T]:
    return value

def main() -> int32:
    render(Box[int32](value=7))
    render(Box[int64](value=8))
    render(Marker[int32](label="narrow"))
    render(Marker[int64](label="wide"))
    narrow: Lookup[int32] = Lookup.Found(9)
    wide: Lookup[int64] = Lookup.Found(10)
    nested: Lookup[list[int64]] = Lookup.Found([15])
    render(narrow)
    render(wide)
    render(nested)
    missing: Lookup[int64] = identity_lookup(value=Lookup.Missing)
    render(missing)
    pair: Pair[int64, None] = Pair[int64, None](first=2147483648, second=None)
    render(pair)
    narrow_values: list[int32] = [11]
    wide_values: list[int64] = [12]
    render_first(narrow_values)
    render_first(wide_values)
    narrow_markers: list[Marker[int32]] = [Marker[int32](label="narrow")]
    wide_markers: list[Marker[int64]] = [Marker[int64](label="wide")]
    render_first(narrow_markers)
    render_first(wide_markers)
    narrow_lookups: list[Lookup[int32]] = [Lookup.Found(13)]
    wide_lookups: list[Lookup[int64]] = [Lookup.Found(14)]
    render_first(narrow_lookups)
    render_first(wide_lookups)
    return 0
