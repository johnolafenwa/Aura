def print_bool(value: bool):
    match own value:
        case true:
            print("true")
        case false:
            print("false")

def main() -> int32:
    mut left = [1, 2, 3]
    mut right = [4, 5]

    left.swap(0, 2)
    print(left[0])
    print(left[2])
    print_bool((2 in left))
    print_bool((9 in left))

    left.extend(right)
    print(left.len())
    print(left[3])
    print(left[4])

    print_bool(left == [3, 2, 1, 4, 5])
    print_bool(left != [1, 2, 3])
    return 0
