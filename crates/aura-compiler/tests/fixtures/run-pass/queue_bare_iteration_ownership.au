def consume(value: own str):
    print(value)

def main() -> int32:
    jobs = Queue[str]()
    jobs.put("one")
    jobs.close()

    for job in jobs:
        consume(job)

    match jobs.poll():
        case Poll.Ready(_unexpected):
            print("unexpected")
        case Poll.Unavailable:
            print("closed")
    return 0
