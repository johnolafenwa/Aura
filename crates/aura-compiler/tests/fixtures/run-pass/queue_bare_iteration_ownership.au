def consume(value: own str):
    print(value)

def main() -> int32:
    jobs = Queue[str]()
    jobs.put("one")
    jobs.close()

    for job in jobs:
        consume(job)

    match jobs.get_or_none():
        case Some(_unexpected):
            print("unexpected")
        case None:
            print("closed")
    return 0
