type Step = Callable[def(n: int64) -> int64]
type Scaled = Callable[def(n: int64, *, scale: int64) -> int64]
type Wrapper = Callable[def(f: own Scaled) -> Scaled]


def traced(f: own Step) -> Step:
    print("traced")
    return Step(lambda [own f] n: f(n) + 1000)


def tag(label: own str) -> Wrapper:
    print(f"evaluate {label}")
    return Wrapper(lambda [own label] own f: wrap(label.clone(), f))


def wrap(label: own str, f: own Scaled) -> Scaled:
    print(f"apply {label}")
    return Scaled(lambda [own label, own f] n, *, scale: f(n, scale=scale) + label.len())


def unchanged(f: own Step) -> Step:
    print("registered")
    return f


@traced
def fact(n: int64) -> int64:
    """Multiplies the numbers from 1 to n."""
    if n <= 1:
        return 1
    return n * fact(n - 1)


@tag("outer")
# A comment between decorators keeps the group together.
@tag("in")
def run(n: int64, *, scale: int64) -> int64:
    return n * scale


@unchanged
def double(n: int64) -> int64:
    return n * 2


def main():
    print(fact(3))
    print(run(3, scale=1))
    print(run(3, scale=10))
    print(double(21))
