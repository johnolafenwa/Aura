def no_value() -> int32 | None:
    return None

def is_empty[T](value: T | None) -> bool:
    return value == None

def main() -> int32:
    value: int32 | None = no_value()
    print(value == None)
    print(None == value)
    print((None) == value)
    print(value == ((None)))
    print(((None)) == value)
    print(value != None)
    print(None != value)
    print(None == None)
    print(None != None)
    present: int32 | None = 7
    print(present == None)
    print(None == present)
    print(present != None)
    print(None != present)
    print(is_empty[int32](value=value))
    nested_left: Lookup[int32 | None] = Lookup.Found(None)
    nested_right: Lookup[int32 | None] = Lookup.Found(no_value())
    print(nested_left == nested_right)
    return 0
