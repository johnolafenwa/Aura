class Profile:
    name: str
    visits: int64

    def describe(self) -> str:
        return f"{self.name}: {self.visits}"

def main():
    users = [Profile(name="ada", visits=2)]
    people: dict[str, Profile] = {"linus": Profile(name="linus", visits=3)}
    names = ["Aura"]
    print(users[0].describe())
    print(people["linus"].describe())
    print(names[0].len())
    print(names[0].contains("ur"))
    print(users[0].name)
    print(people["linus"].visits)
