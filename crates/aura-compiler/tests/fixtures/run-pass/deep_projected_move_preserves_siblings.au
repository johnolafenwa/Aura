class Payload:
    value: str
    sibling: str

class Envelope:
    payload: Payload
    label: str

def take(value: own str) -> str:
    return value

def main() -> int32:
    envelope = Envelope(payload=Payload(value="moved", sibling="inner-survives"), label="outer-survives")
    value = take(envelope.payload.value)
    print(value)
    print(envelope.payload.sibling)
    print(envelope.label)
    return 0
