class Box:
    value: str

def store(values: mut list[str], unique: mut set[str], labels: mut dict[str, str], output: Queue[str], vec_value: own str, set_value: own str, map_key: own str, map_value: own str, queue_value: own str, field_value: own str) -> Box:
    values.append(vec_value)
    unique.add(set_value)
    labels[map_key] = map_value
    output.try_put(queue_value)
    return Box(value=field_value)

def main() -> int32:
    mut values: list[str] = []
    mut unique: set[str] = set[str]()
    mut labels: dict[str, str] = dict[str, str]()
    output = Queue[str]()
    boxed = store(values, unique, labels, output, "vec", "set", "key", "map", "queue", "field")

    print(values.len())
    print(unique.len())
    print(labels.len())
    match output.get():
        case QueueReceive.Item(value):
            print(value)
        case QueueReceive.Closed:
            print("closed")
        case QueueReceive.TimedOut:
            print("timed out")
        case QueueReceive.Cancelled:
            print("cancelled")
    print(boxed.value)
    return 0
