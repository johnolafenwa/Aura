def label(value: str | None) -> str:
    if value == "admin":
        return "admin"
    return "other"


def main():
    names: list[str] = ["ada", "bob", "user-7", "zed"]
    mut equal = 0
    for name in names:
        if name == "user-7":
            equal += 1
        if "bob" != name:
            equal += 10
    print(equal)
    print(f"{"ada" == names[0]} {names[3] != "zed"} {names[1] == "bo"}")
    print(f"{label("admin")} {label(None)} {label("guest")}")
    mut count = 0
    mut i = 3
    while i >= 0:
        if names[i] != names[0]:
            count += 1
        i -= 1
    print(count)
