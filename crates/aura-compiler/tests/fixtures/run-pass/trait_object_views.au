trait Shape:
    def area(self) -> int64
    def name(self) -> str
    def grow(mut self, by: int64) -> None
    def describe(self) -> str:
        return f"{self.name()} of area {self.area()}"


class Square:
    side: int64


class Rect:
    w: int64
    h: int64


class Label:
    text: str
    hits: list[int64]


impl Shape for Square:
    def area(self) -> int64:
        return self.side * self.side
    def name(self) -> str:
        return "square"
    def grow(mut self, by: int64) -> None:
        self.side += by


impl Shape for Rect:
    def area(self) -> int64:
        return self.w * self.h
    def name(self) -> str:
        return "rect"
    def grow(mut self, by: int64) -> None:
        self.w += by
        self.h += by


impl Shape for Label:
    def area(self) -> int64:
        return len(self.text) + len(self.hits)
    def name(self) -> str:
        return self.text.clone()
    def grow(mut self, by: int64) -> None:
        self.hits.append(by)
    def describe(self) -> str:
        return f"label {self.text}"


type Measure = Callable[def(shape: dyn Shape) -> int64]
type Maker = Callable[def(side: int64) -> dyn Shape]


class Scene:
    shapes: list[dyn Shape]
    hero: dyn Shape

    def first(self) -> view dyn Shape from self:
        return view self.shapes[0]

    def lead(mut self) -> view mut dyn Shape from self:
        return view mut self.hero


def widest(shapes: list[dyn Shape]) -> view dyn Shape from shapes:
    mut best = 0
    for index in range(len(shapes)):
        if shapes[index].area() > shapes[best].area():
            best = index
    return view shapes[best]


def main() -> None:
    mut scene = Scene(shapes=[Square(side=2), Rect(w=3, h=4)], hero=Square(side=1))
    print(scene.first().describe())
    view big = widest(scene.shapes)
    print(big.name())
    scene.lead().grow(4)
    print(scene.hero.area())
    view mut lead = scene.lead()
    lead.grow(1)
    print(scene.hero.area())
    view second = scene.shapes[1]
    print(second.area())
    view mut target = scene.shapes[0]
    target.grow(10)
    print(scene.shapes[0].area())
    held = Measure(lambda shape: shape.area() + 1)
    print(held(scene.hero))
    maker = Maker(lambda side: Square(side=side))
    print(maker(3).area())
