def main():
    mut value: int64 | str | None = 41
    match mut value:
        case int64 as number:
            number += 1
        case str as text:
            text = "changed"
        case None:
            pass
    match value:
        case int64 as number:
            print(number)
        case str as text:
            print(text)
        case None:
            print("missing")
