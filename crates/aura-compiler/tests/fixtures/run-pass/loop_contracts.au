def search(xs: list[int64], key: int64) -> int64:
    requires len(xs) > 0
    mut lo = 0
    mut hi = len(xs)
    while lo < hi:
        invariant 0 <= lo and lo <= hi and hi <= len(xs)
        decreases hi - lo
        mid = lo + (hi - lo) // 2
        if xs[mid] < key:
            lo = mid + 1
        elif xs[mid] > key:
            hi = mid
        else:
            return mid
    return -1


def total(xs: list[int64]) -> int64:
    mut acc = 0
    for i, x in enumerate(xs):
        invariant acc == sum(xs[0:i])
        acc += x
    return acc


def countdown(n: int64) -> int64:
    mut steps = 0
    mut k = n
    while k > 0:
        decreases k
        k -= 1
        steps += 1
        if k == 2:
            continue
    return steps


def main():
    xs = [1, 3, 5, 7, 9, 11]
    print(search(xs, 7))
    print(search(xs, 4))
    print(total(xs))
    print(countdown(5))
