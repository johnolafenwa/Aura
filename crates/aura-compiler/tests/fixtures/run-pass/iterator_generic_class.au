from iter import Iterator, Step


class Repeat[T]:
    items: list[T]


impl[T] Iterator[T] for Repeat[T]:
    def next(mut self) -> Step[T]:
        if len(self.items) == 0:
            return Step.End
        return Step.Item(self.items.pop(0))


def main():
    for s in Repeat[str](items=["hi", "there"]):
        print(s)
    for n in Repeat(items=[7, 8]):
        print(n + 1)
    words = Repeat(items=["w"])
    for w in words:
        print(w)
