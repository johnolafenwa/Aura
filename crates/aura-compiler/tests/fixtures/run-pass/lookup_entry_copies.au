# `match d.lookup(key)` whose `Found` arm only reads the value: the key
# test copies the entry once and the reads share that copy, for local
# dicts, dicts in fields, payloads of enum values, and `int64` keys.
import json


enum Cell:
    Num(value: int64)
    Text(value: str)


class Store:
    cells: dict[int64, Cell] = {}
    names: dict[str, list[int64]] = {}


def describe(cell: Cell) -> str:
    match cell:
        case Cell.Num(value):
            return f"num {value}"
        case Cell.Text(value):
            return f"text {value}"


def weight(cell: Cell) -> int64:
    match cell:
        case Cell.Num(value):
            return value
        case Cell.Text(value):
            return value.byte_len()


def field_int(doc: json.Value, name: str) -> int64:
    match doc:
        case json.Value.Object(fields):
            match fields.lookup(name):
                case Lookup.Found(value):
                    match json.as_int(value):
                        case int64 as number:
                            return number
                        case None:
                            return -1
                case Lookup.Missing:
                    return -2
        case _:
            return -3


def total(store: Store, ids: list[int64]) -> int64:
    mut sum = 0
    for id in ids:
        match store.cells.lookup(id):
            case Lookup.Found(cell):
                # Two reads of one loan.
                if weight(cell) > 2 and describe(cell) != "":
                    sum += weight(cell)
            case Lookup.Missing:
                sum -= 1
    return sum


def main():
    mut store = Store()
    for i in range(6):
        if i % 2 == 0:
            store.cells[i] = Cell.Num(value=i * 10)
        else:
            store.cells[i] = Cell.Text(value=f"t{i}")
    store.names["even"] = [0, 2, 4]
    store.names["odd"] = [1, 3, 5]
    for i in range(8):
        match store.cells.lookup(i):
            case Lookup.Found(cell):
                print(describe(cell))
            case Lookup.Missing:
                print(f"missing {i}")
    print(total(store, [0, 1, 2, 3, 9]))

    # A read into a local that the arm then changes leaves the dict as is.
    match store.names.lookup("even"):
        case Lookup.Found(ids):
            mut mine = ids.copy()
            mine.append(100)
            print(mine)
        case Lookup.Missing:
            pass
    print(store.names["even"])

    mut local: dict[str, Cell] = {"a": Cell.Num(value=1), "b": Cell.Text(value="bee")}
    for key in ["a", "b", "c"]:
        match local.lookup(key):
            case Lookup.Found(cell):
                print(describe(cell))
            case Lookup.Missing:
                print(f"no {key}")

    doc = json.Value.Object({"id": json.Value.Int(7), "name": json.Value.String("x")})
    print(field_int(doc, "id"))
    print(field_int(doc, "name"))
    print(field_int(doc, "age"))
    print(field_int(json.Value.Null, "id"))
