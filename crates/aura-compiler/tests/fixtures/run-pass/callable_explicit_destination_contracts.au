type Unary = def(int64) -> int64
type Keyed = def(*, value: int64) -> int64
type Stored = Callable[def(int64) -> int64]
type Job = TaskCallable[def(value: int64 = ...) -> int64]

def increment(value: int64 = 1) -> int64:
    return value + 1

def double(value: int64 = 1) -> int64:
    return value * 2

class Counter:
    value: int64
    def scaled(self, factor: int64) -> int64:
        return self.value * factor

class Pipeline:
    step: Unary

def apply(step: Unary, value: int64) -> int64:
    return step(value)

def choose(first: bool) -> Unary:
    return Unary(increment) if first else Unary(double)

def main():
    annotated: def(int64) -> int64 = Unary(increment)
    aliased: Unary = Unary(increment)
    pipeline = Pipeline(step=Unary(increment))
    steps: list[Unary] = [Unary(increment), Unary(double)]
    selected = Unary(increment) if true else Unary(double)
    print(annotated(1))
    print(aliased(2))
    print(apply(Unary(increment), 3))
    print(pipeline.step(4))
    print(steps[1](5))
    print(choose(false)(6))
    print(selected(7))
    keyed = Keyed(increment)
    print(keyed(value=8))
    packed = Stored(increment)
    print(packed(9))
    job = Job(double)
    print(job())
    restricted = Stored(job)
    print(restricted(10))
    bound = Stored(Counter(value=3).scaled)
    print(bound(4))
