# A loop over lists of scalars and other lists gets a copy for while the
# lists of scalars qualify, and one for while every list does.

class Point:
    x: int64
    y: int64

def score(values: list[int64], cell: int64) -> int64:
    return values[cell] * 2 + 1

# As a spreadsheet's edits: the loop over `values` leaves out the block
# that hands the list to `score`, which the loops over the other lists
# take in.
def recompute(values: mut list[int64], dirty: list[int64], is_formula: list[bool], order: list[int64], edits: int64) -> int64:
    mut recomputed = 0
    for edit in range(edits):
        for cell in order:
            if dirty[cell] == edit and is_formula[cell]:
                result = score(values, cell)
                values[cell] = result % 1000
                recomputed += 1
            else:
                recomputed += values[cell] % 3
    return recomputed

# A loop over a list of scalars and a list of records.
def mixed(xs: list[int64], ps: list[Point]) -> int64:
    mut total = 0
    for i in range(xs.len()):
        total += xs[i] * ps[i].x + ps[i].y
    return total

def main():
    mut values = [3, 5, 7, 11, 13, 17, 19, 23]
    dirty = [0, 1, 0, 1, 2, 2, 0, 1]
    is_formula = [false, true, true, false, true, true, false, true]
    order = [0, 2, 4, 6, 1, 3, 5, 7]
    print(recompute(values, dirty, is_formula, order, 3))
    print(values)
    print(recompute(values, dirty, is_formula, [], 2))
    ps = [Point(x=1, y=2), Point(x=3, y=4), Point(x=5, y=6)]
    print(mixed([2, 4, 6], ps))
    print(mixed([], ps))
