# Loops inside loops, and loops whose lists leave out different blocks,
# each read their lists' views once where they are entered. The copy of
# a loop around another, or across another, holds each version of it.

class Point:
    x: int64
    y: int64

def score(values: list[int64], cell: int64) -> int64:
    return values[cell] * 2 + 1

# As a spreadsheet's edits: the loop over `values` leaves out the block
# that hands the list to `score`, which the loops over the other lists
# take in.
def recompute(values: mut list[int64], dirty: list[int64], is_formula: list[bool], order: list[int64], edits: int64) -> int64:
    mut recomputed = 0
    for edit in range(edits):
        for cell in order:
            if dirty[cell] == edit and is_formula[cell]:
                result = score(values, cell)
                values[cell] = result % 1000
                recomputed += 1
            else:
                recomputed += values[cell] % 3
    return recomputed

# An inner loop over one list inside an outer loop over another. The
# outer loop grows the inner loop's list, so only the inner loop reads
# that list's view once.
def nested(rows: list[int64], cols: mut list[float64], n: int64) -> float64:
    mut total = 0.0
    for i in range(n):
        total += rows[i] as float64
        for j in range(cols.len()):
            total += cols[j] * (i as float64) + (rows[j % rows.len()] as float64)
        cols.append(0.5)
    return total

# Three loops deep, each over its own list, the innermost over the list
# of the outermost too.
def deep(a: list[int64], b: mut list[int64], c: mut list[int64]) -> int64:
    mut total = 0
    for i in range(a.len()):
        for j in range(b.len()):
            for k in range(c.len()):
                total += a[i] * b[j] + c[k] - a[(i + k) % a.len()]
            c.append(j)
        b.append(i)
    return total

# A loop over a list of scalars and a list of records.
def mixed(xs: list[int64], ps: list[Point]) -> int64:
    mut total = 0
    for i in range(xs.len()):
        total += xs[i] * ps[i].x + ps[i].y
    return total

def main():
    mut values = [3, 5, 7, 11, 13, 17, 19, 23]
    dirty = [0, 1, 0, 1, 2, 2, 0, 1]
    is_formula = [false, true, true, false, true, true, false, true]
    order = [0, 2, 4, 6, 1, 3, 5, 7]
    print(recompute(values, dirty, is_formula, order, 3))
    print(values)
    print(recompute(values, dirty, is_formula, [], 2))
    mut cols = [0.5, 1.5]
    print(nested([1, 2, 3], cols, 3))
    print(cols)
    mut none: list[float64] = []
    print(nested([1, 2, 3], none, 2))
    mut b = [4, 5]
    mut c = [6, 7, 8, 9]
    print(deep([1, 2, 3], b, c))
    print(c.len())
    mut empty: list[int64] = []
    mut one = [6]
    print(deep([1], empty, one))
    ps = [Point(x=1, y=2), Point(x=3, y=4), Point(x=5, y=6)]
    print(mixed([2, 4, 6], ps))
    print(mixed([], ps))
