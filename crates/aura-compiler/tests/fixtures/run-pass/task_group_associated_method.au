class Worker:
    def run(value: int32) -> int32:
        return value + 1

def main() -> int32:
    with TaskGroup() as group:
        task = group.start(Worker.run, 4)
        other = group.start(Worker.run, 6)
        match task.result():
            case TaskResult.Ready(value):
                print(value)
            case _:
                return 1
        match other.result():
            case TaskResult.Ready(value):
                print(value)
            case _:
                return 1

    return 0
