def describe(values: list[int64]) -> str:
    return f"{values} len={values.len()}"


def main():
    mut values: list[int64] = [5, 1, 4]
    values.insert(0, 9)
    values.insert(-1, 7)
    values.extend([2, 8])
    print(describe(values))
    values.sort()
    print(values)
    values.sort(reverse=true)
    print(values)
    values.reverse()
    values.swap(0, -1)
    print(values)
    print(values.pop(0))
    print(values.set(1, 40))
    values.remove(40)
    print(values)
    print(values.index(5))
    print(values.count(8))
    print(4 in values)
    print(values[1:3])
    print(values[-2:])
    mut copy = values.copy()
    copy[0] = -1
    print(values == copy)
    copy[0] = values[0]
    print(values == copy)
    while values.len() > 0:
        values.pop()
    values.append(6)
    print(values)
    values.clear()
    values.append(3)
    print(values)

    mut floats: list[float64] = [2.5, -0.0, 1.0]
    floats.sort()
    floats.insert(1, 0.5)
    print(floats)
    print(floats.pop())
    print(floats[-1])

    mut flags: list[bool] = [true, false]
    flags.append(true)
    flags.insert(0, false)
    print(flags)
    print(flags.count(true))
    flags[1] = false
    print(flags)

    mut grid: list[list[int64]] = [[1, 2], [3]]
    grid[1].append(4)
    grid[0][1] = 20
    print(grid)
    mut total = 0
    for row in grid:
        for value in row:
            total += value
    print(total)

    mut mixed: list[int64 | str] = [1, "two"]
    mixed.append(3)
    print(mixed)
    print(mixed.len())
