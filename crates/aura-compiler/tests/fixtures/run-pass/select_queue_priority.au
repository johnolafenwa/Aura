def show(value: own SelectOutcome[str, None]):
    match own value:
        case SelectOutcome.Queue(index, outcome):
            print(index)
            print(outcome)
        case SelectOutcome.Task(_, _):
            print("unexpected task")
        case SelectOutcome.Deadline(index):
            print(index)
        case SelectOutcome.Cancelled:
            print("cancelled")

def main():
    first = Queue[str]()
    second = Queue[str]()
    _ = first.put("first")
    _ = second.put("second")
    show(select(first, second))
    print(second.get())

    duplicate = Queue[str]()
    _ = duplicate.put("one")
    _ = duplicate.put("two")
    show(select(duplicate, duplicate))
    print(duplicate.get())

    buffered = Queue[str]()
    _ = buffered.put("buffered")
    buffered.close()
    show(select(buffered))
    show(select(buffered))
