def sum_set(values: set[int32]) -> int32:
    mut total: int32 = 0
    for value in values:
        total += value
    return total

def main() -> int32:
    mut values = [1, 3]
    values.insert(1, 2)
    print(true.to_string())
    values.append(4)
    values.reverse()
    print(values[0].to_string())
    print(values[3].to_string())
    values.clear()
    print(values.is_empty().to_string())

    mut counts = {"a": 1}
    other = {"b": 2, "c": 3}
    counts.update(other)
    items = counts.items()
    print(items)
    print(counts.items().len().to_string())
    counts.clear()
    print(counts.is_empty().to_string())

    mut seen: set[int32] = {1, 2, 2, 3}
    print(seen.len().to_string())
    print((2 in seen).to_string())
    inserted_existing = 2 not in seen
    seen.add(2)
    print(inserted_existing.to_string())
    inserted_four = 4 not in seen
    seen.add(4)
    print(inserted_four.to_string())
    removed_one = 1 in seen
    seen.discard(1)
    print(removed_one.to_string())
    print(sum_set(seen).to_string())

    copy = seen.copy()
    mut moved_total: int32 = 0
    for value in copy:
        moved_total += value
    print(moved_total.to_string())

    mut names: set[str] = set[str]()
    print(names.is_empty().to_string())
    inserted_name = "aura" not in names
    names.add("aura")
    print(inserted_name.to_string())
    print(names.len().to_string())
    return 0
