def is_slow(ms: int64) -> bool:
    return ms > 100

def scale(value: int64, factor: int64 = 2) -> int64:
    return value * factor

def apply(check: def(int64) -> bool, value: int64) -> bool:
    return check(value)

def make_check() -> def(int64) -> bool:
    return is_slow

def main():
    f: def(int64) -> bool = is_slow
    print(f(150))
    print(apply(is_slow, 50))
    print(make_check()(500))
    g: def(int64, int64) -> int64 = scale
    print(g(3, 4))
    checks: list[def(int64) -> bool] = [is_slow]
    print(checks[0](7))
