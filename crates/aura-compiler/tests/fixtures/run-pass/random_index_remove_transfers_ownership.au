import random

class Holder:
    generator: random.Rng

def main():
    # `pop(index)` transfers a non-copy element out of a list.
    mut generators = list[random.Rng]()
    generators.append(random.Rng(seed=7))
    mut owned_generator = generators.pop(0)
    print(owned_generator.next_int(lo=1, hi=10))

    # `dict.remove(key)` likewise transfers the optional stored value.
    mut holders = dict[str, Holder]()
    holders["a"] = Holder(generator=random.Rng(seed=7))
    match own holders.remove("a"):
        case Option.Some(chosen):
            mut owned_holder = chosen
            print(owned_holder.generator.next_int(lo=1, hi=10))
        case Option.None:
            print("none")
    print(holders.len())
