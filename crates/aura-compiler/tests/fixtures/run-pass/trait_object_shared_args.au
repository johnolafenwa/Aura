# A method reached through a trait object keeps its shared receiver with
# the caller and owns the arguments the call passes.


trait Scorer:
    def score(self, word: str, weights: list[int64]) -> int64
    def label(self, prefix: str) -> str


class Length:
    bonus: int64


class Prefix:
    start: str
    seen: list[str]


impl Scorer for Length:
    def score(self, word: str, weights: list[int64]) -> int64:
        return len(word) * weights[0] + self.bonus
    def label(self, prefix: str) -> str:
        return prefix + "length"


impl Scorer for Prefix:
    def score(self, word: str, weights: list[int64]) -> int64:
        if word.starts_with(self.start):
            return weights[1] + len(self.seen)
        return 0
    def label(self, prefix: str) -> str:
        return prefix + self.start


def total(scorers: list[dyn Scorer], words: list[str]) -> int64:
    weights = [2, 10]
    mut sum = 0
    for scorer in scorers:
        for word in words:
            sum += scorer.score(word, weights)
    return sum


def main():
    scorers: list[dyn Scorer] = [
        Length(bonus=1),
        Prefix(start="a", seen=["x", "y"]),
        Length(bonus=0),
    ]
    words = ["apple", "pear", "avocado"]
    print(total(scorers, words))
    print(total(scorers, words))
    for scorer in scorers:
        print(scorer.label("by "))
    tag = "tag:"
    print(scorers[1].label(tag))
    print(scorers[0].score(words[1], [3, 4]))
    print(tag)
    print(words)
