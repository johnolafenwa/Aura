# A `str` key read from a list is looked up where the list holds it.

def count_found(keys: list[str], table: dict[str, int64]) -> int64:
    mut total = 0
    for i in range(len(keys)):
        match table.get(keys[i]):
            case Found(value):
                total += value
            case Missing:
                total -= 1
    return total


def count_present(keys: list[str], table: dict[str, int64]) -> int64:
    mut present = 0
    for i in range(len(keys)):
        if keys[i] in table:
            present += 1
    return present


def count_members(keys: list[str], seen: set[str]) -> int64:
    mut members = 0
    for i in range(len(keys)):
        if keys[i] in seen:
            members += 1
        if keys[len(keys) - 1 - i] not in seen:
            members += 100
    return members


def lengths(keys: list[str], table: dict[str, str]) -> int64:
    mut total = 0
    for i in range(len(keys)):
        match table.get(keys[i]):
            case Found(text):
                total += len(text)
            case Missing:
                pass
    return total


def count_views(keys: list[str], table: mut dict[str, int64], seen: set[str]) -> int64:
    mut total = 0
    for i in range(len(keys)):
        view key = keys[i]
        if key in table:
            total += 1
        if key in seen:
            total += 10
        match mut table.lookup(key):
            case Lookup.Found(count):
                count += 1
            case Lookup.Missing:
                total += 100
    return total


def main() -> None:
    mut keys = list[str]()
    mut table: dict[str, int64] = {}
    mut seen = set[str]()
    mut names: dict[str, str] = {}
    for i in range(40):
        keys.append(f"key{i}")
        if i % 2 == 0:
            table[f"key{i}"] = i
        if i % 3 == 0:
            seen.add(f"key{i}")
        if i % 5 == 0:
            names[f"key{i}"] = f"name of {i}"
    keys.append("")
    keys.append("clé")
    keys.append("ключ")
    table[""] = 1000
    table["ключ"] = 5000
    seen.add("clé")
    names["clé"] = "é"
    print(count_found(keys, table))
    print(count_present(keys, table))
    print(count_members(keys, seen))
    print(lengths(keys, names))
    # The list changes between lookups.
    mut total = 0
    for round in range(3):
        keys.append(f"key{round * 2}")
        keys[round] = "ключ"
        total += count_found(keys, table) + count_present(keys, table)
    print(total)
    print(count_views(keys, table, seen))
    print(table["key2"])
    one = ["key2"]
    print(one[0] in table)
    print(one[0] in seen)
    print(table.get(one[0]))
    empty: dict[str, int64] = {}
    print(keys[0] in empty)
    print(empty.get(keys[1]))
