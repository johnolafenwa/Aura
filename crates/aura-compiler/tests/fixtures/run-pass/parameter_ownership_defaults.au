class Message:
    text: str

def length(message: Message) -> int32:
    return message.text.len() as int32

def consume(message: own Message) -> str:
    return message.text

def main() -> int32:
    shared = Message(text="borrowed")
    print(length(shared))
    print(shared.text)

    owned = Message(text="consumed")
    print(consume(owned))
    return 0
