class Label:
    text: str

def implicit_shared_length(label: Label = Label(text="default")) -> int32:
    return label.text.len() as int32

def explicit_shared_length(label: Label = Label(text="shared")) -> int32:
    return label.text.len() as int32

def take_default(label: own Label = Label(text="owned")) -> str:
    return label.text

def main() -> int32:
    print(implicit_shared_length())
    print(explicit_shared_length())
    print(take_default())
    return 0
