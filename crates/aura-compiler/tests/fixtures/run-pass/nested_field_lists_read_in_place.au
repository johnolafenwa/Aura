# Reads of one element of a list held in a list field, such as
# `self.boxes[c][i]`, follow the field's list of boxes in generated code
# when the instance is kept in place, and copy the string from the inner
# list's view. Any other shape takes the runtime walk, with the same
# results.


class Mailboxes:
    boxes: list[list[str]]
    counts: list[list[int64]]

    def first(self, client: int64) -> str:
        return self.boxes[client][0].clone()

    def last(self, client: int64) -> str:
        return self.boxes[client][-1].clone()

    def gather(self, client: int64, start: int64, end: int64) -> list[str]:
        mut lines: list[str] = []
        for index in range(start, end):
            lines.append(self.boxes[client][index].clone())
        return lines

    def width(self, client: int64, index: int64) -> int64:
        return self.boxes[client][index].byte_len()

    def count(self, client: int64, index: int64) -> int64:
        return self.counts[client][index]


def build() -> Mailboxes:
    mut boxes: list[list[str]] = []
    mut counts: list[list[int64]] = []
    for client in range(3):
        boxes.append(list[str]())
        counts.append(list[int64]())
    for message in range(7):
        boxes[message % 3].append(f"m{message}")
        counts[message % 3].append(message * 10)
    return Mailboxes(boxes=boxes, counts=counts)


def main():
    mut mail = build()
    print(f"{mail.first(0)} {mail.last(0)} {mail.first(2)} {mail.last(-1)}")
    print(mail.gather(0, 0, 3))
    print(mail.gather(-3, 1, 3))
    print(f"{mail.width(1, 1)} {mail.count(1, 1)} {mail.count(-1, -2)}")
    mail.boxes[1].append("a longer message than the others")
    print(f"{mail.last(1)} {mail.width(1, -1)}")
    # A literal list of lists keeps its elements unboxed: the runtime walk.
    literal = Mailboxes(boxes=[["x", "y"], ["z"]], counts=[[1], [2, 3]])
    print(f"{literal.first(0)} {literal.last(0)} {literal.gather(1, 0, 1)} {literal.count(1, 1)}")
    # A field moved out of the instance and back.
    mut moved = build()
    taken = moved.boxes
    moved.boxes = [["back"]]
    print(f"{moved.first(0)} {taken.len()}")
