class Account:
    balance: int64

    def withdraw(mut self, amount: int64) -> int64:
        """Takes `amount` out and returns the new balance."""
        requires amount > 0
        requires amount <= self.balance
        ensures result >= 0
        ensures result == self.balance
        self.balance = self.balance - amount
        return self.balance


def binary_search(xs: list[int64], key: int64) -> int64:
    requires all([xs[i] <= xs[i + 1] for i in range(len(xs) - 1)])
    ensures result == -1 or (0 <= result and result < len(xs) and xs[result] == key)
    mut lo = 0
    mut hi = len(xs)
    while lo < hi:
        mid = lo + (hi - lo) // 2
        if xs[mid] < key:
            lo = mid + 1
        elif xs[mid] > key:
            hi = mid
        else:
            return mid
    return -1


def greet(name: str):
    requires len(name) > 0
    ensures true
    print(f"hi {name}")


def label(n: int64) -> str:
    ensures len(result) == 3
    if n > 0:
        return "pos"
    return "neg"


def factorial(n: int64) -> int64:
    requires n >= 0
    ensures result >= 1
    if n == 0:
        return 1
    return n * factorial(n - 1)


def count[T](xs: list[T]) -> int64:
    requires len(xs) > 0
    ensures result == len(xs)
    return len(xs)


def requires(flag: bool) -> bool:
    return flag


def ordinary_names() -> bool:
    requires(true)
    ensures = requires(false)
    return ensures


class Resource:
    name: str

    def __enter__(mut self) -> None:
        print(f"enter {self.name}")

    def __exit__(mut self) -> None:
        print(f"exit {self.name}")


def inside_with(flag: bool) -> int64:
    ensures result == 2 or result == 3
    with Resource(name="r") as held:
        if flag:
            return 2
    return 3


def main() -> None:
    mut account = Account(balance=100)
    print(account.withdraw(30))
    print(binary_search([1, 3, 5, 7], 5))
    print(binary_search([1, 3, 5, 7], 4))
    greet("aura")
    print(label(3))
    print(label(-3))
    print(factorial(5))
    print(count([4, 5]))
    print(count(["a"]))
    print(ordinary_names())
    print(inside_with(true))
    print(inside_with(false))
