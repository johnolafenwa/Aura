trait Scale[T]:
    def scale(self, n: T) -> int64

class Engine:
    pass

impl Scale[int64] for Engine:
    def scale(self, n: int64) -> int64:
        return n

impl Scale[str] for Engine:
    def scale(self, n: str) -> int64:
        return len(n)

class Car:
    engine: Engine

impl Scale[str] for Car by engine

def main():
    print(Car(engine=Engine()).scale("aura"))
