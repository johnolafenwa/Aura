trait Show:
    def show(self) -> str

impl Show for int32:
    def show(self) -> str:
        return "int32"

impl Show for int64:
    def show(self) -> str:
        return "int64"

class Wrapper[T: Show]:
    value: T

    def render(self) -> str:
        return self.value.show()

def main() -> int32:
    narrow: Wrapper[int32] = Wrapper[int32](value=7)
    wide: Wrapper[int64] = Wrapper[int64](value=8)
    print(narrow.render())
    print(wide.render())
    return 0
