enum Packet:
    Data(int64 | str)
def main():
    mut value = Packet.Data(41)
    while true:
        match mut value:
            case Packet.Data(int64 as number):
                number += 1
                break
            case Packet.Data(str as text):
                break
    match value:
        case Packet.Data(int64 as number):
            print(number)
        case Packet.Data(str as text):
            print(text)
