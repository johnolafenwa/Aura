trait Shape:
    def area(self) -> int64
    def name(self) -> str
    def grow(mut self, by: int64) -> None
    def describe(self) -> str:
        return f"{self.name()} of area {self.area()}"


class Square:
    side: int64


class Rect:
    w: int64
    h: int64


class Label:
    text: str
    hits: list[int64]


impl Shape for Square:
    def area(self) -> int64:
        return self.side * self.side
    def name(self) -> str:
        return "square"
    def grow(mut self, by: int64) -> None:
        self.side += by


impl Shape for Rect:
    def area(self) -> int64:
        return self.w * self.h
    def name(self) -> str:
        return "rect"
    def grow(mut self, by: int64) -> None:
        self.w += by
        self.h += by


impl Shape for Label:
    def area(self) -> int64:
        return len(self.text) + len(self.hits)
    def name(self) -> str:
        return self.text.clone()
    def grow(mut self, by: int64) -> None:
        self.hits.append(by)
    def describe(self) -> str:
        return f"label {self.text}"


trait Sink:
    def finish(own self) -> str


class Buffer:
    parts: list[str]


impl Sink for Buffer:
    def finish(own self) -> str:
        return ",".join(self.parts)


class Counter:
    n: int64


impl Sink for Counter:
    def finish(own self) -> str:
        return f"count {self.n}"


def close(sink: own dyn Sink) -> str:
    return sink.finish()


def main() -> None:
    sink: dyn Sink = Buffer(parts=["a", "b"])
    print(sink.finish())
    print(close(Counter(n=3)))
    sinks: list[dyn Sink] = [Counter(n=1), Buffer(parts=["z"])]
    for each in own sinks:
        print(each.finish())
