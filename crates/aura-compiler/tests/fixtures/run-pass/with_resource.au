class FileHandle:
    name: str

    def read(self) -> str:
        return self.name.clone()

    def close(mut self):
        print("closed " + self.name)

def use_resource() -> Result[str, str]:
    with file = FileHandle(name="demo"):
        print(file.read())
        return Result.Ok("done")

def main() -> int32:
    match use_resource():
        case Result.Ok(value):
            print(value)
        case Result.Err(err):
            print(err)
    return 0
