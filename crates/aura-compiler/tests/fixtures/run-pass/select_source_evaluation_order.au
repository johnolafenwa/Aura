def observe(label: str, queue: Queue[int32]) -> Queue[int32]:
    print(label)
    return queue

def main():
    first = Queue[int32]()
    second = Queue[int32]()
    _ = first.put(1)
    _ = second.put(2)
    print(select(observe("first", first), observe("second", second)))
    print(second.get())
