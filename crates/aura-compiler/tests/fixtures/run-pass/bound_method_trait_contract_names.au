trait Apply:
    def apply(self, value: int64) -> int64

trait Combine:
    def combine(self, base: int64, *, value: int64) -> int64

class Pair:
    left: str
    right: str

trait Pick:
    def pick(self, pair: Pair) -> view str from pair

class Worker:
    pass

impl Apply for Worker:
    def apply(self, local: int64) -> int64:
        return local

impl Combine for Worker:
    def combine(self, start: int64, *, value: int64) -> int64:
        return start + value

impl Pick for Worker:
    def pick(self, source: Pair) -> view str from source:
        return view source.left

def main():
    worker = Worker()
    f = worker.apply
    print(f(value=7))
    g = Worker().combine
    print(g(1, value=7))
    print(g(base=2, value=7))
    pair = Pair(left="ada", right="linus")
    picker = Worker().pick
    view head = picker(pair=pair)
    print(head)
