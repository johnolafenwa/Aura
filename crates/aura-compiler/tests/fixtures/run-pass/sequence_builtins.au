class Person:
    name: str
    age: int64


def by_age(person: Person) -> int64:
    return person.age


def numbers() -> list[int64]:
    return [5, 4, 9]


def main() -> None:
    names = ["b", "a", "c"]
    print(sorted(names))
    print(sorted(names, reverse=true))
    print(names)
    print(sorted(numbers()))
    print(sorted({3, 1, 2}))
    print(sorted(range(3), reverse=true))
    print(reversed(names))
    print(reversed(range(4)))
    print(list(names))
    print(list(range(4)))
    print(len(list({7, 8})))

    people = [Person(name="ada", age=36), Person(name="bo", age=19), Person(name="cy", age=36)]
    by_years = sorted(people, key=by_age)
    print(f"{by_years[0].name} {by_years[1].name} {by_years[2].name}")
    by_name = sorted(people, key=lambda person: person.name.clone(), reverse=true)
    print(f"{by_name[0].name} {by_name[2].name}")

    view middle = names[1:]
    print(sorted(middle))
    print(reversed(middle))

    values = [0, 1, 2, 3, 4, 5, 6]
    print(values[::2])
    print(values[::-1])
    print(values[1:6:2])
    print(values[5:1:-2])
    print(values[-1::-3])
    print(values[::10])
    print(values[3:3:-1])
    print(names[::-1])
    print(middle[::-1])
    print("héllo wörld"[::-1])
    print("abcdef"[1::2])
    empty: list[int64] = []
    print(empty[::-1])

    print(values[:2] + values[5:])
    print(names + ["d"])
    print([0] * 3)
    print(2 * names)
    print(names * 0)
    times: int32 = 2
    print([1, 2] * times)

    mut collected: list[str] = []
    collected += names
    collected += ["z"]
    collected += collected
    print(collected)
