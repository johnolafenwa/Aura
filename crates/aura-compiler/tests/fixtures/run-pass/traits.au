trait Greeter:
    def greet(self) -> String

class User:
    name: String

impl Greeter for User:
    def greet(self) -> String:
        return "hello " + self.name

def speak[T: Greeter](value: T):
    print(value.greet())

def main() -> int32:
    user = User(name="aura")
    speak(value=user)
    print(User(name="aura").greet())
    return 0
