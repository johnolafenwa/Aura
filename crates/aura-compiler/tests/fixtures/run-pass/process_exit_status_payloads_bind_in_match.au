import process

def describe(status: process.ExitStatus) -> str:
    match status:
        case process.ExitStatus.Exited(code):
            return f"exit {code}"
        case process.ExitStatus.Signaled(signal):
            return f"signal {signal}"

def main() -> int32:
    match process.run(["/bin/sh", "-c", "exit 3"]):
        case Result.Ok(completed):
            print(describe(completed.status()))
            match completed.status():
                case process.ExitStatus.Exited(code):
                    print(code)
                case _:
                    return 1
        case Result.Err(error):
            print(error)
            return 1
    return 0
