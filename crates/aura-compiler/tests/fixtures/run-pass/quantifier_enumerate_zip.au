def ranks(xs: list[int64]) -> int64:
    requires forall((i, x) in enumerate(xs), x == i)
    ensures result == len(xs)
    return len(xs)

def ordered(xs: list[int64], ys: list[int64]) -> bool:
    requires forall((x, y) in zip(xs, ys), x < y)
    return true

def sorted_pairs(xs: list[int64]) -> bool:
    requires all([xs[i] <= xs[j] for i in range(len(xs)) for j in range(len(xs)) if i <= j])
    return true

def main():
    mut total = 0
    for i in range(4):
        invariant total == i * 2
        total += 2
    print(total)
    print(ranks([0, 1, 2]))
    print(ordered([1, 2], [3, 4, 5]))
    print(sorted_pairs([1, 2, 2, 7]))
