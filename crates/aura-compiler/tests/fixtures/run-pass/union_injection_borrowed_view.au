class Profile:
    name: str

def profile_name(profile: Profile) -> view str from profile:
    return view profile.name

def accept(value: str | None) -> int64:
    if value is not None:
        return value.len()
    return 0

def main():
    profile = Profile(name="Ada")
    view name = profile_name(profile)
    print(accept(value=name))
    print(name)
    print(profile.name)
