trait Shape:
    def area(self) -> int64
    def name(self) -> str
    def grow(mut self, by: int64) -> None
    def describe(self) -> str:
        return f"{self.name()} of area {self.area()}"

class Square:
    side: int64

class Rect:
    w: int64
    h: int64

class Label:
    text: str
    hits: list[int64]

impl Shape for Square:
    def area(self) -> int64:
        return self.side * self.side
    def name(self) -> str:
        return "square"
    def grow(mut self, by: int64) -> None:
        self.side += by

impl Shape for Rect:
    def area(self) -> int64:
        return self.w * self.h
    def name(self) -> str:
        return "rect"
    def grow(mut self, by: int64) -> None:
        self.w += by
        self.h += by

impl Shape for Label:
    def area(self) -> int64:
        return len(self.text) + len(self.hits)
    def name(self) -> str:
        return self.text.clone()
    def grow(mut self, by: int64) -> None:
        self.hits.append(by)
    def describe(self) -> str:
        return f"label {self.text}"


trait Named:
    def title(self) -> str

trait Tool: Named:
    def run(self) -> int64

class Echo:
    n: int64

impl Named for Echo:
    def title(self) -> str:
        return "echo"

impl Tool for Echo:
    def run(self) -> int64:
        return self.n

def area_of(shape: dyn Shape) -> int64:
    return shape.area()

def first[T](items: own list[T]) -> T:
    mut owned = items
    return owned.pop()

def main() -> None:
    square = Square(side=3) as dyn Shape
    print(square.area())
    shapes = [Square(side=1) as dyn Shape, Rect(w=2, h=2), Label(text="abc", hits=[])]
    for shape in shapes:
        print(shape.describe())
    print(len(shapes))
    last = first([Rect(w=1, h=1) as dyn Shape, Square(side=5)])
    print(last.name())
    rect = Rect(w=2, h=5)
    print(area_of(rect as dyn Shape))
    print((rect as dyn Shape).area())
    print(rect.w)
    moved = rect as dyn Shape
    print(moved.describe())
    again = moved as dyn Shape
    print(again.area())
    tool = Echo(n=7) as dyn Tool
    named = tool as dyn Named
    print(named.title())
    pair = (Square(side=2) as dyn Shape, 5)
    (shape, extra) = pair
    print(shape.area() + extra)
    maybe: dyn Shape | None = Square(side=4) as dyn Shape
    if maybe is not None:
        print(maybe.area())
    make: def() -> dyn Shape = lambda: Square(side=6) as dyn Shape
    print(make().area())
    table = {"a": Square(side=1) as dyn Shape}
    print(table["a"].area())
    print(f"{(Square(side=9) as dyn Shape).area()}")
