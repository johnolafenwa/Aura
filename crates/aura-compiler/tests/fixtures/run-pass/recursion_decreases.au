def walk(xs: list[int64], i: int64 = 0) -> int64:
    requires 0 <= i and i <= len(xs)
    decreases len(xs) - i
    if i == len(xs):
        return 0
    return xs[i] + walk(xs, i=i + 1)

def gcd(a: int64, b: int64) -> int64:
    requires a >= 0 and b >= 0
    decreases b
    if b == 0:
        return a
    return gcd(b, a % b)

def main():
    print(walk([1, 2, 3, 4]))
    print(gcd(84, 36))
