class Moves:
    values: list[int64]

    def reverse_pair(mut self):
        self.values.swap(-1, 0)


def main():
    mut moves = Moves(values=[1, 2, 3])
    copy = moves.values.copy()
    moves.reverse_pair()
    moves.values.swap(-2, 1)
    print(copy)
    print(moves.values)
