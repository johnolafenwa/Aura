# A literal in a `while ... and` condition can reach the comparison as an
# `int64` while the element is narrower, so each comparison below is between
# two integer kinds.
def main():
    data: list[uint8] = [35, 35, 35, 7]
    mut level = 0
    n = len(data)
    while level < n and data[level] == 35:
        level += 1
    print(level)
    words: list[uint64] = [18446744073709551615, 3]
    mut i = 0
    while i < 2 and words[i] > 2:
        i += 1
    print(i)
    mut j = 0
    while j < 2 and words[j] != 3:
        j += 1
    print(j)
    shorts: list[int16] = [-5, 4]
    mut k = 0
    while k < 2 and shorts[k] < 0:
        k += 1
    print(k)
    big: list[uint32] = [4294967295]
    mut m = 0
    while m < 1 and big[m] >= 4294967295:
        m += 1
    print(m)
    neg: list[int8] = [-1]
    mut q = 0
    while q < 1 and neg[q] <= -1:
        q += 1
    print(q)
