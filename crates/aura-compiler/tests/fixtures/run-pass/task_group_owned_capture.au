def worker(value: own str, output: Queue[str]):
    output.put(value)

def main() -> int32:
    output = Queue[str]()
    with TaskGroup() as group:
        group.start_soon(worker, "task value", output)
        match output.get():
            case QueueReceive.Item(value):
                print(value)
            case QueueReceive.Closed:
                print("closed")
            case QueueReceive.TimedOut:
                print("timed out")
            case QueueReceive.Cancelled:
                print("cancelled")
    return 0
