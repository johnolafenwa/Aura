import sync

def main():
    flag = sync.AtomicBool(false)
    print(flag.load())
    print(flag.swap(true))
    print(flag.compare_and_set(false, true))
    print(flag.compare_and_set(true, false))
    flag.store(true)
    print(flag.load())
    counter = sync.AtomicInt(4)
    print(counter.swap(9))
    print(counter.add(-2))
    print(counter.compare_and_set(9, 0))
    print(counter.compare_and_set(7, 3))
    counter.store(12)
    print(counter.load())
    cache = sync.Map[str, list[int64]]()
    print(cache.get("absent"))
    cache.set("a", [3])
    snapshot = cache.snapshot()
    print(cache.contains("a"))
    print(cache.get("a"))
    cache.set("a", [4])
    print(cache.remove("a"))
    print(cache.remove("a"))
    print(snapshot["a"])
    cache.set("b", [7])
    cache.clear()
    print(cache.len())
    counts = sync.Map[int64, int64]()
    print(counts.get(-1))
    counts.set(-1, 8)
    print(counts.get(-1))
