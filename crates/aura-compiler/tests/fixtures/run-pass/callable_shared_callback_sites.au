import control

type Doubler = Callable[def(value: int64) -> int64]
type Even = Callable[def(value: int64) -> bool]
type Keyed = Callable[def(value: str) -> int64]
type Worker = TaskCallable[def() -> Result[int64, str]]

def double(value: int64) -> int64:
    return value * 2

def main():
    numbers: list[int64] = [3, 1, 2]
    doubler = Doubler(double)
    print(numbers.map(doubler))
    print(numbers.map(doubler))
    even = Even(lambda value: value % 2 == 0)
    print(numbers.filter(even))
    mut names: list[str] = ["ccc", "a", "bb"]
    by_len = Keyed(lambda value: value.len())
    names.sort(key=by_len)
    print(names)
    worker = Worker(lambda: Result.Ok(7))
    print(control.retry(worker, max_attempts=2))
    print(numbers.map(doubler).len())
