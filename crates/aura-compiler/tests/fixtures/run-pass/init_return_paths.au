class Config:
    mode: str
    level: int64

    def __init__(self, raw: int64):
        self.level = raw
        if raw < 0:
            self.mode = "off"
            self.level = 0
            return
        match raw:
            case 0:
                self.mode = "idle"
            case 1:
                self.mode = "low"
            case _:
                self.mode = "high"

def main():
    print(Config(-1).mode)
    print(Config(0).mode)
    print(Config(1).mode)
    c = Config(5)
    print(f"{c.mode} {c.level}")
