def print_optional_string(value: own str | None):
    match own value:
        case str as inner:
            print(inner)
        case None:
            print("none")

def main() -> int32:
    text = "  Aura Repo  "
    trimmed = text.trim()
    parts = trimmed.split(" ")
    print(parts.len())
    match parts.get(0):
        case Lookup.Found(value):
            print(value)
        case Lookup.Missing:
            pass
    match parts.get(1):
        case Lookup.Found(value):
            print(value)
        case Lookup.Missing:
            pass
    print(trimmed.replace("Repo", "Lang"))
    print(trimmed.to_lower())
    print(trimmed.to_upper())
    print_optional_string(trimmed.strip_prefix("Aura "))
    print_optional_string(trimmed.strip_prefix("Repo"))
    print_optional_string(trimmed.strip_suffix(" Repo"))
    print_optional_string(trimmed.strip_suffix("Aura"))
    return 0
