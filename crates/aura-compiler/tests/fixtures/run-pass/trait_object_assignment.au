trait Shape:
    def area(self) -> int64
    def name(self) -> str
    def grow(mut self, by: int64) -> None
    def describe(self) -> str:
        return f"{self.name()} of area {self.area()}"


class Square:
    side: int64


class Rect:
    w: int64
    h: int64


class Label:
    text: str
    hits: list[int64]


impl Shape for Square:
    def area(self) -> int64:
        return self.side * self.side
    def name(self) -> str:
        return "square"
    def grow(mut self, by: int64) -> None:
        self.side += by


impl Shape for Rect:
    def area(self) -> int64:
        return self.w * self.h
    def name(self) -> str:
        return "rect"
    def grow(mut self, by: int64) -> None:
        self.w += by
        self.h += by


impl Shape for Label:
    def area(self) -> int64:
        return len(self.text) + len(self.hits)
    def name(self) -> str:
        return self.text.clone()
    def grow(mut self, by: int64) -> None:
        self.hits.append(by)
    def describe(self) -> str:
        return f"label {self.text}"


class Holder:
    shape: dyn Shape
    count: int64


def pick(big: bool) -> dyn Shape:
    if big:
        return Rect(w=10, h=10)
    return Square(side=1)


def total(shapes: list[dyn Shape]) -> int64:
    mut sum = 0
    for shape in shapes:
        sum += shape.area()
    return sum


def main() -> None:
    mut current: dyn Shape = Square(side=2)
    print(current.describe())
    current = Rect(w=2, h=5)
    print(current.describe())
    current = pick(true)
    print(current.area())
    mut holder = Holder(shape=Square(side=3), count=0)
    holder.shape.grow(1)
    print(holder.shape.area())
    holder.shape = Label(text="tag", hits=[1, 2])
    print(holder.shape.describe())
    mut shapes: list[dyn Shape] = []
    shapes.append(Square(side=1))
    shapes.append(pick(false))
    shapes.insert(0, Rect(w=1, h=7))
    shapes[1] = Label(text="swapped", hits=[])
    print(total(shapes))
    mut index = 0
    while index < len(shapes):
        shapes[index].grow(1)
        print(shapes[index].describe())
        index += 1
    mut table: dict[str, dyn Shape] = {}
    table["one"] = Square(side=4)
    table["two"] = Rect(w=1, h=2)
    table["one"] = Rect(w=3, h=3)
    for key in ["one", "two"]:
        print(f"{key}: {table[key].area()}")
    removed = table.remove("one")
    print(len(table))
    last = shapes.pop()
    print(last.name())
    shapes.clear()
    print(len(shapes))
