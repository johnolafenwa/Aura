def main() -> int32:
    ok: Result[int32, str] = Ok(7)
    err: Result[int32, str] = Err("bad")
    found: Lookup[int32] = Found(3)
    missing: Lookup[int32] = Missing()
    ready: Poll[int32] = Ready(5)
    unavailable: Poll[int32] = Unavailable()

    match own ok:
        case Ok(value):
            print(value)
        case Err(message):
            print(message)

    match own err:
        case Ok(value):
            print(value)
        case Err(message):
            print(message)

    match own found:
        case Found(value):
            print(value)
        case Missing:
            print(0)

    match own missing:
        case Found(value):
            print(value)
        case Missing:
            print(1)

    match own ready:
        case Ready(value):
            print(value)
        case Unavailable:
            print(-1)

    match own unavailable:
        case Ready(value):
            print(value)
        case Unavailable:
            print(2)
    return 0
