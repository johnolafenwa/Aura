def main() -> int32:
    ok: Result[int32, str] = Ok(7)
    err: Result[int32, str] = Err("bad")
    some: Option[int32] = Some(3)
    none: Option[int32] = None

    match own ok:
        case Ok(value):
            print(value)
        case Err(message):
            print(message)

    match own err:
        case Ok(value):
            print(value)
        case Err(message):
            print(message)

    match own some:
        case Some(value):
            print(value)
        case None:
            print(0)

    match own none:
        case Some(value):
            print(value)
        case None:
            print(1)
    return 0
