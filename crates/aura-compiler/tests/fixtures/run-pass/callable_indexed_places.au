type Step = Callable[def(value: int64) -> int64]


class Board:
    steps: list[Step]

    def run(self, index: int64, value: int64) -> int64:
        return self.steps[index](value) + self.steps[0](value)


def main() -> None:
    offset = 3
    board = Board(steps=[lambda value: value + offset])
    print(board.run(0, 4))
    pair: (Step, int64) = (lambda value: value * offset, 0)
    print(pair[0](2))
    print(pair[0](3))
