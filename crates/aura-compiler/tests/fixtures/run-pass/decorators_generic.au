"""Generic decorators infer their type parameters from each decorated function."""

type Fn[A, R] = Callable[def(args: A) -> R]
type Decorator[A, R] = Callable[def(f: own Fn[A, R]) -> Fn[A, R]]


def traced[A, R](f: own Fn[A, R]) -> Fn[A, R]:
    print("traced")
    return Fn[A, R](lambda [own f] args: trace_call(f, args))


def trace_call[A, R](f: Fn[A, R], args: A) -> R:
    print("enter")
    result = f(args)
    print("leave")
    return result


def retry[A, R, E](attempts: own int32) -> Decorator[A, Result[R, E]]:
    return Decorator[A, Result[R, E]](lambda [own attempts] own f: retrying(f, attempts))


def retrying[A, R, E](f: own Fn[A, Result[R, E]], attempts: own int32) -> Fn[A, Result[R, E]]:
    return Fn[A, Result[R, E]](lambda [own f, own attempts] args: attempt(f, args, attempts))


def attempt[A, R, E](f: Fn[A, Result[R, E]], args: A, attempts: int32) -> Result[R, E]:
    mut tries: int32 = 1
    while tries < attempts:
        match own f(args):
            case Ok(value):
                return Ok(value)
            case Err(error):
                print(f"attempt {tries} failed")
        tries += 1
    return f(args)


@traced
def label(args: str) -> str:
    return f"<{args}>"


@traced
def fact(args: int64) -> int64:
    if args <= 1:
        return 1
    return args * fact(args - 1)


@retry(3)
@traced
def half(args: int64) -> Result[int64, str]:
    if args % 2 == 0:
        return Ok(args // 2)
    return Err("odd")


def main():
    print(label("x"))
    print(fact(3))
    match own half(8):
        case Ok(value):
            print(value)
        case Err(error):
            print(error)
    match own half(3):
        case Ok(value):
            print(value)
        case Err(error):
            print(error)
