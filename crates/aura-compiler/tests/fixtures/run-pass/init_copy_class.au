copy class Point:
    x: float64
    y: float64
    length_squared: float64

    def __init__(self, x: float64, y: float64):
        self.x = x
        self.y = y
        self.length_squared = x * x + y * y

def main():
    point = Point(3.0, 4.0)
    copied = point
    print(f"{point.x} {point.y} {copied.length_squared}")
