def print_int_option(value: Option[int32]):
    match own value:
        case Some(inner):
            print(inner)
        case None:
            print(-999)

def main() -> int32:
    mut values: list[int32] = [10, 20, 30, 40]
    print(values[-1])
    values[-2] = 35
    print(values[-2])
    print_int_option(values.get(-4))
    print_int_option(values.get(-5))
    print(values.set(index=-4, value=11))
    print(values.pop(-2))
    values.swap(first=-1, second=-3)
    print(true)
    values.insert(index=-1, value=99)
    print(true)
    end_index: int32 = values.len() as int32
    values.insert(index=end_index, value=77)
    print(true)
    for value in values:
        print(value)
    return 0
