trait Show:
    def show(self) -> String

class Box[T]:
    value: T

impl Show for Box[int32]:
    def show(self) -> String:
        return f"{self.value}"

impl Show for Box[String]:
    def show(self) -> String:
        return self.value.clone()

def render[T: Show](value: T) -> None:
    print(value.show())

def main() -> int32:
    render(Box[int32](value=7))
    render(Box(value="hi"))
    return 0
