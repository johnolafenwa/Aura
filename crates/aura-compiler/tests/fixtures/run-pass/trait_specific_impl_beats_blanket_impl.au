trait Show:
    def show(self) -> str

class Box[T]:
    value: T

impl[T] Show for Box[T]:
    def show(self) -> str:
        return "generic"

impl Show for Box[int32]:
    def show(self) -> str:
        return "int32"

def render[T: Show](value: T) -> None:
    print(value.show())

def main() -> int32:
    render(Box[int32](value=7))
    render(Box(value="hi"))
    return 0
