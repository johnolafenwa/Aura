import math

def near(value: float64, expected: float64) -> bool:
    difference = value - expected
    return difference < 0.000000000001 and difference > -0.000000000001


def main() -> int32:
    print(math.tau)
    print(math.sqrt(2.0))
    print(near(math.cbrt(-27.0), -3.0))
    print(near(math.asin(1.0), math.pi / 2.0))
    print(math.acos(1.0))
    print(near(math.atan(1.0), math.pi / 4.0))
    print(near(math.atan2(1.0, -1.0), 3.0 * math.pi / 4.0))
    print(near(math.sinh(1.0), 1.1752011936438014))
    print(math.cosh(0.0))
    print(near(math.tanh(0.5), 0.46211715726000974))
    print(near(math.asinh(1.0), 0.881373587019543))
    print(math.acosh(1.0))
    print(near(math.atanh(0.5), 0.5493061443340548))
    print(near(math.expm1(0.000001), 0.0000010000005000001665))
    print(near(math.log1p(0.000001), 0.0000009999995000003334))
    print(near(math.hypot(3.0, 4.0), 5.0))
    print(math.copysign(2.5, -0.0))
    print(near(math.degrees(math.pi), 180.0))
    print(near(math.radians(180.0), math.pi))
    print(math.is_nan(math.nan))
    print(math.is_nan(math.asin(math.nan)))
    print(math.is_inf(-math.inf))
    print(math.is_finite(math.inf))
    print(math.gcd(84, -36))
    print(math.gcd(0, 0))
    print(math.lcm(4, 6))
    print(math.isqrt(99))
    print(math.factorial(20))
    print(math.comb(52, 5))
    print(math.perm(10, 3))
    return 0
