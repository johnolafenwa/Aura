def main() -> int32:
    names = ["Ada", "Grace"]
    match names.get(0):
        case Option.Some(value):
            print(value)
        case Option.None:
            pass
    match names.get(1):
        case Option.Some(value):
            print(value)
        case Option.None:
            pass

    grids = [[1, 2], [3, 4]]
    match grids.get(0):
        case Option.Some(row):
            print(row[1])
        case Option.None:
            pass
    match grids.get(1):
        case Option.Some(row):
            print(row[0])
        case Option.None:
            pass
    return 0
