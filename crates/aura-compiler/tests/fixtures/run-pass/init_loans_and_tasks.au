enum Shape:
    Circle(int64)
    Square(int64)

type Unary = def(value: int64) -> int64

def increment(value: int64) -> int64:
    return value + 1

def first(items: list[int64]) -> view int64 from items:
    return view items[0]

def bump(value: mut int64):
    value += 10

def worker(results: Queue[int64], value: int64):
    results.put(value * 2)

class Ledger:
    items: list[int64]
    total: int64
    label: str
    area: int64
    step: Unary
    maybe: int64 | None

    def __init__(self, seed: int64, shape: Shape):
        self.items = [seed, seed + 1]
        view mut slot = self.items[1]
        slot += 5
        bump(slot)
        bumped: int64 = slot + 0
        view head = first(self.items)
        self.total = head + bumped
        self.label = f"{-self.total} {self.total as int32:>6}"
        match shape:
            case Shape.Circle(radius):
                self.area = radius * radius * 3
            case Shape.Square(side):
                self.area = side * side
        self.step = Unary(increment)
        self.maybe = None
        if self.maybe is None:
            self.maybe = self.step(self.total)
        results = Queue[int64]()
        with TaskGroup() as group:
            group.start(worker, results, self.area)
        match results.get(timeout=1s):
            case QueueReceive.Item(value):
                self.total += value
            case _:
                pass
        pair = (self.total, self.area)
        self.items.append(pair[1])

def main():
    ledger = Ledger(2, Shape.Square(3))
    print(ledger.items)
    print(ledger.total)
    print(ledger.label)
    print(ledger.area)
    print(ledger.maybe)
