def main():
    mut names = list[str]()
    names.append("ada")
    names.append("grace")
    for index, name in enumerate(names):
        print(f"{index}:{name}")

    mut tags = set[str]()
    tags.add("beta")
    for index, tag in enumerate(tags):
        print(f"set {index}:{tag}")

    mut numbers = list[int64]()
    numbers.append(1)
    numbers.append(2)
    numbers.append(3)
    mut words = list[str]()
    words.append("one")
    words.append("two")
    for number, word in zip(numbers, words):
        print(f"{number}={word}")

    for number, word in zip(words, numbers):
        print(f"{number}={word}")

    for item in words:
        print(f"plain {item}")

    for item in numbers:
        print(item + 10)

    for index, value in enumerate(numbers):
        if index == 0:
            continue
        if value == 3:
            break
        print(f"skip {index}->{value}")

    print(names.len())
    print(numbers.len())
