type OwnFn = Callable[def(x: int64) -> int64]
type OwnedFn = Callable[own def(x: int64) -> int64]

class Holder:
    f: OwnFn | int64

def make(xs: own list[int64]) -> OwnFn:
    def finish(x: int64) -> int64:
        return x + len(xs)
    return finish

def make_own(s: own str) -> OwnedFn:
    def finish(x: int64) -> int64:
        return x + len(s)
    return finish

def main():
    xs: list[OwnFn | None] = [make([50])]
    ys: list[OwnedFn | None] = [make_own("abc"), None]
    d: dict[str, OwnFn | None] = {"k": make([1, 2])}
    t: (OwnFn | None, int64) = (make([1]), 3)
    h = Holder(f=make([1, 2, 3]))
    print(len(xs) + len(ys) + len(d) + t[1])
