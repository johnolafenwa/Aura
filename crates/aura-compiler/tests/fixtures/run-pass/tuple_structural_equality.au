def trace_singleton(label: str, value: int32) -> (int32,):
    print(label)
    return (value,)

def trace_text(label: str, value: own str) -> (str,):
    print(label)
    return (value,)

def nested_with_score[T](value: own T, score: float32) -> (T, (float32,)):
    return (value, (score,))

def generic_equal[T](value: own T, expected: ((T,),)) -> bool:
    actual = ((value,),)
    return actual == expected

def main() -> int32:
    print((1, ("north",)) == (1, ("north",)))
    print((1, ("north",)) != (1, ("south",)))
    print((("only",),) == (("only",),))
    print((("only",),) != (("only",),))

    concrete: ((Option[int32],), (float32,)) = ((None,), (1,))
    print(((None,), (1,)) == concrete)
    print(concrete == ((None,), (1,)))
    print(((None,), (2,)) != concrete)
    print(((None,), (1,)) == concrete == ((None,), (1,)))

    left = ("kept", ("inside",))
    same = ("kept", ("inside",))
    print(left == same)
    print(left != same)
    print(left == same)
    print(f"{left}")
    print(f"{same}")

    print(
        trace_singleton("a", 1)
        == trace_singleton("b", 1)
        == trace_singleton("c", 1)
    )
    print(
        trace_singleton("x", 1)
        == trace_singleton("y", 2)
        == trace_singleton("z", 2)
    )
    print(
        trace_text("p", "A")
        != trace_text("q", "B")
        == trace_text("r", "B")
    )
    print(
        trace_text("u", "A")
        != trace_text("v", "A")
        == trace_text("w", "A")
    )

    score: float32 = 1.25
    generic_left = nested_with_score[str]("aura", score)
    generic_same = nested_with_score[str]("aura", score)
    print(generic_left == generic_same)
    print(generic_left != nested_with_score[str]("aura", 2.5))
    print(generic_left == generic_same)

    value: float32 = 1.25
    expected: ((float32,),) = ((value,),)
    print(generic_equal[float32](value, expected))
    return 0
