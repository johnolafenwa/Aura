import sync


def early(lock: sync.Mutex[int64]) -> int64:
    with lock.lock() as value:
        value += 1
        return value + 0


def stop() -> Result[int64, str]:
    return Result.Err("stop")


def propagate(lock: sync.Mutex[int64]) -> Result[int64, str]:
    with value = lock.lock():
        value += 1
        n = try stop()
        return Result.Ok(n)


class Finish:
    def __exit__(mut self) -> Result[None, str]:
        print("finish")
        return Result.Err("exit error")


def nested(lock: sync.Mutex[int64], fail: bool) -> Result[int64, str]:
    with value = lock.lock():
        value += 1
        with manager = Finish():
            if fail:
                _ = try stop()
            return Result.Ok(value + 0)
    return Result.Ok(0)


def show(result: Result[int64, str]):
    match result:
        case Result.Err(message):
            print(message)
        case Result.Ok(n):
            print(n)


def main() -> int32:
    lock = sync.Mutex[int64](0)
    print(early(lock))
    for index in range(4):
        with value = lock.lock():
            value += 1
            if index < 2:
                continue
            break
    print(propagate(lock).is_err())
    print(lock.replace(17))
    lock.set(11)
    with value = lock.lock():
        print(value)
    show(nested(lock, true))
    show(nested(lock, false))
    print(lock.replace(19))
    print(lock.is_poisoned())
    return 0
