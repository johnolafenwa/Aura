trait Add[Rhs, Out]:
    def add(self, rhs: Rhs) -> Out

class Label:
    value: String

impl Add[Label, String] for Label:
    def add(self, rhs: Label) -> String:
        return self.value

def main():
    left = Label(value="left")
    right = Label(value="right")
    alias = left + right
    print(alias)
