trait Add[Rhs, Out]:
    def add(mut self, rhs: Rhs) -> Out

copy class Counter:
    value: int32

impl Add[Counter, Counter] for Counter:
    def add(mut self, rhs: Counter) -> Counter:
        self.value += rhs.value
        return self

def main():
    left = Counter(value=1)
    right = Counter(value=2)
    print(left + right)
