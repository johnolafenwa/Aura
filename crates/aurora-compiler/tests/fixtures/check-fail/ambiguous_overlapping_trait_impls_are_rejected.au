trait Show:
    def show(borrow self) -> String

class Pair[A, B]:
    left: A
    right: B

impl[T] Show for Pair[int32, T]:
    def show(borrow self) -> String:
        return "left"

impl[T] Show for Pair[T, int32]:
    def show(borrow self) -> String:
        return "right"

def main() -> int32:
    pair: Pair[int32, int32] = Pair(left=1, right=2)
    print(pair.show())
    return 0
