def apply(transform: def(int64) -> int64, value: int64) -> int64:
    return transform(value)

def main():
    identity = lambda value: value
    consume = lambda own value: value
    update = lambda mut value: value
    combine = lambda left, right: left + right
    deferred = lambda: 42
    selected = lambda value: value if true else 0
    nested = lambda left: lambda right: left + right
    direct = (lambda value: value)(1)
    passed = apply(lambda value: value + 1, 41)
