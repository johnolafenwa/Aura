def worker(out: Queue[int32]):
    mut i: int32 = 0
    while i < 3:
        if cancelled():
            return
        out.put(i)
        i += 1

def main() -> int32:
    out = Queue[int32]()
    mut total: int32 = 0

    with TaskGroup() as group:
        group.start(worker, out)
        mut seen: int32 = 0

        while seen < 3:
            match out.get(timeout=5ms):
                case QueueReceive.Item(next):
                    total += next
                    seen += 1
                case QueueReceive.Closed:
                    break
                case QueueReceive.TimedOut:
                    pass
                case QueueReceive.Cancelled:
                    break

        out.close()

    print(total)
    return 0
