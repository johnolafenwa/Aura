def echo(value: own String) -> String:
    return value

def main() -> int32:
    text = 'it\'s "Aurora"'
    mut counts = {'key': 7}
    print(counts['key'])
    print(f"{echo('{left')}")
    match own text:
        case 'it\'s "Aurora"':
            print('matched')
        case _:
            print('missed')
    return 0
