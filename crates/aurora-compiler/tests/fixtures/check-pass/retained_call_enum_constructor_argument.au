enum Wrapped[T]:
    Value(T)

def main():
    mut options: Vec[Option[int32]] = []
    options.push(Option.Some(1))
    options.push(Option.None)

    mut results: Vec[Result[int32, String]] = []
    results.push(Result.Ok(2))

    mut wrapped: Vec[Wrapped[int32]] = []
    wrapped.push(Wrapped[int32].Value(3))
