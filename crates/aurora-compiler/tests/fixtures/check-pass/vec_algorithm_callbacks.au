trait Ord[Rhs]:
    def lt(self, rhs: Rhs) -> bool

class Score:
    value: int32

impl Ord[Score] for Score:
    def lt(self, rhs: Score) -> bool:
        return self.value < rhs.value

def show(value: int64) -> String:
    return value.to_string()

def keep(value: int64) -> bool:
    return value > 0

def score_key(value: Score) -> int32:
    return value.value

def identity(value: int64) -> int64:
    return value

def main():
    mut values = [3, 1, 2]
    values.sort()
    values.sort_by(key=identity)
    labels: Vec[String] = values.map(f=show)
    retained: Vec[int64] = values.filter(f=keep)

    mut scores = [Score(value=2), Score(value=1)]
    scores.sort()
    scores.sort_by(score_key)
