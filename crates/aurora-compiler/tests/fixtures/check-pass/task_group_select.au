def worker(out: Queue[int32]):
    mut i: int32 = 0
    while i < 3:
        if cancelled():
            return
        out.put(i)
        i += 1

def main() -> int32:
    out: Queue[int32] = queue()
    mut total: int32 = 0

    with tasks() as group:
        group.start(worker, out)
        mut seen: int32 = 0

        while seen < 3:
            select:
                case value = out.get():
                    match value:
                        case Option.Some(next):
                            total += next
                            seen += 1
                        case Option.None:
                            break

        out.close()

    print(total)
    return 0
