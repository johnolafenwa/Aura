def producer(out: Queue[int32]):
    out.put(2)
    out.put(4)
    out.close()

def main() -> int32:
    ch: Queue[int32] = queue()
    task = spawn producer(ch)

    while true:
        match ch.get():
            case Option.Some(value):
                print(value)
            case Option.None:
                break

    task.result()
    return 0
