def main() -> int32:
    jobs = Queue[int32]()
    jobs.close()

    send_result = jobs.put(7)
    match own send_result:
        case Result.Ok(done):
            print("sent")
        case Result.Err(err):
            match own err:
                case SendError.Closed(value):
                    print(value)
                case SendError.Cancelled(value):
                    print(value)
                case SendError.TimedOut(value):
                    print(value)
                case SendError.Full(value):
                    print(value)

    return 0
