trait Describe:
    def describe(borrow self) -> String

impl[T] Describe for Task[T]:
    def describe(borrow self) -> String:
        return "task trait"

def answer() -> int32:
    return 42

def main() -> int32:
    with group = TaskGroup():
        task = group.start(answer)
        print(task.describe())
    return 0
