class Box:
    value: String

def store(values: borrow mut Vec[String], unique: borrow mut Set[String], labels: borrow mut Map[String, String], output: Queue[String], vec_value: own String, set_value: own String, map_key: own String, map_value: own String, queue_value: own String, field_value: own String) -> Box:
    values.push(vec_value)
    unique.insert(set_value)
    labels.set(map_key, map_value)
    output.try_put(queue_value)
    return Box(value=field_value)

def main() -> int32:
    mut values: Vec[String] = []
    mut unique: Set[String] = Set[String]()
    mut labels: Map[String, String] = Map[String, String]()
    output = Queue[String]()
    boxed = store(values, unique, labels, output, "vec", "set", "key", "map", "queue", "field")

    print(values.len())
    print(unique.len())
    print(labels.len())
    match output.get():
        case QueueReceive.Item(value):
            print(value)
        case QueueReceive.Closed:
            print("closed")
        case QueueReceive.TimedOut:
            print("timed out")
        case QueueReceive.Cancelled:
            print("cancelled")
    print(boxed.value)
    return 0
