def show(value: own SelectOutcome[String, None]):
    match own value:
        case SelectOutcome.Queue(index, outcome):
            print(index)
            print(outcome)
        case SelectOutcome.Task(_, _):
            print("unexpected task")
        case SelectOutcome.Deadline(index):
            print(index)
        case SelectOutcome.Cancelled:
            print("cancelled")

def main():
    first = Queue[String]()
    second = Queue[String]()
    first.put("first")
    second.put("second")
    show(select(first, second))
    print(second.get())

    duplicate = Queue[String]()
    duplicate.put("one")
    duplicate.put("two")
    show(select(duplicate, duplicate))
    print(duplicate.get())

    buffered = Queue[String]()
    buffered.put("buffered")
    buffered.close()
    show(select(buffered))
    show(select(buffered))
