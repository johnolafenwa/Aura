def mark(label: String, value: int32) -> int32:
    print(label)
    return value

def combine(first: int32 = mark("default-first", 1), second: int32 = mark("default-second", 2), third: int32 = mark("default-third", 3)) -> int32:
    return first + second + third

def bump(value: borrow mut int32) -> int32:
    value += 1
    return value

def show(first: int32, second: int32):
    print(first)
    print(second)

class Sample:
    first: None = print("field-first")
    second: None = print("field-second")
    third: None = print("field-third")

class Pair:
    first: int32
    second: int32

enum NamedPair:
    Values(first: int32, second: int32)

def main():
    print("function")
    print(combine(third=mark("explicit-third", 30), first=mark("explicit-first", 10)))
    print("class")
    sample = Sample(third=print("explicit-field-third"), first=print("explicit-field-first"))
    print("snapshot")
    mut value: int32 = 1
    show(second=value, first=bump(value))
    print("class snapshot")
    value = 1
    pair = Pair(second=value, first=bump(value))
    print(pair.first)
    print(pair.second)
    print("enum")
    named = NamedPair.Values(second=mark("enum-second", 2), first=mark("enum-first", 1))
    match named:
        case NamedPair.Values(first, second):
            print(first)
            print(second)
