def print_int_option(value: Option[int32]):
    match value:
        case Some(inner):
            print(inner)
        case None:
            print(-1)

def main() -> int32:
    mut values: Vec[int32] = [1, 2, 3]
    print(values.len())
    print(values.is_empty())
    print_int_option(values.get(1))
    print_int_option(values.set(index=1, value=20))
    print_int_option(values.remove(0))
    values.push(99)
    print_int_option(values.pop())
    mut total: int32 = 0
    for value in values:
        total += value
    print(total)
    return 0
