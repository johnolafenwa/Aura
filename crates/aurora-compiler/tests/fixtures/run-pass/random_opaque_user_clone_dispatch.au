import random

trait FreshClone:
    def clone(borrow self) -> Holder

class Holder:
    generator: random.Rng
    seed: int64

impl FreshClone for Holder:
    def clone(borrow self) -> Holder:
        return Holder(random.Rng(self.seed), self.seed)

def main() -> int32:
    mut original = Holder(random.Rng(42), 42)
    mut copied = original.clone()

    print(original.generator.next_float())
    print(copied.generator.next_float())
    print(original.generator.next_float())
    print(copied.generator.next_float())
    return 0
