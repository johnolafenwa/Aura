enum Opt:
    Some(int32)
    None

def main() -> int32:
    mut x: Opt = Opt.Some(10)
    match borrow mut x:
        case Some(v):
            v = v + 1
            if false:
                x = Opt.Some(100)
        case None:
            pass
    match borrow x:
        case Some(v):
            print(v)
        case None:
            print(-1)
    return 0
