def main() -> int32:
    jobs: Queue[int32] = queue()
    send_one = jobs.put(1)
    send_two = jobs.put(2)
    jobs.close()

    match send_one:
        case Ok(_):
            pass
        case Err(_):
            print("send failed")

    match send_two:
        case Ok(_):
            pass
        case Err(_):
            print("send failed")

    for job in jobs:
        print(job)

    return 0
