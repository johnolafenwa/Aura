trait Base:
    def base(borrow self) -> int32

trait Derived: Base:
    def derived(borrow self) -> int32

class Counter:
    value: int32

impl Base for Counter:
    def base(borrow self) -> int32:
        return self.value

impl Derived for Counter:
    def derived(borrow self) -> int32:
        return self.value + 1

def total[T: Derived](value: T) -> int32:
    return value.base() + value.derived()

def main() -> int32:
    counter = Counter(value=10)
    print(total(counter))
    return 0
