def producer(out: Channel[int32]):
    out.send(2)
    out.send(4)
    out.close()

def main() -> int32:
    ch: Channel[int32] = channel()
    task = spawn producer(ch.clone())

    while true:
        match ch.recv():
            case Option.Some(value):
                print(value)
            case Option.None:
                break

    task.join()
    return 0
