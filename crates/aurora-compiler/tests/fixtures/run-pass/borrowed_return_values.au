class User:
    score: int32

def score_ref(user: User) -> int32:
    return user.score

class Holder:
    value: int32

    def value_ref(self) -> int32:
        return self.value

def print_score(score: int32):
    print(score)

def main():
    user = User(score=7)
    holder = Holder(value=9)
    print(score_ref(user))
    print(holder.value_ref())
    print_score(score_ref(user))
