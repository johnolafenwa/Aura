import function_value_imported_support.helpers

def apply(transform: def(int32) -> int32, value: int32) -> int32:
    return transform(value)

def main() -> int32:
    imported = function_value_imported_support.helpers.triple
    imported_empty: def() -> Option[int32] = function_value_imported_support.helpers.empty
    print(imported(4))
    print(apply(imported, 5))
    with group = TaskGroup():
        empty_task = group.start(imported_empty)
        match empty_task.result_or(Option.Some(99), timeout=1s):
            case Option.None:
                print("imported-none")
            case Option.Some(value):
                print(value)
    return 0
