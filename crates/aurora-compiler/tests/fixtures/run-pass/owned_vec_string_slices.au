def make_values() -> Vec[int32]:
    print("base")
    return [0, 1, 2, 3]

def slice_start() -> int32:
    print("start")
    return 1

def slice_end() -> int32:
    print("end")
    return 3

def main() -> int32:
    values: Vec[int32] = [0, 1, 2, 3]
    print(values[:2][1])
    print(values[2:][0])
    print(values[1:3].len())
    print(values[:].len())
    print(values[-3:-1][1])
    print(values[2:2].len())

    mut original: Vec[int32] = [5, 6, 7]
    mut copied: Vec[int32] = original[:]
    copied.set(0, 99)
    print(original[0])
    print(copied[0])

    ordered = make_values()[slice_start():slice_end()]
    print(ordered[0])

    text: String = "Aé🙂Z"
    print(text[1:3])
    print(text[:2])
    print(text[-2:])
    print(text[:])
    print("AéZ"[1:3])
    print(f"slice={text[1:3]}")

    names: Vec[String] = ["Ada", "Grace"]
    first: Vec[String] = names[:1]
    match first.get(0):
        case Option.Some(name):
            print(name)
        case Option.None:
            print("missing")
    print(names.len())
    return 0
