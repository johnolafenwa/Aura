enum Opt:
    Some(int32)
    None

class Holder:
    state: Opt
    other: int32

def main() -> int32:
    mut holder = Holder(state=Opt.Some(10), other=0)
    match mut holder.state:
        case Some(v):
            holder.other = 9
            v = v + 1
        case None:
            pass
    print(holder.other)
    match mut holder.state:
        case Some(v):
            print(v)
        case None:
            print(-1)
    return 0
