trait Add[Rhs, Out]:
    def add(mut self, rhs: own Rhs) -> Out

copy class Counter:
    value: int32

class Holder:
    text: String

impl Add[Counter, Counter] for Counter:
    def add(mut self, rhs: own Counter) -> Counter:
        self.value += rhs.value
        return self

def show_floats(first: float64, second: float64 = 2):
    print(first)
    print(second)

def main() -> int32:
    mut direct = Counter(value=1)
    direct += Counter(value=2)
    print(direct.value)

    mut counters: Vec[Counter] = [Counter(value=4)]
    counters[0] += Counter(value=5)
    print(counters[0].value)

    mut holder = Holder(text="left")
    suffix = "-right"
    holder.text += suffix
    print(holder.text)

    with TaskGroup() as group:
        group.start_soon(show_floats, 1)
    return 0
