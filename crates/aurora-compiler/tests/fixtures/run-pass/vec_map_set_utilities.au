def sum_set(values: borrow Set[int32]) -> int32:
    mut total: int32 = 0
    for value in borrow values:
        total += value
    return total

def main() -> int32:
    mut values = [1, 3]
    print(values.insert(1, 2).to_string())
    values.push(4)
    values.reverse()
    print(values[0].to_string())
    print(values[3].to_string())
    values.clear()
    print(values.is_empty().to_string())

    mut counts = {"a": 1}
    other = {"b": 2, "c": 3}
    counts.extend(other)
    items = counts.items()
    match items.get(0):
        case Option.Some(entry):
            print(entry.key)
        case Option.None:
            pass
    match items.get(2):
        case Option.Some(entry):
            print(entry.value.to_string())
        case Option.None:
            pass
    print(counts.entries().len().to_string())
    counts.clear()
    print(counts.is_empty().to_string())

    mut seen: Set[int32] = {1, 2, 2, 3}
    print(seen.len().to_string())
    print(seen.contains(2).to_string())
    print(seen.insert(2).to_string())
    print(seen.insert(4).to_string())
    print(seen.remove(1).to_string())
    print(sum_set(seen).to_string())

    copy = seen.clone()
    mut moved_total: int32 = 0
    for value in copy:
        moved_total += value
    print(moved_total.to_string())

    mut names: Set[String] = Set[String]()
    print(names.is_empty().to_string())
    print(names.insert("aurora").to_string())
    print(names.len().to_string())
    return 0
