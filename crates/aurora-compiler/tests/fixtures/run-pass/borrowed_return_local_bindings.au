class User:
    score: int32

def score_ref(user: borrow User) -> borrow[user] int32:
    return user.score

def echo_score(user: borrow User) -> borrow[user] int32:
    alias = score_ref(user)
    return alias

def main():
    user = User(score=7)
    alias = score_ref(user)
    print(alias)
    print(echo_score(user))
