public trait Named:
    def name(self) -> String

public trait Describe:
    def describe(self) -> String

public class User:
    public label: String

    public def associated() -> String:
        return "remote-associated"

    public def inherent(self) -> String:
        return f"remote-inherent:{self.label}"

impl Named for User:
    def name(self) -> String:
        return f"remote:{self.label}"

public class Holder[T]:
    public value: T

    public def source(self) -> String:
        return "remote-holder"

impl[T] Describe for Holder[T]:
    def describe(self) -> String:
        return "remote-generic-trait"

public enum Envelope[T]:
    Value(T)
    Empty
