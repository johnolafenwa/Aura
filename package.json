{
  "name": "aura-monorepo",
  "private": true,
  "version": "0.6.0",
  "packageManager": "npm@11.4.2",
  "engines": {
    "node": "22.14.0"
  },
  "workspaces": [
    "tools/*"
  ],
  "scripts": {
    "coverage:compiler": "bash scripts/coverage-compiler.sh",
    "coverage:compiler:check": "bash scripts/coverage-compiler.sh --check",
    "test:rust": "RUST_MIN_STACK=33554432 cargo test",
    "test:backend-parity": "cargo test -p aura --test backend_parity -- --ignored --test-threads=1 --nocapture",
    "test:backend-parity:llvm": "AURA_NATIVE_CODEGEN=llvm cargo test -p aura --features llvm --test backend_parity -- --ignored --test-threads=1 --nocapture",
    "test:llvm": "RUST_MIN_STACK=33554432 cargo test -p aura-compiler --lib --features llvm && AURA_NATIVE_CODEGEN=llvm RUST_MIN_STACK=33554432 cargo test -p aura-compiler --lib --features llvm direct_objects_are_identical_across_repeated_builds",
    "test:scheduler-stress": "bash scripts/stress-scheduler.sh",
    "test:scheduler-model": "cargo test -p aura-compiler --test scheduler_model",
    "bench:compiler": "cargo bench -p aura-compiler --bench compiler_pipeline",
    "bench:direct-integer-loops": "python3 scripts/bench-direct-integer-loops.py",
    "bench:scalable-runtime": "python3 scripts/bench-scalable-runtime.py",
    "bench:numeric-arrays": "python3 scripts/bench-numeric-arrays.py",
    "bench:release-performance": "python3 scripts/bench-release-performance.py",
    "test:bench-scalable-runtime": "python3 -m unittest scripts/test_bench_scalable_runtime.py",
    "test:bench-numeric-arrays": "python3 -m unittest scripts/test_bench_numeric_arrays.py",
    "test:bench-release-performance": "python3 -m unittest scripts/test_bench_release_performance.py",
    "test:release-packaging": "python3 -m unittest scripts/test_release_packaging.py",
    "test:identity": "python3 -m unittest scripts/test_aura_identity.py",
    "check:format": "cargo fmt --all --check",
    "check:clippy": "cargo clippy -p aura-core -p aura-runtime -p aura-compiler -p aura -- -D warnings",
    "check:clippy:llvm": "cargo clippy -p aura-compiler -p aura --features llvm -- -D warnings",
    "check:hygiene": "bash scripts/check-hygiene.sh",
    "check:audit": "npm audit --audit-level=moderate && cargo audit",
    "build:extension": "npm --prefix tools/vscode-aura run build",
    "package:extension": "npm --prefix tools/vscode-aura run package:vsix",
    "check:lsp": "npm --prefix tools/aura-language-server run check",
    "test:lsp": "npm --prefix tools/aura-language-server test",
    "coverage:lsp": "npm --prefix tools/aura-language-server run coverage",
    "coverage:lsp:check": "npm --prefix tools/aura-language-server run coverage:check",
    "docs:dev": "vitepress dev docs",
    "docs:llms": "python3 scripts/generate_llms.py",
    "docs:llms:check": "python3 scripts/generate_llms.py --check",
    "docs:build": "vitepress build docs",
    "check:doc-examples": "python3 scripts/check_doc_examples.py",
    "docs:preview": "vitepress preview docs",
    "check:extension": "npm --prefix tools/vscode-aura run check",
    "test:extension": "npm --prefix tools/vscode-aura test",
    "ci": "npm run check:format && npm run test:bench-scalable-runtime && npm run test:bench-numeric-arrays && npm run test:bench-release-performance && npm run test:bench-direct-integer-loops && npm run test:bench-binary-size && npm run test:native-binaries && npm run test:bench-representation && npm run test:bench-runtime-values && npm run test:bench-compile-time && npm run test:rust-baselines && npm run test:release-packaging && npm run test:identity && npm run test:rust && npm run test:backend-parity && npm run test:llvm && npm run test:backend-parity:llvm && npm run test:lsp && npm run check:extension && npm run test:extension && npm run coverage:compiler:check && npm run coverage:lsp:check && npm run check:doc-examples && npm run docs:build && npm run check:audit && npm run check:clippy && npm run check:clippy:llvm && npm run check:hygiene",
    "postinstall": "npm run build:extension",
    "test:bench-direct-integer-loops": "python3 -m unittest scripts/test_bench_direct_integer_loops.py",
    "test:bench-binary-size": "python3 -m unittest scripts/test_bench_binary_size.py",
    "test:native-binaries": "python3 -m unittest scripts/test_check_native_binaries.py scripts/test_check_aura_libraries.py",
    "check:native-binaries": "python3 scripts/check-native-binaries.py",
    "test:bench-representation": "python3 -m unittest scripts/test_bench_representation.py",
    "test:rust-baselines": "python3 -m unittest scripts/test_rust_baselines.py && python3 scripts/rust_baselines.py",
    "test:bench-runtime-values": "python3 -m unittest scripts/test_bench_runtime_values.py",
    "test:bench-compile-time": "python3 -m unittest scripts/test_bench_compile_time.py"
  },
  "devDependencies": {
    "vitepress": "2.0.0-alpha.17"
  }
}
