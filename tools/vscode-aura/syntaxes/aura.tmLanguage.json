{
  "scopeName": "source.aura",
  "name": "Aura",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#returnedViewFunctions"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#contextualSyntax"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.aura",
          "match": "#.*$"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "storage.modifier.machine.aura",
          "match": "^[ \\t]*@machine\\.(?:interrupt|naked|section|link_name|align|noinline|always_inline|used)\\b"
        },
        {
          "name": "storage.modifier.attribute.aura",
          "match": "@[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.interpolated.double.aura",
          "begin": "f\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.aura"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.aura"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.aura",
              "match": "\\\\."
            },
            {
              "name": "constant.character.escape.aura",
              "match": "\\{\\{|\\}\\}"
            },
            {
              "name": "meta.interpolation.aura",
              "begin": "\\{",
              "contentName": "meta.embedded.expression.aura",
              "beginCaptures": {
                "0": {
                  "name": "constant.character.format.placeholder.other.aura punctuation.definition.interpolation.begin.aura"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "constant.character.format.placeholder.other.aura punctuation.definition.interpolation.end.aura"
                }
              },
              "patterns": [
                {
                  "name": "meta.format-spec.aura",
                  "match": ":[^{}]*?(?=\\})",
                  "captures": {
                    "0": {
                      "name": "storage.modifier.format.aura"
                    }
                  }
                },
                {
                  "include": "#strings"
                },
                {
                  "include": "#keywords"
                },
                {
                  "include": "#builtins"
                },
                {
                  "include": "#types"
                },
                {
                  "include": "#numbers"
                },
                {
                  "include": "#operators"
                },
                {
                  "name": "variable.other.readwrite.aura",
                  "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
                }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.docstring.triple.double.aura",
          "begin": "^\\s*(\"\"\")",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.string.begin.aura"
            }
          },
          "end": "\"\"\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.aura"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.aura",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.docstring.triple.single.aura",
          "begin": "^\\s*(''')",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.string.begin.aura"
            }
          },
          "end": "'''",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.aura"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.aura",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.triple.double.aura",
          "begin": "\"\"\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.aura"
            }
          },
          "end": "\"\"\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.aura"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.aura",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.triple.single.aura",
          "begin": "'''",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.aura"
            }
          },
          "end": "'''",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.aura"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.aura",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.raw.double.aura",
          "begin": "r\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.aura"
            }
          },
          "end": "(?<!\\\\)(?:\\\\\\\\)*\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.aura"
            }
          }
        },
        {
          "name": "string.quoted.raw.single.aura",
          "begin": "r'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.aura"
            }
          },
          "end": "(?<!\\\\)(?:\\\\\\\\)*'",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.aura"
            }
          }
        },
        {
          "name": "string.quoted.binary.double.aura",
          "begin": "(?<![A-Za-z0-9_])(b)(\")",
          "beginCaptures": {
            "1": {
              "name": "storage.type.string.aura"
            },
            "2": {
              "name": "punctuation.definition.string.begin.aura"
            }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.aura"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.aura",
              "match": "\\\\(?:x[0-9A-Fa-f]{2}|.)"
            }
          ]
        },
        {
          "name": "string.quoted.binary.single.aura",
          "begin": "(?<![A-Za-z0-9_])(b)(')",
          "beginCaptures": {
            "1": {
              "name": "storage.type.string.aura"
            },
            "2": {
              "name": "punctuation.definition.string.begin.aura"
            }
          },
          "end": "'|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.aura"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.aura",
              "match": "\\\\(?:x[0-9A-Fa-f]{2}|.)"
            }
          ]
        },
        {
          "name": "string.quoted.double.aura",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.aura"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.aura"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.aura",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.aura",
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.aura"
            }
          },
          "end": "'",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.aura"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.aura",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.aura",
          "match": "\\b\\d+(?:\\.\\d+)?(?:ms|s|m)?\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.definition.ffi.layout-class.aura",
          "begin": "\\b(extern)\\s+(\"C\")(?=\\s+(?:packed|align)\\b)",
          "beginCaptures": {
            "1": {
              "name": "keyword.declaration.ffi.aura"
            },
            "2": {
              "name": "string.quoted.double.aura"
            }
          },
          "end": "\\b(class)\\s+([A-Za-z_][A-Za-z0-9_]*)|$",
          "endCaptures": {
            "1": {
              "name": "keyword.declaration.aura"
            },
            "2": {
              "name": "entity.name.type.aura"
            }
          },
          "patterns": [
            {
              "name": "storage.modifier.layout.aura",
              "match": "\\b(?:packed|align)\\b"
            },
            {
              "name": "constant.numeric.aura",
              "match": "\\b(?:0[xX][\\da-fA-F_]+|0[oO][0-7_]+|0[bB][01_]+|[\\d_]+)\\b"
            }
          ]
        },
        {
          "name": "meta.definition.ffi.opaque.aura",
          "match": "\\b(extern)\\s+(\"C\")\\s+(opaque)\\s+(class)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.ffi.aura"
            },
            "2": {
              "name": "string.quoted.double.aura"
            },
            "3": {
              "name": "keyword.declaration.ffi.aura"
            },
            "4": {
              "name": "keyword.declaration.aura"
            },
            "5": {
              "name": "entity.name.type.aura"
            }
          }
        },
        {
          "name": "meta.definition.ffi.union.aura",
          "match": "\\b(extern)\\s+(\"C\")\\s+(union)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.ffi.aura"
            },
            "2": {
              "name": "string.quoted.double.aura"
            },
            "3": {
              "name": "keyword.declaration.ffi.aura"
            },
            "4": {
              "name": "entity.name.type.aura"
            }
          }
        },
        {
          "name": "meta.definition.ffi.class.aura",
          "match": "\\b(extern)\\s+(\"C\")\\s+(class)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.ffi.aura"
            },
            "2": {
              "name": "string.quoted.double.aura"
            },
            "3": {
              "name": "keyword.declaration.aura"
            },
            "4": {
              "name": "entity.name.type.aura"
            }
          }
        },
        {
          "name": "meta.definition.ffi.function.aura",
          "match": "\\b(extern)\\s+(\"C\")\\s+(def)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.ffi.aura"
            },
            "2": {
              "name": "string.quoted.double.aura"
            },
            "3": {
              "name": "keyword.declaration.function.aura"
            },
            "4": {
              "name": "entity.name.function.aura"
            }
          }
        },
        {
          "name": "meta.definition.export.function.aura",
          "match": "\\b(export)\\s+(\"C\")\\s+(def)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.export.aura"
            },
            "2": {
              "name": "string.quoted.double.aura"
            },
            "3": {
              "name": "keyword.declaration.function.aura"
            },
            "4": {
              "name": "entity.name.function.aura"
            }
          }
        },
        {
          "name": "meta.definition.class.aura",
          "match": "\\b(class|enum|trait)\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.aura"
            },
            "2": {
              "name": "entity.name.type.aura"
            }
          }
        },
        {
          "name": "meta.definition.type-alias.aura",
          "match": "^\\s*(?:(public)\\s+)?(type)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?:\\[|=|:|$))",
          "captures": {
            "1": {
              "name": "storage.modifier.aura"
            },
            "2": {
              "name": "keyword.declaration.aura"
            },
            "3": {
              "name": "entity.name.type.aura"
            }
          }
        },
        {
          "name": "meta.definition.function.captures.aura",
          "begin": "^[\\t ]+(def)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*\\[",
          "beginCaptures": {
            "1": {
              "name": "keyword.declaration.function.aura"
            },
            "2": {
              "name": "entity.name.function.aura"
            }
          },
          "end": "\\]",
          "patterns": [
            {
              "match": "\\b(mut|own)\\b",
              "name": "storage.modifier.capture.aura"
            },
            {
              "match": "[A-Za-z_][A-Za-z0-9_]*",
              "name": "variable.other.capture.aura"
            }
          ]
        },
        {
          "name": "meta.definition.function.aura",
          "match": "\\bdef\\s+([a-zA-Z_][A-Za-z0-9_]*)",
          "captures": {
            "0": {
              "name": "keyword.declaration.function.aura"
            },
            "1": {
              "name": "entity.name.function.aura"
            }
          }
        }
      ]
    },
    "returnedViewFunctions": {
      "patterns": [
        {
          "name": "meta.definition.function.returned-view.aura",
          "begin": "^([\\t ]*)(def)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b(?=[^\\n]*\\)\\s*->\\s*view\\b\\s+(?:mut\\s+)?(?:[A-Za-z_][A-Za-z0-9_.]*|\\())",
          "beginCaptures": {
            "2": {
              "name": "keyword.declaration.function.aura"
            },
            "3": {
              "name": "entity.name.function.aura"
            }
          },
          "end": "^(?!\\1[\\t ]+)(?=[\\t ]*\\S)",
          "patterns": [
            {
              "match": "\\b(return)(\\s+)(view)\\b(?=\\s+(?:mut\\s+)?(?!(?:and|or|not|is|in|if|else)\\b)(?:[A-Za-z_][A-Za-z0-9_]*|\\())",
              "captures": {
                "1": {
                  "name": "keyword.control.aura"
                },
                "3": {
                  "name": "keyword.declaration.view.aura"
                }
              }
            },
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "contextualSyntax": {
      "patterns": [
        {
          "name": "meta.declaration.delegation.aura",
          "begin": "^\\s*(impl)\\b(?=[^#]*\\bby\\s+[A-Za-z_]\\w*\\s*:?\\s*(?:#|$))",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.aura"
            }
          },
          "end": "$",
          "patterns": [
            {
              "name": "keyword.control.delegation.aura",
              "match": "\\bby(?=\\s+[A-Za-z_]\\w*\\s*:?\\s*(?:#|$))"
            },
            {
              "include": "#comments"
            },
            {
              "include": "#keywords"
            },
            {
              "include": "#types"
            },
            {
              "include": "#operators"
            }
          ]
        },
        {
          "name": "meta.assembly.aura",
          "begin": "^[ \\t]*(asm|module_asm)[ \\t]*\\(",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.assembly.aura"
            }
          },
          "end": "\\)",
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#comments"
            },
            {
              "begin": "\\b(input|output|clobber|options)[ \\t]*\\(",
              "beginCaptures": {
                "1": {
                  "name": "keyword.other.assembly-clause.aura"
                }
              },
              "end": "\\)",
              "patterns": [
                {
                  "include": "#assemblyOperandGroup"
                },
                {
                  "include": "$self"
                }
              ]
            }
          ]
        },
        {
          "name": "meta.return-type.view.aura",
          "begin": "(->)(?=\\s*view\\b\\s+(?:mut\\s+)?(?:[A-Za-z_][A-Za-z0-9_.]*(?:\\s*\\[|\\s+from\\b)|\\())",
          "beginCaptures": {
            "1": {
              "name": "keyword.operator.aura"
            }
          },
          "end": "\\b(from)(\\s+)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?::|=|\\]|,|\\)|$))",
          "endCaptures": {
            "1": {
              "name": "keyword.declaration.view.aura"
            }
          },
          "patterns": [
            {
              "name": "keyword.declaration.view.aura",
              "match": "\\bview\\b"
            },
            {
              "name": "storage.modifier.aura",
              "match": "\\bmut\\b"
            },
            {
              "include": "#types"
            },
            {
              "include": "#operators"
            }
          ]
        },
        {
          "name": "meta.definition.view.aura",
          "begin": "^\\s*(view)\\b(?=\\s+(?:mut\\s+)?[A-Za-z_][A-Za-z0-9_]*\\s*=)",
          "beginCaptures": {
            "1": {
              "name": "keyword.declaration.view.aura"
            }
          },
          "end": "(?==)",
          "patterns": [
            {
              "name": "storage.modifier.aura",
              "match": "\\bmut\\b"
            }
          ]
        },
        {
          "match": "^\\s*(from)\\b(?=\\s+(?:[A-Za-z_][A-Za-z0-9_]*\\.)*[A-Za-z_][A-Za-z0-9_]*\\s+import\\b)",
          "captures": {
            "1": {
              "name": "keyword.control.aura"
            }
          }
        },
        {
          "match": "\\b(is)\\b(?=\\s+(?:not\\s+)?None\\b)",
          "captures": {
            "1": {
              "name": "keyword.control.aura"
            }
          }
        },
        {
          "name": "meta.definition.ffi.bit-field.aura",
          "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*:\\s*(uint(?:8|16|32|64))\\s+(bits)\\s*\\(\\s*((?:0[xX][\\da-fA-F_]+|0[oO][0-7_]+|0[bB][01_]+|[\\d_]+))\\s*\\)",
          "captures": {
            "1": {
              "name": "variable.other.member.aura"
            },
            "2": {
              "name": "support.type.primitive.aura"
            },
            "3": {
              "name": "storage.modifier.layout.aura"
            },
            "4": {
              "name": "constant.numeric.aura"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "storage.modifier.const.aura",
          "match": "\\bconst(?=\\s+[A-Za-z_][A-Za-z0-9_]*\\s*[:=])"
        },
        {
          "name": "keyword.declaration.ffi.aura",
          "match": "\\b(extern|opaque)\\b"
        },
        {
          "name": "keyword.control.contract.aura",
          "match": "^\\s*(requires|ensures|invariant|decreases)(?=\\s+[^\\s=:,.)\\]])"
        },
        {
          "name": "keyword.control.flow.yield.aura",
          "match": "^\\s*yield(?=\\s+[^\\s=:,.)\\]])"
        },
        {
          "name": "storage.modifier.spec.aura",
          "match": "\\b(spec|lemma)(?=\\s+def\\b)"
        },
        {
          "name": "storage.modifier.ghost.aura",
          "match": "^\\s*\\bghost(?=\\s+(mut\\s+)?[A-Za-z_][A-Za-z0-9_]*\\s*(:|=|\\+=|-=|\\*=))"
        },
        {
          "name": "keyword.control.aura",
          "match": "\\b(import|return|assert|if|elif|else|while|for|in|match|case|with|try|lambda|and|or|not|break|continue|pass|impl|as)\\b"
        },
        {
          "name": "storage.modifier.dyn.aura",
          "match": "\\bdyn(?=\\s+[A-Za-z_])"
        },
        {
          "name": "storage.modifier.aura",
          "match": "\\b(public|mut|own|indirect|copy)\\b"
        },
        {
          "name": "constant.language.aura",
          "match": "\\b(None|true|false|self|Self)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.aura",
          "match": "(?<!\\.)\\b(print|eprint|range|cancelled|yield_now|sleep|select|wait_any|wait_all|abs|min|max|sum|any|all|sorted|reversed|list|sqrt|round|divmod|parse_int32|parse_int64|parse_float64|ord|chr|len|str)\\b(?=\\s*\\()"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.aura",
          "match": "\\b(bool|int|int8|int16|int32|int64|int128|intsize|uint8|uint16|uint32|uint64|uint128|uintsize|float32|float64|str|cstr|ptr|list|dict|set|Duration|Lookup|Poll|Result|SendError|Queue|QueueReceive|Task|TaskResult|TaskGroup|SelectOutcome|WaitAny|WaitAll|Array|process\\.Child|fs\\.File|net\\.TcpStream)\\b"
        },
        {
          "name": "support.type.primitive.aura",
          "match": "(?<=: |array\\[)array(?=\\[)"
        },
        {
          "name": "support.type.primitive.aura",
          "match": "\\b(Callable|TaskCallable)\\b"
        },
        {
          "name": "support.type.primitive.aura",
          "match": "\\bfixed(?=\\s*\\[)"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.aura",
          "match": "->|//=|\\+=|-=|\\*=|/=|%=|\\|=|==|!=|<=|>=|//|\\+|-|\\*|/|%|=|<|>|\\||\\."
        }
      ]
    },
    "assemblyOperandGroup": {
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        {
          "include": "#assemblyOperandGroup"
        },
        {
          "include": "$self"
        }
      ]
    }
  }
}
