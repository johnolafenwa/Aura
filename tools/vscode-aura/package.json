{
  "name": "vscode-aura-lang",
  "displayName": "Aura Programming Language",
  "description": "Language support for Aura, a compiled, statically typed programming language with Python-familiar syntax: highlighting, snippets, and compiler-backed LSP.",
  "version": "0.11.0",
  "publisher": "JohnOlafenwa",
  "preview": true,
  "icon": "images/aura.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/johnolafenwa/Aura.git",
    "directory": "tools/vscode-aura"
  },
  "bugs": {
    "url": "https://github.com/johnolafenwa/Aura/issues"
  },
  "homepage": "https://github.com/johnolafenwa/Aura#readme",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "files": [
    "INSTALL.md",
    "LICENSE",
    "README.md",
    "dist/**",
    "debug/**",
    "images/aura.png",
    "language-configuration.json",
    "snippets/**",
    "syntaxes/**"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The Aura language server starts the Aura compiler, which reads and resolves the workspace's packages. Trust the folder to enable it."
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onLanguage:aura",
    "onDebugResolve:aura",
    "onDebugDynamicConfigurations:aura",
    "onCommand:aura.debugFile"
  ],
  "main": "./dist/extension.js",
  "devDependencies": {
    "esbuild": "^0.25.0",
    "shiki": "^3.23.0",
    "vscode-languageclient": "^10.1.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "contributes": {
    "languages": [
      {
        "id": "aura",
        "aliases": [
          "Aura",
          "aura"
        ],
        "extensions": [
          ".au"
        ],
        "icon": {
          "light": "./images/aura.png",
          "dark": "./images/aura.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "aura",
        "scopeName": "source.aura",
        "path": "./syntaxes/aura.tmLanguage.json",
        "tokenTypes": {
          "meta.embedded.expression.aura": "other"
        }
      }
    ],
    "commands": [
      {
        "command": "aura.restartLanguageServer",
        "title": "Restart Language Server",
        "category": "Aura"
      },
      {
        "command": "aura.runFile",
        "title": "Run File",
        "category": "Aura",
        "icon": "$(play)"
      },
      {
        "command": "aura.debugFile",
        "title": "Debug File",
        "category": "Aura",
        "icon": "$(debug-alt)"
      },
      {
        "command": "aura.buildFile",
        "title": "Build File",
        "category": "Aura"
      },
      {
        "command": "aura.testFile",
        "title": "Test File",
        "category": "Aura"
      },
      {
        "command": "aura.runTests",
        "title": "Run Workspace Tests",
        "category": "Aura"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "aura.runFile",
          "when": "editorLangId == aura",
          "group": "navigation"
        },
        {
          "command": "aura.debugFile",
          "when": "editorLangId == aura",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "aura.runFile",
          "when": "editorLangId == aura"
        },
        {
          "command": "aura.debugFile",
          "when": "editorLangId == aura"
        },
        {
          "command": "aura.buildFile",
          "when": "editorLangId == aura"
        },
        {
          "command": "aura.testFile",
          "when": "editorLangId == aura"
        }
      ]
    },
    "configuration": {
      "title": "Aura",
      "properties": {
        "aura.compilerPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Full path to the `aura` executable the language server runs. Leave empty to use `aura` on `PATH`, then `~/.local/bin`, `~/.cargo/bin`, `/opt/homebrew/bin`, and `/usr/local/bin`."
        },
        "aura.lldbDapPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Full path to the `lldb-dap` debug adapter the Aura debugger starts. Leave empty to use Xcode's on macOS (`xcrun -f lldb-dap`), then `lldb-dap`, `lldb-dap-<version>`, or `lldb-vscode` on `PATH`."
        }
      }
    },
    "snippets": [
      {
        "language": "aura",
        "path": "./snippets/aura.json"
      }
    ],
    "breakpoints": [
      {
        "language": "aura"
      }
    ],
    "debuggers": [
      {
        "type": "aura",
        "label": "Aura",
        "languages": [
          "aura"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The .au file to build with `aura build --debug` and debug.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments the program receives.",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "The program's working directory. Defaults to the directory of `program`."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Environment variables to add for the program.",
                "default": {}
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at the program's first instruction.",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "aura",
            "request": "launch",
            "name": "Debug Aura file",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Aura: Debug file",
            "description": "Build the current .au file with debug info and debug it.",
            "body": {
              "type": "aura",
              "request": "launch",
              "name": "Debug Aura file",
              "program": "^\"\\${file}\""
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node ./scripts/build.js",
    "vscode:prepublish": "npm run build",
    "package:vsix": "npm run build && npx --yes @vscode/vsce@4.0.0 package --out aura-language.vsix --no-dependencies",
    "test": "npm run build && node --test ./test/*.test.js",
    "check": "npm run build && node --check ./src/extension.js && node --check ./scripts/build.js"
  },
  "keywords": [
    "aura",
    "compiled language",
    "python-like",
    "structured concurrency",
    "lsp"
  ]
}
