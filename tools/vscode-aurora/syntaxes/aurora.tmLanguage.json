{
  "scopeName": "source.aurora",
  "name": "Aurora",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.aurora",
          "match": "#.*$"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "storage.modifier.attribute.aurora",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.aurora",
          "begin": "f?\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.aurora"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.aurora"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.aurora",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.aurora",
              "begin": "\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.begin.aurora"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.end.aurora"
                }
              },
              "patterns": [
                {
                  "include": "#keywords"
                },
                {
                  "include": "#types"
                },
                {
                  "include": "#numbers"
                }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.single.aurora",
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.aurora"
            }
          },
          "end": "'",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.aurora"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.aurora",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.aurora",
          "match": "\\b\\d+(?:\\.\\d+)?(?:ms|s|m)?\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.definition.class.aurora",
          "match": "\\b(class|enum|trait)\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.aurora"
            },
            "2": {
              "name": "entity.name.type.aurora"
            }
          }
        },
        {
          "name": "meta.definition.function.aurora",
          "match": "\\bdef\\s+([a-zA-Z_][A-Za-z0-9_]*)",
          "captures": {
            "0": {
              "name": "keyword.declaration.function.aurora"
            },
            "1": {
              "name": "entity.name.function.aurora"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.aurora",
          "match": "\\b(import|return|if|elif|else|while|for|in|match|case|with|try|and|or|not|break|continue|pass|impl|as)\\b"
        },
        {
          "name": "storage.modifier.aurora",
          "match": "\\b(public|mut|borrow|indirect|copy)\\b"
        },
        {
          "name": "constant.language.aurora",
          "match": "\\b(None|Some|true|false|self|Self)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.aurora",
          "match": "\\b(bool|int8|int16|int32|int64|int128|intsize|uint8|uint16|uint32|uint64|uint128|uintsize|float32|float64|String|Duration|Option|Result|SendError|Queue|QueueReceive|Task|TaskResult|TaskGroup|WaitAny|WaitAll|Vec|Map|MapEntry|Set|process\\.Child|fs\\.File|net\\.TcpStream)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.aurora",
          "match": "->|\\+|\\-|\\*|/|=|\\."
        }
      ]
    }
  }
}
