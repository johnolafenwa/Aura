{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "folding": {
    "offSide": true
  },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(class|enum|trait|def|if|elif|else|while|for|match|case|with|impl)\\b.*:\\s*$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(class|enum|trait|def|if|elif|else|while|for|match|case|with|impl)\\b.*:\\s*$",
      "action": {
        "indent": "indent"
      }
    }
  ]
}
