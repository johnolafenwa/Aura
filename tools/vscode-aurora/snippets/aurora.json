{
  "Class": {
    "prefix": "class",
    "body": [
      "class ${1:Name}:",
      "    ${2:field}: ${3:Type}"
    ],
    "description": "Aurora class declaration"
  },
  "Function": {
    "prefix": "def",
    "body": [
      "def ${1:name}(${2:param}: ${3:Type}) -> ${4:None}:",
      "    ${5:return None}"
    ],
    "description": "Aurora function declaration"
  },
  "If": {
    "prefix": "if",
    "body": [
      "if ${1:condition}:",
      "    ${2:# TODO}"
    ],
    "description": "Aurora if block"
  },
  "Match": {
    "prefix": "match",
    "body": [
      "match ${1:value}:",
      "    case ${2:Pattern}:",
      "        ${3:# TODO}"
    ],
    "description": "Aurora match block"
  },
  "With": {
    "prefix": "with",
    "body": [
      "with ${1:expr} as ${2:name}:",
      "    ${3:# TODO}"
    ],
    "description": "Aurora with block"
  },
  "Select": {
    "prefix": "select",
    "body": [
      "select:",
      "    case ${1:value} = ${2:channel}.recv():",
      "    ${3:# TODO}"
    ],
    "description": "Aurora select block"
  },
  "SpawnDetached": {
    "prefix": "spawn detached",
    "body": [
      "spawn detached ${1:worker}(${2:arg})"
    ],
    "description": "Aurora detached task"
  }
}
