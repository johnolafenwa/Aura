def safe_parse(s: String) -> Result[int32, String]:
    value = try parse_int32(s)
    return Result.Ok(value + 1)

def main() -> int32:
    match safe_parse("99"):
        case Result.Ok(value):
            print(value)
        case Result.Err(e):
            print("ERR: " + e)

    match safe_parse("bad"):
        case Result.Ok(value):
            print(value)
        case Result.Err(e):
            print("ERR: " + e)
    return 0
