## FizzBuzz into Vec: generate FizzBuzz strings 1-30, store in Vec[String], print all

def main() -> int32:
    mut results: Vec[String] = []

    mut i: int32 = 1
    while i <= 30:
        if i % 15 == 0:
            results.push("FizzBuzz")
        elif i % 3 == 0:
            results.push("Fizz")
        elif i % 5 == 0:
            results.push("Buzz")
        else:
            results.push(f"{i}")
        i += 1

    print(f"Generated {results.len()} FizzBuzz entries:")
    for entry in results:
        print(entry)

    return 0
