## Vec of Pairs: use a class Pair with two fields, build a Vec[Pair], iterate and print
## NOTE: String is not Copy, so Pair with String fields cannot be a copy class.
## Indexing a non-copy element out of a borrowed Vec moves it, so we use
## borrow iteration (`for in borrow`) and consuming iteration.

class Pair:
    key: String
    value: int32

def main() -> int32:
    mut pairs: Vec[Pair] = []

    pairs.push(Pair(key="alpha", value=1))
    pairs.push(Pair(key="beta", value=2))
    pairs.push(Pair(key="gamma", value=3))
    pairs.push(Pair(key="delta", value=4))
    pairs.push(Pair(key="epsilon", value=5))

    print(f"Number of pairs: {pairs.len()}")

    ## Iterate and print using for-in borrow (non-destructive)
    print("All pairs (borrow iteration):")
    for p in borrow pairs:
        print(f"  {p.key} -> {p.value}")

    ## Compute sum of values via borrow iteration
    mut total: int32 = 0
    for p in borrow pairs:
        total += p.value
    print(f"Sum of values: {total}")

    ## Find a pair by iterating with borrow
    print("Looking for 'gamma':")
    mut found = false
    for p in borrow pairs:
        if p.key == "gamma":
            print(f"  Found: {p.key} -> {p.value}")
            found = true
    if not found:
        print("  Not found")

    ## Modify a pair via set at index
    pairs.set(index=2, value=Pair(key="GAMMA", value=30))
    print("After modifying index 2:")
    for p in borrow pairs:
        print(f"  {p.key} -> {p.value}")

    ## Pop the last element
    match pairs.pop():
        case Some(p):
            print(f"Popped: {p.key} -> {p.value}")
        case None:
            print("Nothing to pop")

    print(f"Size after pop: {pairs.len()}")

    ## Final consuming iteration
    print("Consuming iteration:")
    for p in pairs:
        print(f"  [{p.key}] = {p.value}")

    return 0
