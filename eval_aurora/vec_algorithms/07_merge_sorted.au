## Merge two sorted vecs into one sorted vec

def merge_sorted(a: borrow Vec[int32], b: borrow Vec[int32]) -> Vec[int32]:
    mut result: Vec[int32] = []
    mut i: int32 = 0
    mut j: int32 = 0
    na = a.len() as int32
    nb = b.len() as int32

    while i < na and j < nb:
        if a[i] <= b[j]:
            result.push(a[i])
            i += 1
        else:
            result.push(b[j])
            j += 1

    ## Append remaining elements from a
    while i < na:
        result.push(a[i])
        i += 1

    ## Append remaining elements from b
    while j < nb:
        result.push(b[j])
        j += 1

    return result

def print_vec(arr: borrow Vec[int32]):
    mut i: int32 = 0
    n = arr.len() as int32
    while i < n:
        print(arr[i])
        i += 1

def main() -> int32:
    a = [1, 3, 5, 7, 9]
    b = [2, 4, 6, 8, 10]

    print("Vec A:")
    print_vec(a)
    print("Vec B:")
    print_vec(b)

    merged = merge_sorted(a, b)
    print("Merged:")
    print_vec(merged)

    ## Merge with empty
    c: Vec[int32] = []
    d = [1, 2, 3]
    merged2 = merge_sorted(c, d)
    print("Merge empty with [1,2,3]:")
    print_vec(merged2)

    ## Merge with overlapping values
    e = [1, 1, 3]
    f = [1, 2, 3]
    merged3 = merge_sorted(e, f)
    print("Merge [1,1,3] with [1,2,3]:")
    print_vec(merged3)

    return 0
