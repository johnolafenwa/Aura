## Concurrent collection: multiple spawned tasks each compute results,
## send them via channels, main aggregates into a Vec.

def compute_squares(worker_id: int32, start: int32, end: int32, out: Channel[int32]):
    ## Compute squares of numbers from start to end (exclusive)
    mut i = start
    while i < end:
        out.send(i * i)
        i += 1
    print(f"Worker {worker_id} done (range {start}..{end})")

def main() -> int32:
    results_chan: Channel[int32] = channel()
    mut collected: Vec[int32] = []

    ## Spawn 4 workers, each computing squares of a range
    ## Worker 0: 1-5, Worker 1: 6-10, Worker 2: 11-15, Worker 3: 16-20
    with task_group() as group:
        group.spawn(compute_squares, 0, 1, 6, results_chan.clone())
        group.spawn(compute_squares, 1, 6, 11, results_chan.clone())
        group.spawn(compute_squares, 2, 11, 16, results_chan.clone())
        group.spawn(compute_squares, 3, 16, 21, results_chan.clone())

        ## Collect all 20 results
        mut count: int32 = 0
        total_expected: int32 = 20

        while count < total_expected:
            select:
                case value = results_chan.recv():
                    match value:
                        case Option.Some(v):
                            collected.push(v)
                            count += 1
                        case Option.None:
                            break

        results_chan.close()

    print(f"Collected {collected.len()} values")

    ## Compute sum of all collected squares
    mut total: int32 = 0
    for val in collected:
        total += val

    print(f"Sum of squares 1^2 to 20^2 = {total}")
    ## Expected: sum of i^2 for i=1..20 = 2870
    print("Expected: 2870")

    return 0
