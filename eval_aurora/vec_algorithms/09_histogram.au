## Histogram / frequency count: count occurrences of values 0-9 in a vec

def main() -> int32:
    ## Input data: values 0-9
    data = [3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5, 8, 9, 7, 9, 3, 2, 3, 8, 4, 6, 2, 6, 4, 3]

    ## Create a frequency counter vec of size 10, all initialized to 0
    mut counts: Vec[int32] = []
    mut i: int32 = 0
    while i < 10:
        counts.push(0)
        i += 1

    ## Count occurrences
    mut j: int32 = 0
    n = data.len() as int32
    while j < n:
        val = data[j]
        old = counts[val]
        counts.set(index=val, value=old + 1)
        j += 1

    ## Print histogram
    print("Histogram:")
    mut k: int32 = 0
    while k < 10:
        print(f"  {k}: {counts[k]}")
        k += 1

    ## Print total to verify
    mut total: int32 = 0
    mut m: int32 = 0
    while m < 10:
        total += counts[m]
        m += 1
    print(f"Total count: {total} (expected {n})")

    return 0
