## Matrix as Vec of Vecs: Create a 3x3 matrix, access elements, compute row sums
## KEY INSIGHT: Direct indexing like matrix[r] moves the inner Vec, which is non-copy.
## Use `for row in borrow matrix:` to iterate rows without moving them.

def main() -> int32:
    ## Build a 3x3 matrix
    mut matrix: Vec[Vec[int32]] = []
    matrix.push([1, 2, 3])
    matrix.push([4, 5, 6])
    matrix.push([7, 8, 9])

    ## Print the matrix using borrow iteration
    print("Matrix (Vec[Vec[int32]]):")
    for row in borrow matrix:
        a = row[0]
        b = row[1]
        c = row[2]
        print(f"  [{a}, {b}, {c}]")

    ## Compute row sums
    print("Row sums:")
    mut r: int32 = 0
    for row in borrow matrix:
        mut sum: int32 = 0
        mut c: int32 = 0
        while c < row.len() as int32:
            sum += row[c]
            c += 1
        print(f"  Row {r}: {sum}")
        r += 1

    ## Compute column sums using nested borrow iteration
    print("Column sums:")
    mut col_sums: Vec[int32] = []
    col_sums.push(0)
    col_sums.push(0)
    col_sums.push(0)

    for row in borrow matrix:
        mut c: int32 = 0
        while c < 3:
            old = col_sums[c]
            col_sums.set(index=c, value=old + row[c])
            c += 1

    mut c2: int32 = 0
    while c2 < 3:
        print(f"  Col {c2}: {col_sums[c2]}")
        c2 += 1

    ## Compute total sum of all elements
    mut total: int32 = 0
    for row in borrow matrix:
        mut c: int32 = 0
        while c < row.len() as int32:
            total += row[c]
            c += 1
    print(f"Total sum: {total}")

    return 0
