# Test 07: Match with literals
# NOTE: Aurora does NOT support matching on integer literals.
# Match patterns only support: EnumName.Variant, EnumName.Variant(binding), _
# So we test matching on enum variants with no payload (simulating literal patterns).

enum Digit:
    Zero
    One
    Two
    Three

def digit_name(d: Digit) -> String:
    match d:
        case Digit.Zero:
            return "zero"
        case Digit.One:
            return "one"
        case Digit.Two:
            return "two"
        case Digit.Three:
            return "three"

def main() -> int32:
    print(digit_name(d=Digit.Zero))
    print(digit_name(d=Digit.One))
    print(digit_name(d=Digit.Two))
    print(digit_name(d=Digit.Three))
    return 0
