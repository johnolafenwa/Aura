# Test 17: For loop over channel - iterate channel values

def producer(ch: Channel[int32]):
    ch.send(1)
    ch.send(2)
    ch.send(3)
    ch.send(4)
    ch.send(5)
    ch.close()

def main() -> int32:
    ch: Channel[int32] = channel()
    task = spawn producer(ch.clone())

    mut sum: int32 = 0
    mut count: int32 = 0
    for value in ch:
        sum += value
        count += 1

    task.join()
    print("channel count:")
    print(count)
    print("channel sum:")
    print(sum)
    return 0
