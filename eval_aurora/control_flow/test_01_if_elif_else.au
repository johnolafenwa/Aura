# Test 01: If/elif/else chains - multiple conditions, nested ifs

def classify_score(score: int32) -> String:
    if score >= 90:
        return "A"
    elif score >= 80:
        return "B"
    elif score >= 70:
        return "C"
    elif score >= 60:
        return "D"
    else:
        return "F"

def nested_check(x: int32, y: int32) -> String:
    if x > 0:
        if y > 0:
            return "both positive"
        else:
            return "x positive y not"
    else:
        if y > 0:
            return "y positive x not"
        else:
            return "both not positive"

def main() -> int32:
    # Test basic if/elif/else chain
    print(classify_score(score=95))
    print(classify_score(score=85))
    print(classify_score(score=75))
    print(classify_score(score=65))
    print(classify_score(score=50))

    # Test nested ifs
    print(nested_check(x=1, y=1))
    print(nested_check(x=1, y=0))
    print(nested_check(x=0, y=1))
    print(nested_check(x=0, y=0))

    # Test simple if without else
    x: int32 = 10
    if x > 5:
        print("big")

    return 0
