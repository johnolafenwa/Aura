# Test 16: Loop with mutable counter - mut variable updated in loop

def main() -> int32:
    # Accumulate sum using mutable counter in for loop
    mut sum: int32 = 0
    for i in range(start=1, stop=11):
        sum += i
    print("sum 1..10:")
    print(sum)

    # Mutable counter in while loop
    mut product: int32 = 1
    mut n: int32 = 1
    while n <= 5:
        product *= n
        n += 1
    print("5! =")
    print(product)

    # Multiple mutable variables updated in loop
    mut a: int32 = 0
    mut b: int32 = 1
    for i in range(8):
        mut temp: int32 = a + b
        a = b
        b = temp
    print("fib(8) via mut swap:")
    print(a)

    # Decrementing counter
    mut countdown: int32 = 5
    mut steps: int32 = 0
    while countdown > 0:
        countdown -= 1
        steps += 1
    print("countdown steps:")
    print(steps)

    return 0
