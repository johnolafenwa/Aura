# Test 03: While loop - basic, with break, with continue

def main() -> int32:
    # Basic while loop
    print("basic while:")
    mut n: int32 = 0
    while n < 5:
        n += 1
    print(n)

    # While with break
    print("while with break:")
    mut m: int32 = 0
    while true:
        m += 1
        if m == 7:
            break
    print(m)

    # While with continue - sum only odd numbers up to 10
    print("while with continue:")
    mut i: int32 = 0
    mut odd_sum: int32 = 0
    while i < 10:
        i += 1
        if i % 2 == 0:
            continue
        odd_sum += i
    print(odd_sum)

    # While that never executes
    print("while false:")
    mut never: int32 = 0
    while false:
        never += 1
    print(never)

    return 0
