# Test 05: Break in nested loops - does break exit only the inner loop?

def main() -> int32:
    # Break should only exit the innermost loop
    mut outer_count: int32 = 0
    mut inner_total: int32 = 0
    for i in range(5):
        outer_count += 1
        for j in range(10):
            if j == 3:
                break
            inner_total += 1

    print("outer count (should be 5):")
    print(outer_count)
    print("inner total (should be 15, 3 per outer iter):")
    print(inner_total)

    # Continue should only affect the innermost loop
    mut outer2: int32 = 0
    mut inner2: int32 = 0
    for i in range(3):
        outer2 += 1
        for j in range(5):
            if j % 2 == 0:
                continue
            inner2 += 1

    print("outer2 (should be 3):")
    print(outer2)
    print("inner2 (should be 6, 2 odd per iter):")
    print(inner2)

    return 0
