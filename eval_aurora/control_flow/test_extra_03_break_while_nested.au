# Extra test: Break in nested while loops

def main() -> int32:
    mut outer_iters: int32 = 0
    mut inner_iters: int32 = 0

    mut i: int32 = 0
    while i < 5:
        i += 1
        outer_iters += 1

        mut j: int32 = 0
        while j < 100:
            j += 1
            inner_iters += 1
            if j == 3:
                break

    print("outer while iters (should be 5):")
    print(outer_iters)
    print("inner while iters (should be 15):")
    print(inner_iters)

    return 0
