# Test 14: Early return - return from middle of function

def find_first_even(limit: int32) -> int32:
    mut i: int32 = 1
    while i <= limit:
        if i % 2 == 0:
            return i
        i += 1
    return -1

def check_bounds(x: int32) -> String:
    if x < 0:
        return "negative"
    if x == 0:
        return "zero"
    if x > 100:
        return "too large"
    return "ok"

def guard_clause(a: int32, b: int32) -> Result[int32, String]:
    if a < 0:
        return Result.Err("a is negative")
    if b == 0:
        return Result.Err("b is zero")
    return Result.Ok(a / b)

def main() -> int32:
    print("first even up to 10:")
    print(find_first_even(limit=10))

    print("first even up to 1:")
    print(find_first_even(limit=1))

    print(check_bounds(x=-5))
    print(check_bounds(x=0))
    print(check_bounds(x=50))
    print(check_bounds(x=200))

    match guard_clause(a=10, b=3):
        case Result.Ok(val):
            print(val)
        case Result.Err(e):
            print(e)

    match guard_clause(a=-1, b=3):
        case Result.Ok(val):
            print(val)
        case Result.Err(e):
            print(e)

    match guard_clause(a=10, b=0):
        case Result.Ok(val):
            print(val)
        case Result.Err(e):
            print(e)

    return 0
