# Test 11: Try expression - error propagation through multiple functions

def parse_int(s: String) -> Result[int32, String]:
    if s == "42":
        return Result.Ok(42)
    elif s == "7":
        return Result.Ok(7)
    else:
        return Result.Err("parse error: " + s)

def double_parsed(s: String) -> Result[int32, String]:
    value = try parse_int(s=s)
    return Result.Ok(value * 2)

def add_ten_to_parsed(s: String) -> Result[int32, String]:
    value = try parse_int(s=s)
    return Result.Ok(value + 10)

def main() -> int32:
    # try with successful parse
    match double_parsed(s="42"):
        case Result.Ok(val):
            print("double 42:")
            print(val)
        case Result.Err(e):
            print(e)

    # try with failed parse - error should propagate
    match double_parsed(s="abc"):
        case Result.Ok(val):
            print("double abc:")
            print(val)
        case Result.Err(e):
            print(e)

    # try with another successful case
    match add_ten_to_parsed(s="7"):
        case Result.Ok(val):
            print("7 + 10:")
            print(val)
        case Result.Err(e):
            print(e)

    return 0
