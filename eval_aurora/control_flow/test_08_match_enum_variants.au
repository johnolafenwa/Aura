# Test 08: Match with enum variants - destructuring Option, Result

def safe_divide(a: int32, b: int32) -> Result[int32, String]:
    if b == 0:
        return Result.Err("division by zero")
    return Result.Ok(a / b)

def find_value(flag: bool) -> Option[int32]:
    if flag:
        return Option.Some(42)
    return Option.None

def main() -> int32:
    # Match on Result - Ok case
    result_ok: Result[int32, String] = safe_divide(a=10, b=2)
    match result_ok:
        case Result.Ok(val):
            print("ok:")
            print(val)
        case Result.Err(msg):
            print("err:")
            print(msg)

    # Match on Result - Err case
    result_err: Result[int32, String] = safe_divide(a=10, b=0)
    match result_err:
        case Result.Ok(val):
            print("ok:")
            print(val)
        case Result.Err(msg):
            print("err:")
            print(msg)

    # Match on Option - Some case
    opt_some: Option[int32] = find_value(flag=true)
    match opt_some:
        case Option.Some(val):
            print("some:")
            print(val)
        case Option.None:
            print("none")

    # Match on Option - None case
    opt_none: Option[int32] = find_value(flag=false)
    match opt_none:
        case Option.Some(val):
            print("some:")
            print(val)
        case Option.None:
            print("none")

    return 0
