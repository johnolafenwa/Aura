# Test 12: Result chaining - multiple try expressions in sequence

def step1(x: int32) -> Result[int32, String]:
    if x < 0:
        return Result.Err("step1: negative input")
    return Result.Ok(x + 10)

def step2(x: int32) -> Result[int32, String]:
    if x > 100:
        return Result.Err("step2: too large")
    return Result.Ok(x * 2)

def step3(x: int32) -> Result[int32, String]:
    if x == 0:
        return Result.Err("step3: zero")
    return Result.Ok(x - 1)

def pipeline(input: int32) -> Result[int32, String]:
    a = try step1(x=input)
    b = try step2(x=a)
    c = try step3(x=b)
    return Result.Ok(c)

def main() -> int32:
    # Successful pipeline: 5 -> 15 -> 30 -> 29
    match pipeline(input=5):
        case Result.Ok(val):
            print("pipeline(5):")
            print(val)
        case Result.Err(e):
            print(e)

    # Fails at step1: negative
    match pipeline(input=-1):
        case Result.Ok(val):
            print(val)
        case Result.Err(e):
            print(e)

    # Fails at step2: 90 + 10 = 100, 100*2 = 200 > 100
    match pipeline(input=90):
        case Result.Ok(val):
            print(val)
        case Result.Err(e):
            print(e)

    return 0
