def main() -> int32:
    scores = {"alice": 90, "bob": 45, "carol": 80, "dave": 30}
    mut passing = Map[String, int32]()
    for e in scores.entries():
        if e.value >= 50:
            passing.set(e.key, e.value)
    print(passing.len())
    for e in passing.entries():
        print(f"{e.key}: {e.value}")
    return 0
