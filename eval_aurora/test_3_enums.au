enum Message:
    Ping
    Text(String)

def main() -> None:
    msg1 = Message.Ping
    match msg1:
        case Message.Ping:
            print(1)
        case Message.Text(t):
            print(0)
    
    msg2 = Message.Text(String("hello"))
    match borrow msg2:
        case Message.Ping:
            print(1)
        case Message.Text(t):
            print(t.clone())
