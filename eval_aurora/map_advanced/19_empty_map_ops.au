## Test 19: Empty map operations
## Call every method on an empty map, verify no crashes

def print_bool(value: bool):
    match value:
        case true:
            print("true")
        case false:
            print("false")

def print_str_option(value: Option[String]):
    match value:
        case Some(inner):
            print(inner)
        case None:
            print("(none)")

def main() -> int32:
    mut m = Map[String, String]()

    print(f"len: {m.len()}")
    print("is_empty:")
    print_bool(m.is_empty())

    print("contains_key:")
    print_bool(m.contains_key("x"))

    print("get:")
    print_str_option(m.get("x"))

    print("remove:")
    print_str_option(m.remove("x"))

    print("keys len:")
    print(m.keys().len())

    print("values len:")
    print(m.values().len())

    ## Clone empty map
    m2 = m.clone()
    print(f"clone len: {m2.len()}")

    print("all empty map ops passed")
    return 0
