## Test 20: Large map stress test
## Insert 1000 entries, verify len, retrieve entries

def main() -> int32:
    mut m = Map[int32, int32]()

    ## Insert 1000 entries
    mut i: int32 = 0
    while i < 1000:
        m[i] = i * i
        i += 1

    print(f"size after 1000 inserts: {m.len()}")

    ## Verify specific entries
    print(f"m[0] = {m[0]}")
    print(f"m[10] = {m[10]}")
    print(f"m[100] = {m[100]}")
    print(f"m[500] = {m[500]}")
    print(f"m[999] = {m[999]}")

    ## Verify contains_key
    mut has_all = true
    mut j: int32 = 0
    while j < 1000:
        if not m.contains_key(j):
            has_all = false
        j += 1

    match has_all:
        case true:
            print("all 1000 keys present")
        case false:
            print("ERROR: some keys missing")

    ## Remove some entries
    mut k: int32 = 0
    while k < 100:
        m.remove(k)
        k += 1

    print(f"size after removing 100: {m.len()}")

    return 0
