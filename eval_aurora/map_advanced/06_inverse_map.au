## Test 06: Inverse map
## Given Map[String, int32], build Map[int32, String] swapping keys/values

def main() -> int32:
    mut original = Map[String, int32]()
    original["alpha"] = 1
    original["beta"] = 2
    original["gamma"] = 3
    original["delta"] = 4

    mut inverse = Map[int32, String]()

    keys = original.keys()
    for key in keys:
        val = original[key.clone()]
        inverse[val] = key

    print(f"original size: {original.len()}")
    print(f"inverse size: {inverse.len()}")

    print(f"inverse[1] = {inverse[1]}")
    print(f"inverse[2] = {inverse[2]}")
    print(f"inverse[3] = {inverse[3]}")
    print(f"inverse[4] = {inverse[4]}")

    return 0
