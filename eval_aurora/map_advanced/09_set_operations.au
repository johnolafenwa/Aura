## Test 09: Set operations using Map
## Use Map[int32, bool] as a set, implement union and intersection

def main() -> int32:
    ## Set A: {1, 2, 3, 4, 5}
    mut set_a = Map[int32, bool]()
    set_a[1] = true
    set_a[2] = true
    set_a[3] = true
    set_a[4] = true
    set_a[5] = true

    ## Set B: {3, 4, 5, 6, 7}
    mut set_b = Map[int32, bool]()
    set_b[3] = true
    set_b[4] = true
    set_b[5] = true
    set_b[6] = true
    set_b[7] = true

    ## Union: all keys from both
    mut union_set = Map[int32, bool]()
    keys_a = set_a.keys()
    for k in keys_a:
        union_set[k] = true
    keys_b = set_b.keys()
    for k in keys_b:
        union_set[k] = true

    ## Intersection: keys in both
    mut intersection = Map[int32, bool]()
    keys_a2 = set_a.keys()
    for k in keys_a2:
        if set_b.contains_key(k):
            intersection[k] = true

    print(f"set A size: {set_a.len()}")
    print(f"set B size: {set_b.len()}")
    print(f"union size: {union_set.len()}")
    print(f"intersection size: {intersection.len()}")

    print("intersection members:")
    int_keys = intersection.keys()
    for k in int_keys:
        print(f"  {k}")

    return 0
