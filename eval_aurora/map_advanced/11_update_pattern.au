## Test 11: Update pattern
## Read current value, compute new, write back

def main() -> int32:
    mut m = Map[String, int32]()
    m["counter"] = 0

    ## Increment counter multiple times
    mut i: int32 = 0
    while i < 5:
        old = m["counter"]
        m["counter"] = old + 1
        i += 1

    counter_val = m["counter"]
    print(f"counter after 5 increments: {counter_val}")

    ## Accumulate with different step
    m["total"] = 0
    steps = [10, 20, 30, 40]
    for step in steps:
        old = m["total"]
        m["total"] = old + step

    total_val = m["total"]
    print(f"total after accumulation: {total_val}")

    return 0
