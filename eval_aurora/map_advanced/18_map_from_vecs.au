## Test 18: Map from Vec of pairs
## Given parallel Vecs of keys and values, build a map

def main() -> int32:
    all_keys: Vec[String] = ["name", "version", "author", "license"]
    all_values: Vec[String] = ["aurora", "0.1.0", "john", "MIT"]

    mut m = Map[String, String]()

    n = all_keys.len() as int32
    mut idx: int32 = 0
    while idx < n:
        k = all_keys[idx]
        v = all_values[idx]
        m[k] = v
        idx += 1

    print(f"map size: {m.len()}")

    result_keys = m.keys()
    for key in result_keys:
        val = m[key.clone()]
        print(f"  {key}: {val}")

    return 0
