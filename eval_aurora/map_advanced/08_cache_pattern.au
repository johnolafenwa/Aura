## Test 08: Cache pattern
## Compute values on first access, store in map, return cached on subsequent access

def expensive_compute(n: int32) -> int32:
    ## Simulate expensive: compute n * n + n
    return n * n + n

def main() -> int32:
    mut cache = Map[int32, int32]()

    ## Access values, computing on first access
    inputs = [5, 3, 5, 7, 3, 5, 7, 10]

    for input in inputs:
        match cache.get(input):
            case Some(cached):
                print(f"cached({input}) = {cached}")
            case None:
                result = expensive_compute(input)
                cache[input] = result
                print(f"computed({input}) = {result}")

    print(f"cache size: {cache.len()}")
    return 0
