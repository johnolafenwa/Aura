## Test 02: Phone book
## Map[String, String] for name -> phone number

def print_str_option(value: Option[String]):
    match value:
        case Some(inner):
            print(inner)
        case None:
            print("(not found)")

def main() -> int32:
    mut book = Map[String, String]()

    ## Add entries
    book["Alice"] = "555-0100"
    book["Bob"] = "555-0200"
    book["Carol"] = "555-0300"
    book["Dave"] = "555-0400"

    print(f"contacts: {book.len()}")

    ## Look up by name
    print("Looking up Bob:")
    print_str_option(book.get("Bob"))

    print("Looking up Eve:")
    print_str_option(book.get("Eve"))

    ## Remove entry
    print("Removing Carol:")
    print_str_option(book.remove("Carol"))
    print(f"contacts after remove: {book.len()}")

    ## List all contacts
    print("All contacts:")
    keys = book.keys()
    for name in keys:
        print(f"  {name}: {book[name.clone()]}")

    return 0
