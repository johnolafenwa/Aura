## Test 12: Keys/values ordering
## Check if keys() and values() are returned in insertion order or arbitrary

def main() -> int32:
    mut m = Map[String, int32]()
    m["first"] = 1
    m["second"] = 2
    m["third"] = 3
    m["fourth"] = 4
    m["fifth"] = 5

    print("keys:")
    keys = m.keys()
    for k in keys:
        print(f"  {k}")

    print("values:")
    values = m.values()
    for v in values:
        print(f"  {v}")

    print(f"keys count: {m.keys().len()}")
    print(f"values count: {m.values().len()}")

    return 0
