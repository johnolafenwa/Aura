## Test 07: Config store
## Map[String, String] of config key-value pairs with get() + match for defaults

def get_config(config: Map[String, String], key: String, default: String) -> String:
    match config.get(key):
        case Some(value):
            return value
        case None:
            return default

def main() -> int32:
    mut config = Map[String, String]()
    config["host"] = "localhost"
    config["port"] = "8080"
    config["debug"] = "true"
    config["log_level"] = "info"

    host = get_config(config.clone(), "host", "0.0.0.0")
    port = get_config(config.clone(), "port", "3000")
    debug = get_config(config.clone(), "debug", "false")
    timeout = get_config(config.clone(), "timeout", "30")
    log_level = get_config(config.clone(), "log_level", "warn")

    print(f"host: {host}")
    print(f"port: {port}")
    print(f"debug: {debug}")
    print(f"timeout: {timeout}")
    print(f"log_level: {log_level}")

    return 0
