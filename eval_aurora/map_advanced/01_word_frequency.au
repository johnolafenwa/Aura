## Test 01: Word frequency counter
## Count occurrences of words in a Vec[String] using Map[String, int32]

def main() -> int32:
    words: Vec[String] = ["hello", "world", "hello", "aurora", "world", "hello", "map", "aurora"]

    mut counts = Map[String, int32]()

    for word in words:
        match counts.get(word.clone()):
            case Some(n):
                counts[word.clone()] = n + 1
            case None:
                counts[word] = 1

    keys = counts.keys()
    for key in keys:
        print(f"{key}: {counts[key.clone()]}")

    print(f"unique words: {counts.len()}")
    return 0
