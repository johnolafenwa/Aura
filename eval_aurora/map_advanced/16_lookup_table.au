## Test 16: Map as lookup table
## Precompute values, use map for O(1) lookup in a loop

def main() -> int32:
    ## Precompute squares
    mut squares = Map[int32, int32]()
    mut i: int32 = 0
    while i <= 20:
        squares[i] = i * i
        i += 1

    ## Use lookup table
    queries = [1, 5, 10, 15, 20, 7, 13]
    for q in queries:
        print(f"{q}^2 = {squares[q]}")

    print(f"table size: {squares.len()}")
    return 0
