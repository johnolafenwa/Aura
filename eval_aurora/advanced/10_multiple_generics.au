# Test 10: Multiple generics - class Pair[A, B]
class Pair[A, B]:
    first: A
    second: B

    def get_first(borrow self) -> A:
        return self.first

    def get_second(borrow self) -> B:
        return self.second

def swap[A, B](p: Pair[A, B]) -> Pair[B, A]:
    return Pair(first=p.second, second=p.first)

def main() -> int32:
    # int, string pair
    p1: Pair[int32, String] = Pair(first=42, second="hello")
    print(p1.get_first())
    print(p1.get_second())

    # bool, float pair
    p2: Pair[bool, float64] = Pair(first=true, second=3.14)
    print(p2.get_first())
    print(p2.get_second())

    # swap
    p3: Pair[int32, String] = Pair(first=1, second="world")
    swapped = swap(p=p3)
    print(swapped.get_first())
    print(swapped.get_second())

    return 0
