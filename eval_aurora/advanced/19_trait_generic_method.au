# Test 19: Trait with generic impl - generic impl for a trait
trait Mapper[T]:
    def map_value(borrow self, value: T) -> T

class Doubler:
    factor: int32

impl Mapper[int32] for Doubler:
    def map_value(borrow self, value: int32) -> int32:
        return value * self.factor

class Box[T]:
    value: T

impl Mapper[T] for Box[T]:
    def map_value(borrow self, value: T) -> T:
        return value

def main() -> int32:
    d = Doubler(factor=3)
    print(d.map_value(value=7))

    b = Box(value=10)
    print(b.map_value(value=42))

    return 0
