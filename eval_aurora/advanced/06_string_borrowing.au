# Test 6: String borrowing - functions taking str (borrowed) vs String (owned)
def borrowed_greeting(name: borrow str) -> String:
    return "Hello, " + name

def owned_greeting(name: String) -> String:
    return "Hi, " + name

def main() -> int32:
    text: String = "Aurora"

    # Pass String to function expecting borrow str
    result1 = borrowed_greeting(text)
    print(result1)

    # text should still be usable after borrow
    print(text.clone())

    # Pass as owned - should consume
    result2 = owned_greeting(text)
    print(result2)

    return 0
