# Test 7: Generic identity function with int, string, bool, class
class Point:
    x: int32
    y: int32

def identity[T](value: T) -> T:
    return value

def main() -> int32:
    # int
    print(identity(value=42))

    # string
    print(identity(value="hello"))

    # bool
    print(identity(value=true))

    # class
    p = identity(value=Point(x=1, y=2))
    print(p.x)
    print(p.y)

    return 0
