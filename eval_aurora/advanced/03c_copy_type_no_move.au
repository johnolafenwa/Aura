# Test 3c: Copy types (scalars) don't have move semantics
copy class Point:
    x: int32
    y: int32

def take_int(n: int32):
    print(n)

def take_point(p: Point):
    print(p.x)

def main() -> int32:
    # Scalars are copy - should still be usable after passing
    x = 42
    take_int(x)
    print(x)

    # Copy class should also work
    p = Point(x=1, y=2)
    take_point(p)
    print(p.y)

    return 0
