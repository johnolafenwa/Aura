# Test 7b: Generic type inference - does Aurora infer T?
def first[T](a: T, b: T) -> T:
    return a

def main() -> int32:
    # Should infer T = int32
    print(first(a=1, b=2))
    # Should infer T = String
    print(first(a="hello", b="world"))
    # Should infer T = bool
    print(first(a=true, b=false))
    return 0
