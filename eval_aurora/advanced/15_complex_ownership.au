# Test 15: Complex ownership - class containing String fields, moving the class
class Person:
    name: String
    email: String

def consume_person(p: Person):
    print(p.name)
    print(p.email)

def main() -> int32:
    person = Person(name="Alice", email="alice@example.com")
    # Move person into function
    consume_person(person)
    # This should fail - person was moved
    # Commenting out to test separately
    return 0
