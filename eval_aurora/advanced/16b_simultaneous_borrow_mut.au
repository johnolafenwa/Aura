# Test 16b: Attempt simultaneous mutable borrows
class Data:
    value: int32

def two_mut_borrows(a: borrow mut Data, b: borrow mut Data):
    a.value += 1
    b.value += 2

def main() -> int32:
    mut data = Data(value=0)
    # Passing same value as two mutable borrows - should this fail?
    two_mut_borrows(data, data)
    print(data.value)
    return 0
