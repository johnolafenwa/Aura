# Test 15b: Attempting to use class after it was moved
class Person:
    name: String
    email: String

def consume_person(p: Person):
    print(p.name)
    print(p.email)

def main() -> int32:
    person = Person(name="Alice", email="alice@example.com")
    consume_person(person)
    # Should fail - person was moved
    print(person.name)
    return 0
