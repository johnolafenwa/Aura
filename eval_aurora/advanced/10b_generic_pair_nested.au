# Test 10b: Nested generics - Box containing Pair
class Box[T]:
    value: T

    def get(borrow self) -> T:
        return self.value

class Pair[A, B]:
    first: A
    second: B

def main() -> int32:
    # Box containing a Pair
    boxed_pair: Box[Pair[int32, String]] = Box(value=Pair(first=1, second="hello"))
    pair = boxed_pair.get()
    print(pair.first)
    print(pair.second)
    return 0
