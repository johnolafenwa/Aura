def print_bool(value: bool):
    match value:
        case true:
            print("true")
        case false:
            print("false")

def main() -> int32:
    mut v = [1, 2, 3]
    for x in borrow mut v:
        x += 10
    for x in borrow v:
        print(x)
    print_bool(v == [11, 12, 13])
    return 0
