trait Greeter:
    def greet(borrow self) -> String

class Person:
    name: String

impl Greeter for Person:
    def greet(borrow self) -> String:
        return "hello " + self.name


def speak[T: Greeter](item: borrow T):
    print(item.greet())


def main() -> int32:
    p = Person(name="Alice")
    speak(p)
    return 0
