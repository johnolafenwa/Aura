class Counter:
    value: int32

    def bump(borrow mut self):
        self.value += 1

    def reset(borrow mut self):
        self.value = 0


def main() -> int32:
    mut counter = Counter(value=4)
    counter.bump()
    counter.bump()
    print(counter.value)
    counter.reset()
    counter.bump()
    print(counter.value)
    return 0
