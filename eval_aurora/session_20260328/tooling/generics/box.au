class Box[T]:
    value: T

    def unwrap(borrow self) -> T:
        return self.value

    def replace(borrow mut self, value: T) -> T:
        old = self.value
        self.value = value
        return old

def identity[T](value: T) -> T:
    return value

def main() -> int32:
    box = Box(value=7)
    print(box.unwrap())
    print(box.replace(value=11))
    print(identity(value="x"))
    return 0
