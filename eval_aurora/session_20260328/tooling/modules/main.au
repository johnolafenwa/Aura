import helpers.math
from helpers.counter import Counter

from pkg.types import User, Status


def main() -> int32:
    print(helpers.math.double(value=5))
    print(helpers.math.triple(value=4))
    counter = Counter(value=2)
    print(counter.read())
    user = User(label="ada")
    print(user.name())
    status = Status.Ready
    match status:
        case Status.Ready:
            print(1)
        case Status.Busy:
            print(2)
    return 0
