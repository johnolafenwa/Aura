def worker(out: Channel[int32]):
    mut i: int32 = 0
    while true:
        if cancelled():
            return
        out.send(i)
        i += 1

def main() -> int32:
    out: Channel[int32] = channel()
    with task_group() as group:
        group.spawn(worker, out.clone())
        match out.recv():
            case Option.Some(value):
                print(value)
                group.cancel()
            case Option.None:
                print(0)
    return 0
