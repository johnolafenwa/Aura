class Counter:
    value: int32 = 1

    def bump(borrow mut self, amount: int32) -> int32:
        self.value += amount
        return self.value

    def read(borrow self) -> int32:
        return self.value

def main() -> int32:
    mut counter = Counter()
    print(counter.bump(2))
    print(counter.read())
    return 0
