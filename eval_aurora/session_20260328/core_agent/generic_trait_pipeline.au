trait Describe:
    def describe(borrow self) -> String

class Box[T]:
    value: T

impl Describe for Box[int32]:
    def describe(borrow self) -> String:
        return f"box {self.value}"

def render[T: Describe](value: T) -> None:
    print(value.describe())

def main() -> int32:
    render(value=Box(value=7))
    return 0
