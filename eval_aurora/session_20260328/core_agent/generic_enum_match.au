enum Maybe[T]:
    Just(T)
    Nothing

def read(value: Maybe[int32]) -> int32:
    match value:
        case Maybe.Just(inner):
            return inner
        case Maybe.Nothing:
            return 0

def main() -> int32:
    print(read(value=Maybe.Just(5)))
    print(read(value=Maybe.Nothing))
    return 0
