import pkg.user
from pkg.named import Named

enum ParseResult:
    Success(int32)
    Failure(String)

def render[T: Named](value: T) -> String:
    return value.name()

def decode(result: Result[int32, String]) -> int32:
    match result:
        case Result.Ok(value):
            return value
        case Result.Err(message):
            print(message)
            return 0

def main() -> int32:
    user = pkg.user.User(label="Ada")
    print(render(value=user))
    print(decode(Result.Ok(5)))
    match ParseResult.Success(1):
        case ParseResult.Success(value):
            print(value)
        case ParseResult.Failure(message):
            print(message)
    return 0
