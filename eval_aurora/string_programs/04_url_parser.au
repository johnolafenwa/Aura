## Program 4: URL Parser
## Parse URL using strip_prefix, split, contains, starts_with

def print_string_option(label: String, value: Option[String]):
    match value:
        case Some(text):
            print(f"  {label}: {text}")
        case None:
            print(f"  {label}: (none)")

def parse_url(url: String):
    print(f"Parsing: {url}")

    ## Strip protocol
    mut without_protocol = ""
    match url.strip_prefix("https://"):
        case Some(rest):
            print("  Protocol: https")
            without_protocol = rest
        case None:
            match url.strip_prefix("http://"):
                case Some(rest):
                    print("  Protocol: http")
                    without_protocol = rest
                case None:
                    print("  Protocol: (unknown)")
                    without_protocol = url.clone()

    ## Split by "?" to separate path from query
    parts = without_protocol.split("?")
    path_part = parts[0]

    if parts.len() > 1:
        print(f"  Query: {parts[1]}")
    else:
        print("  Query: (none)")

    ## Split path by "/"
    segments = path_part.split("/")
    print(f"  Host: {segments[0]}")

    if segments.len() > 1:
        print(f"  Path segments: {segments.len() - 1}")
        for i in range(start=1, stop=segments.len()):
            seg = segments[i].clone()
            if seg.len() > 0:
                print(f"    /{seg}")

def main() -> int32:
    parse_url("https://example.com/path/to/page?q=1")
    print("")
    parse_url("http://api.server.com/v2/users")
    print("")
    parse_url("https://simple.com")
    return 0
