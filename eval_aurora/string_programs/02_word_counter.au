## Program 2: Word Counter
## Split text by space, count words, build word frequency map

def main() -> int32:
    text = "the quick brown fox jumps over the lazy dog the fox the"
    print(f"Text: {text}")

    words = text.split(" ")
    print(f"Total words: {words.len()}")

    ## Build frequency map
    mut freq = Map[String, int32]()
    for word in borrow words:
        if freq.contains_key(word):
            current = freq[word]
            freq[word] = current + 1
        else:
            freq[word] = 1

    print(f"Unique words: {freq.len()}")

    ## Print frequencies
    keys = freq.keys()
    for key in keys:
        count = freq[key.clone()]
        print(f"  {key}: {count}")

    ## Find the most frequent word
    mut max_count = 0
    mut max_word = ""
    check_keys = freq.keys()
    for k in check_keys:
        c = freq[k.clone()]
        if c > max_count:
            max_count = c
            max_word = k

    print(f"Most frequent: {max_word} ({max_count})")

    return 0
