## Program 10: All String Methods in One Program
## Uses every string method at least once with labeled results

def print_string_option(label: String, value: Option[String]):
    match value:
        case Some(text):
            print(f"  {label}: Some({text})")
        case None:
            print(f"  {label}: None")

def main() -> int32:
    text = "  Hello, Aurora World!  "
    print(f"Original: [{text}]")
    print("")

    ## 1. len()
    print(f"1. len(): {text.len()}")

    ## 2. trim()
    trimmed = text.trim()
    print(f"2. trim(): [{trimmed}]")

    ## 3. to_lower()
    lowered = trimmed.clone().to_lower()
    print(f"3. to_lower(): {lowered}")

    ## 4. to_upper()
    uppered = trimmed.clone().to_upper()
    print(f"4. to_upper(): {uppered}")

    ## 5. contains()
    print(f"5. contains('Aurora'): {trimmed.clone().contains("Aurora")}")
    print(f"   contains('Python'): {trimmed.clone().contains("Python")}")

    ## 6. starts_with()
    print(f"6. starts_with('Hello'): {trimmed.clone().starts_with("Hello")}")
    print(f"   starts_with('World'): {trimmed.clone().starts_with("World")}")

    ## 7. ends_with()
    print(f"7. ends_with('World!'): {trimmed.clone().ends_with("World!")}")
    print(f"   ends_with('Hello'): {trimmed.clone().ends_with("Hello")}")

    ## 8. split()
    parts = trimmed.clone().split(" ")
    print(f"8. split(' '): {parts.len()} parts")
    for i in range(parts.len()):
        print(f"   [{i}] {parts[i]}")

    ## 9. replace()
    replaced = trimmed.clone().replace("Aurora", "Rust")
    print(f"9. replace('Aurora', 'Rust'): {replaced}")

    ## 10. strip_prefix()
    print("10. strip_prefix():")
    print_string_option("strip_prefix('Hello, ')", trimmed.clone().strip_prefix("Hello, "))
    print_string_option("strip_prefix('Bye')", trimmed.clone().strip_prefix("Bye"))

    ## 11. strip_suffix()
    print("11. strip_suffix():")
    print_string_option("strip_suffix(' World!')", trimmed.clone().strip_suffix(" World!"))
    print_string_option("strip_suffix('xyz')", trimmed.clone().strip_suffix("xyz"))

    ## 12. clone()
    cloned = trimmed.clone()
    print(f"12. clone(): {cloned}")
    print(f"    clone().len(): {cloned.len()}")

    ## Combining multiple methods in a pipeline
    print("")
    print("--- Pipeline Demo ---")
    raw = "   AURORA Is AWESOME!   "
    print(f"Raw: [{raw}]")
    result = raw.trim().to_lower().replace("!", "")
    print(f"trim -> to_lower -> replace('!',''): {result}")

    words = result.split(" ")
    print(f"Then split by space: {words.len()} words")
    for w in words:
        print(f"  {w}")

    ## All methods on a single variable chain
    print("")
    print("--- Chain Test ---")
    data = "  KEY=value  "
    clean = data.trim()
    print(f"trim: [{clean}]")
    print(f"len: {clean.clone().len()}")
    print(f"contains('='): {clean.clone().contains("=")}")
    print(f"starts_with('KEY'): {clean.clone().starts_with("KEY")}")
    print(f"ends_with('ue'): {clean.clone().ends_with("ue")}")
    print(f"to_lower: {clean.clone().to_lower()}")
    print(f"to_upper: {clean.clone().to_upper()}")
    print(f"replace('=', ' -> '): {clean.clone().replace("=", " -> ")}")

    kv = clean.clone().split("=")
    print(f"split('='): key={kv[0]}, value={kv[1]}")

    print_string_option("strip_prefix('KEY')", clean.clone().strip_prefix("KEY"))
    print_string_option("strip_suffix('value')", clean.clone().strip_suffix("value"))

    return 0
