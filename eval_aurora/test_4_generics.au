trait Greeter:
    def greet(borrow self)

class Person:
    name: String

impl Greeter for Person:
    def greet(borrow self):
        print(self.name.clone())

def say_hello[T: Greeter](item: borrow T):
    item.greet()

def main() -> None:
    p = Person(name=String("Alice"))
    say_hello(borrow p)
