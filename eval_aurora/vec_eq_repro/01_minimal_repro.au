# Minimal reproducer: Vec equality fails when comparing
# a push-built vec against a literal-built vec
def main():
    # Build via literal
    a = [1, 2, 3]

    # Build via push
    mut b: Vec[int32] = []
    b.push(1)
    b.push(2)
    b.push(3)

    # These should be equal but are not
    print(a == b)
    print(b == a)
    print(a != b)
