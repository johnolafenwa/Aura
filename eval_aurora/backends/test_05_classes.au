class Point:
    x: float64
    y: float64

    def magnitude(borrow self) -> float64:
        return (self.x * self.x + self.y * self.y).sqrt()

class Counter:
    value: int32

    def read(borrow self) -> int32:
        return self.value

    def bump(borrow mut self):
        self.value += 1

    def reset(borrow mut self):
        self.value = 0

    def zero() -> Counter:
        return Counter(value=0)

def distance(a: Point, b: Point) -> float64:
    dx = a.x - b.x
    dy = a.y - b.y
    return (dx * dx + dy * dy).sqrt()

def main() -> int32:
    p1 = Point(x=3.0, y=4.0)
    print(p1.magnitude())

    p2 = Point(x=0.0, y=0.0)
    p3 = Point(x=3.0, y=4.0)
    print(distance(p2, p3))

    mut c = Counter(value=0)
    c.bump()
    c.bump()
    c.bump()
    print(c.read())

    c.reset()
    print(c.read())

    c2 = Counter.zero()
    print(c2.read())

    return 0
