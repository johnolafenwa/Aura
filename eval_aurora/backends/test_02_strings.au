def main() -> int32:
    name: String = "Aurora"
    version: int32 = 42

    greeting = "Hello" + ", " + "World"
    print(greeting)

    fstr = f"Language: {name}"
    print(fstr)

    combined = f"{name} version {version}"
    print(combined)

    a: String = "foo"
    b: String = "bar"
    c = a + b
    print(c)

    empty = ""
    result = "start" + empty + "end"
    print(result)

    return 0
