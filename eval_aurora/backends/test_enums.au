enum Shape:
    Circle(float64)
    Rectangle(float64)

def area(s: Shape) -> float64:
    match s:
        case Shape.Circle(r):
            return r * r * 3.14159
        case Shape.Rectangle(side):
            return side * side

def main() -> int32:
    c = Shape.Circle(5.0)
    r = Shape.Rectangle(3.0)
    print(area(c))
    print(area(r))
    return 0
