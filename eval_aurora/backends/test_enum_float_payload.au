enum MaybeFloat:
    Some(float64)
    None

def describe(m: MaybeFloat) -> String:
    match m:
        case MaybeFloat.Some(v):
            return f"got {v}"
        case MaybeFloat.None:
            return "nothing"

def main() -> int32:
    a = MaybeFloat.Some(3.14)
    b = MaybeFloat.None
    print(describe(a))
    print(describe(b))
    return 0
