def main() -> int32:
    a: int32 = 15
    b: int32 = 7

    sum: int32 = a + b
    diff: int32 = a - b
    product: int32 = a * b
    quotient: int32 = a / b
    remainder: int32 = a % b

    print(sum)
    print(diff)
    print(product)
    print(quotient)
    print(remainder)

    x: float64 = 9.0
    y: float64 = 2.5
    print(x + y)
    print(x * y)
    print(x - y)

    neg: int32 = 0 - 42
    print(neg)

    return 0
