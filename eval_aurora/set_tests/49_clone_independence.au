def main() -> int32:
    s1 = Set{1, 2, 3}
    mut s2 = s1.clone()
    s2.insert(100)
    s2.remove(1)
    # s1 should be unaffected
    print(s1.len())
    print(s1.contains(1))
    print(s1.contains(100))
    # s2 should have changes
    print(s2.len())
    print(s2.contains(100))
    print(s2.contains(1))
    return 0
