def main() -> int32:
    # Given a vec with duplicates, use set to find uniques
    data = [5, 3, 1, 3, 5, 7, 1, 9, 7, 5]
    mut seen = Set[int32]()
    for x in data:
        seen.insert(x)
    print(seen.len())
    print(seen.contains(1))
    print(seen.contains(3))
    print(seen.contains(5))
    print(seen.contains(7))
    print(seen.contains(9))
    return 0
