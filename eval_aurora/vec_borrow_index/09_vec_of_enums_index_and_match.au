enum Shape:
    Circle(int32)
    Square(int32)

def describe(s: Shape):
    match s:
        case Shape.Circle(r):
            print(r)
        case Shape.Square(side):
            print(side)

def main() -> int32:
    shapes = [Shape.Circle(10), Shape.Square(5), Shape.Circle(3)]
    describe(shapes[0])
    describe(shapes[1])
    describe(shapes[2])
    return 0
