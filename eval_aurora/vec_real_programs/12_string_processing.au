## String processing: Vec[String] of names, demonstrate swap on strings,
## borrow-safe indexing, and building filtered lists.
## Note: String comparison (< >) is not supported, so alphabetical sort
## is not possible. We demonstrate swap and other operations instead.
## Uses: swap, borrow iteration on Vec[String], len(), borrow-safe indexing

def main() -> int32:
    mut names: Vec[String] = ["Charlie", "Alice", "Eve", "Bob", "Dave"]

    print("Original names:")
    for name in borrow names:
        print(f"  {name}")

    ## Swap to rearrange: move Alice to front, Bob to second, etc.
    ## Current: [Charlie, Alice, Eve, Bob, Dave]
    ## Swap 0,1: [Alice, Charlie, Eve, Bob, Dave]
    names.swap(0, 1)
    ## Swap 1,3: [Alice, Bob, Eve, Charlie, Dave]
    names.swap(1, 3)
    ## Swap 2,3: [Alice, Bob, Charlie, Eve, Dave]
    names.swap(2, 3)
    ## Swap 3,4: [Alice, Bob, Charlie, Dave, Eve]
    names.swap(3, 4)

    print("After rearranging with swap:")
    for name in borrow names:
        print(f"  {name}")

    ## Borrow-safe read access (String is non-copy)
    print(f"First: {names[0]}")
    print(f"Last: {names[names.len() - 1]}")
    print(f"Total: {names.len()}")

    ## Build a filtered sublist: pick specific indices
    mut selected: Vec[String] = []
    selected.push("Alice")
    selected.push("Charlie")
    selected.push("Eve")

    print("Selected names:")
    for name in borrow selected:
        print(f"  {name}")
    print(f"Selected count: {selected.len()}")

    ## Extend the selected list
    mut more: Vec[String] = []
    more.push("Frank")
    more.push("Grace")
    selected.extend(more)

    print("After extending selected:")
    for name in borrow selected:
        print(f"  {name}")

    return 0
