## Set intersection: find elements present in both vecs using contains.
## Uses: contains, borrow iteration, push, len()

def intersect(a: borrow Vec[int32], b: borrow Vec[int32]) -> Vec[int32]:
    mut result: Vec[int32] = []
    for val in borrow a:
        if b.contains(val):
            result.push(val)
    return result

def print_vec(arr: borrow Vec[int32]):
    mut first = true
    mut buf = "["
    for val in borrow arr:
        if first:
            first = false
        else:
            buf = buf + ", "
        buf = buf + f"{val}"
    buf = buf + "]"
    print(buf)

def main() -> int32:
    a = [1, 2, 3, 4, 5, 6]
    b = [4, 5, 6, 7, 8, 9]

    result = intersect(a, b)
    print("A:")
    print_vec(a)
    print("B:")
    print_vec(b)
    print("Intersection:")
    print_vec(result)
    print(f"Size: {result.len()}")

    return 0
