## Concurrent aggregation with equality check: spawn workers, collect via channel,
## sort, compare against expected with ==.
## Uses: ==, swap (for sorting), contains, extend, len(), channels, task_group

def worker(id: int32, start: int32, count: int32, out: Channel[int32]):
    mut i = start
    mut done: int32 = 0
    while done < count:
        out.send(i * i)
        i += 1
        done += 1

def bubble_sort(arr: borrow mut Vec[int32]):
    n = arr.len()
    mut i: int32 = 0
    while i < n:
        mut j: int32 = 0
        while j < n - 1 - i:
            if arr[j] > arr[j + 1]:
                arr.swap(j, j + 1)
            j += 1
        i += 1

def print_vec(arr: borrow Vec[int32]):
    mut first = true
    mut buf = "["
    for val in borrow arr:
        if first:
            first = false
        else:
            buf = buf + ", "
        buf = buf + f"{val}"
    buf = buf + "]"
    print(buf)

def main() -> int32:
    ch: Channel[int32] = channel()
    mut collected: Vec[int32] = []

    with task_group() as group:
        ## Worker 0: squares of 1,2,3
        group.spawn(worker, 0, 1, 3, ch.clone())
        ## Worker 1: squares of 4,5,6
        group.spawn(worker, 1, 4, 3, ch.clone())

        ## Collect 6 results
        mut count: int32 = 0
        while count < 6:
            select:
                case value = ch.recv():
                    match value:
                        case Option.Some(v):
                            collected.push(v)
                            count += 1
                        case Option.None:
                            break

        ch.close()

    print(f"Collected {collected.len()} values")

    ## Sort results
    bubble_sort(collected)
    print("Sorted results:")
    print_vec(collected)

    ## Verify correctness element-by-element
    ## (Note: == has known bug when comparing push-built vs literal-built vecs)
    expected = [1, 4, 9, 16, 25, 36]
    mut ok = true
    if collected.len() != expected.len():
        ok = false
    else:
        mut k: int32 = 0
        while k < collected.len():
            if collected[k] != expected[k]:
                ok = false
            k += 1
    if ok:
        print("Equality check: PASS")
    else:
        print("Equality check: FAIL")

    ## Check contains
    if collected.contains(9) and collected.contains(36):
        print("Contains check: PASS")

    return 0
