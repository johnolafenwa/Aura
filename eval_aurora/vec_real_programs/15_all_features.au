## All features in one program: exercises every new Vec feature at least once.
## Features tested:
##   - Borrow-safe indexing on String (non-copy)
##   - len() returns int32 (used directly in range())
##   - swap(i, j)
##   - contains(value)
##   - extend(other_vec)
##   - == and != operators
##   - for x in borrow mut vec: mutable iteration

def print_bool(label: String, value: bool):
    match value:
        case true:
            print(f"{label}: true")
        case false:
            print(f"{label}: false")

def main() -> int32:
    print("=== 1. Borrow-safe indexing on String ===")
    names: Vec[String] = ["Ada", "Grace", "Alan"]
    print(f"names[0] = {names[0]}")
    print(f"names[2] = {names[2]}")
    ## Vec still usable after indexing
    print(f"len = {names.len()}")

    print("=== 2. len() in range() ===")
    data = [10, 20, 30]
    for i in range(data.len()):
        print(f"data[{i}] = {data[i]}")

    print("=== 3. swap ===")
    mut nums = [1, 2, 3, 4, 5]
    nums.swap(0, 4)
    nums.swap(1, 3)
    ## Should be [5, 4, 3, 2, 1]
    for val in borrow nums:
        print(val)

    print("=== 4. contains ===")
    print_bool("nums contains 3", nums.contains(3))
    print_bool("nums contains 99", nums.contains(99))

    print("=== 5. extend ===")
    mut base = [1, 2]
    extra = [3, 4, 5]
    base.extend(extra)
    for val in borrow base:
        print(val)

    print("=== 6. == and != ===")
    a = [1, 2, 3, 4, 5]
    b = [1, 2, 3, 4, 5]
    c = [5, 4, 3, 2, 1]
    print_bool("a == b", a == b)
    print_bool("a != b", a != b)
    print_bool("a == c", a == c)
    print_bool("a != c", a != c)

    print("=== 7. borrow mut iteration ===")
    mut values = [10, 20, 30, 40]
    for val in borrow mut values:
        val = val + 5
    print("After adding 5 to each:")
    for val in borrow values:
        print(val)

    print("=== All features exercised! ===")
    return 0
