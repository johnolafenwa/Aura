## Normalize floats: find max, divide all by max using borrow mut.
## Uses: borrow mut iteration, borrow iteration, Vec[float64]

def main() -> int32:
    mut data: Vec[float64] = [3.0, 7.0, 1.5, 10.0, 4.5]

    print("Original:")
    for val in borrow data:
        print(val)

    ## Find maximum
    mut max_val = 0.0
    for val in borrow data:
        if val > max_val:
            max_val = val
    print(f"Max: {max_val}")

    ## Normalize: divide each by max
    for val in borrow mut data:
        val = val / max_val

    print("Normalized:")
    for val in borrow data:
        print(val)

    return 0
