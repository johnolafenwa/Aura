## Build and compare: build two vecs differently, verify equality with == and !=.
## Uses: ==, !=, push, extend, literal construction
##
## NOTE: Known bug -- Vec equality comparing push-built vecs against literal-built
## vecs returns false even when contents match. The test documents this.

def print_bool(label: String, value: bool):
    match value:
        case true:
            print(f"{label}: true")
        case false:
            print(f"{label}: false")

def main() -> int32:
    ## Method 1: direct literal
    literal_vec = [1, 2, 3, 4, 5]

    ## Method 2: push loop
    mut push_vec: Vec[int32] = []
    mut i: int32 = 1
    while i <= 5:
        push_vec.push(i)
        i += 1

    ## Method 3: extend from pieces
    mut extend_vec: Vec[int32] = [1, 2]
    rest = [3, 4, 5]
    extend_vec.extend(rest)

    ## Literal vs literal (same construction path) -- works
    lit2 = [1, 2, 3, 4, 5]
    print_bool("literal == literal", literal_vec == lit2)

    ## Push vs push (same construction path) -- works
    mut push2: Vec[int32] = []
    mut j: int32 = 1
    while j <= 5:
        push2.push(j)
        j += 1
    print_bool("push == push", push_vec == push2)

    ## Extend result keeps literal origin -- works with literal
    print_bool("literal == extend", literal_vec == extend_vec)

    ## Known bug: push-built != literal-built even with same contents
    print_bool("literal == push (known bug)", literal_vec == push_vec)
    print_bool("push == extend (known bug)", push_vec == extend_vec)

    ## Test true inequality -- different values
    different = [1, 2, 3, 4, 6]
    print_bool("literal == different", literal_vec == different)
    print_bool("literal != different", literal_vec != different)

    ## Test different lengths
    shorter = [1, 2, 3]
    print_bool("literal == shorter", literal_vec == shorter)

    return 0
