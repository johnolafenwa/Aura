def main() -> int32:
    # parse_int32 valid
    match parse_int32("42"):
        case Result.Ok(value):
            print(value.to_string())
        case Result.Err(_):
            print("FAIL-int32-valid")

    # parse_int32 negative
    match parse_int32("-100"):
        case Result.Ok(value):
            print(value.to_string())
        case Result.Err(_):
            print("FAIL-int32-neg")

    # parse_int32 invalid
    match parse_int32("hello"):
        case Result.Ok(_):
            print("FAIL-should-err")
        case Result.Err(msg):
            print("int32-err-ok")

    # parse_int64 valid
    match parse_int64("9000000000"):
        case Result.Ok(value):
            print(value.to_string())
        case Result.Err(_):
            print("FAIL-int64-valid")

    # parse_int64 invalid
    match parse_int64("not_a_number"):
        case Result.Ok(_):
            print("FAIL-should-err")
        case Result.Err(msg):
            print("int64-err-ok")

    # parse_float64 valid
    match parse_float64("3.14"):
        case Result.Ok(value):
            print(value.to_string())
        case Result.Err(_):
            print("FAIL-float64-valid")

    # parse_float64 invalid
    match parse_float64("xyz"):
        case Result.Ok(_):
            print("FAIL-should-err")
        case Result.Err(msg):
            print("float64-err-ok")

    # to_string on int
    x: int32 = 99
    print(x.to_string())

    # to_string on bool
    print(true.to_string())
    print(false.to_string())

    # Round-trip: parse(x.to_string()) == x for int32
    a: int32 = 777
    match parse_int32(a.to_string()):
        case Result.Ok(value):
            print((value == 777).to_string())
        case Result.Err(_):
            print("FAIL-roundtrip-int32")

    # Round-trip: parse(x.to_string()) == x for int64
    b: int64 = 123456789
    match parse_int64(b.to_string()):
        case Result.Ok(value):
            print((value == 123456789).to_string())
        case Result.Err(_):
            print("FAIL-roundtrip-int64")

    return 0
