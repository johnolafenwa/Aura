def print_entry(e: borrow MapEntry[String, int32]):
    print(f"{e.key} = {e.value}")

def main() -> int32:
    # Create map and get entries
    data = {"x": 10, "y": 20, "z": 30}
    items = data.items()

    # Access .key and .value
    print(items[0].key)
    print(items[0].value.to_string())
    print(items[1].key)
    print(items[1].value.to_string())
    print(items[2].key)
    print(items[2].value.to_string())

    # Pass entry to function via borrow
    for entry in borrow items:
        print_entry(entry)

    # entries() same as items()
    entries = data.entries()
    print(entries.len().to_string())
    print(entries[0].key)

    # String-valued map entries
    labels = {"greeting": "hello", "farewell": "bye"}
    label_items = labels.items()
    print(label_items[0].key)
    print(label_items[0].value)
    print(label_items[1].key)
    print(label_items[1].value)

    return 0
