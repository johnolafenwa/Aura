def sum_set(values: borrow Set[int32]) -> int32:
    mut total = 0
    for value in borrow values:
        total += value
    return total

def main() -> int32:
    # === parse_int32 + to_string ===
    match parse_int32("123"):
        case Result.Ok(v):
            print(v.to_string())
        case Result.Err(_):
            print("FAIL")

    # === parse_float64 ===
    match parse_float64("2.718"):
        case Result.Ok(v):
            print(v.to_string())
        case Result.Err(_):
            print("FAIL")

    # === join + split ===
    words = "the quick brown fox".split(" ")
    print(words.len().to_string())
    rejoined = "-".join(words)
    print(rejoined)

    # === Vec.insert + Vec.reverse ===
    mut nums = [10, 30]
    nums.insert(1, 20)
    nums.push(40)
    nums.reverse()
    for n in borrow nums:
        print(n.to_string())

    # === Map with entries + extend ===
    mut config = {"host": "localhost", "port": "8080"}
    extra = {"debug": "true"}
    config.extend(extra)
    items = config.items()
    print(items.len().to_string())

    # access entries
    print(config["host"])
    print(config["debug"])

    entries = config.entries()
    print(entries.len().to_string())

    keys = config.keys()
    print(keys.len().to_string())

    # === Set basics ===
    mut seen = Set{1, 2, 3, 2, 1}
    print(seen.len().to_string())
    seen.insert(4)
    print(seen.contains(4).to_string())
    seen.remove(1)
    total = sum_set(seen)
    print(total.to_string())

    # === bool to_string ===
    print(true.to_string())
    print(false.to_string())

    # === to_string on int ===
    x: int32 = 42
    print(x.to_string())

    # === round-trip parse(to_string()) ===
    val: int32 = 555
    match parse_int32(val.to_string()):
        case Result.Ok(v):
            print((v == 555).to_string())
        case Result.Err(_):
            print("FAIL")

    # === Map clear ===
    config.clear()
    print(config.is_empty().to_string())

    # === Vec clear ===
    nums.clear()
    print(nums.is_empty().to_string())

    return 0
