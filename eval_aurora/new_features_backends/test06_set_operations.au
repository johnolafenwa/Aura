def main() -> int32:
    # Test if set operations (union, intersection, difference) exist
    # These are NOT expected to be implemented yet
    a = Set{1, 2, 3}
    b = Set{2, 3, 4}

    # Manual union: iterate both and insert
    mut union_set: Set[int32] = Set[int32]()
    for v in a:
        union_set.insert(v)
    for v in b:
        union_set.insert(v)
    print(union_set.len().to_string())
    print(union_set.contains(1).to_string())
    print(union_set.contains(4).to_string())

    # Manual intersection
    c = Set{1, 2, 3}
    d = Set{2, 3, 4}
    mut inter_count = 0
    for v in c:
        if d.contains(v):
            inter_count += 1
    print(inter_count.to_string())

    # Manual difference (in c but not in d2)
    c2 = Set{1, 2, 3}
    d2 = Set{2, 3, 4}
    mut diff_count = 0
    for v in c2:
        if not d2.contains(v):
            diff_count += 1
    print(diff_count.to_string())

    return 0
