def main() -> int32:
    # Create a map with some values
    mut counts = {"alpha": 1, "beta": 2, "gamma": 3}
    print(counts.len().to_string())

    # entries() returns Vec of MapEntry
    entries = counts.entries()
    print(entries.len().to_string())

    # items() is the same as entries()
    items = counts.items()
    print(items.len().to_string())

    # Access key and value on entry
    print(items[0].key)
    print(items[0].value.to_string())

    # keys() and values()
    keys = counts.keys()
    print(keys.len().to_string())
    values = counts.values()
    print(values.len().to_string())

    # contains_key
    print(counts.contains_key("alpha").to_string())
    print(counts.contains_key("missing").to_string())

    # extend with another map
    extra = {"delta": 4, "epsilon": 5}
    counts.extend(extra)
    print(counts.len().to_string())
    print(counts.contains_key("delta").to_string())
    print(counts.contains_key("epsilon").to_string())

    # get
    match counts.get("delta"):
        case Some(val):
            print(val.to_string())
        case None:
            print("FAIL")

    # set returns old value
    match counts.set(key="alpha", value=99):
        case Some(old):
            print(old.to_string())
        case None:
            print("FAIL-no-old")

    print(counts["alpha"].to_string())

    # remove
    match counts.remove("beta"):
        case Some(old):
            print(old.to_string())
        case None:
            print("FAIL-no-remove")

    print(counts.len().to_string())

    # clear
    counts.clear()
    print(counts.len().to_string())
    print(counts.is_empty().to_string())

    return 0
