def main() -> int32:
    # Invalid parse_int32
    match parse_int32(""):
        case Result.Ok(_):
            print("FAIL")
        case Result.Err(msg):
            print("empty-int32-err")

    match parse_int32("3.14"):
        case Result.Ok(_):
            print("FAIL")
        case Result.Err(msg):
            print("float-as-int32-err")

    match parse_int32("99999999999999999999"):
        case Result.Ok(_):
            print("FAIL")
        case Result.Err(msg):
            print("overflow-int32-err")

    # Invalid parse_int64
    match parse_int64("abc"):
        case Result.Ok(_):
            print("FAIL")
        case Result.Err(msg):
            print("invalid-int64-err")

    # Invalid parse_float64
    match parse_float64("not_a_float"):
        case Result.Ok(_):
            print("FAIL")
        case Result.Err(msg):
            print("invalid-float64-err")

    # parse_float64 with empty string
    match parse_float64(""):
        case Result.Ok(_):
            print("FAIL")
        case Result.Err(msg):
            print("empty-float64-err")

    # Vec insert out of bounds returns false
    mut v = [1, 2, 3]
    result = v.insert(10, 99)
    print(result.to_string())
    print(v.len().to_string())

    # Vec get out of bounds returns None
    match v.get(100):
        case Some(_):
            print("FAIL")
        case None:
            print("get-oob-none")

    # Vec remove out of bounds returns None
    match v.remove(50):
        case Some(_):
            print("FAIL")
        case None:
            print("remove-oob-none")

    # Vec pop on empty returns None
    mut empty: Vec[int32] = []
    match empty.pop():
        case Some(_):
            print("FAIL")
        case None:
            print("pop-empty-none")

    # Map get missing key returns None
    data = {"a": 1}
    match data.get("missing"):
        case Some(_):
            print("FAIL")
        case None:
            print("map-get-none")

    # Map remove missing key returns None
    mut mdata = {"a": 1}
    match mdata.remove("missing"):
        case Some(_):
            print("FAIL")
        case None:
            print("map-remove-none")

    # Set remove absent returns false
    mut s = Set{1, 2}
    print(s.remove(99).to_string())

    # Set insert duplicate returns false
    print(s.insert(1).to_string())

    return 0
