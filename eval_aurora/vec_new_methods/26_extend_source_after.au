# Test 26: Source vec after extend - extend CONSUMES (moves) the source
# b is NOT usable after a.extend(b) - it is moved
# This test verifies that extend works and documents the move semantics
def main() -> int32:
    mut a = [1, 2]
    b = [3, 4]
    a.extend(b)
    # b is now moved and cannot be used
    # Verify a has all elements
    for x in borrow a:
        print(x)
    print(a.len())
    return 0
