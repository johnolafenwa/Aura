# Test 06: len() after mutations - push 5, verify 5; pop 2, verify 3
def main() -> int32:
    mut v = Vec[int32]()
    print(v.len())

    v.push(10)
    v.push(20)
    v.push(30)
    v.push(40)
    v.push(50)
    print(v.len())

    v.pop()
    v.pop()
    print(v.len())

    # Also test len after remove
    v.remove(0)
    print(v.len())

    return 0
