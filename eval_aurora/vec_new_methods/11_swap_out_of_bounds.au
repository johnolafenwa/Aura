# Test 11: Swap out of bounds - returns false
def main() -> int32:
    mut v = [10, 20, 30]

    # One index out of bounds
    result1 = v.swap(0, 99)
    print(result1)

    # Both indices out of bounds
    result2 = v.swap(10, 20)
    print(result2)

    # Verify vec unchanged
    print(v[0])
    print(v[1])
    print(v[2])

    return 0
