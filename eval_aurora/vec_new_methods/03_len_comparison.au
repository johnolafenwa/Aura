# Test 03: Comparison with int32 - no cast needed
def main() -> int32:
    v = [10, 20, 30]

    if v.len() == 3:
        print("len == 3: true")

    if v.len() > 0:
        print("len > 0: true")

    if v.len() >= 3:
        print("len >= 3: true")

    if v.len() != 0:
        print("len != 0: true")

    # while loop with len comparison
    mut xs = [1, 2, 3, 4]
    mut i: int32 = 0
    while i < xs.len():
        print(xs[i])
        i += 1

    return 0
