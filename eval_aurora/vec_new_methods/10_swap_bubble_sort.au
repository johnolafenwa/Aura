# Test 10: Bubble sort using swap instead of manual temp variable
def bubble_sort(arr: borrow mut Vec[int32]):
    n = arr.len()
    mut i: int32 = 0
    while i < n:
        mut j: int32 = 0
        while j < n - 1 - i:
            if arr[j] > arr[j + 1]:
                arr.swap(j, j + 1)
            j += 1
        i += 1

def main() -> int32:
    mut data = [64, 34, 25, 12, 22, 11, 90]
    bubble_sort(data)
    for x in borrow data:
        print(x)
    return 0
