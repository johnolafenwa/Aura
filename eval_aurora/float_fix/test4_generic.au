enum Maybe[T]:
    Just(T)
    Nothing

def get_or_default(m: Maybe[float64], default: float64) -> float64:
    match m:
        case Maybe.Just(v):
            return v
        case Maybe.Nothing:
            return default

def main():
    a: Maybe[float64] = Maybe.Just(2.718)
    b: Maybe[float64] = Maybe.Nothing
    print(get_or_default(m=a, default=0.0))
    print(get_or_default(m=b, default=99.9))
