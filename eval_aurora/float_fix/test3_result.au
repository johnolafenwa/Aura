def safe_div(a: float64, b: float64) -> Result[float64, String]:
    if b == 0.0:
        return Result.Err("division by zero")
    return Result.Ok(a / b)

def extract(r: Result[float64, String]) -> float64:
    match r:
        case Result.Ok(val):
            return val
        case Result.Err(msg):
            print(msg)
            return -1.0

def main():
    r1 = safe_div(10.0, 3.0)
    r2 = safe_div(10.0, 0.0)
    print(extract(r1))
    print(extract(r2))
