enum Action:
    Scale(float64)
    Reset

def process(val: float64, action: Action) -> float64:
    match action:
        case Action.Scale(factor):
            return val * factor
        case Action.Reset:
            return 0.0

def main():
    mut val: float64 = 1.0
    for i in range(5):
        val = process(val=val, action=Action.Scale(2.0))
    print(val)
    val = process(val=val, action=Action.Reset)
    print(val)
