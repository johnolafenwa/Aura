def fail_if_zero(val: int32) -> Result[int32, String]:
    if val == 0:
        return Err(String("zero not allowed"))
    return Ok(val * 2)

def do_work(val: int32) -> Result[int32, String]:
    res = try fail_if_zero(val)
    return Ok(res + 1)

def main() -> None:
    match do_work(5):
        case Ok(v):
            print(v)
        case Err(e):
            print(e)
            
    match do_work(0):
        case Ok(v):
            print(v)
        case Err(e):
            print(e)
