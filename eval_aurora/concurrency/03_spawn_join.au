# Test 3: Spawn task and join it
def worker(out: Channel[int32]):
    out.send(42)
    out.close()

def main() -> int32:
    ch: Channel[int32] = channel()
    task = spawn worker(ch.clone())

    match ch.recv():
        case Option.Some(v):
            print(v)
        case Option.None:
            print("none")

    task.join()
    print("joined")
    return 0
