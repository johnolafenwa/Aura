# Test 13: Fan-out pattern - one producer, multiple consumers
def consumer(id: int32, input: Channel[int32], output: Channel[int32]):
    while true:
        match input.recv():
            case Option.Some(v):
                output.send(v * id)
            case Option.None:
                return

def main() -> int32:
    jobs: Channel[int32] = channel()
    results: Channel[int32] = channel()
    mut total: int32 = 0

    with task_group() as group:
        # Start 3 consumers
        group.spawn(consumer, 1, jobs.clone(), results.clone())
        group.spawn(consumer, 2, jobs.clone(), results.clone())
        group.spawn(consumer, 3, jobs.clone(), results.clone())

        # Send 3 jobs
        jobs.send(10)
        jobs.send(10)
        jobs.send(10)
        jobs.close()

        # Collect 3 results
        mut count: int32 = 0
        while count < 3:
            match results.recv():
                case Option.Some(v):
                    total += v
                    count += 1
                case Option.None:
                    break

    print(total)
    return 0
