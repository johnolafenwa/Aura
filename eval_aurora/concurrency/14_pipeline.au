# Test 14: Pipeline pattern - chain of workers connected by channels
def stage1(input: Channel[int32], output: Channel[int32]):
    # Add 10 to each value
    while true:
        match input.recv():
            case Option.Some(v):
                output.send(v + 10)
            case Option.None:
                output.close()
                return

def stage2(input: Channel[int32], output: Channel[int32]):
    # Multiply by 2
    while true:
        match input.recv():
            case Option.Some(v):
                output.send(v * 2)
            case Option.None:
                output.close()
                return

def main() -> int32:
    ch1: Channel[int32] = channel()
    ch2: Channel[int32] = channel()
    ch3: Channel[int32] = channel()

    t1 = spawn stage1(ch1.clone(), ch2.clone())
    t2 = spawn stage2(ch2.clone(), ch3.clone())

    # Feed pipeline: 5 -> +10 -> 15 -> *2 -> 30
    ch1.send(5)
    ch1.close()

    match ch3.recv():
        case Option.Some(v):
            print(v)
        case Option.None:
            print("none")

    t1.join()
    t2.join()
    return 0
