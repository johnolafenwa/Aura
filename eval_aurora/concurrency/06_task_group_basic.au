# Test 6: Task group - spawn multiple tasks in group
def worker(out: Channel[int32], value: int32):
    out.send(value)

def main() -> int32:
    out: Channel[int32] = channel()
    mut total: int32 = 0

    with task_group() as group:
        group.spawn(worker, out.clone(), 10)
        group.spawn(worker, out.clone(), 20)
        group.spawn(worker, out.clone(), 30)

        mut count: int32 = 0
        while count < 3:
            match out.recv():
                case Option.Some(v):
                    total += v
                    count += 1
                case Option.None:
                    break

    print(total)
    return 0
