# Test 4: Multiple producers sending to one channel
def producer(out: Channel[int32], value: int32):
    out.send(value)

def main() -> int32:
    ch: Channel[int32] = channel()

    t1 = spawn producer(ch.clone(), 10)
    t2 = spawn producer(ch.clone(), 20)
    t3 = spawn producer(ch.clone(), 30)

    mut total: int32 = 0
    mut count: int32 = 0
    while count < 3:
        match ch.recv():
            case Option.Some(v):
                total += v
                count += 1
            case Option.None:
                break

    t1.join()
    t2.join()
    t3.join()

    print(total)
    return 0
