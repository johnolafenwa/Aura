# Test 2: Channel iteration with for loop
def main() -> int32:
    ch: Channel[int32] = channel()
    ch.send(1)
    ch.send(2)
    ch.send(3)
    ch.send(4)
    ch.send(5)
    ch.close()

    mut sum: int32 = 0
    for value in ch:
        sum += value
        print(value)

    print(sum)
    return 0
