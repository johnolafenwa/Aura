# Test 12: Channel of strings
def greeter(out: Channel[String]):
    out.send("hello")
    out.send("world")
    out.close()

def main() -> int32:
    ch: Channel[String] = channel()
    task = spawn greeter(ch.clone())

    while true:
        match ch.recv():
            case Option.Some(msg):
                print(msg)
            case Option.None:
                break

    task.join()
    print("done")
    return 0
