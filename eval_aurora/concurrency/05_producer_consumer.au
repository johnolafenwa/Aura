# Test 5: Classic producer-consumer pattern
def producer(out: Channel[int32]):
    mut i: int32 = 1
    while i <= 5:
        out.send(i)
        i += 1
    out.close()

def main() -> int32:
    ch: Channel[int32] = channel()
    task = spawn producer(ch.clone())

    mut sum: int32 = 0
    while true:
        match ch.recv():
            case Option.Some(v):
                sum += v
            case Option.None:
                break

    task.join()
    print(sum)
    return 0
