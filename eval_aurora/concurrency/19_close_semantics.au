# Test 19: Close semantics - what happens sending to closed channel?
def main() -> int32:
    ch: Channel[int32] = channel()

    # Send before close
    ch.send(1)
    ch.send(2)
    ch.close()

    # Recv from closed channel should drain remaining values
    match ch.recv():
        case Option.Some(v):
            print(v)
        case Option.None:
            print("none")

    match ch.recv():
        case Option.Some(v):
            print(v)
        case Option.None:
            print("none")

    # After draining, should get None
    match ch.recv():
        case Option.Some(v):
            print(v)
        case Option.None:
            print("drained")

    # Send to closed channel
    match ch.send(99):
        case Result.Ok(value):
            print("unexpected")
        case Result.Err(error):
            match error:
                case SendError.Closed(v):
                    print(v)

    return 0
