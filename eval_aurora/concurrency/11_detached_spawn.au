# Test 11: Detached spawn (fire and forget)
def background(out: Channel[int32]):
    out.send(99)
    out.close()

def main() -> int32:
    ch: Channel[int32] = channel()
    spawn detached background(ch.clone())

    match ch.recv():
        case Option.Some(v):
            print(v)
        case Option.None:
            print("none")

    return 0
