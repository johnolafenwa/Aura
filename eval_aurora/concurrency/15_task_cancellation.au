# Test 15: Task cancellation - cancel group, check cancelled()
def worker(out: Channel[int32]):
    mut i: int32 = 0
    while true:
        if cancelled():
            out.send(-1)
            return
        out.send(i)
        i += 1

def main() -> int32:
    out: Channel[int32] = channel()

    with task_group() as group:
        group.spawn(worker, out.clone())

        # Read first value
        match out.recv():
            case Option.Some(v):
                print(v)
            case Option.None:
                print("none")

        # Cancel the group
        group.cancel()

    print("cancelled")
    return 0
