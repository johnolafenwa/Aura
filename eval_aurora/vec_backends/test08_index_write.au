def print_option(value: Option[int32]):
    match value:
        case Some(inner):
            print(inner)
        case None:
            print(-1)

def main() -> int32:
    mut xs = [10, 20, 30]
    print_option(xs.set(index=0, value=100))
    print_option(xs.set(index=2, value=300))
    print(xs[0])
    print(xs[1])
    print(xs[2])
    return 0
