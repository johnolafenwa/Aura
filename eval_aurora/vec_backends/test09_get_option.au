def print_option(value: Option[int32]):
    match value:
        case Some(inner):
            print(inner)
        case None:
            print(-1)

def main() -> int32:
    xs = [10, 20, 30]
    print_option(xs.get(0))
    print_option(xs.get(1))
    print_option(xs.get(2))
    print_option(xs.get(3))
    print_option(xs.get(99))
    return 0
