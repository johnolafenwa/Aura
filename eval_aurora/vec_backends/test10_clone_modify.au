def print_option(value: Option[int32]):
    match value:
        case Some(inner):
            print(inner)
        case None:
            print(-1)

def main() -> int32:
    original = [1, 2, 3]
    mut copy = original.clone()
    copy.push(4)
    print_option(copy.set(index=0, value=99))
    print(original[0])
    print(original[1])
    print(original[2])
    print(original.len())
    print(copy[0])
    print(copy[1])
    print(copy[2])
    print(copy[3])
    print(copy.len())
    return 0
