# Test 16: Clear a String vec
def print_bool(value: bool):
    match value:
        case true:
            print("true")
        case false:
            print("false")

def main() -> int32:
    mut v = ["hello", "world", "test"]
    print(v.len())
    v.clear()
    print(v.len())
    print_bool(v.is_empty())
    return 0
