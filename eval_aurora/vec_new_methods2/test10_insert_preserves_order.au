# Test 10: Insert preserves order — build sorted list
def main() -> int32:
    mut sorted = Vec[int32]()
    # Insert values: 3, 1, 4, 1, 5, 9, 2, 6
    # Insert 3
    sorted.insert(index=0, value=3)
    # Insert 1 before 3
    sorted.insert(index=0, value=1)
    # Insert 4 after 3
    sorted.insert(index=2, value=4)
    # Insert 1 at beginning (duplicate ok)
    sorted.insert(index=0, value=1)
    # Insert 5 after 4
    sorted.insert(index=4, value=5)
    # Insert 9 at end
    sorted.insert(index=5, value=9)
    # Insert 2 at position 2 (between 1 and 3)
    sorted.insert(index=2, value=2)
    # Insert 6 at position 6 (between 5 and 9)
    sorted.insert(index=6, value=6)
    # Should be [1, 1, 2, 3, 4, 5, 6, 9]
    mut i = 0
    while i < sorted.len():
        print(sorted[i])
        i += 1
    return 0
