# Test 5: Multiple inserts at various positions
def main() -> int32:
    mut v = Vec[int32]()
    v.insert(index=0, value=3)
    v.insert(index=0, value=1)
    v.insert(index=1, value=2)
    v.insert(index=3, value=5)
    v.insert(index=3, value=4)
    # Should be [1, 2, 3, 4, 5]
    print(v.len())
    mut i = 0
    while i < v.len():
        print(v[i])
        i += 1
    return 0
