# Test 29: Clear + rebuild with inserts
def main() -> int32:
    mut v = [100, 200, 300]
    print(v.len())
    v.clear()
    print(v.len())
    v.insert(index=0, value=10)
    v.insert(index=1, value=20)
    v.insert(index=2, value=30)
    print(v.len())
    print(v[0])
    print(v[1])
    print(v[2])
    return 0
