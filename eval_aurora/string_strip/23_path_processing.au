def process_path(path: String) -> String:
    mut result = path
    match result.strip_prefix("src/"):
        case Some(without_prefix):
            result = without_prefix
        case None:
            result = result
    match result.strip_suffix(".au"):
        case Some(without_suffix):
            return without_suffix
        case None:
            return result

def main() -> int32:
    print(process_path("src/main.au"))
    print(process_path("src/utils.py"))
    print(process_path("lib/main.au"))
    return 0
