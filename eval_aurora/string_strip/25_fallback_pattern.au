def remove_prefix_or_keep(s: String, prefix: String) -> String:
    match s.strip_prefix(prefix):
        case Some(stripped):
            return stripped
        case None:
            return s

def main() -> int32:
    print(remove_prefix_or_keep("hello_world", "hello_"))
    print(remove_prefix_or_keep("goodbye_world", "hello_"))
    return 0
