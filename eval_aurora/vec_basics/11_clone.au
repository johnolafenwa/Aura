def main() -> int32:
    mut original = [10, 20, 30]
    mut cloned = original.clone()

    # Modify the clone
    cloned[0] = 999
    cloned.push(40)

    # Verify original is unchanged
    print(original[0])
    print(original[1])
    print(original[2])
    print(original.len())

    # Verify clone has changes
    print(cloned[0])
    print(cloned[1])
    print(cloned[2])
    print(cloned[3])
    print(cloned.len())

    return 0
