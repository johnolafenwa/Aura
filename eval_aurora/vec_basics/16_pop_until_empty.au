def main() -> int32:
    mut v = Vec[int32]()

    # Push N elements
    for i in range(10):
        v.push(i)

    print(v.len())
    print(v.is_empty())

    # Pop all
    mut count: int32 = 0
    mut done = false
    for _ in range(20):
        if done:
            pass
        else:
            match v.pop():
                case Some(val):
                    count += 1
                case None:
                    done = true

    print(count)
    print(v.len())
    print(v.is_empty())

    return 0
