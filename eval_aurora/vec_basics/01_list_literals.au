def main() -> int32:
    # Vec[int32] from literal
    ints = [10, 20, 30]
    print(ints[0])
    print(ints[1])
    print(ints[2])

    # Vec[float64] from literal
    floats = [1.1, 2.2, 3.3]
    print(floats[0])
    print(floats[1])
    print(floats[2])

    # Vec[bool] from literal
    bools = [true, false, true]
    print(bools[0])
    print(bools[1])
    print(bools[2])

    # Vec[String] from literal - use borrow iteration since String has move semantics
    strs = ["hello", "world", "aurora"]
    for s in borrow strs:
        print(s)

    return 0
