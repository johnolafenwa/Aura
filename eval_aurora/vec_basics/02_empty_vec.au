def main() -> int32:
    # Empty vec with type annotation
    empty1: Vec[int32] = []
    print(empty1.is_empty())
    print(empty1.len())

    # Empty vec with explicit constructor
    empty2 = Vec[int32]()
    print(empty2.is_empty())
    print(empty2.len())

    # Empty vec of strings
    empty3: Vec[String] = []
    print(empty3.is_empty())
    print(empty3.len())

    return 0
