def print_opt(value: Option[int32]):
    match value:
        case Some(inner):
            print(inner)
        case None:
            print("None")

def main() -> int32:
    mut v = Vec[int32]()

    # Push some elements
    v.push(10)
    v.push(20)
    v.push(30)
    print(v.len())

    # Pop one
    print_opt(v.pop())
    print(v.len())

    # Set element
    print_opt(v.set(index=0, value=100))
    print(v[0])

    # Push more
    v.push(40)
    v.push(50)
    print(v.len())

    # Remove from middle
    print_opt(v.remove(1))
    print(v.len())

    # Get remaining elements
    print_opt(v.get(0))
    print_opt(v.get(1))
    print_opt(v.get(2))

    # Push and pop interleaved
    v.push(60)
    print_opt(v.pop())
    v.push(70)
    v.push(80)
    print_opt(v.pop())
    print(v.len())

    # Index write
    v[0] = 999
    print(v[0])

    return 0
