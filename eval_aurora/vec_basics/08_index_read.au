def main() -> int32:
    v = [100, 200, 300, 400, 500]

    # Read each element with bracket notation
    print(v[0])
    print(v[1])
    print(v[2])
    print(v[3])
    print(v[4])

    # Read with computed index
    mut i: int32 = 0
    for _ in range(5):
        print(v[i])
        i += 1

    return 0
