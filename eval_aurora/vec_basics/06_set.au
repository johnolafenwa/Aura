def print_opt(value: Option[int32]):
    match value:
        case Some(inner):
            print(inner)
        case None:
            print("None")

def main() -> int32:
    mut v = [10, 20, 30, 40, 50]

    # Set at valid indices - should return old value as Some
    print_opt(v.set(index=0, value=100))
    print_opt(v.set(index=2, value=300))
    print_opt(v.set(index=4, value=500))

    # Verify updated values
    print(v[0])
    print(v[1])
    print(v[2])
    print(v[3])
    print(v[4])

    # Set at invalid index - should return None
    print_opt(v.set(index=10, value=999))
    print_opt(v.set(index=999, value=999))

    return 0
