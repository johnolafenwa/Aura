def main() -> int32:
    # Test: push to original after clone
    mut v = [1, 2, 3]
    cloned = v.clone()

    v.push(4)
    v.push(5)
    print(v.len())

    # Clone should still have 3
    print(cloned.len())

    # Print both
    for x in v:
        print(x)

    for x in cloned:
        print(x)

    return 0
