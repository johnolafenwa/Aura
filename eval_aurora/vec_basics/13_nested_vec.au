def main() -> int32:
    # Create a 2D structure: Vec[Vec[int32]]
    row1 = [1, 2, 3]
    row2 = [4, 5, 6]
    row3 = [7, 8, 9]

    mut matrix: Vec[Vec[int32]] = []
    matrix.push(row1)
    matrix.push(row2)
    matrix.push(row3)

    print(matrix.len())

    # Access inner elements via borrow iteration
    # Direct indexing moves the inner vec, so we use borrow
    for row in borrow matrix:
        print(row[0])
        print(row[1])
        print(row[2])

    return 0
