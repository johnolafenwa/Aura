def main() -> int32:
    # Test: can we index into a nested vec if we only access the outer once?
    row1 = [1, 2, 3]
    row2 = [4, 5, 6]

    mut matrix: Vec[Vec[int32]] = []
    matrix.push(row1)
    matrix.push(row2)

    # Single indexing should move the inner vec out
    inner = matrix[0]
    print(inner[0])
    print(inner[1])
    print(inner[2])

    return 0
