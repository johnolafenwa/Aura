def main() -> int32:
    mut m = Map[String, int32]()
    # First set should return None (no previous value)
    result1 = m.set("key", 10)
    match result1:
        case Some(v):
            print(v)
        case None:
            print("None")
    # Second set should return Some(10) (previous value)
    result2 = m.set("key", 20)
    match result2:
        case Some(v):
            print(v)
        case None:
            print("None")
    return 0
