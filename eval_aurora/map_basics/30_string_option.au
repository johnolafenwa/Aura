def main() -> int32:
    mut m = Map[String, Option[int32]]()
    m.set("present", Option.Some(42))
    m.set("absent", Option.None)
    match m.get("present"):
        case Some(inner):
            match inner:
                case Some(v):
                    print(v)
                case None:
                    print("inner None")
        case None:
            print("key None")
    match m.get("absent"):
        case Some(inner):
            match inner:
                case Some(v):
                    print(v)
                case None:
                    print("inner None")
        case None:
            print("key None")
    return 0
