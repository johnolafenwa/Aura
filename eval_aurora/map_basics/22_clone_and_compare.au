def main() -> int32:
    mut m = Map[String, int32]()
    m.set("x", 10)
    m.set("y", 20)
    cloned = m.clone()
    match cloned.get("x"):
        case Some(v):
            print(v)
        case None:
            print("None")
    match cloned.get("y"):
        case Some(v):
            print(v)
        case None:
            print("None")
    return 0
