class Config:
    settings: Map[String, String]

    def new(settings: Map[String, String]) -> Config:
        return Config(settings=settings)

    def get_setting(borrow self, key: String) -> Option[String]:
        return self.settings.get(key)

def main() -> int32:
    data = {"theme": "dark", "lang": "en"}
    config = Config.new(data)
    match config.get_setting("theme"):
        case Some(v):
            print(v)
        case None:
            print("None")
    match config.get_setting("lang"):
        case Some(v):
            print(v)
        case None:
            print("None")
    return 0
