# Verify that set() returns Option[V] containing the previous value
def main() -> int32:
    mut m = Map[String, int32]()

    # First insert: no previous value
    r1 = m.set("a", 10)
    match r1:
        case Some(v):
            print(f"previous: {v}")
        case None:
            print("no previous")

    # Overwrite: returns previous value
    r2 = m.set("a", 20)
    match r2:
        case Some(v):
            print(f"previous: {v}")
        case None:
            print("no previous")

    # Current value should be latest
    print(m["a"])
    return 0
