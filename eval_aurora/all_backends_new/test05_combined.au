def print_int_option(value: Option[int32]):
    match value:
        case Some(inner):
            print(inner)
        case None:
            print("None")

def main() -> int32:
    mut words: Vec[String] = ["  hello  ", "  world  ", "  aurora  "]
    mut lengths = Map[String, int32]()

    for word in borrow words:
        trimmed = word.trim()
        lengths.set(key=trimmed.clone(), value=trimmed.len())

    print(lengths.len())
    print_int_option(lengths.get("hello"))
    print_int_option(lengths.get("world"))
    print_int_option(lengths.get("aurora"))

    a = 5
    b = 12
    print(min(a, b))
    print(max(a, b))
    print(abs(-99))

    dist = sqrt(9.0)
    print(dist)
    return 0
