def print_int_option(value: Option[int32]):
    match value:
        case Some(inner):
            print(inner)
        case None:
            print("None")

def main() -> int32:
    mut m = Map[String, int32]()
    m.set(key="a", value=1)
    m.set(key="b", value=2)
    m.set(key="c", value=3)
    print(m.len())
    print(m.contains_key("b"))
    print(m.contains_key("z"))
    print_int_option(m.get("a"))
    print_int_option(m.get("z"))
    print_int_option(m.remove("b"))
    print(m.len())
    print(m.contains_key("b"))
    print(m.keys().len())
    print(m.values().len())
    print(m.is_empty())
    return 0
