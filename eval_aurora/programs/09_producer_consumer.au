## Producer-consumer pipeline: three-stage pipeline.
## Stage 1 (generate): produces integers
## Stage 2 (transform): squares each number
## Stage 3 (collect): sums all results

def generate(out: Channel[int32], count: int32):
    mut i: int32 = 1
    while i <= count:
        out.send(i)
        i += 1
    out.close()

def transform(input: Channel[int32], out: Channel[int32]):
    ## Read from input, square each value, send to output
    for value in input:
        squared = value * value
        out.send(squared)
    out.close()

def collect(input: Channel[int32], result: Channel[int32]):
    ## Sum all values from input
    mut total: int32 = 0
    for value in input:
        total += value
    result.send(total)
    result.close()

def main() -> int32:
    ## Set up the three-stage pipeline
    stage1_out: Channel[int32] = channel()
    stage2_out: Channel[int32] = channel()
    result_chan: Channel[int32] = channel()

    ## Spawn all three stages
    t1 = spawn generate(stage1_out.clone(), 10)
    t2 = spawn transform(stage1_out, stage2_out.clone())
    t3 = spawn collect(stage2_out, result_chan.clone())

    ## Read the final result
    match result_chan.recv():
        case Option.Some(total):
            print(f"Sum of squares from 1 to 10: {total}")
            ## Expected: 1 + 4 + 9 + 16 + 25 + 36 + 49 + 64 + 81 + 100 = 385
            print(f"Expected: 385")
        case Option.None:
            print("Error: no result received")

    t1.join()
    t2.join()
    t3.join()

    ## Second pipeline test: smaller numbers
    stage1b: Channel[int32] = channel()
    stage2b: Channel[int32] = channel()
    resultb: Channel[int32] = channel()

    t4 = spawn generate(stage1b.clone(), 5)
    t5 = spawn transform(stage1b, stage2b.clone())
    t6 = spawn collect(stage2b, resultb.clone())

    match resultb.recv():
        case Option.Some(total):
            print(f"Sum of squares from 1 to 5: {total}")
            ## Expected: 1 + 4 + 9 + 16 + 25 = 55
            print(f"Expected: 55")
        case Option.None:
            print("Error: no result received")

    t4.join()
    t5.join()
    t6.join()

    return 0
