## State machine: Traffic light controller.
## Models a traffic light cycling through states,
## and a door lock with PIN-based unlock.

enum TrafficLight:
    Red
    Yellow
    Green

enum DoorState:
    Locked
    Unlocked

def traffic_light_name(state: TrafficLight) -> String:
    match state:
        case TrafficLight.Red:
            return "RED"
        case TrafficLight.Yellow:
            return "YELLOW"
        case TrafficLight.Green:
            return "GREEN"

def next_light(state: TrafficLight) -> TrafficLight:
    match state:
        case TrafficLight.Red:
            return TrafficLight.Green
        case TrafficLight.Green:
            return TrafficLight.Yellow
        case TrafficLight.Yellow:
            return TrafficLight.Red

def door_state_name(state: DoorState) -> String:
    match state:
        case DoorState.Locked:
            return "LOCKED"
        case DoorState.Unlocked:
            return "UNLOCKED"

def try_unlock(state: DoorState, pin: int32, correct_pin: int32) -> DoorState:
    match state:
        case DoorState.Locked:
            if pin == correct_pin:
                print("Correct PIN! Door unlocked.")
                return DoorState.Unlocked
            else:
                print("Wrong PIN! Door remains locked.")
                return DoorState.Locked
        case DoorState.Unlocked:
            print("Door is already unlocked.")
            return DoorState.Unlocked

def lock_door(state: DoorState) -> DoorState:
    match state:
        case DoorState.Unlocked:
            print("Door locked.")
            return DoorState.Locked
        case DoorState.Locked:
            print("Door is already locked.")
            return DoorState.Locked

def main() -> int32:
    ## Traffic light cycle simulation
    print("=== Traffic Light State Machine ===")
    mut light = TrafficLight.Red
    for i in range(7):
        print(f"Step {i}: Light is {traffic_light_name(light)}")
        light = next_light(light)

    ## Door lock state machine
    print("")
    print("=== Door Lock State Machine ===")
    correct_pin: int32 = 1234
    mut door = DoorState.Locked
    print(f"Initial state: {door_state_name(door)}")

    print("Attempt unlock with PIN 0000:")
    door = try_unlock(door, 0000, correct_pin)
    print(f"State: {door_state_name(door)}")

    print("Attempt unlock with PIN 9999:")
    door = try_unlock(door, 9999, correct_pin)
    print(f"State: {door_state_name(door)}")

    print("Attempt unlock with PIN 1234:")
    door = try_unlock(door, 1234, correct_pin)
    print(f"State: {door_state_name(door)}")

    print("Attempt unlock again:")
    door = try_unlock(door, 1234, correct_pin)
    print(f"State: {door_state_name(door)}")

    print("Lock the door:")
    door = lock_door(door)
    print(f"State: {door_state_name(door)}")

    print("Lock again:")
    door = lock_door(door)
    print(f"State: {door_state_name(door)}")

    return 0
