## Sieve of Eratosthenes / Prime finder up to 100
## Since Aurora has no arrays, we use trial division to test each number.

def is_prime(n: int32) -> bool:
    if n < 2:
        return false
    if n == 2:
        return true
    if n % 2 == 0:
        return false
    mut divisor: int32 = 3
    while divisor * divisor <= n:
        if n % divisor == 0:
            return false
        divisor += 2
    return true

def main() -> int32:
    mut count: int32 = 0
    print("Primes up to 100:")
    for n in range(101):
        if is_prime(n):
            print(n)
            count += 1
    print(f"Total primes found: {count}")
    return 0
