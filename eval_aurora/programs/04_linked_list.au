## Singly linked list with insert_front, print, and length operations.
## Uses indirect for recursive node references.

class Node:
    value: int32
    next: indirect Node?

class LinkedList:
    head: indirect Node?
    size: int32

    def new() -> LinkedList:
        return LinkedList(head=Option.None, size=0)

    def insert_front(borrow mut self, value: int32):
        old_head = self.head
        self.head = Option.Some(Node(value=value, next=old_head))
        self.size += 1

    def length(borrow self) -> int32:
        return self.size

def print_node(node: borrow Node):
    print(node.value)
    match borrow node.next:
        case Some(next):
            print_node(node=next)
        case None:
            pass

def print_list(list: borrow LinkedList):
    match borrow list.head:
        case Some(head):
            print_node(node=head)
        case None:
            print("(empty list)")

def count_nodes(node: borrow Node) -> int32:
    match borrow node.next:
        case Some(next):
            return 1 + count_nodes(node=next)
        case None:
            return 1

def recursive_length(list: borrow LinkedList) -> int32:
    match borrow list.head:
        case Some(head):
            return count_nodes(node=head)
        case None:
            return 0

def main() -> int32:
    mut list = LinkedList.new()

    print(f"Empty list length: {list.length()}")
    print("Contents of empty list:")
    print_list(list)

    ## Insert elements (they go to front, so order will be reversed)
    list.insert_front(10)
    list.insert_front(20)
    list.insert_front(30)
    list.insert_front(40)
    list.insert_front(50)

    print(f"List length: {list.length()}")
    print(f"Recursive length: {recursive_length(list)}")
    print("List contents (front to back):")
    print_list(list)

    ## Insert more
    list.insert_front(60)
    print(f"After inserting 60, length: {list.length()}")
    print("Updated list:")
    print_list(list)

    return 0
