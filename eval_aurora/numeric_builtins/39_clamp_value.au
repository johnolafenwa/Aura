def main() -> int32:
    lower: int32 = 0
    upper: int32 = 100

    # Value below range
    v1: int32 = -10
    print(min(max(v1, lower), upper))

    # Value in range
    v2: int32 = 50
    print(min(max(v2, lower), upper))

    # Value above range
    v3: int32 = 150
    print(min(max(v3, lower), upper))

    return 0
