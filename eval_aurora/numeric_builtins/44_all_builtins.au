def main() -> int32:
    # Compute distance between two points
    x1: float64 = -1.0
    y1: float64 = 2.0
    x2: float64 = 4.0
    y2: float64 = -3.0

    dx: float64 = abs(x2 - x1) as float64
    dy: float64 = abs(y2 - y1) as float64
    dist: float64 = sqrt(dx * dx + dy * dy)
    print(dist)

    # Find min and max of some values
    a: int32 = 42
    b: int32 = -17
    c: int32 = 88
    smallest: int32 = min(min(a, b), c)
    largest: int32 = max(max(a, b), c)
    print(smallest)
    print(largest)

    # Clamp a value
    value: int32 = -50
    clamped: int32 = min(max(value, 0), 100)
    print(clamped)

    # abs of the difference
    diff: int32 = abs(a - c)
    print(diff)

    return 0
