# Test 6b: F-string edge cases

# f-string with boolean
b = true
print(f"Bool: {b}")

# f-string with float
pi = 3.14159
print(f"Pi: {pi}")

# f-string with nested braces (if supported)
x = 10
print(f"Value: {x}")

# f-string with complex expression
print(f"Result: {2 * 3 + 4}")

# f-string with comparison
print(f"Is positive: {10 > 0}")

# Multiple expressions
a = 1
b2 = 2
c = 3
print(f"{a}, {b2}, {c}")

# Empty f-string interpolation
name = ""
print(f"Name: [{name}]")

# f-string with function call
def square(n: int32) -> int32:
    return n * n

print(f"5 squared = {square(5)}")
