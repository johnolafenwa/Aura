# Test 11b: Unary operator edge cases

# Unary on expression result
x = -(3 + 4)
print(x)

# Negation of zero
y = -0
print(y)

# Negation of min int (potential overflow)
# z: int8 = -128
# w = -z  # Would be 128, which doesn't fit in int8
# print(w)

# Float negation
a = -0.0
print(a)

# Chained negation
b = -(-(-5))
print(b)
