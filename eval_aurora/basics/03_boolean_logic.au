# Test 3: Boolean logic - complex expressions with and/or/not

# Basic boolean values
a: bool = true
b: bool = false
print(a)
print(b)

# and operator
print(true and true)
print(true and false)
print(false and true)
print(false and false)

# or operator
print(true or true)
print(true or false)
print(false or true)
print(false or false)

# not operator
print(not true)
print(not false)

# Complex expressions
print(true and true or false)
print(false or true and true)
print(not false and true)
print(not true or false)
print(not (true and false))
print((true or false) and (false or true))

# Nested not
print(not not true)
print(not not false)
