# Test 12: Comparison operators

# Integer comparisons
print(10 == 10)
print(10 == 20)
print(10 != 20)
print(10 != 10)

print(5 < 10)
print(10 < 5)
print(10 < 10)

print(5 <= 10)
print(10 <= 10)
print(11 <= 10)

print(10 > 5)
print(5 > 10)
print(10 > 10)

print(10 >= 5)
print(10 >= 10)
print(9 >= 10)

# Float comparisons
print(3.14 < 3.15)
print(3.14 == 3.14)
print(3.14 > 3.13)

# Boolean comparisons
print(true == true)
print(true == false)
print(false == false)

# String comparisons
print("hello" == "hello")
print("hello" == "world")
print("hello" != "world")

# Negative numbers
print(-5 < 0)
print(-5 > -10)
print(-5 == -5)
