# Test 3b: Short-circuit evaluation
# If short-circuit works, the second function should NOT be called in some cases

mut counter = 0

def side_effect_true() -> bool:
    # We can't easily mutate a global, so let's use print to detect calls
    print("side_effect_true called")
    return true

def side_effect_false() -> bool:
    print("side_effect_false called")
    return false

# false and X - should short-circuit, X should not be evaluated
print("Test: false and side_effect_true()")
result1 = false and side_effect_true()
print(result1)

# true or X - should short-circuit, X should not be evaluated
print("Test: true or side_effect_false()")
result2 = true or side_effect_false()
print(result2)

# true and X - should NOT short-circuit
print("Test: true and side_effect_true()")
result3 = true and side_effect_true()
print(result3)

# false or X - should NOT short-circuit
print("Test: false or side_effect_false()")
result4 = false or side_effect_false()
print(result4)
