# Test 1: Type limits - int8 overflow, large int64, float precision, uint operations

# int8 range: -128 to 127
x: int8 = 127
print(x)

y: int8 = -128
print(y)

# int64 large values
big: int64 = 9223372036854775807
print(big)

big_neg: int64 = -9223372036854775808
print(big_neg)

# float precision
f1: float64 = 0.1 + 0.2
print(f1)

f2: float64 = 1.0 / 3.0
print(f2)

# Very small float
tiny: float64 = 0.000000001
print(tiny)

# uint8 operations
u1: uint8 = 255
print(u1)

u2: uint8 = 0
print(u2)

# uint64 large value
u64: uint64 = 18446744073709551615
print(u64)

# float32 precision
f32: float32 = 3.14159
print(f32)
