# Test 4a: Basic type casting that should work

# int to float
x: int32 = 42
f: float64 = x as float64
print(f)

# float to int (truncation)
pi: float64 = 3.99
i: int32 = pi as int32
print(i)

# Negative float to int
neg: float64 = -2.7
ni: int32 = neg as int32
print(ni)

# Widening cast: int8 to int64
small: int8 = 100
big: int64 = small as int64
print(big)

# uint to int
u: uint32 = 42
si: int32 = u as int32
print(si)

# int to uint
pos: int32 = 50
up: uint32 = pos as uint32
print(up)

# float32 to float64
f32: float32 = 3.14
f64: float64 = f32 as float64
print(f64)

# float64 to float32
big_f: float64 = 1.23456789012345
small_f: float32 = big_f as float32
print(small_f)
