# Test 9: Nested function calls

def add(a: int32, b: int32) -> int32:
    return a + b

def multiply(a: int32, b: int32) -> int32:
    return a * b

def negate(x: int32) -> int32:
    return -x

# Simple nesting
result1 = add(multiply(2, 3), 4)
print(result1)

# Triple nesting
result2 = add(multiply(2, 3), negate(multiply(4, 5)))
print(result2)

# Deeply nested
result3 = negate(negate(negate(add(1, 2))))
print(result3)

# Nested with same function
result4 = add(add(add(1, 2), 3), 4)
print(result4)

# Using result as both arguments
result5 = multiply(add(1, 2), add(3, 4))
print(result5)
