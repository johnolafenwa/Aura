# Test 10: Multiple return types

def get_int() -> int32:
    return 42

def get_string() -> str:
    return "hello"

def get_bool() -> bool:
    return true

def get_float() -> float64:
    return 3.14

def get_none() -> None:
    print("side effect")

print(get_int())
print(get_string())
print(get_bool())
print(get_float())
get_none()
