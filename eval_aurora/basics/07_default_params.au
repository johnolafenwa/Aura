# Test 7: Default parameters

def greet(name: str, greeting: str = "Hello") -> str:
    return f"{greeting}, {name}!"

# Call with both args
print(greet("Alice", "Hi"))

# Call with default
print(greet("Bob"))

# Multiple defaults
def make_point(x: int32 = 0, y: int32 = 0, z: int32 = 0) -> str:
    return f"({x}, {y}, {z})"

print(make_point(1, 2, 3))
print(make_point(1, 2))
print(make_point(1))
print(make_point())

# Default with different types
def config(name: str = "default", value: int32 = 42, enabled: bool = true) -> str:
    return f"name={name}, value={value}, enabled={enabled}"

print(config())
print(config("custom"))
print(config("custom", 100))
print(config("custom", 100, false))
