# Test 17b: Vec consumed when passed by value -- using after should fail
def sum_values(values: Vec[int32]) -> int32:
    mut total: int32 = 0
    for v in values:
        total += v
    return total

def main() -> int32:
    xs = [1, 2, 3]
    print(sum_values(xs))
    # xs should be consumed after pass by value
    print(xs.len())
    return 0
