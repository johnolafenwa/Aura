# Test 19: Multiple borrow iterations over the same vec

def main() -> int32:
    xs: Vec[String] = ["one", "two", "three"]

    # First borrow iteration
    for x in borrow xs:
        print(x)

    # Second borrow iteration
    for x in borrow xs:
        print(x)

    # Vec still accessible
    print(xs.len())
    return 0
