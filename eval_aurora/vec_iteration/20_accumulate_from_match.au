# Test 20: Accumulate into Vec from match on enum

enum Shape:
    Circle(int32)
    Square(int32)
    Unknown

def main() -> int32:
    shapes: Vec[int32] = []
    mut areas: Vec[int32] = []

    circle = Shape.Circle(5)
    square = Shape.Square(4)
    unknown = Shape.Unknown

    # Match each and push area into vec
    match circle:
        case Shape.Circle(r):
            areas.push(r * r * 3)
        case Shape.Square(s):
            areas.push(s * s)
        case Shape.Unknown:
            areas.push(0)

    match square:
        case Shape.Circle(r):
            areas.push(r * r * 3)
        case Shape.Square(s):
            areas.push(s * s)
        case Shape.Unknown:
            areas.push(0)

    match unknown:
        case Shape.Circle(r):
            areas.push(r * r * 3)
        case Shape.Square(s):
            areas.push(s * s)
        case Shape.Unknown:
            areas.push(0)

    print(areas.len())
    for area in areas:
        print(area)
    return 0
