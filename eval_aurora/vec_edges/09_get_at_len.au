# Test 9: Get at exactly len (off-by-one) - should return None
def main() -> int32:
    v = [10, 20, 30]
    # len is 3, so index 3 is out of bounds by one
    result = v.get(3)
    match result:
        case Some(val):
            print(val)
        case None:
            print("get at len returned None")

    # Also try the last valid index
    match v.get(2):
        case Some(val):
            print(val)
        case None:
            print("unexpected None")

    return 0
