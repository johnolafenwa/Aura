# Test 21: Vec passed to function by value (move semantics)
# Caller should NOT be able to use the vec after passing it
def consume(v: Vec[int32]):
    print(v.len())
    for x in v:
        print(x)

def main() -> int32:
    v = [1, 2, 3]
    consume(v)
    # This should fail - v was moved
    print(v.len())
    return 0
