# Test 17: Single element operations
def main() -> int32:
    mut v: Vec[int32] = []

    # Push one
    v.push(42)
    print(v.len())
    print(v[0])

    # Pop one
    match v.pop():
        case Some(val):
            print(val)
        case None:
            print(-1)
    print(v.len())
    print(v.is_empty())

    # Push again
    v.push(99)
    print(v.len())

    # Get
    match v.get(0):
        case Some(val):
            print(val)
        case None:
            print(-1)

    # Remove
    match v.remove(0):
        case Some(val):
            print(val)
        case None:
            print(-1)
    print(v.len())
    print(v.is_empty())

    return 0
