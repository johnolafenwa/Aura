# Test 18: Clone independence - modify original, clone unchanged
def main() -> int32:
    mut original = [1, 2, 3]
    mut cloned = original.clone()

    # Modify original
    original.push(4)
    original[0] = 100

    # Verify clone unchanged
    print(cloned.len())
    print(cloned[0])
    print(cloned[1])
    print(cloned[2])

    # Verify original was modified
    print(original.len())
    print(original[0])

    # Modify clone, verify original not affected
    cloned.push(999)
    print(original.len())
    print(cloned.len())

    return 0
