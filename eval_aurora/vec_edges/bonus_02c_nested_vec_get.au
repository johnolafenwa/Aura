# Bonus 2c: Nested vec access via .get (returns Option so no move?)
def main() -> int32:
    mut outer: Vec[Vec[int32]] = []
    outer.push([1, 2, 3])
    outer.push([4, 5, 6])
    # Use get instead of index
    match outer.get(0):
        case Some(inner):
            print(inner[1])
        case None:
            print(-1)
    print(outer.len())
    return 0
