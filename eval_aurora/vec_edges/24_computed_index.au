# Test 24: Index with expressions - computed indices
def main() -> int32:
    v = [100, 200, 300, 400, 500]

    # Index with variable
    mut i = 2
    print(v[i])

    # Index with expression i + 1
    print(v[i + 1])

    # Index with len - 1
    last = v.len() - 1
    print(v[last])

    # Index with literal arithmetic
    print(v[1 + 1])

    return 0
