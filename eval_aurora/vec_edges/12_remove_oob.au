# Test 12: Remove at out-of-bounds index
def main() -> int32:
    mut v = [10, 20, 30]
    result = v.remove(100)
    match result:
        case Some(val):
            print(val)
        case None:
            print("remove OOB returned None")

    # Verify vec unchanged
    print(v.len())
    return 0
