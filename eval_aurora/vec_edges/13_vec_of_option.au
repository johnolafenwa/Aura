# Test 13: Vec of Option[int32] - nested generic
def main() -> int32:
    mut v: Vec[Option[int32]] = []
    v.push(Option.Some(10))
    v.push(Option.None)
    v.push(Option.Some(30))

    for item in v:
        match item:
            case Option.Some(val):
                print(val)
            case Option.None:
                print(-1)

    return 0
