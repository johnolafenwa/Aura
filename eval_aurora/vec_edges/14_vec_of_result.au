# Test 14: Vec of Result[int32, String]
def main() -> int32:
    mut v: Vec[Result[int32, String]] = []
    v.push(Result.Ok(42))
    v.push(Result.Err("something failed"))
    v.push(Result.Ok(100))

    for item in v:
        match item:
            case Result.Ok(val):
                print(val)
            case Result.Err(msg):
                print(msg)

    return 0
