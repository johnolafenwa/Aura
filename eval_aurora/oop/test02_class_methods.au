class Counter:
    value: int32

    def read(borrow self) -> int32:
        return self.value

    def doubled(borrow self) -> int32:
        return self.value + self.value

    def increment(borrow mut self):
        self.value += 1

    def reset(borrow mut self):
        self.value = 0

    def zero() -> Counter:
        return Counter(value=0)

def main() -> int32:
    mut c = Counter(value=5)
    print(c.read())
    print(c.doubled())
    c.increment()
    print(c.read())
    c.reset()
    print(c.read())
    c2 = Counter.zero()
    print(c2.read())
    return 0
