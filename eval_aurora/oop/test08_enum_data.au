enum Shape:
    Circle(float64)
    Square(float64)
    Empty

def area(s: Shape) -> float64:
    match s:
        case Shape.Circle(radius):
            return 3.14159 * radius * radius
        case Shape.Square(side):
            return side * side
        case Shape.Empty:
            return 0.0

def main() -> int32:
    c = Shape.Circle(5.0)
    sq = Shape.Square(3.0)
    e = Shape.Empty
    print(area(c))
    print(area(sq))
    print(area(e))
    return 0
