enum Status:
    Active
    Inactive
    Suspended
    Deleted

def is_usable(s: Status) -> bool:
    match s:
        case Status.Active:
            return true
        case _:
            return false

def main() -> int32:
    print(is_usable(Status.Active))
    print(is_usable(Status.Inactive))
    print(is_usable(Status.Suspended))
    print(is_usable(Status.Deleted))
    return 0
