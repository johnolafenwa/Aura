class Node:
    value: int32
    next: indirect Node?

def print_list(node: Node):
    print(node.value)
    match node.next:
        case Option.Some(n):
            print_list(n)
        case Option.None:
            pass

def main() -> int32:
    leaf = Node(value=3, next=Option.None)
    mid = Node(value=2, next=Option.Some(leaf))
    head = Node(value=1, next=Option.Some(mid))
    print_list(head)
    return 0
