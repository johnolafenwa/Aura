class Address:
    city: String
    zip: int32

class Employee:
    name: String
    address: Address

def main() -> int32:
    addr = Address(city="Seattle", zip=98101)
    emp = Employee(name="Alice", address=addr)
    print(emp.name)
    print(emp.address.city)
    print(emp.address.zip)
    return 0
