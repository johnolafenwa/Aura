def find_positive(x: int32) -> Option[int32]:
    if x > 0:
        return Option.Some(x)
    return Option.None

def main() -> int32:
    val1: Option[int32] = find_positive(42)
    val2: Option[int32] = find_positive(-5)

    match val1:
        case Option.Some(v):
            print(v)
        case Option.None:
            print(0)

    match val2:
        case Option.Some(v):
            print(v)
        case Option.None:
            print(0)

    return 0
