trait Named:
    def name(borrow self) -> String

trait Aged:
    def age(borrow self) -> int32

class Person:
    first_name: String
    years: int32

impl Named for Person:
    def name(borrow self) -> String:
        return self.first_name

impl Aged for Person:
    def age(borrow self) -> int32:
        return self.years

def print_name[T: Named](entity: T):
    print(entity.name())

def print_age[T: Aged](entity: T):
    print(entity.age())

def main() -> int32:
    p = Person(first_name="Alice", years=30)
    print_name(entity=p)
    p2 = Person(first_name="Bob", years=25)
    print_age(entity=p2)
    return 0
