class Box[T]:
    value: T

    def get(borrow self) -> T:
        return self.value

class Pair[A, B]:
    first: A
    second: B

def main() -> int32:
    int_box: Box[int32] = Box(value=42)
    str_box: Box[String] = Box(value="hello")
    pair: Pair[int32, String] = Pair(first=1, second="one")

    print(int_box.get())
    print(str_box.get())
    print(pair.first)
    print(pair.second)
    return 0
