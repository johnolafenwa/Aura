trait Describable:
    def describe(borrow self) -> String

class Dog:
    name: String
    breed: String

class Cat:
    name: String

impl Describable for Dog:
    def describe(borrow self) -> String:
        return self.name + " the " + self.breed

impl Describable for Cat:
    def describe(borrow self) -> String:
        return self.name + " the cat"

def introduce[T: Describable](animal: T):
    print(animal.describe())

def main() -> int32:
    dog = Dog(name="Rex", breed="husky")
    cat = Cat(name="Whiskers")
    introduce(animal=dog)
    introduce(animal=cat)
    return 0
