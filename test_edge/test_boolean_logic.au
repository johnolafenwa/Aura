## Test: Complex boolean expressions
def main() -> int32:
    a: bool = true
    b: bool = false
    c: bool = true

    print(a and b)
    print(a or b)
    print(not a)
    print(a and c)
    print(not b and c)
    print(a or b and c)

    ## Comparison chains
    x: int32 = 5
    print(x > 3 and x < 10)
    print(x == 5 or x == 6)

    return 0
