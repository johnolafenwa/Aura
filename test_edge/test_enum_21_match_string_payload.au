enum Message:
    Hello(str)
    Goodbye(str)
    Empty

def greet(m: own Message) -> str:
    match own m:
        case Message.Hello(name):
            return name
        case Message.Goodbye(name):
            return name
        case Message.Empty:
            return "nobody"

def main() -> int32:
    m1 = Message.Hello("Alice")
    m2 = Message.Goodbye("Bob")
    m3 = Message.Empty
    print(greet(m1))
    print(greet(m2))
    print(greet(m3))
    return 0
