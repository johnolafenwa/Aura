def main() -> int32:
    # Sum only odd numbers from 1..10
    mut i: int32 = 0
    mut sum_odd: int32 = 0

    while i < 10:
        i += 1
        if i % 2 == 0:
            continue
        sum_odd += i

    # odd numbers: 1+3+5+7+9 = 25
    print(sum_odd)

    # Test continue with multiple conditions
    mut j: int32 = 0
    mut collected: int32 = 0
    while j < 20:
        j += 1
        if j % 3 == 0:
            continue
        if j % 5 == 0:
            continue
        collected += 1

    # Numbers 1-20 not divisible by 3 or 5:
    # Remove: 3,5,6,9,10,12,15,18,20 => 20 - 9 = 11 ... wait
    # 3,6,9,12,15,18 (div by 3) = 6 items
    # 5,10,20 (div by 5, not already counted) = 3 items (15 already counted)
    # total removed = 9, so 20 - 9 = 11
    print(collected)

    return 0
