## Test 11: Trait implemented for specialized generic class
## Expects: "boxed: hello"

trait Showable:
    def show(self) -> String

class Box[T]:
    value: T

impl Showable for Box[String]:
    def show(self) -> String:
        return "boxed: " + self.value

def main() -> int32:
    b: Box[String] = Box(value="hello")
    print(b.show())
    return 0
