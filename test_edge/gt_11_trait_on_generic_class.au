## Test 11: Trait implemented for specialized generic class
## Expects: "boxed: hello"

trait Showable:
    def show(self) -> str

class Box[T]:
    value: T

impl Showable for Box[str]:
    def show(self) -> str:
        return "boxed: " + self.value

def main() -> int32:
    b: Box[str] = Box(value="hello")
    print(b.show())
    return 0
