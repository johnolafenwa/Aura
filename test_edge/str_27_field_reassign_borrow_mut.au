# Test: reassigning str field in borrow mut method

class Config:
    host: str
    port: int32

    def set_host(mut self, new_host: str):
        self.host = new_host + ""

    def describe(self) -> str:
        return f"{self.host}:{self.port}"

def main() -> int32:
    mut cfg = Config(host="localhost", port=8080)
    print(cfg.describe())

    cfg.set_host("example.com")
    print(cfg.describe())

    # Multiple reassignments
    cfg.set_host("api.test.com")
    print(cfg.describe())

    return 0
