# Test: reassigning String field in borrow mut method

class Config:
    host: String
    port: int32

    def set_host(borrow mut self, new_host: borrow str):
        self.host = new_host + ""

    def describe(borrow self) -> String:
        return f"{self.host}:{self.port}"

def main() -> int32:
    mut cfg = Config(host="localhost", port=8080)
    print(cfg.describe())

    cfg.set_host("example.com")
    print(cfg.describe())

    # Multiple reassignments
    cfg.set_host("api.test.com")
    print(cfg.describe())

    return 0
