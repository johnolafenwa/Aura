def step1(x: int32) -> Result[int32, str]:
    if x < 0:
        return Result.Err("negative")
    return Result.Ok(x + 1)

def step2(x: int32) -> Result[int32, str]:
    if x > 100:
        return Result.Err("too large")
    return Result.Ok(x * 2)

def step3(x: int32) -> Result[int32, str]:
    if x == 0:
        return Result.Err("zero")
    return Result.Ok(x + 10)

def pipeline(x: int32) -> Result[int32, str]:
    a = try step1(x)
    b = try step2(a)
    c = try step3(b)
    return Result.Ok(c)

def main() -> int32:
    match pipeline(5):
        case Result.Ok(v):
            print(v)
        case Result.Err(e):
            print(e)

    match pipeline(-1):
        case Result.Ok(v):
            print(v)
        case Result.Err(e):
            print(e)

    match pipeline(99):
        case Result.Ok(v):
            print(v)
        case Result.Err(e):
            print(e)

    return 0
