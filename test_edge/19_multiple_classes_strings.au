class Address:
    street: str
    city: str

    def full(self) -> str:
        return self.street + ", " + self.city

class Contact:
    name: str
    address: Address

    def summary(self) -> str:
        return self.name + " at " + self.address.full()

def main() -> int32:
    addr = Address(street="123 Main St", city="Springfield")
    person = Contact(name="Alice", address=addr)

    print(person.summary())
    print(person.name)
    print(person.address.full())

    return 0
