## Test 10: Function with 12 parameters
def add_all(a: int32, b: int32, c: int32, d: int32, e: int32, f: int32, g: int32, h: int32, i: int32, j: int32, k: int32, l: int32) -> int32:
    return a + b + c + d + e + f + g + h + i + j + k + l

def main() -> int32:
    result = add_all(a=1, b=2, c=3, d=4, e=5, f=6, g=7, h=8, i=9, j=10, k=11, l=12)
    print(result)
    return 0
