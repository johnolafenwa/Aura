class Box:
    value: int32

    def get(self) -> int32:
        return self.value

    def doubled(self) -> int32:
        return self.get() * 2

def main() -> int32:
    b = Box(value=5)

    result = b.get() + b.doubled()
    print(result)

    if b.get() > 3:
        print("big")
    else:
        print("small")

    mut i = 0
    while i < b.get():
        i += 1
    print(i)

    print(Box(value=10).get() + Box(value=20).get())

    return 0
