## Test 18: Trait implementation for builtin type
## Expects: "num" then "num"

trait Describable:
    def describe(self) -> str

impl Describable for int32:
    def describe(self) -> str:
        return "num"

def show[T: Describable](val: T):
    print(val.describe())

def main() -> int32:
    x: int32 = 7
    show(val=x)
    show(val=100)
    return 0
