# Test: calling a method from trait impl inside a generic function
# (related to the swap inference bug)

trait Sized:
    def size(self) -> int32

class Container[T]:
    item: T
    count: int32

impl Sized for Container[int32]:
    def size(self) -> int32:
        return self.count

# Call trait method on generic param
def get_size[T: Sized](item: T) -> int32:
    return item.size()

def main() -> int32:
    c = Container(item=5, count=10)
    print(get_size(item=c))
    return 0
