# Investigate: does borrow self allow field access that free functions don't?

class Holder:
    text: str

    def get_text(self) -> str:
        return self.text

    def clone_text(self) -> str:
        return self.text.clone()

    def print_text(self):
        print(self.text)

def main() -> int32:
    h = Holder(text="hello")
    t = h.get_text()
    print(t)
    return 0
