def main() -> int32:
    # Basic while loop
    mut i: int32 = 0
    mut sum: int32 = 0
    while i < 10:
        sum += i
        i += 1
    print(sum)    # 45

    # While with break
    mut j: int32 = 0
    while true:
        if j == 5:
            break
        j += 1
    print(j)      # 5

    # While with continue (skip even numbers)
    mut k: int32 = 0
    mut odd_sum: int32 = 0
    while k < 10:
        k += 1
        if k % 2 == 0:
            continue
        odd_sum += k
    print(odd_sum)  # 1+3+5+7+9 = 25

    # While with both break and continue
    mut m: int32 = 0
    mut acc: int32 = 0
    while m < 100:
        m += 1
        if m % 3 == 0:
            continue
        if m > 10:
            break
        acc += m
    print(acc)  # 1+2+4+5+7+8+10 = 37

    # while false (never executes)
    mut never: int32 = 0
    while false:
        never = 999
    print(never)   # 0

    # single-iteration while
    mut once: int32 = 0
    while once < 1:
        once += 1
    print(once)    # 1

    return 0
