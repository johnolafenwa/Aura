# Test: try on a function that doesn't return Result (should error)
def normal_func(x: int32) -> int32:
    return x + 1

def wrapper() -> Result[int32, str]:
    v = try normal_func(5)
    return Result.Ok(v)

def main() -> int32:
    match wrapper():
        case Result.Ok(v):
            print(v)
        case Result.Err(e):
            print(e)
    return 0
