def sum_to_n(n: int64) -> int64:
    mut total: int64 = 0
    mut idx: int64 = 0
    while idx <= n:
        total += idx
        idx += 1
    return total

def main() -> int32:
    # Sum 1 to 100
    print(sum_to_n(100))     # 5050

    # Sum 1 to 1000
    print(sum_to_n(1000))    # 500500

    # Sum 1 to 10000
    print(sum_to_n(10000))   # 50005000

    # Power of 2 computation
    mut power: int64 = 1
    for p in range(20):
        power *= 2
    print(power)             # 2^20 = 1048576

    # GCD
    print(gcd(48, 18))       # 6
    print(gcd(100, 75))      # 25
    print(gcd(17, 13))       # 1

    return 0

def gcd(a: int32, b: int32) -> int32:
    mut x: int32 = a
    mut y: int32 = b
    while y != 0:
        mut temp: int32 = y
        y = x % y
        x = temp
    return x
