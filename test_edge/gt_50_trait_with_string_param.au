## Test 50: Trait method that takes a str parameter
## Expects: "greeting: hi aura"

trait Formatter:
    def format(self, prefix: str) -> str

class Name:
    text: str

impl Formatter for Name:
    def format(self, prefix: str) -> str:
        return prefix + " " + self.text

def render[T: Formatter](item: T, prefix: str):
    print(item.format(prefix))

def main() -> int32:
    n = Name(text="aura")
    render(item=n, prefix="greeting: hi")
    return 0
