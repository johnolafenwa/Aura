# Test: chaining trait method calls

trait Describable:
    def describe(self) -> str

class Item:
    name: str

impl Describable for Item:
    def describe(self) -> str:
        return self.name

class Container:
    item: Item

    def get_item(self) -> Item:
        return self.item

def main() -> int32:
    c = Container(item=Item(name="test"))
    # Chain: c.get_item().describe()
    print(c.get_item().describe())
    return 0
