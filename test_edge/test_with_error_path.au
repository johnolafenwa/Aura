## Test: With statement where the function returns an error
class Connection:
    name: str

    def query(self) -> str:
        return self.name

    def close(mut self):
        print("closed " + self.name)

def failing_op() -> Result[str, str]:
    with conn = Connection(name="db"):
        print("opened")
        return Result.Err("something went wrong")

def main() -> int32:
    match failing_op():
        case Result.Ok(v):
            print(v)
        case Result.Err(e):
            print(e)
    return 0
