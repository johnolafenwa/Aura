def parse_num(n: int32) -> Result[int32, int32]:
    if n < 0:
        return Result.Err(n)
    return Result.Ok(n)

def process() -> Result[int32, int32]:
    v = try parse_num(-1)
    return Result.Ok(v * 2)

def main() -> int32:
    res = process()
    match own res:
        case Result.Ok(v):
            print(v)
        case Result.Err(e):
            print(e)
    return 0
