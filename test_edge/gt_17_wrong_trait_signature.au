## Test 17: Wrong trait method signature - should produce compile error
## Expects: Compile error about mismatched signature

trait Printable:
    def to_string(self) -> String

class Widget:
    id: int32

impl Printable for Widget:
    def to_string(self) -> int32:
        return self.id

def main() -> int32:
    w = Widget(id=5)
    print(w.to_string())
    return 0
