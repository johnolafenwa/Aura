class Account:
    public name: String
    balance: int32

    def get_balance(borrow self) -> int32:
        return self.balance

    def deposit(borrow mut self, amount: int32):
        self.balance += amount

def main() -> int32:
    mut acct = Account(name="Alice", balance=100)
    print(acct.name)
    print(acct.get_balance())

    acct.deposit(amount=50)
    print(acct.get_balance())

    print(acct.balance)

    return 0
