def divide(a: int32, b: int32) -> Result[int32, String]:
    if b == 0:
        return Result.Err("division by zero")
    return Result.Ok(a // b)

def compute(a: int32, b: int32, c: int32) -> Result[int32, String]:
    step1 = try divide(a, b)
    step2 = try divide(step1, c)
    return Result.Ok(step2)

def chain_three(x: int32, y: int32, z: int32) -> Result[int32, String]:
    r1 = try divide(x, y)
    r2 = try divide(r1, z)
    r3 = try divide(r2, 1)
    return Result.Ok(r3)

def main() -> int32:
    match compute(100, 2, 5):
        case Result.Ok(v):
            print(v)
        case Result.Err(e):
            print(e)

    match compute(100, 0, 5):
        case Result.Ok(v):
            print(v)
        case Result.Err(e):
            print(e)

    match compute(100, 2, 0):
        case Result.Ok(v):
            print(v)
        case Result.Err(e):
            print(e)

    match chain_three(120, 2, 3):
        case Result.Ok(v):
            print(v)
        case Result.Err(e):
            print(e)

    return 0
