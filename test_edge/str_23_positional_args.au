# Test: can we pass str arguments positionally (without named args)?

def greet(name: str) -> str:
    return f"Hi {name}"

def consume(text: str):
    print(text)

def main() -> int32:
    # Positional borrow str
    r = greet("World")
    print(r)

    # Positional owned str
    consume("owned")

    return 0
