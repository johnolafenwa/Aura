# Edge test: Class containing a channel as a field

class MessageBus:
    ch: Channel[str]

    def send_msg(self, msg: str):
        self.ch.send(msg)

    def close(mut self):
        self.ch.close()

def receiver(bus: MessageBus):
    for msg in bus.ch:
        print(msg)

def main() -> int32:
    ch: Channel[str] = channel()
    bus = MessageBus(ch=ch.clone())

    task = spawn receiver(MessageBus(ch=ch.clone()))

    bus.send_msg(msg="hello")
    bus.send_msg(msg="world")

    mut bus2 = bus
    bus2.close()

    task.join()
    return 0
