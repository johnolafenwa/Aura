# Test: match borrow on enum with str payload (should not consume)

enum Container:
    Full(str)
    Empty

def main() -> int32:
    c = Container.Full("hello")

    # match borrow should not consume c
    match c:
        case Container.Full(s):
            print(s)
        case Container.Empty:
            print("empty")

    # c should still be usable after match borrow
    match c:
        case Container.Full(s):
            print(s)
        case Container.Empty:
            print("empty")

    return 0
