# Test: manually implementing a map-like pattern over Option
def map_option(opt: Option[int32], addend: int32) -> Option[int32]:
    match own opt:
        case Option.Some(v):
            return Option.Some(v + addend)
        case Option.None:
            return Option.None

def flat_map_option(opt: Option[int32]) -> Option[str]:
    match own opt:
        case Option.Some(v):
            if v > 0:
                return Option.Some("positive")
            return Option.None
        case Option.None:
            return Option.None

def main() -> int32:
    a: Option[int32] = Option.Some(10)
    b = map_option(a, 5)
    match own b:
        case Option.Some(v):
            print(v)
        case Option.None:
            print("none")

    c: Option[int32] = Option.None
    d = map_option(c, 5)
    match own d:
        case Option.Some(v):
            print(v)
        case Option.None:
            print("none")

    # flat_map on positive
    e: Option[int32] = Option.Some(1)
    match flat_map_option(e):
        case Option.Some(s):
            print(s)
        case Option.None:
            print("none")

    # flat_map on zero
    f: Option[int32] = Option.Some(0)
    match flat_map_option(f):
        case Option.Some(s):
            print(s)
        case Option.None:
            print("none")

    # flat_map on None
    g: Option[int32] = Option.None
    match flat_map_option(g):
        case Option.Some(s):
            print(s)
        case Option.None:
            print("none")

    return 0
