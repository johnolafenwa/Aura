# Edge: for range(1) should iterate once with i=0
def main() -> int32:
    mut count: int32 = 0
    mut val: int32 = -1
    for i in range(1):
        count += 1
        val = i
    print(count)
    print(val)

    # for range(1, 2) should iterate once with i=1
    mut count2: int32 = 0
    mut val2: int32 = -1
    for i in range(1, 2):
        count2 += 1
        val2 = i
    print(count2)
    print(val2)

    return 0
