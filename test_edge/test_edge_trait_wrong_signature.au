# Test: implementing a trait but with wrong return type (should error)

trait Returner:
    def get_value(self) -> int32

class BadImpl:
    value: str

impl Returner for BadImpl:
    def get_value(self) -> str:
        return self.value

def main() -> int32:
    b = BadImpl(value="hello")
    print(b.get_value())
    return 0
