def main() -> int32:
    # Basic += on string
    mut s: str = "Hello"
    s += " World"
    print(s)

    # Multiple +=
    mut acc: str = ""
    acc += "a"
    acc += "b"
    acc += "c"
    print(acc)

    # += with variable
    mut base: str = "base"
    suffix = "-end"
    base += suffix
    print(base)

    # += empty string (no-op)
    mut unchanged: str = "stay"
    unchanged += ""
    if unchanged == "stay":
        print("noop: pass")
    else:
        print("noop: FAIL")

    return 0
