## Test 04: Generic enum with match - Maybe/Option pattern
## Expects: 42 then "nothing"

enum Maybe[T]:
    Some(T)
    Nothing

def main() -> int32:
    val: Maybe[int32] = Maybe.Some(42)
    match own val:
        case Maybe.Some(inner):
            print(inner)
        case Maybe.Nothing:
            print("nothing")

    empty: Maybe[str] = Maybe.Nothing
    match own empty:
        case Maybe.Some(inner):
            print(inner)
        case Maybe.Nothing:
            print("nothing")
    return 0
