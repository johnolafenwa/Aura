# Edge test: str operations and f-string edge cases

def main() -> int32:
    # Empty string
    empty: str = ""
    print(empty)

    # str comparison
    a: str = "hello"
    b: str = "hello"
    if a == b:
        print("equal")
    else:
        print("not equal")

    # str concatenation chain
    result = "a" + "b" + "c" + "d"
    print(result)

    # F-string with expressions
    x: int32 = 5
    y: int32 = 10
    print(f"{x} + {y} = {x + y}")

    # Nested f-string fields
    name: str = "test"
    print(f"name={name}")

    # str with special characters
    slash: str = "path/to/file"
    print(slash)

    return 0
