def rapid_producer(ch: Channel[int32], count: int32):
    mut i: int32 = 0
    while i < count:
        ch.send(i)
        i += 1
    ch.close()

def main() -> int32:
    ch = Channel[int32](capacity=100)
    task = spawn rapid_producer(ch.clone(), 500)

    mut sum: int32 = 0
    mut received: int32 = 0
    while true:
        match ch.recv():
            case Option.Some(v):
                sum += v
                received += 1
            case Option.None:
                break

    task.join()
    print(received)
    print(sum)
    print("rapid producer ok")
    return 0
