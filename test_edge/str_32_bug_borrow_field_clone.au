# BUG: Cannot clone str field on borrow param in free function
# Expected: h.text.clone() should work on a borrowed parameter
# Actual: "cannot move non-copy field out of borrowed value"

class Holder:
    text: str

def clone_text(h: Holder) -> str:
    return h.text.clone()

def main() -> int32:
    h = Holder(text="hello")
    t = clone_text(h)
    print(t)
    return 0
