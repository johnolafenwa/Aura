def main() -> int32:
    ch: Channel[int32] = channel()
    ch.close()

    send_result = ch.send(42)
    match send_result:
        case Result.Ok(done):
            print("error: send should fail on closed channel")
        case Result.Err(err):
            match err:
                case SendError.Closed(value):
                    print(value)
                    print("send on closed returned value ok")

    send_result2 = ch.send(99)
    match send_result2:
        case Result.Ok(done):
            print("error: second send should also fail")
        case Result.Err(err):
            match err:
                case SendError.Closed(value):
                    print(value)
                    print("second send on closed ok")

    match ch.recv():
        case Option.Some(v):
            print("error: recv should be None")
        case Option.None:
            print("recv on closed ok")

    return 0
