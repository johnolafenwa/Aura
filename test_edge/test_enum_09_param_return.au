enum Status:
    Active(int32)
    Inactive

def make_active(id: int32) -> Status:
    return Status.Active(id)

def make_inactive() -> Status:
    return Status.Inactive

def status_id(s: Status) -> int32:
    match s:
        case Status.Active(id):
            return id
        case Status.Inactive:
            return -1

def promote(s: Status) -> Status:
    match s:
        case Status.Active(id):
            return Status.Active(id + 100)
        case Status.Inactive:
            return Status.Active(1)

def main() -> int32:
    s1 = make_active(5)
    s2 = make_inactive()
    print(status_id(s1))
    print(status_id(s2))
    s3 = make_active(5)
    s4 = make_inactive()
    print(status_id(promote(s3)))
    print(status_id(promote(s4)))
    return 0
