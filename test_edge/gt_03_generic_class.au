## Test 03: Generic class with field access and method
## Expects: 99 then "aurora"

class Box[T]:
    value: T

    def get(self) -> T:
        return self.value

def main() -> int32:
    int_box: Box[int32] = Box(value=99)
    print(int_box.get())
    str_box: Box[String] = Box(value="aurora")
    print(str_box.get())
    return 0
