def validate_age(age: int32) -> Result[int32, String]:
    if age < 0:
        return Result.Err("age cannot be negative")
    if age > 150:
        return Result.Err("age too large")
    return Result.Ok(age)

def validate_name_len(len: int32) -> Result[int32, String]:
    if len == 0:
        return Result.Err("name cannot be empty")
    return Result.Ok(len)

def create_user(age: int32, name_len: int32) -> Result[int32, String]:
    valid_age = try validate_age(age)
    valid_len = try validate_name_len(name_len)
    return Result.Ok(valid_age + valid_len)

def main() -> int32:
    # Both valid
    match create_user(25, 5):
        case Result.Ok(v):
            print(v)
        case Result.Err(e):
            print(e)

    # Age invalid
    match create_user(-1, 5):
        case Result.Ok(v):
            print(v)
        case Result.Err(e):
            print(e)

    # Name len invalid
    match create_user(25, 0):
        case Result.Ok(v):
            print(v)
        case Result.Err(e):
            print(e)

    # Age too large
    match create_user(200, 5):
        case Result.Ok(v):
            print(v)
        case Result.Err(e):
            print(e)

    return 0
