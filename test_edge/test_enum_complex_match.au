## Test: Complex enum with data and matching
enum Shape:
    Circle(float64)
    Empty

def describe(s: Shape) -> str:
    match own s:
        case Shape.Circle(r):
            return f"circle with radius {r}"
        case Shape.Empty:
            return "empty"

def main() -> int32:
    s1 = Shape.Circle(3.14)
    s2 = Shape.Empty
    print(describe(s=s1))
    print(describe(s=s2))
    return 0
