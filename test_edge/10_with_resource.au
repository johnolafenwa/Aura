class Connection:
    name: str
    active: bool = true

    def query(self) -> str:
        return "result from " + self.name

    def close(mut self):
        print("closing " + self.name)

class Logger:
    prefix: str

    def log(self, msg: str):
        print(self.prefix + ": " + msg)

    def close(mut self):
        print("logger closed")

def use_connection() -> Result[str, str]:
    with conn = Connection(name="db1"):
        result = conn.query()
        print(result)
        return Result.Ok("connection done")

def use_logger() -> Result[str, str]:
    with logger = Logger(prefix="APP"):
        logger.log("started")
        logger.log("running")
        return Result.Ok("logger done")

def main() -> int32:
    match use_connection():
        case Result.Ok(value):
            print(value)
        case Result.Err(err):
            print(err)

    match use_logger():
        case Result.Ok(value):
            print(value)
        case Result.Err(err):
            print(err)

    return 0
