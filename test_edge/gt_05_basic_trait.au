## Test 05: Basic trait definition and implementation
## Expects: "Hello, Aurora"

trait Greetable:
    def greet(borrow self) -> String

class Person:
    name: String

impl Greetable for Person:
    def greet(borrow self) -> String:
        return "Hello, " + self.name

def main() -> int32:
    p = Person(name="Aurora")
    print(p.greet())
    return 0
