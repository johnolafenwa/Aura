## Test 05: Basic trait definition and implementation
## Expects: "Hello, Aura"

trait Greetable:
    def greet(self) -> str

class Person:
    name: str

impl Greetable for Person:
    def greet(self) -> str:
        return "Hello, " + self.name

def main() -> int32:
    p = Person(name="Aura")
    print(p.greet())
    return 0
