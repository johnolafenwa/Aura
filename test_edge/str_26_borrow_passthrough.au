# Test: passing a borrow str through to another function

def inner(s: str) -> String:
    return f"inner({s})"

def outer(s: str) -> String:
    return inner(s)

def main() -> int32:
    result = outer("test")
    print(result)

    text = "variable"
    r2 = outer(text)
    print(r2)
    # text still usable
    print(text)

    return 0
