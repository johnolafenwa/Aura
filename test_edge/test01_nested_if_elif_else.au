def classify(x: int32) -> String:
    if x < 0:
        if x < -100:
            return "very negative"
        elif x < -10:
            return "negative"
        else:
            return "slightly negative"
    elif x == 0:
        return "zero"
    else:
        if x > 100:
            return "very positive"
        elif x > 10:
            return "positive"
        else:
            return "slightly positive"

def main() -> int32:
    print(classify(-200))
    print(classify(-50))
    print(classify(-5))
    print(classify(0))
    print(classify(3))
    print(classify(42))
    print(classify(999))
    return 0
