def main() -> int32:
    # Float modulo
    a: float64 = 10.5
    b: float64 = 3.0
    print(a % b)       # 1.5

    # Float modulo with negative
    c: float64 = -10.5
    d: float64 = 3.0
    print(c % d)       # -1.5

    # Float modulo by zero
    e: float64 = 10.0
    f: float64 = 0.0
    print(e % f)       # NaN

    # Float modulo zero
    g: float64 = 0.0
    h: float64 = 3.0
    print(g % h)       # 0.0

    return 0
