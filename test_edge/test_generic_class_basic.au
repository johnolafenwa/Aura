class Box[T]:
    value: T

    def get(self) -> T:
        return self.value

class Holder[T]:
    item: T
    count: int32

    def get_item(self) -> T:
        return self.item

    def get_count(self) -> int32:
        return self.count

def main() -> int32:
    # Box with int32
    b1 = Box(value=42)
    print(b1.get())

    # Box with String
    b2 = Box(value="hello")
    print(b2.get())

    # Box with float64
    b3 = Box(value=3.14)
    print(b3.get())

    # Box with bool
    b4 = Box(value=true)
    print(b4.get())

    # Holder with int32
    h1 = Holder(item=99, count=1)
    print(h1.get_item())
    print(h1.get_count())

    # Holder with String
    h2 = Holder(item="world", count=5)
    print(h2.get_item())
    print(h2.get_count())

    return 0
