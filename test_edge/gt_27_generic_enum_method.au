## Test 27: Method on generic enum
## Expects: 1 then 0

enum Maybe[T]:
    Some(T)
    Nothing

    def is_some(self) -> int32:
        match own self:
            case Maybe.Some(_):
                return 1
            case Maybe.Nothing:
                return 0

def main() -> int32:
    val: Maybe[int32] = Maybe.Some(42)
    print(val.is_some())
    empty: Maybe[int32] = Maybe.Nothing
    print(empty.is_some())
    return 0
