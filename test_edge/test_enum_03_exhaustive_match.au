enum Direction:
    North
    South
    East
    West

def direction_to_string(d: Direction) -> str:
    match own d:
        case Direction.North:
            return "north"
        case Direction.South:
            return "south"
        case Direction.East:
            return "east"
        case Direction.West:
            return "west"

def main() -> int32:
    print(direction_to_string(Direction.North))
    print(direction_to_string(Direction.South))
    print(direction_to_string(Direction.East))
    print(direction_to_string(Direction.West))
    return 0
