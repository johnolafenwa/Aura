## Test 06: Trait bounds on generic functions
## Expects: "Robot says beep" then "Dog says woof"

trait Speakable:
    def speak(self) -> str

class Robot:
    sound: str

class Dog:
    sound: str

impl Speakable for Robot:
    def speak(self) -> str:
        return "Robot says " + self.sound

impl Speakable for Dog:
    def speak(self) -> str:
        return "Dog says " + self.sound

def announce[T: Speakable](creature: T):
    print(creature.speak())

def main() -> int32:
    announce(creature=Robot(sound="beep"))
    announce(creature=Dog(sound="woof"))
    return 0
