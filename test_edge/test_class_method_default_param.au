class Logger:
    prefix: str

    def log(self, msg: str, level: int32 = 0):
        if level == 0:
            print(self.prefix + ": " + msg)
        else:
            print(self.prefix + " [WARN]: " + msg)

def main() -> int32:
    logger = Logger(prefix="APP")
    logger.log(msg="started")
    logger.log(msg="problem detected", level=1)
    logger.log(msg="all good")
    return 0
