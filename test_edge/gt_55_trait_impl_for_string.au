## Test 55: Trait implemented for str type
## Expects: "hello" (testing if traits work on str like on int32)

trait Shoutify:
    def shout(self) -> str

impl Shoutify for str:
    def shout(self) -> str:
        return self.clone()

def main() -> int32:
    s: str = "hello"
    print(s.shout())
    return 0
