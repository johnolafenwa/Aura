## Test 55: Trait implemented for String type
## Expects: "hello" (testing if traits work on String like on int32)

trait Shoutify:
    def shout(self) -> String

impl Shoutify for String:
    def shout(self) -> String:
        return self.clone()

def main() -> int32:
    s: String = "hello"
    print(s.shout())
    return 0
