def main() -> int32:
    ch: Channel[int32] = channel()
    ch.close()

    send_result = ch.send(99)
    match send_result:
        case Result.Ok(done):
            print("error: send succeeded on closed channel")
        case Result.Err(err):
            match err:
                case SendError.Closed(value):
                    print(value)
                    print("send correctly failed")

    match ch.recv():
        case Option.Some(value):
            print("error: recv got value on closed channel")
        case Option.None:
            print("recv correctly returned None")

    return 0
