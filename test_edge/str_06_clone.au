def consume(s: str):
    print(s)

def main() -> int32:
    # Basic clone
    original: str = "original"
    copy = original.clone()
    print(copy)

    # Clone independence: modify original, clone unchanged
    mut source: str = "before"
    cloned = source.clone()
    source = "after"
    print(source)
    print(cloned)
    if source != cloned:
        print("independence: pass")
    else:
        print("independence: FAIL")

    # Clone allows use after move
    text: str = "hello"
    cloned2 = text.clone()
    consume(text)
    print(cloned2)

    # Clone of empty string
    empty: str = ""
    empty_copy = empty.clone()
    if empty_copy == "":
        print("empty clone: pass")
    else:
        print("empty clone: FAIL")

    return 0
