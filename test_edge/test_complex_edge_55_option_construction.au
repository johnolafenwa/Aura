# BUG: Option construction without type annotation

def main() -> int32:
    # With annotation - works
    o1: Option[int32] = Option.Some(42)
    match own o1:
        case Option.Some(v):
            print(v)
        case Option.None:
            print("none")

    # Without annotation - fails?
    o2 = Option.Some(99)
    match own o2:
        case Option.Some(v):
            print(v)
        case Option.None:
            print("none")

    return 0
