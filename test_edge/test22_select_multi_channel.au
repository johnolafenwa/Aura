def sender_a(out: Channel[int32]):
    sleep(20ms)
    out.send(1)

def sender_b(out: Channel[int32]):
    sleep(5ms)
    out.send(2)

def main() -> int32:
    ch_a: Channel[int32] = channel()
    ch_b: Channel[int32] = channel()

    spawn detached sender_a(ch_a.clone())
    spawn detached sender_b(ch_b.clone())

    select:
        case va = ch_a.recv():
            match own va:
                case Option.Some(v):
                    print(v)
                case Option.None:
                    print("none a")
        case vb = ch_b.recv():
            match own vb:
                case Option.Some(v):
                    print(v)
                case Option.None:
                    print("none b")
        case after(1s):
            print("timeout")

    return 0
