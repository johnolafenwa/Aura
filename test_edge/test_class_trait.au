trait Printable:
    def to_string(self) -> str

class Dog:
    name: str
    breed: str

impl Printable for Dog:
    def to_string(self) -> str:
        return self.name + " (" + self.breed + ")"

class Cat:
    name: str

impl Printable for Cat:
    def to_string(self) -> str:
        return "Cat: " + self.name

def show[T: Printable](item: T):
    print(item.to_string())

def main() -> int32:
    d = Dog(name="Rex", breed="Labrador")
    show(item=d)
    print(d.to_string())

    c = Cat(name="Whiskers")
    show(item=c)

    return 0
