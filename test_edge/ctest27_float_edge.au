def main() -> int32:
    # Float infinity operations
    a: float64 = 1.0 / 0.0
    print(a)              # inf

    # Infinity + number
    b: float64 = a + 1.0
    print(b)              # inf

    # Infinity - infinity
    c: float64 = a - a
    print(c)              # NaN

    # Infinity * 0
    d: float64 = a * 0.0
    print(d)              # NaN

    # NaN comparisons
    e: float64 = 0.0 / 0.0
    print(e == e)         # false (NaN != NaN)
    print(e != e)         # true
    print(e < 0.0)        # false
    print(e > 0.0)        # false

    # Very small float
    f: float64 = 0.000000000000001
    print(f)

    # Negative zero equality
    g: float64 = -0.0
    h: float64 = 0.0
    print(g == h)         # true (IEEE 754)

    return 0
