# Edge test: Match inside match with complex enum interaction

enum Shape:
    Circle(int32)
    Square(int32)

enum Color:
    Red
    Blue

def classify(shape: Shape, color: Color) -> String:
    match shape:
        case Shape.Circle(r):
            match color:
                case Color.Red:
                    return f"red circle r={r}"
                case Color.Blue:
                    return f"blue circle r={r}"
        case Shape.Square(s):
            match color:
                case Color.Red:
                    return f"red square s={s}"
                case Color.Blue:
                    return f"blue square s={s}"

def main() -> int32:
    print(classify(shape=Shape.Circle(5), color=Color.Red))
    print(classify(shape=Shape.Square(3), color=Color.Blue))
    print(classify(shape=Shape.Circle(10), color=Color.Blue))
    return 0
