public class Pair:
    public first: int32
    public second: int32

    public def sum(self) -> int32:
        return self.first + self.second

    public def max(self) -> int32:
        if self.first > self.second:
            return self.first
        return self.second

public def make_pair(a: int32, b: int32) -> Pair:
    return Pair(first=a, second=b)
