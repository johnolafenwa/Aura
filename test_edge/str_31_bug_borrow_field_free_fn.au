# BUG: Free function cannot access str field on borrow param
# Expected: should work same as borrow self methods
# Actual: "cannot move non-copy field out of borrowed value"

class Holder:
    text: str

def get_text(h: Holder) -> str:
    return h.text

def main() -> int32:
    h = Holder(text="hello")
    t = get_text(h)
    print(t)
    return 0
