def main() -> int32:
    # Break from nested while loops (inner only)
    mut outer_count: int32 = 0
    mut inner_total: int32 = 0
    mut i: int32 = 0
    while i < 5:
        mut j: int32 = 0
        while j < 10:
            if j == 3:
                break
            inner_total += 1
            j += 1
        outer_count += 1
        i += 1
    print(outer_count)    # 5
    print(inner_total)    # 15 (3 per outer iteration * 5)

    # Continue in nested loops (use different var names)
    mut skip_count: int32 = 0
    for x in range(3):
        for y in range(3):
            if y == 1:
                continue
            skip_count += 1
    print(skip_count)     # 6 (2 per outer * 3)

    # Early return from function
    print(early_return_test(5))    # 1
    print(early_return_test(-1))   # -1
    print(early_return_test(0))    # 0

    # While with complex condition
    mut a: int32 = 0
    mut b: int32 = 100
    while a < 10 and b > 50:
        a += 1
        b -= 10
    print(a)    # 5
    print(b)    # 50

    return 0

def early_return_test(n: int32) -> int32:
    if n > 0:
        return 1
    elif n < 0:
        return -1
    return 0
