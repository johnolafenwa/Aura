## Test 10: Generic class with trait bound on type parameter
## Expects: "aura" then "empty"

trait Named:
    def name(self) -> str

class User:
    label: str

impl Named for User:
    def name(self) -> str:
        return self.label.clone()

class Container[T: Named]:
    item: T

    def display(self) -> str:
        return self.item.name()

enum MaybeNamed[T: Named]:
    Present(T)
    Absent

def main() -> int32:
    c = Container(item=User(label="aura"))
    print(c.display())

    val: MaybeNamed[User] = MaybeNamed.Absent
    match own val:
        case MaybeNamed.Present(inner):
            print(inner.name())
        case _:
            print("empty")
    return 0
