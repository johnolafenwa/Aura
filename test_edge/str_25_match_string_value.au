# Test: can we match on string values directly?
# (This may or may not be supported)

def classify(s: str) -> str:
    if s == "red":
        return "color"
    if s == "cat":
        return "animal"
    return "unknown"

def main() -> int32:
    print(classify("red"))
    print(classify("cat"))
    print(classify("xyz"))
    return 0
