# BUG test: Can we pass a str field from match borrow binding?

class Wrapper:
    label: str

def print_label(s: str):
    print(s)

def main() -> int32:
    opt: Wrapper? = Option.Some(Wrapper(label="hello"))

    match opt:
        case Some(w):
            # Can we pass w.label (borrowed str field) to a function?
            print_label(w.label)
        case None:
            print("none")

    return 0
