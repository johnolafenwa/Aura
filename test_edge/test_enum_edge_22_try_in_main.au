# Test: can main return Result and use try?
def risky(x: int32) -> Result[int32, String]:
    if x == 0:
        return Result.Err("zero!")
    return Result.Ok(x * 2)

def process() -> Result[int32, String]:
    a = try risky(5)
    b = try risky(a)
    c = try risky(b)
    return Result.Ok(c)

def main() -> int32:
    match process():
        case Result.Ok(v):
            print(v)
        case Result.Err(e):
            print(e)

    # Chain that fails
    match process_fail():
        case Result.Ok(v):
            print(v)
        case Result.Err(e):
            print(e)

    return 0

def process_fail() -> Result[int32, String]:
    a = try risky(5)
    b = try risky(0)
    c = try risky(b)
    return Result.Ok(c)
