class Point:
    x: float64
    y: float64

def print_point(p: Point):
    print(p.x)
    print(p.y)

def move_point(p: Point) -> Point:
    return Point(x=p.x + 1.0, y=p.y + 1.0)

def mutate_point(p: mut Point):
    p.x = 0.0
    p.y = 0.0

copy class Size:
    w: int32
    h: int32

def area(s: Size) -> int32:
    return s.w * s.h

def double_area(s: Size) -> int32:
    return area(s=s) * 2

def main() -> int32:
    p = Point(x=1.0, y=2.0)
    print_point(p=p)
    print_point(p=p)

    p2 = move_point(p=p)
    print(p2.x)
    print(p2.y)

    mut p3 = Point(x=5.0, y=6.0)
    mutate_point(p=p3)
    print(p3.x)
    print(p3.y)

    s = Size(w=3, h=4)
    print(area(s=s))
    print(double_area(s=s))
    print(s.w)

    return 0
