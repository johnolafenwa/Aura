# Edge: passing class instances as function arguments
class Vec2:
    x: float64
    y: float64

def dot(a: Vec2, b: Vec2) -> float64:
    return a.x * b.x + a.y * b.y

def add(a: Vec2, b: Vec2) -> Vec2:
    return Vec2(x=a.x + b.x, y=a.y + b.y)

def main() -> int32:
    v1 = Vec2(x=1.0, y=2.0)
    v2 = Vec2(x=3.0, y=4.0)
    print(dot(v1, v2))

    v3 = add(v1, v2)
    print(v3.x)
    print(v3.y)
    return 0
