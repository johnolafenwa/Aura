enum Light:
    Red
    Yellow
    Green

def next_light(l: Light) -> Light:
    match own l:
        case Light.Red:
            return Light.Green
        case Light.Green:
            return Light.Yellow
        case Light.Yellow:
            return Light.Red

def light_name(l: Light) -> String:
    match own l:
        case Light.Red:
            return "red"
        case Light.Yellow:
            return "yellow"
        case Light.Green:
            return "green"

def main() -> int32:
    l = Light.Red
    print(light_name(l))
    l2 = next_light(Light.Red)
    print(light_name(l2))
    l3 = next_light(Light.Green)
    print(light_name(l3))
    l4 = next_light(Light.Yellow)
    print(light_name(l4))
    return 0
