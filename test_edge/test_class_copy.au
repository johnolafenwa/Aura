copy class Vec2:
    x: float64
    y: float64

def consume_vec(v: Vec2):
    print(v.x)
    print(v.y)

def main() -> int32:
    v1 = Vec2(x=1.0, y=2.0)
    v2 = v1
    v3 = v1

    print(v1.x)
    print(v2.x)
    print(v3.y)

    consume_vec(v1)
    print(v1.x)

    mut v4 = Vec2(x=10.0, y=20.0)
    v5 = v4
    v4.x = 99.0
    print(v4.x)
    print(v5.x)

    return 0
