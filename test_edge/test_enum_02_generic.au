enum Container[T]:
    Empty
    Value(T)

def unwrap_or_default(c: Container[int32], default_val: int32) -> int32:
    match c:
        case Container.Empty:
            return default_val
        case Container.Value(v):
            return v

def main() -> int32:
    full: Container[int32] = Container.Value(42)
    empty: Container[int32] = Container.Empty

    print(unwrap_or_default(full, 0))
    print(unwrap_or_default(empty, -1))
    return 0
