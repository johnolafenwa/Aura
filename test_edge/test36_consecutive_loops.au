# Test: many consecutive loops
def main() -> int32:
    mut a: int32 = 0
    for i in range(5):
        a += 1

    mut b: int32 = 0
    for i in range(5):
        b += 2

    mut c: int32 = 0
    for i in range(5):
        c += 3

    # a=5, b=10, c=15
    print(a + b + c)

    # Now with while
    mut d: int32 = 0
    mut n: int32 = 0
    while n < 3:
        d += n
        n += 1

    n = 0
    mut e: int32 = 0
    while n < 3:
        e += n * 2
        n += 1

    # d = 0+1+2 = 3, e = 0+2+4 = 6
    print(d + e)

    return 0
