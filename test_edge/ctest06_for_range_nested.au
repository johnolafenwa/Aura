def main() -> int32:
    # Basic range(n)
    mut sum1: int32 = 0
    for i in range(5):
        sum1 += i
    print(sum1)    # 0+1+2+3+4 = 10

    # range(start, stop)
    mut sum2: int32 = 0
    for i in range(3, 8):
        sum2 += i
    print(sum2)    # 3+4+5+6+7 = 25

    # range(0) - empty range
    mut sum3: int32 = 0
    for i in range(0):
        sum3 += 999
    print(sum3)    # 0

    # range(1) - single iteration
    mut sum4: int32 = 0
    for i in range(1):
        sum4 += 1
    print(sum4)    # 1

    # Nested for loops
    mut total: int32 = 0
    for i in range(3):
        for j in range(4):
            total += 1
    print(total)   # 12

    # Nested for with multiplication table pattern
    mut prod_sum: int32 = 0
    for i in range(1, 4):
        for j in range(1, 4):
            prod_sum += i * j
    print(prod_sum)  # (1*1+1*2+1*3)+(2*1+2*2+2*3)+(3*1+3*2+3*3) = 6+12+18 = 36

    # Triple nested loop
    mut count3: int32 = 0
    for i in range(3):
        for j in range(3):
            for k in range(3):
                count3 += 1
    print(count3)  # 27

    # For with break
    mut break_val: int32 = 0
    for i in range(100):
        if i == 7:
            break
        break_val = i
    print(break_val)   # 6

    # For with continue
    mut cont_sum: int32 = 0
    for i in range(10):
        if i % 2 == 0:
            continue
        cont_sum += i
    print(cont_sum)    # 1+3+5+7+9 = 25

    return 0
