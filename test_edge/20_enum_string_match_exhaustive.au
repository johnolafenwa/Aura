enum Shape:
    Circle(float64)
    Rectangle(float64)
    Named(String)

def describe(s: Shape) -> String:
    match s:
        case Shape.Circle(r):
            return "circle"
        case Shape.Rectangle(w):
            return "rectangle"
        case Shape.Named(name):
            return "shape: " + name

def main() -> int32:
    s1 = Shape.Circle(3.0)
    s2 = Shape.Rectangle(4.0)
    s3 = Shape.Named("triangle")

    print(describe(s1))
    print(describe(s2))
    print(describe(s3))

    return 0
