def main() -> int32:
    print(42)
    print(3.14)
    print(true)
    print(false)
    print("hello")
    print(0)
    print(-1)
    print(0.0)
    print(-2.5)
    print("")

    x: int32 = 100
    y: float64 = 9.81
    z: bool = true
    s: str = "aura"
    print(x)
    print(y)
    print(z)
    print(s)

    return 0
