# Test: generic enum with trait-bounded type parameter

trait Printable:
    def to_str(self) -> str

enum Holder[T: Printable]:
    Has(T)
    Empty

class Label:
    text: str

impl Printable for Label:
    def to_str(self) -> str:
        return self.text

def main() -> int32:
    l = Label(text="test")
    h: Holder[Label] = Holder.Has(l)
    match own h:
        case Holder.Has(v):
            print(v.to_str())
        case Holder.Empty:
            print("empty")
    return 0
