## Test: Class with multiple methods, mutating and read-only
class Stack:
    values: String
    count: int32

    def push(borrow mut self, item: int32):
        self.count += 1

    def pop(borrow mut self) -> int32:
        if self.count > 0:
            self.count -= 1
        return self.count

    def size(borrow self) -> int32:
        return self.count

    def is_empty(borrow self) -> bool:
        return self.count == 0

def main() -> int32:
    mut s = Stack(values="data", count=0)
    print(s.is_empty())
    s.push(item=10)
    s.push(item=20)
    s.push(item=30)
    print(s.size())
    print(s.is_empty())
    s.pop()
    print(s.size())
    return 0
