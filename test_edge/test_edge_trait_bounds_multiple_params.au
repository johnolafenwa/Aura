# Test: multiple type params each with trait bounds

trait Show:
    def show(self) -> str

trait Count:
    def count(self) -> int32

class Name:
    text: str

class Qty:
    n: int32

impl Show for Name:
    def show(self) -> str:
        return self.text

impl Count for Qty:
    def count(self) -> int32:
        return self.n

def display[A: Show, B: Count](a: A, b: B):
    print(a.show())
    print(b.count())

def main() -> int32:
    n = Name(text="item")
    q = Qty(n=5)
    display(a=n, b=q)
    return 0
