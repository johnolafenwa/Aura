# Test: concatenation with borrow str parameters

def join(a: borrow str, b: borrow str, sep: borrow str) -> String:
    return a + sep + b

def prefix(s: borrow str) -> String:
    return "prefix_" + s

def suffix(s: borrow str) -> String:
    return s + "_suffix"

def main() -> int32:
    r1 = join("hello", "world", " ")
    print(r1)

    r2 = prefix("test")
    print(r2)

    r3 = suffix("test")
    print(r3)

    # Chain results
    r4 = prefix("a")
    r5 = suffix(r4)
    print(r5)

    return 0
