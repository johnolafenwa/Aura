def fire_and_forget(out: Channel[int32]):
    out.send(77)
    out.close()

def main() -> int32:
    ch: Channel[int32] = channel()
    spawn detached fire_and_forget(ch.clone())

    match ch.recv():
        case Option.Some(value):
            print(value)
        case Option.None:
            print("error: no value")

    match ch.recv():
        case Option.Some(value):
            print("error: extra value")
        case Option.None:
            print("channel closed correctly")

    return 0
