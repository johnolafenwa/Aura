def main() -> int32:
    # Mutable string reassignment
    mut s: str = "first"
    print(s)
    s = "second"
    print(s)
    s = "third"
    print(s)

    # Mutable from concat
    mut greeting: str = "Hello"
    greeting = greeting + " World"
    print(greeting)

    # Reassign to empty
    mut text: str = "content"
    text = ""
    if text == "":
        print("cleared: pass")
    else:
        print("cleared: FAIL")

    # Multiple reassignments
    mut counter_str: str = "a"
    counter_str = "b"
    counter_str = "c"
    counter_str = "d"
    print(counter_str)

    return 0
