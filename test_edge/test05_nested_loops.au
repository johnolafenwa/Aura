def main() -> int32:
    # Nested while loops: multiplication table style
    mut i: int32 = 1
    mut total: int32 = 0
    while i <= 3:
        mut j: int32 = 1
        while j <= 3:
            total += i * j
            j += 1
        i += 1
    # 1*1+1*2+1*3 + 2*1+2*2+2*3 + 3*1+3*2+3*3 = 6 + 12 + 18 = 36
    print(total)

    # Nested for loops
    mut sum: int32 = 0
    for a in range(3):
        for b in range(3):
            sum += a + b
    # a=0: 0+0+1+2=3... actually:
    # (0,0)=0 (0,1)=1 (0,2)=2 (1,0)=1 (1,1)=2 (1,2)=3 (2,0)=2 (2,1)=3 (2,2)=4 = 18
    print(sum)

    # While inside for
    mut product: int32 = 0
    for x in range(4):
        mut y: int32 = 0
        while y < x:
            product += 1
            y += 1
    # x=0: 0 iters, x=1: 1 iter, x=2: 2 iters, x=3: 3 iters => 0+1+2+3 = 6
    print(product)

    return 0
