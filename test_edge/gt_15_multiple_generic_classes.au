## Test 15: Multiple generic classes interacting
## Expects: 42

class Pair[T, U]:
    first: T
    second: U

class Wrapper[T]:
    inner: T

    def unwrap(self) -> T:
        return self.inner

def main() -> int32:
    p: Pair[int32, String] = Pair(first=42, second="hello")
    w: Wrapper[int32] = Wrapper(inner=p.first)
    print(w.unwrap())
    return 0
