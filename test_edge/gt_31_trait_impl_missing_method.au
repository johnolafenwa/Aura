## Test 31: Trait impl that's missing one of two required methods
## Expects: Compile error about incomplete implementation

trait Displayable:
    def label(self) -> str
    def icon(self) -> str

class Button:
    text: str

impl Displayable for Button:
    def label(self) -> str:
        return self.text.clone()
    ## Note: icon() is NOT implemented

def main() -> int32:
    b = Button(text="OK")
    print(b.label())
    return 0
