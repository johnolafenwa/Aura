def find_first_positive(a: int32, b: int32, c: int32) -> Option[int32]:
    if a > 0:
        return Option.Some(a)
    if b > 0:
        return Option.Some(b)
    if c > 0:
        return Option.Some(c)
    return Option.None

def option_to_string(o: Option[int32]) -> String:
    match o:
        case Option.Some(v):
            print(v)
            return "found"
        case Option.None:
            return "none"

def main() -> int32:
    # First is positive
    r1 = find_first_positive(5, -1, -2)
    print(option_to_string(r1))

    # Second is positive
    r2 = find_first_positive(-1, 10, -2)
    print(option_to_string(r2))

    # Third is positive
    r3 = find_first_positive(-1, -2, 99)
    print(option_to_string(r3))

    # None positive
    r4 = find_first_positive(-1, -2, -3)
    print(option_to_string(r4))

    # All positive - should return first
    r5 = find_first_positive(1, 2, 3)
    print(option_to_string(r5))

    # Test Option with String type
    opt_str: Option[String] = Option.Some("hello")
    match opt_str:
        case Option.Some(s):
            print(s)
        case Option.None:
            print("empty")

    opt_none: Option[String] = Option.None
    match opt_none:
        case Option.Some(s):
            print(s)
        case Option.None:
            print("empty")

    return 0
