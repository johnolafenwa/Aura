# Test: consuming match on str payload (move semantics)
# After consuming match that extracts str, original enum should be moved
enum Msg:
    Text(str)
    Empty

def main() -> int32:
    m = Msg.Text("hello")

    # This match consumes m
    match own m:
        case Msg.Text(s):
            print(s)
            # s is now the owned str
            print(s)
        case Msg.Empty:
            print("empty")

    # m should be moved now - next line should error if uncommented
    # match m:
    #     case Msg.Text(s): print(s)
    #     case Msg.Empty: print("empty")

    return 0
