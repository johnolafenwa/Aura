def main() -> int32:
    # Test that break only exits the innermost loop
    mut outer_count: int32 = 0
    mut inner_count: int32 = 0

    mut i: int32 = 0
    while i < 5:
        outer_count += 1
        mut j: int32 = 0
        while j < 10:
            j += 1
            if j == 3:
                break
            inner_count += 1
        i += 1

    # outer_count should be 5 (outer loop runs all iterations)
    print(outer_count)
    # inner_count: each inner loop runs j=1(count+1),j=2(count+1),j=3(break) => 2 per outer iteration
    # 5 * 2 = 10
    print(inner_count)

    # Nested for with break
    mut for_outer: int32 = 0
    mut for_inner: int32 = 0
    for a in range(4):
        for_outer += 1
        for b in range(10):
            if b == 2:
                break
            for_inner += 1

    # for_outer = 4, for_inner = 4 * 2 = 8
    print(for_outer)
    print(for_inner)

    return 0
