# Test trait with borrow mut self

trait Incrementable:
    def increment(borrow mut self)
    def value(borrow self) -> int32

class Counter:
    count: int32

impl Incrementable for Counter:
    def increment(borrow mut self):
        self.count += 1

    def value(borrow self) -> int32:
        return self.count

def main() -> int32:
    mut c = Counter(count=0)
    c.increment()
    c.increment()
    c.increment()
    print(c.value())
    return 0
