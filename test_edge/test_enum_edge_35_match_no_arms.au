# Test: empty enum body - Aurora requires at least one variant
# KNOWN ISSUE: `enum Empty:` with no variants fails with parse error:
#   "expected Indent, found KwDef"
# Aurora does not support empty enums (no `pass` keyword for enum bodies)

# Minimal test: single-variant enum works fine
enum Minimal:
    Only

def main() -> int32:
    m = Minimal.Only
    match own m:
        case Minimal.Only:
            print("only")
    return 0
