class Builder:
    prefix: str
    suffix: str

    def build(self, middle: str) -> str:
        return self.prefix + middle + self.suffix

    def close(mut self):
        pass

def main() -> int32:
    b = Builder(prefix="[", suffix="]")
    print(b.build("hello"))
    print(b.build("world"))
    print(b.build(""))

    return 0
