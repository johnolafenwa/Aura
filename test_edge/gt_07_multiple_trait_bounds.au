## Test 07: Multiple trait bounds (T: A + B)
## Expects: 15

trait HasX:
    def get_x(borrow self) -> int32

trait HasY:
    def get_y(borrow self) -> int32

class Point:
    x: int32
    y: int32

impl HasX for Point:
    def get_x(borrow self) -> int32:
        return self.x

impl HasY for Point:
    def get_y(borrow self) -> int32:
        return self.y

def sum_coords[T: HasX + HasY](p: T) -> int32:
    return p.get_x() + p.get_y()

def main() -> int32:
    pt = Point(x=7, y=8)
    print(sum_coords(p=pt))
    return 0
