def main() -> int32:
    mut greeting: str = "hello"
    print(greeting)

    greeting = greeting + " world"
    print(greeting)

    greeting = greeting + "!"
    print(greeting)

    mut parts: str = ""
    parts = parts + "a"
    parts = parts + "b"
    parts = parts + "c"
    print(parts)

    mut name: str = "alice"
    name = "bob"
    print(name)

    return 0
