## Test 34: Trait that returns int32, multiple impls
## Expects: 100 then 50

trait Sizeable:
    def size(borrow self) -> int32

class BigThing:
    s: int32

class SmallThing:
    s: int32

impl Sizeable for BigThing:
    def size(borrow self) -> int32:
        return self.s * 10

impl Sizeable for SmallThing:
    def size(borrow self) -> int32:
        return self.s

def report_size[T: Sizeable](item: T):
    print(item.size())

def main() -> int32:
    report_size(item=BigThing(s=10))
    report_size(item=SmallThing(s=50))
    return 0
