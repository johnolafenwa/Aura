## Test 24: Implementing two different traits for the same type
## Expects: "alice" then 30

trait HasName:
    def name(self) -> str

trait HasAge:
    def age(self) -> int32

class Person:
    n: str
    a: int32

impl HasName for Person:
    def name(self) -> str:
        return self.n.clone()

impl HasAge for Person:
    def age(self) -> int32:
        return self.a

def main() -> int32:
    p = Person(n="alice", a=30)
    print(p.name())
    print(p.age())
    return 0
