def worker(out: Channel[int32]):
    mut i: int32 = 0
    while i < 1000:
        if cancelled():
            return
        out.send(i)
        i += 1

def main() -> int32:
    out: Channel[int32] = channel()

    with task_group() as group:
        group.spawn(worker, out.clone())
        mut seen: int32 = 0

        while seen < 3:
            select:
                case value = out.recv():
                    match value:
                        case Option.Some(next):
                            print(next)
                            seen += 1
                            if seen == 3:
                                group.cancel()
                        case Option.None:
                            break

    print("cancelled ok")
    return 0
