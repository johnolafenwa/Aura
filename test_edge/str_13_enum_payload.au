# String as enum payload with different operations

enum ParseResult:
    Success(int32)
    Failure(String)

def parse(input: str) -> ParseResult:
    if input == "42":
        return ParseResult.Success(42)
    return ParseResult.Failure(f"cannot parse: {input}")

def main() -> int32:
    r1 = parse("42")
    r2 = parse("abc")

    match own r1:
        case ParseResult.Success(v):
            print(v)
        case ParseResult.Failure(msg):
            print(msg)

    match own r2:
        case ParseResult.Success(v):
            print(v)
        case ParseResult.Failure(msg):
            print(msg)

    return 0
