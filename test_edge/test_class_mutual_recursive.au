class A:
    value: int32
    b_ref: indirect B?

class B:
    value: int32
    a_ref: indirect A?

def main() -> int32:
    b = B(value=20, a_ref=Option.None)
    a = A(value=10, b_ref=Option.Some(b))
    print(a.value)
    match a.b_ref:
        case Some(b_inner):
            print(b_inner.value)
        case None:
            pass
    return 0
