def find_first_even(limit: int32) -> int32:
    for i in range(limit):
        if i % 2 == 0:
            if i > 0:
                return i
    return -1

def find_in_while(target: int32) -> int32:
    mut i: int32 = 0
    while i < 100:
        if i == target:
            return i
        i += 1
    return -1

def main() -> int32:
    # Should return 2 (first even > 0)
    print(find_first_even(10))

    # Should return -1 (no even > 0 in range(1))
    print(find_first_even(1))

    # Should find 42
    print(find_in_while(42))

    # Should return -1 (200 > 100)
    print(find_in_while(200))

    return 0
