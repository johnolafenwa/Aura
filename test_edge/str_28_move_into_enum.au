# Test: moving owned String into an enum variant

enum Container:
    Full(String)
    Empty

def pack(text: String) -> Container:
    return Container.Full(text)

def unpack(c: Container) -> String:
    match c:
        case Container.Full(s):
            return s
        case Container.Empty:
            return "nothing"

def main() -> int32:
    # Move into enum
    c1 = pack("hello")
    result = unpack(c1)
    print(result)

    # Direct construction
    c2 = Container.Full("world")
    match c2:
        case Container.Full(s):
            print(s)
        case Container.Empty:
            print("empty")

    # Empty variant
    c3 = Container.Empty
    print(unpack(c3))

    return 0
