# Test: moving owned str into an enum variant

enum Container:
    Full(str)
    Empty

def pack(text: own str) -> Container:
    return Container.Full(text)

def unpack(c: own Container) -> str:
    match own c:
        case Container.Full(s):
            return s
        case Container.Empty:
            return "nothing"

def main() -> int32:
    # Move into enum
    c1 = pack("hello")
    result = unpack(c1)
    print(result)

    # Direct construction
    c2 = Container.Full("world")
    match own c2:
        case Container.Full(s):
            print(s)
        case Container.Empty:
            print("empty")

    # Empty variant
    c3 = Container.Empty
    print(unpack(c3))

    return 0
