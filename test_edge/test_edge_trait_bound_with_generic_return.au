# Test: trait-bounded function that returns a generic class

class Box[T]:
    value: T

trait Wrappable:
    def wrap_value(borrow self) -> int32

class Item:
    n: int32

impl Wrappable for Item:
    def wrap_value(borrow self) -> int32:
        return self.n

def box_it[T: Wrappable](item: T) -> Box[int32]:
    return Box(value=item.wrap_value())

def main() -> int32:
    i = Item(n=42)
    b: Box[int32] = box_it(item=i)
    print(b.value)
    return 0
