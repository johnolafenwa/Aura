## Test: Various string operations
def main() -> int32:
    ## Concatenation
    a: str = "hello"
    b: str = " world"
    c = a + b
    print(c)

    ## F-string with expressions
    x: int32 = 42
    msg = f"the answer is {x}"
    print(msg)

    ## Empty string
    empty: str = ""
    print(empty)

    ## str with special chars
    special: str = "tab\there"
    print(special)

    return 0
