enum Weekday:
    Monday
    Tuesday
    Wednesday
    Thursday
    Friday
    Saturday
    Sunday

def is_weekend(d: Weekday) -> bool:
    match own d:
        case Weekday.Monday:
            return false
        case Weekday.Tuesday:
            return false
        case Weekday.Wednesday:
            return false
        case Weekday.Thursday:
            return false
        case Weekday.Friday:
            return false
        case Weekday.Saturday:
            return true
        case Weekday.Sunday:
            return true

def main() -> int32:
    if is_weekend(Weekday.Saturday):
        print("weekend")
    if is_weekend(Weekday.Monday):
        print("weekend")
    else:
        print("weekday")
    return 0
