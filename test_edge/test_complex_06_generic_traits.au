# Test 6: Generic container with traits - Printable trait for multiple types
# Tests: traits, impl for different types, generics with trait bounds, class methods
# BUG FOUND: Adding "impl Trait for int32" causes "unsupported call target" error
# when calling trait methods on generic parameters in the same file.

trait Printable:
    def describe(self) -> String

class User:
    name: String
    age: int32

impl Printable for User:
    def describe(self) -> String:
        return f"User({self.name}, {self.age})"

class Product:
    title: String
    price: int32

impl Printable for Product:
    def describe(self) -> String:
        return f"Product({self.title}, {self.price})"

# Generic container with trait bound
class Container[T: Printable]:
    item: T

    def display(self) -> String:
        return self.item.describe()

# Generic function with trait bound
def show[T: Printable](value: T):
    print(value.describe())

def main() -> int32:
    # Test with User
    u = User(name="Alice", age=30)
    show(value=u)

    # Test with Product
    p = Product(title="Laptop", price=999)
    show(value=p)

    # Test Container with User
    c1 = Container(item=User(name="Bob", age=25))
    print(c1.display())

    # Test Container with Product
    c2 = Container(item=Product(title="Phone", price=499))
    print(c2.display())

    return 0
