## Test 35: Generic method on a non-generic class, with multiple types
## Expects: 100 then "test" then 1

class Util:
    id: int32

    def echo[T](borrow self, val: T) -> T:
        return val

def main() -> int32:
    u = Util(id=1)
    print(u.echo(100))
    print(u.echo("test"))
    print(u.echo(1))
    return 0
