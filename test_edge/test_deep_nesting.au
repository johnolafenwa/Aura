## Test 9: Deeply nested blocks - 6 levels of nesting
def main() -> int32:
    mut total: int32 = 0
    for i in range(3):
        if i >= 0:
            for j in range(3):
                if j >= 0:
                    for k in range(3):
                        if k >= 0:
                            total += 1
    print(total)
    return 0
