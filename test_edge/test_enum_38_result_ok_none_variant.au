def do_work(fail: bool) -> Result[int32, String]:
    if fail:
        return Result.Err("failed")
    return Result.Ok(0)

def main() -> int32:
    match do_work(false):
        case Result.Ok(v):
            print(v)
        case Result.Err(e):
            print(e)

    match do_work(true):
        case Result.Ok(v):
            print(v)
        case Result.Err(e):
            print(e)
    return 0
