# Edge test: with-resource block with error propagation via try

class Connection:
    name: str

    def query(self, q: int32) -> Result[int32, str]:
        if q < 0:
            return Result.Err("invalid query")
        return Result.Ok(q * 10)

    def close(mut self):
        print(f"closing {self.name}")

def run_query(q: int32) -> Result[int32, str]:
    with conn = Connection(name="db"):
        result = try conn.query(q)
        return Result.Ok(result + 1)

def main() -> int32:
    # Success case
    match run_query(5):
        case Result.Ok(v):
            print(f"success: {v}")
        case Result.Err(e):
            print(f"error: {e}")

    # Error case - should still close the resource
    match run_query(-1):
        case Result.Ok(v):
            print(f"success: {v}")
        case Result.Err(e):
            print(f"error: {e}")

    return 0
