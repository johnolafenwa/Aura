# Test: using a variant from wrong enum in match (should error)
enum Fruit:
    Apple
    Banana

enum Color:
    Red
    Blue

def name(f: Fruit) -> str:
    match own f:
        case Color.Red:
            return "red"
        case Fruit.Apple:
            return "apple"
        case Fruit.Banana:
            return "banana"

def main() -> int32:
    print(name(Fruit.Apple))
    return 0
