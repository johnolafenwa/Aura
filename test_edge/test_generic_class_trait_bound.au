# Test: generic class with trait-bounded type parameter
# e.g., class Container[T: Printable]:

trait Printable:
    def to_string(self) -> str

class Label:
    text: str

impl Printable for Label:
    def to_string(self) -> str:
        return self.text

class Container[T: Printable]:
    item: T

    def display(self):
        print(self.item.to_string())

def main() -> int32:
    l = Label(text="aura")
    c = Container(item=l)
    c.display()
    return 0
