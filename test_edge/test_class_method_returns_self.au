copy class Vec2:
    x: float64
    y: float64

    def add(self, other: Vec2) -> Vec2:
        return Vec2(x=self.x + other.x, y=self.y + other.y)

    def scale(self, factor: float64) -> Vec2:
        return Vec2(x=self.x * factor, y=self.y * factor)

    def length_sq(self) -> float64:
        return self.x * self.x + self.y * self.y

def main() -> int32:
    a = Vec2(x=1.0, y=2.0)
    b = Vec2(x=3.0, y=4.0)

    c = a.add(other=b)
    print(c.x)
    print(c.y)

    d = a.scale(factor=3.0)
    print(d.x)
    print(d.y)

    e = a.add(other=b).scale(factor=2.0)
    print(e.x)
    print(e.y)

    print(a.length_sq())

    return 0
