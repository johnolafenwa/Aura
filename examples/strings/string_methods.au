def print_optional_string(value: own str | None):
    match own value:
        case str as text:
            print(text)
        case None:
            print("none")

def main() -> int32:
    unicode = 'A🎉'
    unicode.len()       # 2 Unicode scalar values; O(n)
    unicode.byte_len()  # 5 UTF-8 bytes; O(1)

    text = "  aura repo  "
    print(text.len())
    print(text.contains("repo"))
    print(text.starts_with("  au"))
    print(text.ends_with("  "))
    trimmed = text.trim()
    print(trimmed)
    parts = trimmed.split(" ")
    print(parts.len())
    match parts.get(0):
        case Lookup.Found(value):
            print(value)
        case Lookup.Missing:
            pass
    match parts.get(1):
        case Lookup.Found(value):
            print(value)
        case Lookup.Missing:
            pass
    print(trimmed.replace("repo", "lang"))
    print(trimmed.to_lower())
    print(trimmed.to_upper())
    print_optional_string(trimmed.strip_prefix("aura "))
    print_optional_string(trimmed.strip_prefix("repo"))
    print_optional_string(trimmed.strip_suffix(" repo"))
    print_optional_string(trimmed.strip_suffix("aura"))
    print(trimmed.clone().len())
    return 0
