def producer(out: Queue[int32]) -> int32:
    out.put(2)
    out.put(4)
    out.close()
    return 6

def main() -> int32:
    jobs = Queue[int32]()
    with TaskGroup() as group:
        task = group.start(producer, jobs)

        while true:
            match jobs.get_or_none():
                case Option.Some(value):
                    print(value)
                case Option.None:
                    break

        print(task.result_or(-1))
    return 0
