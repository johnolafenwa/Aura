def producer(out: Queue[int32]) -> int32:
    _ = out.put(2)
    _ = out.put(4)
    out.close()
    return 6

def main() -> int32:
    jobs = Queue[int32]()
    with TaskGroup() as group:
        task = group.start(producer, jobs)

        while true:
            match jobs.poll(timeout=2s):
                case Poll.Ready(value):
                    print(value)
                case Poll.Unavailable:
                    break

        print(task.result_or(-1, timeout=2s))
    return 0
