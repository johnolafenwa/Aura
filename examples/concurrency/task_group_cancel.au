def worker(out: Queue[int32]):
    mut i: int32 = 0
    while i < 100:
        if cancelled():
            return
        out.put(i)
        i += 1

def main() -> int32:
    out: Queue[int32] = queue()

    with tasks() as group:
        group.start(worker, out)
        mut seen: int32 = 0

        while seen < 2:
            select:
                case value = out.get():
                    match value:
                        case Option.Some(next):
                            print(next)
                            seen += 1
                            if seen == 2:
                                group.cancel()
                        case Option.None:
                            break

    return 0
