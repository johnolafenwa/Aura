def main() -> int32:
    jobs: Queue[int32] = queue()
    jobs.close()

    send_result = jobs.put(7)
    match send_result:
        case Result.Ok(done):
            print("sent")
        case Result.Err(err):
            match err:
                case SendError.Closed(value):
                    print(value)
                case SendError.Cancelled(value):
                    print(value)

    return 0
