class Worker:
    def run(value: int32) -> int32:
        return value + 1

def main() -> int32:
    with TaskGroup() as group:
        task = group.start(Worker.run, 4)
        other = group.start(Worker.run, 6)
        print(task.result_or(-1, timeout=50ms))
        print(other.result_or(-1, timeout=50ms))

    return 0
