def consumer(inbox: Queue[int32]) -> int32:
    sleep(5ms)

    mut total: int32 = 0
    match inbox.get():
        case QueueReceive.Item(value):
            total += value
        case QueueReceive.Closed:
            return total
        case QueueReceive.TimedOut:
            return total
        case QueueReceive.Cancelled:
            return total

    sleep(5ms)

    match inbox.get():
        case QueueReceive.Item(value):
            total += value
        case QueueReceive.Closed:
            pass
        case QueueReceive.TimedOut:
            pass
        case QueueReceive.Cancelled:
            pass

    return total

def main() -> int32:
    jobs = Queue[int32](capacity=1)
    with TaskGroup() as group:
        worker = group.start(consumer, jobs)

        match jobs.put(1):
            case Result.Ok(_):
                print("queued 1")
            case Result.Err(_):
                print("send failed")
                return 1

        match jobs.put(2):
            case Result.Ok(_):
                print("queued 2")
            case Result.Err(_):
                print("send failed")
                return 1

        jobs.close()
        match worker.result():
            case TaskResult.Ready(total):
                print(total)
            case TaskResult.Cancelled:
                return 1
            case TaskResult.TimedOut:
                return 1
    return 0
