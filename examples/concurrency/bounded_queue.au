def consumer(inbox: Queue[int32]) -> int32:
    sleep(5ms)

    mut total: int32 = 0
    total += inbox.get_or(0, timeout=50ms)

    sleep(5ms)
    total += inbox.get_or(0, timeout=50ms)

    return total

def main() -> int32:
    jobs = Queue[int32](capacity=1)
    with TaskGroup() as group:
        worker = group.start(consumer, jobs)

        match jobs.put(1):
            case Result.Ok(_):
                print("queued 1")
            case Result.Err(_):
                print("send failed")
                return 1

        match jobs.put(2):
            case Result.Ok(_):
                print("queued 2")
            case Result.Err(_):
                print("send failed")
                return 1

        jobs.close()
        print(worker.result_or(-1, timeout=50ms))
    return 0
