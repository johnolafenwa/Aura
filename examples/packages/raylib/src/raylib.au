# Stop audio stream
public extern "C" def StopAudioStream(stream: AudioStream) -> None


# Set volume for audio stream (1.0 is max level)
public extern "C" def SetAudioStreamVolume(stream: AudioStream, volume: float32) -> None


# Set pitch for audio stream (1.0 is base level)
public extern "C" def SetAudioStreamPitch(stream: AudioStream, pitch: float32) -> None


# Set pan for audio stream (-1.0 to 1.0 range, 0.0 is centered)
public extern "C" def SetAudioStreamPan(stream: AudioStream, pan: float32) -> None


# Default size for new audio streams
public extern "C" def SetAudioStreamBufferSizeDefault(size: int32) -> None


