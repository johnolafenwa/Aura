"""raylib 6.0, bound through FFI.

Generated by `tools/generate_binding.py` from raylib's own
`raylib_api.json`. Do not edit this file by hand.
Names are raylib's own, so its cheatsheet and examples read
across: `InitWindow` in C is `raylib.InitWindow` here.

A pointer inside a struct, such as `Image.data`, is a `uint64`
address that raylib owns. Pass the struct back to raylib and do
not change the address.
"""


public extern "C" class Vector2:
    """Vector2, 2 components."""
    public x: float32
    public y: float32


public extern "C" class Vector3:
    """Vector3, 3 components."""
    public x: float32
    public y: float32
    public z: float32


public extern "C" class Vector4:
    """Vector4, 4 components."""
    public x: float32
    public y: float32
    public z: float32
    public w: float32


