# Initialize window and OpenGL context
public extern "C" def InitWindow(width: int32, height: int32, title: cstr) -> None


# Close window and unload OpenGL context
public extern "C" def CloseWindow() -> None


# Check if application should close (KEY_ESCAPE pressed or windows close icon
# clicked)
public extern "C" def WindowShouldClose() -> bool


# Check if window has been initialized successfully
public extern "C" def IsWindowReady() -> bool


# Check if window is currently fullscreen
public extern "C" def IsWindowFullscreen() -> bool


# Check if window is currently hidden
public extern "C" def IsWindowHidden() -> bool


# Check if window is currently minimized
public extern "C" def IsWindowMinimized() -> bool


# Check if window is currently maximized
public extern "C" def IsWindowMaximized() -> bool


# Check if window is currently focused
public extern "C" def IsWindowFocused() -> bool


