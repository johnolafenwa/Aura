"""Draws a picture into an image and writes it to a file.

raylib's image functions work on memory, so this program needs no window
and no display. Run it from the package directory:

    aura run src/picture.au
"""

import raylib

WIDTH: int32 = 320
HEIGHT: int32 = 200


def sky(image: mut raylib.Image) -> None:
    """Fills the image with bands that fade from blue to white."""
    bands: int32 = 20
    for index in range(20):
        band = index as int32
        step = band * 255 // (bands - 1)
        shade = raylib.Color(
            r=step as uint8,
            g=(120 + step * 135 // 255) as uint8,
            b=255,
            a=255,
        )
        raylib.ImageDrawRectangle(
            image,
            0,
            band * HEIGHT // bands,
            WIDTH,
            HEIGHT // bands,
            shade,
        )


def main() -> int32:
    raylib.SetTraceLogLevel(raylib.LOG_WARNING)
    mut image = raylib.GenImageColor(WIDTH, HEIGHT, raylib.RAYWHITE)
    sky(image)
    raylib.ImageDrawCircle(image, 250, 50, 28, raylib.GOLD)
    # A fan of triangles around its first point: a hill behind the house.
    hill = [
        raylib.Vector2(x=220.0, y=150.0),
        raylib.Vector2(x=320.0, y=150.0),
        raylib.Vector2(x=290.0, y=110.0),
        raylib.Vector2(x=240.0, y=95.0),
        raylib.Vector2(x=180.0, y=120.0),
        raylib.Vector2(x=150.0, y=150.0),
    ]
    raylib.ImageDrawTriangleFan(image, hill, len(hill) as int32, raylib.LIME)
    raylib.ImageDrawRectangle(image, 0, 150, WIDTH, 50, raylib.DARKGREEN)
    raylib.ImageDrawRectangle(image, 60, 100, 80, 50, raylib.MAROON)
    raylib.ImageDrawLineEx(
        image,
        raylib.Vector2(x=50.0, y=100.0),
        raylib.Vector2(x=100.0, y=70.0),
        4,
        raylib.DARKBROWN,
    )
    raylib.ImageDrawLineEx(
        image,
        raylib.Vector2(x=100.0, y=70.0),
        raylib.Vector2(x=150.0, y=100.0),
        4,
        raylib.DARKBROWN,
    )
    raylib.ImageDrawRectangleLines(
        image,
        raylib.Rectangle(x=0.0, y=0.0, width=320.0, height=200.0),
        2,
        raylib.BLACK,
    )

    if not raylib.ExportImage(image, "picture.png"):
        print("could not write picture.png")
        return 1
    raylib.UnloadImage(image)

    saved = raylib.LoadImage("picture.png")
    print(f"picture.png is {saved.width} by {saved.height}")
    sun = raylib.GetImageColor(saved, 250, 50)
    print(f"the sun is {sun.r}, {sun.g}, {sun.b}")
    hill_top = raylib.GetImageColor(saved, 240, 120)
    print(f"the hill is {hill_top.r}, {hill_top.g}, {hill_top.b}")
    grass = raylib.GetImageColor(saved, 10, 190)
    print(f"the grass is {grass.r}, {grass.g}, {grass.b}")
    raylib.UnloadImage(saved)
    return 0
