"""Reference tool runner, version 2: typed tools with derived codecs and decorators."""

import agent
import control
import json
import metrics
from agent import ToolCall, ToolError, traced


class DoubleArgs:
    """Doubles a number."""

    value: int64


impl json.Codec for DoubleArgs


class IncrementArgs:
    """Adds a step to a number."""

    value: int64
    step: int64 = 1


impl json.Codec for IncrementArgs


class Answer:
    """A tool's numeric result."""

    tool: str
    value: int64


impl json.Codec for Answer


@traced("double")
def double(args: DoubleArgs) -> Result[Answer, ToolError]:
    return Ok(Answer(tool="double", value=args.value * 2))


@traced("increment")
def increment(args: IncrementArgs) -> Result[Answer, ToolError]:
    return Ok(Answer(tool="increment", value=args.value + args.step))


def dispatch(call: own ToolCall) -> Result[json.Value, ToolError]:
    if call.tool == "double":
        return agent.run(double, call.args)
    if call.tool == "increment":
        return agent.run(increment, call.args)
    return Err(ToolError.UnknownTool(name=call.tool))


def handle(text: str) -> Result[json.Value, ToolError]:
    match own json.decode_text[ToolCall](text):
        case Ok(call):
            return dispatch(call)
        case Err(error):
            return Err(ToolError.InvalidRequest(reason=f"{error}"))


class Session:
    name: str

    def close(mut self) -> None:
        print(f"closed {self.name}")


def connect_tools() -> Result[int64, ToolError]:
    metrics.increment("tool-runner-attempts", 1)
    if metrics.get("tool-runner-attempts") < 3:
        return Err(ToolError.NotReady)
    return Ok(metrics.get("tool-runner-attempts"))


def stream_events(events: Queue[str]) -> None:
    events.put("stream started")
    events.put("token tools")
    events.put("token ready")
    events.put("stream finished")
    events.close()


def run_tools() -> Result[int32, ToolError]:
    for spec in [
        agent.tool[DoubleArgs]("double"),
        agent.tool[IncrementArgs]("increment"),
    ]:
        print(f"tool {spec.name} {json.dumps(spec.schema)}")
    requests = [
        '{"tool": "double", "args": {"value": 21}}',
        '{"tool": "increment", "args": {"value": 42}}',
        '{"tool": "increment", "args": {"value": 42, "step": 8}}',
        '{"tool": "double", "args": {"value": "x"}}',
        '{"tool": "double", "args": {"value": 1, "extra": true}}',
        '{"tool": "missing", "args": {}}',
        '{"args": {}}',
    ]
    for text in requests:
        match own handle(text):
            case Ok(value):
                print(f"result {json.dumps(value)}")
            case Err(ToolError.InvalidRequest(reason)):
                print(f"rejected {reason}")
            case Err(ToolError.UnknownTool(name)):
                print(f"unknown tool {name}")
            case Err(error):
                return Err(error)

    metrics.reset()
    attempts = try control.retry(connect_tools, max_attempts=3, initial_backoff=0ms)
    print(f"ready after {attempts} attempts")
    events = Queue[str]()
    with TaskGroup() as group:
        group.start(stream_events, events)
        for event in events:
            print(event)
    return Ok(0)


def main() -> int32:
    print("tool-runner version 2")
    with session = Session(name="tool-runner"):
        match run_tools():
            case Ok(code):
                return code
            case Err(error):
                print(error)
                return 1
