def main():
    mut hosts = list[str]()
    hosts.append("alpha")
    hosts.append("beta")

    for index, host in enumerate(hosts):
        print(f"{index}: {host}")

    mut ports = list[int32]()
    ports.append(80)
    ports.append(443)
    ports.append(8080)

    for host, port in zip(hosts, ports):
        print(f"{host}:{port}")

    print(ports.len())
