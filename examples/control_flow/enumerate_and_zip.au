def main():
    mut hosts = Vec[String]()
    hosts.push("alpha")
    hosts.push("beta")

    for index, host in enumerate(hosts):
        print(f"{index}: {host}")

    mut ports = Vec[int32]()
    ports.push(80)
    ports.push(443)
    ports.push(8080)

    for host, port in zip(hosts, ports):
        print(f"{host}:{port}")

    print(ports.len())
