def choose_positive(left: borrow[shared] int32, right: borrow[shared] int32) -> borrow[shared] int32:
    if left > 0:
        return left
    return right

def identity(value: borrow[src] int32) -> borrow[src] int32:
    return value

def main() -> int32:
    left: int32 = 0
    right: int32 = 7
    picked = choose_positive(left=left, right=right)
    aliased = identity(value=picked)
    print(aliased)
    return 0
