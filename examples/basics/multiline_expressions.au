def weighted_total(
    values: Vec[int64],
    weights: Vec[int64]
) -> int64:
    return (
        values[0] * weights[0]
        + values[1] * weights[1]
    )

def main():
    values = [
        10, # first input
        20
    ]
    weights = [
        2,
        3
    ]
    labels = {
        "first": values[0],
        "second": values[1]
    }
    total = weighted_total(
        values,
        weights
    )
    print(total)
    print(labels["second"])
