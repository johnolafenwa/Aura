def main() -> int32:
    # Integer division is explicit floor division. The remainder follows the
    # divisor's sign, so quotient * divisor + remainder always recovers the
    # dividend.
    print(7 // 3)
    print(-7 // 3)
    print(-7 % 3)
    print(7 // -3)
    print(7 % -3)

    # `/` is true division for floats. Convert both integer operands when a
    # fractional result is wanted.
    numerator: int64 = 7
    denominator: int64 = 2
    print(numerator.to_float() / denominator.to_float())

    # `as float64` remains checked and exact.
    exact_integer: int64 = 42
    exact_float: float64 = exact_integer as float64
    print(exact_float)

    # `.to_float()` deliberately permits IEEE-754 round-to-nearest,
    # ties-to-even conversion. Writing `rounded_integer as float64` instead
    # would trap because this value is not exactly representable.
    rounded_integer: int64 = 9007199254740993
    print(rounded_integer.to_float() == 9007199254740992.0)

    return 0
