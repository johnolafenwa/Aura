"""A generic retry decorator, with the attempt count as its argument."""

type Fn[A, R] = Callable[def(args: A) -> R]
type Decorator[A, R] = Callable[def(f: own Fn[A, R]) -> Fn[A, R]]


def retry[A, R, E](attempts: own int32) -> Decorator[A, Result[R, E]]:
    """Builds a decorator that calls the function up to `attempts` times."""
    return Decorator[A, Result[R, E]](lambda [own attempts] own f: retrying(f, attempts))


def retrying[A, R, E](f: own Fn[A, Result[R, E]], attempts: own int32) -> Fn[A, Result[R, E]]:
    return Fn[A, Result[R, E]](lambda [own f, own attempts] args: attempt(f, args, attempts))


def attempt[A, R, E](f: Fn[A, Result[R, E]], args: A, attempts: int32) -> Result[R, E]:
    mut tries: int32 = 1
    while tries < attempts:
        match own f(args):
            case Ok(value):
                return Ok(value)
            case Err(error):
                print(f"attempt {tries} failed")
        tries += 1
    return f(args)


@retry(3)
def parse_port(args: str) -> Result[int64, str]:
    if args == "8080":
        return Ok(8080)
    return Err(f"bad port {args}")


def main():
    match own parse_port("8080"):
        case Ok(port):
            print(port)
        case Err(message):
            print(message)
    match own parse_port("http"):
        case Ok(port):
            print(port)
        case Err(message):
            print(message)
