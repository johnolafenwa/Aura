import io
import net

def serve(addresses: Queue[String]) -> Result[None, io.Error]:
    with server_listener = try net.listen("127.0.0.1:0"):
        addresses.put(try server_listener.local_addr())
        stream = try server_listener.accept(timeout=5s)
        with server_stream = stream:
            payload = try server_stream.read_exact(4, timeout=5s)
            print(payload.len())
            try server_stream.write_bytes(payload, timeout=5s)
            return Result.Ok(None)

def run() -> Result[None, io.Error]:
    with TaskGroup() as group:
        addresses = Queue[String](capacity=1)
        server = group.start(serve, addresses)
        address = try receive_address(addresses)

        stream = try net.connect_timeout(address, 5s)
        with client_stream = stream:
            try client_stream.write_bytes([116 as uint8, 101 as uint8, 115 as uint8, 116 as uint8], timeout=5s)
            match try client_stream.read_bytes(8, timeout=5s):
                case Option.Some(reply):
                    print(reply[0])
                case Option.None:
                    return Result.Ok(None)

        match own server.result():
            case TaskResult.Ready(result):
                try result
            case TaskResult.Error(_message):
                return Result.Ok(None)
            case TaskResult.Cancelled:
                return Result.Ok(None)
            case TaskResult.TimedOut:
                return Result.Ok(None)
        return Result.Ok(None)

def receive_address(addresses: Queue[String]) -> Result[String, io.Error]:
    match own addresses.get(timeout=5s):
        case QueueReceive.Item(address):
            return Result.Ok(address)
        case QueueReceive.Closed:
            return Result.Err(io.Error.Other(message="TCP address queue closed"))
        case QueueReceive.TimedOut:
            return Result.Err(io.Error.TimedOut)
        case QueueReceive.Cancelled:
            return Result.Err(io.Error.Cancelled)

def main() -> int32:
    match run():
        case Result.Ok(_):
            return 0
        case Result.Err(error):
            print(error)
            return 1
