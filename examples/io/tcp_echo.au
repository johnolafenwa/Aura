import io
import net

def serve(addresses: Queue[String]) -> Result[None, io.Error]:
    with server = try net.listen("127.0.0.1:0"):
        addresses.put(try server.local_addr())
        with stream = try server.accept():
            message = try stream.read_line()
            match own message:
                case Option.Some(text):
                    try stream.write_all("echo:" + text)
                    try stream.flush()
                case Option.None:
                    pass
        return Result.Ok(None)

def main() -> int32:
    with TaskGroup() as group:
        addresses = Queue[String](capacity=1)
        server = group.start(serve, addresses)
        match addresses.get(timeout=5s):
            case QueueReceive.Item(address):
                match own net.connect(address):
                    case Result.Ok(client):
                        with socket = client:
                            match socket.write_all("ping\n"):
                                case Result.Ok(_):
                                    pass
                                case Result.Err(_):
                                    return 1
                            match socket.flush():
                                case Result.Ok(_):
                                    pass
                                case Result.Err(_):
                                    return 1
                            match own socket.read_line():
                                case Result.Ok(message):
                                    match own message:
                                        case Option.Some(text):
                                            print(text)
                                        case Option.None:
                                            return 1
                                case Result.Err(_):
                                    return 1
                    case Result.Err(_):
                        return 1
                match own server.result():
                    case TaskResult.Ready(result):
                        match own result:
                            case Result.Ok(_):
                                return 0
                            case Result.Err(_):
                                return 1
                    case TaskResult.Error(_message):
                        return 1
                    case TaskResult.Cancelled:
                        return 1
                    case TaskResult.TimedOut:
                        return 1
            case QueueReceive.Closed:
                return 1
            case QueueReceive.TimedOut:
                return 1
            case QueueReceive.Cancelled:
                return 1
