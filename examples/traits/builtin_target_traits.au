trait Describe:
    def describe(self) -> str

impl Describe for list[int32]:
    def describe(self) -> str:
        return f"list of {self.len()}"

impl Describe for str:
    def describe(self) -> str:
        return f"text of {self.len()}"

def describe_through_bound[T: Describe](value: T) -> str:
    return value.describe()

def main():
    mut values = list[int32]()
    values.append(1)
    values.append(2)
    print(values.describe())

    text = "hello"
    print(describe_through_bound(text))
