copy class Money:
    cents: int64

impl Display for Money:
    def display(self) -> str:
        return f"${self.cents // 100}.{self.cents % 100:02}"

enum Status:
    Paid(Money)
    Due

impl Display for Status:
    def display(self) -> str:
        match self:
            case Status.Paid(amount):
                return f"paid {amount}"
            case Status.Due:
                return "due"

class Invoice:
    total: Money
    status: Status

def main():
    price = Money(cents=1250)
    print(price)
    print(f"[{price:>8}]")
    print(str(Status.Paid(price)))
    print([price, Money(cents=5)])
    print(Invoice(total=price, status=Status.Due))
