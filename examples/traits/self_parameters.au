trait Combine:
    def combine(self, other: Self) -> Self

class Counter:
    value: int32

impl Combine for Counter:
    def combine(self, other: Self) -> Self:
        return Counter(value=self.value + other.value)

def main() -> int32:
    left = Counter(value=4)
    right = Counter(value=5)
    total = left.combine(right)
    print(total.value)
    return 0
