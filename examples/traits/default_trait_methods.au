trait Named:
    def name(self) -> str
    def label(self) -> str:
        return "name=" + self.name()

class User:
    name: str

class Team:
    name: str

impl Named for User:
    def name(self) -> str:
        return self.name.clone()

impl Named for Team:
    def name(self) -> str:
        return self.name.clone()

    def label(self) -> str:
        return "team=" + self.name()

def show[T: Named](value: T):
    print(value.label())

def main() -> None:
    show(value=User(name="aura"))
    show(value=Team(name="infra"))
