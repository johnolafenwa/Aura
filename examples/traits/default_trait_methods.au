trait Named:
    def name(borrow self) -> String
    def label(borrow self) -> String:
        return "name=" + self.name()

class User:
    name: String

class Team:
    name: String

impl Named for User:
    def name(borrow self) -> String:
        return self.name.clone()

impl Named for Team:
    def name(borrow self) -> String:
        return self.name.clone()

    def label(borrow self) -> String:
        return "team=" + self.name()

def show[T: Named](value: T):
    print(value.label())

def main() -> None:
    show(value=User(name="aurora"))
    show(value=Team(name="infra"))
