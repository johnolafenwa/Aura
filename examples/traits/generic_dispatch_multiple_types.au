trait Describe:
    def describe(self) -> str

class Dog:
    name: str

class Cat:
    label: str

impl Describe for Dog:
    def describe(self) -> str:
        return "dog"

impl Describe for Cat:
    def describe(self) -> str:
        return "cat"

def show[T: Describe](animal: T) -> None:
    print(animal.describe())

def main() -> int32:
    show(animal=Dog(name="Rex"))
    show(animal=Cat(label="Milo"))
    return 0
