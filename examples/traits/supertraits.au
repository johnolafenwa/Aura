trait Named:
    def name(self) -> str

trait Labelled: Named:
    def label(self) -> str:
        return "name=" + self.name()

class User:
    name: str

impl Named for User:
    def name(self) -> str:
        return self.name.clone()

impl Labelled for User:
    pass

def show[T: Labelled](value: T) -> None:
    print(value.label())
    print(value.name())

def main() -> int32:
    show(value=User(name="aura"))
    return 0
