class Point:
    x: int64
    y: int64

def describe(values: list[int64]) -> str:
    return match values:
        case []: "empty"
        case [only]: f"one: {only}"
        case [first, *_, last]: f"from {first} to {last}"

def locate(point: Point) -> str:
    return match point:
        case Point(x=0, y=0): "origin"
        case Point(x=0, y=y): f"on the y axis at {y}"
        case Point(x=x, y=0): f"on the x axis at {x}"
        case _: "elsewhere"

def main():
    head, *tail = (1, "two", 3.0)
    print(head)
    print(tail)

    print(describe([]))
    print(describe([7]))
    print(describe([1, 2, 3, 4]))

    match [10, 20, 30]:
        case [first, *rest]:
            print(f"{first} then {rest}")
        case []:
            print("empty")

    print(locate(Point(x=0, y=0)))
    print(locate(Point(x=0, y=5)))
    print(locate(Point(x=3, y=4)))
