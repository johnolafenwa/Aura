enum Status:
    Ready
    Count(int32)

def main() -> int32:
    status = Status.Count(value=4)
    ok: Result[int32, str] = Ok(7)
    maybe: int32 | None = 9

    print(status)
    match own ok:
        case Ok(value):
            print(value)
        case Err(message):
            print(message)
    match own maybe:
        case int32 as value:
            print(value)
        case None:
            print(0)
    return 0
