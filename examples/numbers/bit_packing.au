def pack_rgb(red: uint32, green: uint32, blue: uint32) -> uint32:
    sixteen: uint32 = 16
    eight: uint32 = 8
    return (red << sixteen) | (green << eight) | blue

def main() -> int32:
    red: uint32 = 0xFF
    green: uint32 = 0x80
    blue: uint32 = 0b0000_0000
    packed = pack_rgb(red, green, blue)
    mask: uint32 = 0xFF
    eight: uint32 = 8
    sixteen: uint32 = 16

    print(packed)
    print((packed >> sixteen) & mask)
    print((packed >> eight) & mask)
    print(packed & mask)

    high: uint8 = 0b1000_0000
    one: uint8 = 1
    print(high.wrapping_shl(one))
    print(high.saturating_shl(one))
    print(high.wrapping_shr(one))
    print(high.saturating_shr(one))

    print(3 ** 4)
    print(round(2.5))
    print(round(3.5))

    quotient, remainder = divmod(-17, 5)
    print(quotient)
    print(remainder)
    return 0
