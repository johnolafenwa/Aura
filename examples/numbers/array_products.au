def main() -> int32:
    scores = Array[float64].from_list(
        [72.0, 88.0, 95.0,
         95.0, 91.0, 84.0],
        [2, 3],
    )
    weights = Array[float64].from_list([0.2, 0.3, 0.5], [3])
    print(scores.matmul(weights))
    print(weights.dot(weights))

    left = Array[int64].from_list([1, 2, 3, 4], [2, 2])
    right = Array[int64].from_list([5, 6, 7, 8], [2, 2])
    print(left.matmul(right))
    print(left.dot(right))

    tenths = Array[float64].full([1000000], 0.1)
    print(tenths.sum())
    print(tenths.fast_sum())
    print(tenths.fast_mean())
    return 0
