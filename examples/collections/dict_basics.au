def print_int_lookup(value: Lookup[int32]):
    match own value:
        case Lookup.Found(inner):
            print(inner)
        case Lookup.Missing:
            print(-1)

def main() -> int32:
    mut counts: dict[str, int32] = {"aura": 1}
    other: dict[str, int32] = {"codex": 2, "repo": 3}
    counts.update(other)
    print(counts.len())
    print(("aura" in counts))
    print_int_lookup(counts.get("aura"))
    previous_aura = counts.get("aura")
    counts["aura"] = 5
    print_int_lookup(previous_aura)
    print(counts["aura"])
    items = counts.items()
    match items.get(0):
        case Lookup.Found(entry):
            print(entry)
        case Lookup.Missing:
            pass
    match items.get(2):
        case Lookup.Found(entry):
            print(entry)
        case Lookup.Missing:
            pass
    print(counts.keys().len())
    print(counts.values().len())
    print(counts.items().len())
    counts.clear()
    print(counts.is_empty())
    return 0
