def print_int_option(value: Option[int32]):
    match own value:
        case Some(inner):
            print(inner)
        case None:
            print(-1)

def main() -> int32:
    mut values: list[int32] = [1, 2, 3]
    print(values.len())
    print(values[0])
    print_int_option(values.get(1))
    print(values.set(index=1, value=20))
    print(values[1])
    print(values.pop(0))
    values.append(99)
    print(values.pop())
    print(values.is_empty())
    return 0
