def print_bool(value: bool):
    match value:
        case true:
            print("true")
        case false:
            print("false")

def main() -> int32:
    mut names: Vec[String] = ["Ada", "Grace"]
    match names.get(-2):
        case Option.Some(value):
            print(value)
        case Option.None:
            pass

    match names.get(-1):
        case Option.Some(value):
            print(value)
        case Option.None:
            pass

    mut values = [1, 3]
    print_bool(values.insert(index=-1, value=2))
    values.push(4)
    values.reverse()
    print(values[-4])
    print(values[-1])

    for value in mut values:
        value += 10

    for index in range(values.len() as int32):
        print(values[index])

    values.swap(first=-4, second=-2)
    print_bool(values.contains(12))

    extras = [99, 100]
    values.extend(extras)

    print(values[-1])
    print_bool(values == [12, 13, 14, 11, 99, 100])
    values.clear()
    print_bool(values.is_empty())
    return 0
