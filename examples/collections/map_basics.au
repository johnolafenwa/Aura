def print_int_option(value: Option[int32]):
    match value:
        case Some(inner):
            print(inner)
        case None:
            print(-1)

def main() -> int32:
    mut counts = {"aurora": 1}
    other = {"codex": 2, "repo": 3}
    counts.extend(other)
    print(counts.len())
    print(counts.contains_key("aurora"))
    print_int_option(counts.get("aurora"))
    print_int_option(counts.set(key="aurora", value=5))
    print(counts["aurora"])
    items = counts.items()
    print(items[0].key)
    print(items[2].value)
    print(counts.keys().len())
    print(counts.values().len())
    print(counts.entries().len())
    counts.clear()
    print(counts.is_empty())
    return 0
