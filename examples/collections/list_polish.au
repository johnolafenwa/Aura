def print_bool(value: bool):
    match own value:
        case true:
            print("true")
        case false:
            print("false")

def main() -> int32:
    mut names: list[str] = ["Ada", "Grace"]
    match names.get(-2):
        case Lookup.Found(value):
            print(value)
        case Lookup.Missing:
            pass

    match names.get(-1):
        case Lookup.Found(value):
            print(value)
        case Lookup.Missing:
            pass

    mut values = [1, 3]
    values.insert(index=-1, value=2)
    print_bool(true)
    values.append(4)
    values.reverse()
    print(values[-4])
    print(values[-1])

    for value in mut values:
        value += 10

    for index in range(values.len()):
        print(values[index])

    values.swap(first=-4, second=-2)
    print_bool((12 in values))

    extras = [99, 100]
    values.extend(extras)

    print(values[-1])
    print_bool(values == [12, 13, 14, 11, 99, 100])
    values.clear()
    print_bool(values.is_empty())
    return 0
