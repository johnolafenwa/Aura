import helpers.math

def apply(transform: def(int32) -> int32, value: int32) -> int32:
    return transform(value)

def main() -> int32:
    imported = helpers.math.double
    imported_empty: def() -> Option[int32] = helpers.math.empty
    print(imported(5))
    print(apply(imported, 6))
    with group = TaskGroup():
        empty_task = group.start(imported_empty)
        match empty_task.result_or(Option.Some(99), timeout=1s):
            case Option.None:
                print("none")
            case Option.Some(value):
                print(value)
    return 0
