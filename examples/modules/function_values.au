import helpers.math
type Unary = def(int32) -> int32

def apply(transform: def(int32) -> int32, value: int32) -> int32:
    return transform(value)

def main() -> int32:
    imported = helpers.math.double
    imported_empty: def() -> (int32 | None) = helpers.math.empty
    print(imported(5))
    print(apply(Unary(imported), 6))
    with group = TaskGroup():
        empty_task = group.start(imported_empty)
        match own empty_task.result_or(99, timeout=1s):
            case None:
                print("none")
            case int32 as value:
                print(value)
    return 0
